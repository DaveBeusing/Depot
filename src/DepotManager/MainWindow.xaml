<Window x:Class="DepotManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Depot.Controls"
        Title="Depot Manager"
        Icon="Resources/Images/Depot.ico"
        Width="900" Height="720" MinWidth="820" MinHeight="650"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource NavigationBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,22">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Depot Manager" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="Install and maintain Depot" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border x:Name="StatusBadge" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="Checking installation…"/>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="28,24">
      <Grid x:Name="InstallationWizard">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="{DynamicResource NavigationBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
          <StackPanel>
            <TextBlock Text="Installation" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,18"/>
            <TextBlock x:Name="Step1Text" Text="1   Install location" Style="{StaticResource ManagerStepTextStyle}" Margin="0,0,0,14"/>
            <TextBlock x:Name="Step2Text" Text="2   Database" Style="{StaticResource ManagerStepTextStyle}" Margin="0,0,0,14"/>
            <TextBlock x:Name="Step3Text" Text="3   Configuration" Style="{StaticResource ManagerStepTextStyle}" Margin="0,0,0,14"/>
            <TextBlock x:Name="Step4Text" Text="4   Administrator" Style="{StaticResource ManagerStepTextStyle}" Margin="0,0,0,14"/>
            <TextBlock x:Name="Step5Text" Text="5   Ready" Style="{StaticResource ManagerStepTextStyle}"/>
          </StackPanel>
        </Border>

        <Grid Grid.Column="2">
          <Border x:Name="Step1Panel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
            <StackPanel>
              <TextBlock Text="Choose where Depot should be installed" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="Depot is installed per user and does not require a separate runtime installation." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,18" TextWrapping="Wrap"/>
              <TextBlock Text="Install location" Style="{StaticResource ManagerLabelStyle}"/>
              <TextBox x:Name="InstallPathBox" Style="{StaticResource AppTextBoxStyle}"/>
              <ProgressBar x:Name="Progress" Style="{StaticResource ManagerProgressBarStyle}" Height="6" Margin="0,18,0,0" Minimum="0" Maximum="100"/>
              <Button Content="Install" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,24,0,0" Click="Install_Click"/>
            </StackPanel>
          </Border>

          <Border x:Name="Step2Panel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
            <StackPanel>
              <TextBlock Text="Choose the database" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="Select how this Depot installation should connect to its database." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,20" TextWrapping="Wrap"/>

              <Button Tag="0" Style="{StaticResource ManagerChoiceCardStyle}" Margin="0,0,0,10" Click="DatabaseChoice_Click">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Lokal (sqlite3)" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Create and use a local SQLite database on this computer." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,24,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="›" FontSize="24" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Button>

              <Button Tag="1" Style="{StaticResource ManagerChoiceCardStyle}" Margin="0,0,0,10" Click="DatabaseChoice_Click">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Remote (MySQL/MariaDB)" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Connect to an existing MySQL or MariaDB server." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,24,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="›" FontSize="24" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Button>

              <Button Tag="2" Style="{StaticResource ManagerChoiceCardStyle}" Click="DatabaseChoice_Click">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Remote (SQL)" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Connect to an existing Microsoft SQL Server database." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,24,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="›" FontSize="24" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </StackPanel>
          </Border>

          <Border x:Name="Step3Panel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Configure the database" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="SelectedDatabaseText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>

                <StackPanel x:Name="LocalDatabasePanel">
                  <TextBlock Text="Local database file" Style="{StaticResource ManagerLabelStyle}"/>
                  <TextBox x:Name="SqlitePathBox" Style="{StaticResource AppTextBoxStyle}" TextChanged="ConnectionInput_Changed"/>
                </StackPanel>

                <StackPanel x:Name="RemoteDatabasePanel" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Server / Host" Style="{StaticResource ManagerLabelStyle}"/>
                      <TextBox x:Name="HostBox" Style="{StaticResource AppTextBoxStyle}" TextChanged="ConnectionInput_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Port" Style="{StaticResource ManagerLabelStyle}"/>
                      <TextBox x:Name="PortBox" Style="{StaticResource AppTextBoxStyle}" TextChanged="ConnectionInput_Changed"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Database" Style="{StaticResource ManagerLabelStyle}"/>
                  <TextBox x:Name="DatabaseBox" Style="{StaticResource AppTextBoxStyle}" TextChanged="ConnectionInput_Changed"/>
                  <TextBlock Text="Username" Style="{StaticResource ManagerLabelStyle}"/>
                  <TextBox x:Name="UserBox" Style="{StaticResource AppTextBoxStyle}" TextChanged="ConnectionInput_Changed"/>
                  <TextBlock Text="Password" Style="{StaticResource ManagerLabelStyle}"/>
                  <controls:PasswordInput x:Name="DatabasePasswordBox" Style="{StaticResource RoundedPasswordInputStyle}" PasswordValueChanged="ConnectionPassword_Changed"/>
                  <CheckBox x:Name="TlsBox" Content="Require encrypted/TLS connection" IsChecked="True" Margin="0,14,0,0" Checked="ConnectionOption_Changed" Unchecked="ConnectionOption_Changed"/>
                </StackPanel>

                <Border x:Name="ConnectionResultBorder" Visibility="Collapsed" Margin="0,18,0,0" Padding="12,10" BorderThickness="1" CornerRadius="6">
                  <TextBlock x:Name="ConnectionResultText" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                  <Button Content="Back" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Back_Click"/>
                  <Button Content="Validate" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ValidateConnection_Click"/>
                  <Button x:Name="ConfigurationNextButton" Content="Next" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="ConfigurationNext_Click"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border x:Name="Step4Panel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
            <StackPanel>
              <TextBlock Text="Create administrator" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="Create the initial administrator for the local Depot database. Depot will not start until the complete setup succeeds." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
              <TextBlock Text="Administrator name" Style="{StaticResource ManagerLabelStyle}"/>
              <TextBox x:Name="AdminNameBox" Style="{StaticResource AppTextBoxStyle}"/>
              <TextBlock Text="Administrator e-mail / username" Style="{StaticResource ManagerLabelStyle}"/>
              <TextBox x:Name="AdminEmailBox" Style="{StaticResource AppTextBoxStyle}"/>
              <TextBlock Text="Password" Style="{StaticResource ManagerLabelStyle}"/>
              <controls:PasswordInput x:Name="AdminPasswordBox" Style="{StaticResource RoundedPasswordInputStyle}"/>
              <TextBlock Text="Confirm password" Style="{StaticResource ManagerLabelStyle}"/>
              <controls:PasswordInput x:Name="AdminConfirmBox" Style="{StaticResource RoundedPasswordInputStyle}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Back" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Back_Click"/>
                <Button Content="Next" Style="{StaticResource PrimaryButtonStyle}" Click="AdministratorNext_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="Step5Panel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Depot is ready" FontSize="24" FontWeight="SemiBold"/>
              <TextBlock Text="Continue will complete the configuration, close Depot Manager and start Depot." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="SummaryText" Margin="0,16,0,24" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Back" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Back_Click"/>
                <Button Content="Continue" Style="{StaticResource PrimaryButtonStyle}" Click="Continue_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Border x:Name="MaintenancePanel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
        <StackPanel>
          <TextBlock Text="Depot maintenance" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="The installed Depot version can be started, updated, repaired or removed." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,22"/>
          <WrapPanel>
            <Button Content="Start Depot" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,10" Click="Start_Click"/>
            <Button Content="Update" Style="{StaticResource ManagerSuccessButtonStyle}" Margin="0,0,10,10" Click="Update_Click"/>
            <Button Content="Repair" Style="{StaticResource ManagerWarningButtonStyle}" Margin="0,0,10,10" Click="Repair_Click"/>
            <Button Content="Uninstall" Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,10" Click="Uninstall_Click"/>
          </WrapPanel>
          <TextBlock Text="Installation location" Style="{StaticResource ManagerLabelStyle}"/>
          <TextBox x:Name="MaintenancePathBox" IsReadOnly="True" Style="{StaticResource AppTextBoxStyle}"/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource NavigationBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,12">
      <TextBlock x:Name="DetailText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
