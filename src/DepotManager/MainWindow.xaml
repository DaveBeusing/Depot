<Window x:Class="DepotManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Depot Manager" Icon="Resources/Images/Depot.ico" Width="900" Height="690" MinWidth="820" MinHeight="620" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource NavigationBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,22">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Depot Manager" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Install and maintain Depot" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
        <Border x:Name="StatusBadge" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Checking installation…"/></Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="28,24">
      <Grid x:Name="InstallationWizard">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource NavigationBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
          <StackPanel>
            <TextBlock Text="Installation" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,18"/>
            <TextBlock x:Name="Step1Text" Text="1   Install location" Style="{StaticResource ManagerStepTextStyle}" Margin="0,0,0,14"/>
            <TextBlock x:Name="Step2Text" Text="2   Database" Style="{StaticResource ManagerStepTextStyle}" Margin="0,0,0,14"/>
            <TextBlock x:Name="Step3Text" Text="3   Administrator" Style="{StaticResource ManagerStepTextStyle}" Margin="0,0,0,14"/>
            <TextBlock x:Name="Step4Text" Text="4   Ready" Style="{StaticResource ManagerStepTextStyle}"/>
          </StackPanel>
        </Border>

        <Grid Grid.Column="2">
          <Border x:Name="Step1Panel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
            <StackPanel><TextBlock Text="Choose where Depot should be installed" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Depot is installed per user and does not require a separate runtime installation." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,18" TextWrapping="Wrap"/><TextBlock Text="Install location" Style="{StaticResource ManagerLabelStyle}"/><TextBox x:Name="InstallPathBox" Style="{StaticResource ManagerTextBoxStyle}"/><ProgressBar x:Name="Progress" Style="{StaticResource ManagerProgressBarStyle}" Height="6" Margin="0,18,0,0" Minimum="0" Maximum="100"/><Button Content="Install" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Margin="0,24,0,0" Click="Install_Click"/></StackPanel>
          </Border>

          <Border x:Name="Step2Panel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Configure the database" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Choose a local database or connect Depot to an existing remote database." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
              <TextBlock Text="Database" Style="{StaticResource ManagerLabelStyle}"/><ComboBox x:Name="ProviderBox" Style="{StaticResource ManagerComboBoxStyle}" SelectionChanged="Provider_Changed"><ComboBoxItem Content="Lokal (sqlite3)" IsSelected="True"/><ComboBoxItem Content="Remote (MySQL/MariaDB)"/><ComboBoxItem Content="Remote (SQL)"/></ComboBox>
              <StackPanel x:Name="LocalDatabasePanel"><TextBlock Text="Local database file" Style="{StaticResource ManagerLabelStyle}"/><TextBox x:Name="SqlitePathBox" Style="{StaticResource ManagerTextBoxStyle}"/></StackPanel>
              <StackPanel x:Name="RemoteDatabasePanel" Visibility="Collapsed">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Server / Host" Style="{StaticResource ManagerLabelStyle}"/><TextBox x:Name="HostBox" Style="{StaticResource ManagerTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Port" Style="{StaticResource ManagerLabelStyle}"/><TextBox x:Name="PortBox" Text="3306" Style="{StaticResource ManagerTextBoxStyle}"/></StackPanel></Grid>
                <TextBlock Text="Database" Style="{StaticResource ManagerLabelStyle}"/><TextBox x:Name="DatabaseBox" Style="{StaticResource ManagerTextBoxStyle}"/><TextBlock Text="Username" Style="{StaticResource ManagerLabelStyle}"/><TextBox x:Name="UserBox" Style="{StaticResource ManagerTextBoxStyle}"/><TextBlock Text="Password" Style="{StaticResource ManagerLabelStyle}"/><PasswordBox x:Name="DatabasePasswordBox" Style="{StaticResource ManagerPasswordBoxStyle}"/><CheckBox x:Name="TlsBox" Content="Require encrypted/TLS connection" IsChecked="True" Margin="0,14,0,0"/>
                <TextBlock Text="Remote databases must already contain a Depot administrator. The Administrator step is only used for a new local database." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Test connection" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="TestConnection_Click"/><Button x:Name="DatabaseNextButton" Content="Continue" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="DatabaseNext_Click"/></StackPanel>
            </StackPanel></ScrollViewer>
          </Border>

          <Border x:Name="Step3Panel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
            <StackPanel><TextBlock Text="Create administrator" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Create the initial administrator for the new local Depot database. Depot cannot be started until this step has completed successfully." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/><TextBlock Text="Administrator name" Style="{StaticResource ManagerLabelStyle}"/><TextBox x:Name="AdminNameBox" Style="{StaticResource ManagerTextBoxStyle}"/><TextBlock Text="Administrator e-mail / username" Style="{StaticResource ManagerLabelStyle}"/><TextBox x:Name="AdminEmailBox" Style="{StaticResource ManagerTextBoxStyle}"/><TextBlock Text="Password" Style="{StaticResource ManagerLabelStyle}"/><PasswordBox x:Name="AdminPasswordBox" Style="{StaticResource ManagerPasswordBoxStyle}"/><TextBlock Text="Confirm password" Style="{StaticResource ManagerLabelStyle}"/><PasswordBox x:Name="AdminConfirmBox" Style="{StaticResource ManagerPasswordBoxStyle}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="Back" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Back_Click"/><Button Content="Complete installation" Style="{StaticResource PrimaryButtonStyle}" Click="Provision_Click"/></StackPanel></StackPanel>
          </Border>

          <Border x:Name="Step4Panel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Depot is ready" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Margin="0,12,0,24" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14"/><Button Content="Start Depot" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="Start_Click"/></StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Border x:Name="MaintenancePanel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28">
        <StackPanel><TextBlock Text="Depot maintenance" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="The installed Depot version can be started, updated, repaired or removed." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,22"/><WrapPanel><Button Content="Start Depot" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,10" Click="Start_Click"/><Button Content="Check for updates" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,10" Click="Update_Click"/><Button Content="Repair" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,10" Click="Repair_Click"/><Button Content="Uninstall" Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,10" Click="Uninstall_Click"/></WrapPanel><TextBlock Text="Installation location" Style="{StaticResource ManagerLabelStyle}"/><TextBox x:Name="MaintenancePathBox" IsReadOnly="True" Style="{StaticResource ManagerTextBoxStyle}"/></StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource NavigationBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,12"><TextBlock x:Name="DetailText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></Border>
  </Grid>
</Window>
