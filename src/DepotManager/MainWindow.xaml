<Window x:Class="DepotManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Depot Manager" Width="760" Height="700" MinWidth="700" MinHeight="620" Background="#17191D" Foreground="#F1F3F5" WindowStartupLocation="CenterScreen">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Depot Manager" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Installation, updates, repair and first configuration" Foreground="#AAB0B8" Margin="0,4,0,14"/></StackPanel>
<Border Grid.Row="1" Background="#22262C" Padding="12" CornerRadius="6"><TextBlock x:Name="StatusText" Text="Checking installation…"/></Border>
<TabControl Grid.Row="2" x:Name="Wizard" Margin="0,16,0,16" Background="#17191D" Foreground="#F1F3F5">
<TabItem Header="Installation"><StackPanel Margin="16"><TextBlock Text="Install location"/><TextBox x:Name="InstallPathBox"/><WrapPanel><Button x:Name="InstallButton" Content="Install latest Depot" Click="Install_Click"/><Button Content="Check for updates" Click="Update_Click"/><Button Content="Repair" Click="Repair_Click"/><Button Content="Start Depot" Click="Start_Click"/><Button Content="Uninstall" Click="Uninstall_Click"/></WrapPanel><ProgressBar x:Name="Progress" Height="18" Margin="4,14" Minimum="0" Maximum="100"/></StackPanel></TabItem>
<TabItem Header="Database"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Database provider"/><ComboBox x:Name="ProviderBox" Margin="4" SelectionChanged="Provider_Changed"><ComboBoxItem Content="SQLite" IsSelected="True"/><ComboBoxItem Content="Microsoft SQL Server"/><ComboBoxItem Content="MySQL / MariaDB"/></ComboBox><TextBlock Text="SQLite database file"/><TextBox x:Name="SqlitePathBox"/><TextBlock Text="Server / Host"/><TextBox x:Name="HostBox"/><TextBlock Text="Port"/><TextBox x:Name="PortBox" Text="1433"/><TextBlock Text="Database"/><TextBox x:Name="DatabaseBox"/><TextBlock Text="Username"/><TextBox x:Name="UserBox"/><TextBlock Text="Password"/><PasswordBox x:Name="DatabasePasswordBox"/><CheckBox x:Name="TlsBox" Content="Require encrypted/TLS connection" IsChecked="True" Margin="4"/><Button Content="Test connection" HorizontalAlignment="Left" Click="TestConnection_Click"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Administrator"><StackPanel Margin="16"><TextBlock Text="Administrator name"/><TextBox x:Name="AdminNameBox"/><TextBlock Text="Administrator e-mail / username"/><TextBox x:Name="AdminEmailBox"/><TextBlock Text="Password"/><PasswordBox x:Name="AdminPasswordBox"/><TextBlock Text="Confirm password"/><PasswordBox x:Name="AdminConfirmBox"/><Button Content="Provision database and administrator" HorizontalAlignment="Left" Click="Provision_Click"/></StackPanel></TabItem>
<TabItem Header="Ready"><StackPanel Margin="16"><TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="16"/><Button Content="Start Depot" HorizontalAlignment="Left" Click="Start_Click"/></StackPanel></TabItem>
</TabControl>
<TextBlock Grid.Row="3" x:Name="DetailText" Foreground="#AAB0B8" TextWrapping="Wrap"/>
</Grid></Window>
