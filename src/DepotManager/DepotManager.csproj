<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="DepotManager.Version.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DepotManager</AssemblyName>
    <Product>Depot Manager</Product>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Page Include="..\Depot\Resources\Colors.xaml" Link="Resources\Colors.xaml" />
    <Page Include="..\Depot\Resources\Typography.xaml" Link="Resources\Typography.xaml" />
    <Page Include="..\Depot\Resources\Spacing.xaml" Link="Resources\Spacing.xaml" />
    <Page Include="..\Depot\Resources\Buttons.xaml" Link="Resources\Buttons.xaml" />
    <Page Include="..\Depot\Resources\ScrollBars.xaml" Link="Resources\ScrollBars.xaml" />
  </ItemGroup>
</Project>
