<Application
	x:Class="Depot.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:Depot.Converters"
	xmlns:viewModels="clr-namespace:Depot.ViewModels"
	xmlns:views="clr-namespace:Depot.Views">
	<Application.Resources>
		<ResourceDictionary>

			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Resources/Theme.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
			<converters:NonZeroToVisibilityConverter x:Key="NonZeroToVisibilityConverter" />

			<DataTemplate DataType="{x:Type viewModels:SalesOverviewViewModel}"><views:SalesView DataContext="{Binding Workspace}" /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:CustomersViewModel}"><views:SalesView DataContext="{Binding Workspace}" /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:SalesOrdersViewModel}"><views:SalesView DataContext="{Binding Workspace}" /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:SalesApprovalsViewModel}"><views:SalesView DataContext="{Binding Workspace}" /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:ShippingViewModel}"><views:SalesView DataContext="{Binding Workspace}" /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:SalesInvoicesViewModel}"><views:SalesView DataContext="{Binding Workspace}" /></DataTemplate>

		</ResourceDictionary>
	</Application.Resources>
</Application>