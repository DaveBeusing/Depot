<Window
	x:Class="Depot.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls"
	xmlns:commands="clr-namespace:Depot.Commands"
	xmlns:viewModels="clr-namespace:Depot.ViewModels"
	xmlns:administrationViewModels="clr-namespace:Depot.ViewModels.Administration"
	xmlns:sharedViewModels="clr-namespace:Depot.ViewModels.Shared"
	xmlns:views="clr-namespace:Depot.Views"
	xmlns:administrationViews="clr-namespace:Depot.Views.Administration"
	xmlns:sharedViews="clr-namespace:Depot.Views.Shared"
	xmlns:masterDataViewModels="clr-namespace:Depot.ViewModels.MasterData"
	xmlns:masterDataViews="clr-namespace:Depot.Views.MasterData"
	xmlns:purposeViewModels="clr-namespace:Depot.ViewModels.Purposes"
	xmlns:purposeViews="clr-namespace:Depot.Views.Purposes"
	xmlns:reasonCodeViewModels="clr-namespace:Depot.ViewModels.ReasonCodes"
	xmlns:reasonCodeViews="clr-namespace:Depot.Views.ReasonCodes"
	xmlns:warehouseViewModels="clr-namespace:Depot.ViewModels.Warehouses"
	xmlns:warehouseViews="clr-namespace:Depot.Views.Warehouses"
	xmlns:supplierViewModels="clr-namespace:Depot.ViewModels.Suppliers"
	xmlns:supplierViews="clr-namespace:Depot.Views.Suppliers"
	xmlns:userViewModels="clr-namespace:Depot.ViewModels.Users"
	xmlns:userViews="clr-namespace:Depot.Views.Users"
	xmlns:helpViewModels="clr-namespace:Depot.ViewModels.Help"
	xmlns:helpViews="clr-namespace:Depot.Views.Help"
	Title="Depot - Inventory Management"
	Icon="/Resources/Images/Depot.ico"
	Width="1600"
	Height="950"
	MinWidth="1200"
	MinHeight="700"
	Activated="OnWindowActivated"
	Deactivated="OnWindowDeactivated">
	<Window.CommandBindings>
		<CommandBinding Command="{x:Static commands:HelpCommands.OpenHelp}" Executed="OnOpenHelpExecuted" />
		<CommandBinding Command="{x:Static commands:HelpCommands.OpenTopic}" Executed="OnOpenHelpTopicExecuted" />
		<CommandBinding Command="{x:Static commands:HelpCommands.CopyDiagnostics}" Executed="OnCopyDiagnosticsExecuted" />
	</Window.CommandBindings>
	<Window.InputBindings>
		<KeyBinding Key="F1" Command="{x:Static commands:HelpCommands.OpenHelp}" />
	</Window.InputBindings>

	<Window.Resources>
		<ResourceDictionary>
			<DataTemplate DataType="{x:Type viewModels:DashboardViewModel}"><views:DashboardView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:InventoryViewModel}"><views:InventoryView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:ItemsViewModel}"><views:ItemsView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:MovementsViewModel}"><views:MovementsView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:StockTransfersViewModel}"><views:StockTransfersView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:InventoryCountsViewModel}"><views:InventoryCountsView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:MaterialIssuesViewModel}"><views:MaterialIssuesView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:MaterialReturnsViewModel}"><views:MaterialReturnsView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:PurchaseOrdersPageViewModel}"><views:PurchaseOrdersView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:GoodsReceiptsPageViewModel}"><views:GoodsReceiptsView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:SupplierReturnsViewModel}"><views:SupplierReturnsView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:PurchaseOrderApprovalsViewModel}"><views:PurchaseOrderApprovalsView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:ReportsViewModel}"><views:ReportsView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:ShellModuleViewModel}"><views:ShellModuleView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:ImportViewModel}"><views:ImportView /></DataTemplate>
			<DataTemplate DataType="{x:Type administrationViewModels:AdministrationViewModel}"><administrationViews:AdministrationView /></DataTemplate>
			<DataTemplate DataType="{x:Type administrationViewModels:DatabaseSettingsViewModel}"><administrationViews:DatabaseSettingsView /></DataTemplate>
			<DataTemplate DataType="{x:Type administrationViewModels:AboutViewModel}"><administrationViews:AboutView /></DataTemplate>
			<DataTemplate DataType="{x:Type administrationViewModels:AuditLogViewModel}"><administrationViews:AuditLogView /></DataTemplate>
			<DataTemplate DataType="{x:Type sharedViewModels:PlaceholderViewModel}"><sharedViews:PlaceholderView /></DataTemplate>
			<DataTemplate DataType="{x:Type masterDataViewModels:MasterDataViewModel}"><masterDataViews:MasterDataView /></DataTemplate>
			<DataTemplate DataType="{x:Type purposeViewModels:PurposeViewModel}"><purposeViews:PurposesView /></DataTemplate>
			<DataTemplate DataType="{x:Type masterDataViewModels:ItemReferenceDataViewModel}"><masterDataViews:ItemReferenceDataView /></DataTemplate>
			<DataTemplate DataType="{x:Type reasonCodeViewModels:ReasonCodeViewModel}"><reasonCodeViews:ReasonCodesView /></DataTemplate>
			<DataTemplate DataType="{x:Type warehouseViewModels:WarehouseStructureViewModel}"><warehouseViews:WarehouseStructureView /></DataTemplate>
			<DataTemplate DataType="{x:Type supplierViewModels:SupplierViewModel}"><supplierViews:SuppliersView /></DataTemplate>
			<DataTemplate DataType="{x:Type userViewModels:UserViewModel}"><userViews:UsersView /></DataTemplate>
			<DataTemplate DataType="{x:Type userViewModels:RoleViewModel}"><userViews:RolesView /></DataTemplate>
			<DataTemplate DataType="{x:Type helpViewModels:HelpViewModel}"><helpViews:HelpView /></DataTemplate>
			<DataTemplate DataType="{x:Type viewModels:NotificationCenterViewModel}"><views:NotificationCenterView /></DataTemplate>

			<Style x:Key="ActivityBarListStyle" TargetType="ListBox">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			</Style>
			<Style x:Key="ActivityBarItemStyle" TargetType="ListBoxItem">
				<Setter Property="Height" Value="48" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="2,0,0,0" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ListBoxItem">
							<Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource NavigationHoverBrush}" /></Trigger>
								<Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource NavigationAccentBrush}" /><Setter TargetName="Root" Property="Background" Value="{DynamicResource NavigationSelectedBackgroundBrush}" /></Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<DataTemplate x:Key="ActivityBarItemTemplate">
				<Grid Width="46" Height="46" ToolTip="{Binding Name}">
					<Path Width="21" Height="21" Data="{Binding IconData}" Stroke="{DynamicResource NavigationForegroundBrush}" StrokeThickness="1.5" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="ModuleSidebarTemplate">
				<StackPanel>
					<TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="14,16,14,3" />
					<TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="14,0,14,14" />
					<ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Style="{DynamicResource SecondaryNavigationListBoxStyle}" ItemContainerStyle="{DynamicResource SecondaryNavigationItemStyle}" />
				</StackPanel>
			</DataTemplate>
			<DataTemplate x:Key="DirectSidebarTemplate">
				<StackPanel Margin="14,16">
					<TextBlock Text="{Binding DataContext.SelectedNavigationItem.Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
					<TextBlock Text="Activity workspace" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,5,0,0" />
				</StackPanel>
			</DataTemplate>
			<controls:ActivitySidebarTemplateSelector
				x:Key="ActivitySidebarTemplateSelector"
				ModuleTemplate="{StaticResource ModuleSidebarTemplate}"
				DefaultTemplate="{StaticResource DirectSidebarTemplate}" />

			<Style x:Key="WorkspaceTabControlStyle" TargetType="controls:WorkspaceTabControl">
				<Setter Property="Background" Value="#1B1B1F" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="controls:WorkspaceTabControl">
							<Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
								<TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="WorkspaceTabItemStyle" TargetType="TabItem">
				<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
				<Setter Property="Background" Value="#1B1B1F" />
				<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
				<Setter Property="BorderThickness" Value="0,0,1,0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="TabItem">
							<Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" MinWidth="120" Height="36">
								<ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource NavigationHoverBrush}" /></Trigger>
								<Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<DataTemplate x:Key="WorkspaceTabHeaderTemplate">
				<Grid Margin="12,0,6,0">
					<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<Path Width="14" Height="14" Data="{Binding IconData}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
					<TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
					<Button Grid.Column="2" Width="24" Height="24" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}" Command="{x:Static controls:WorkspaceTabControl.CloseTabCommand}" CommandParameter="{Binding}" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:WorkspaceTabControl}}}" ToolTip="Close tab">
						<TextBlock Text="×" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
					</Button>
				</Grid>
			</DataTemplate>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="{DynamicResource BackgroundBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="52" />
			<ColumnDefinition Width="250" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="24" />
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Grid.Column="0" Background="#17171A" BorderBrush="{DynamicResource NavigationBorderBrush}" BorderThickness="0,0,1,0">
			<DockPanel>
				<Border DockPanel.Dock="Top" Height="52" BorderBrush="{DynamicResource NavigationBorderBrush}" BorderThickness="0,0,0,1">
					<Image Source="/Resources/Images/Depot_32.png" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
				</Border>
				<StackPanel DockPanel.Dock="Bottom">
					<Button Height="44" Background="Transparent" BorderThickness="0" Command="{Binding NotificationCommand}" ToolTip="Notifications"><TextBlock Text="●" Foreground="{DynamicResource NavigationForegroundBrush}" FontSize="14" /></Button>
					<Button Height="44" Background="Transparent" BorderThickness="0" Command="{x:Static commands:HelpCommands.OpenHelp}" ToolTip="Help"><TextBlock Text="?" Foreground="{DynamicResource NavigationForegroundBrush}" FontSize="18" FontWeight="SemiBold" /></Button>
				</StackPanel>
				<ListBox Style="{StaticResource ActivityBarListStyle}" ItemContainerStyle="{StaticResource ActivityBarItemStyle}" ItemTemplate="{StaticResource ActivityBarItemTemplate}" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}" />
			</DockPanel>
		</Border>

		<Border Grid.Row="0" Grid.Column="1" Background="#1D1D21" BorderBrush="{DynamicResource NavigationBorderBrush}" BorderThickness="0,0,1,0">
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<Border Padding="14,15" BorderBrush="{DynamicResource NavigationBorderBrush}" BorderThickness="0,0,0,1">
					<StackPanel>
						<TextBlock Text="DEPOT" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" />
						<TextBlock Text="Inventory Operations" Foreground="{DynamicResource NavigationMutedTextBrush}" FontSize="10" Margin="0,3,0,0" />
					</StackPanel>
				</Border>
				<ContentControl
					Grid.Row="1"
					Content="{Binding SelectedNavigationItem.Content}"
					ContentTemplateSelector="{StaticResource ActivitySidebarTemplateSelector}" />
				<Border Grid.Row="2" Padding="12" BorderBrush="{DynamicResource NavigationBorderBrush}" BorderThickness="0,1,0,0">
					<StackPanel>
						<TextBlock Text="{Binding CurrentUserDisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
						<TextBlock Text="{Binding CurrentUserRole}" Foreground="{DynamicResource NavigationMutedTextBrush}" FontSize="10" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
						<Button Content="Sign out" Command="{Binding LogoutCommand}" HorizontalAlignment="Left" Padding="8,3" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource SecondaryTextBrush}" />
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<Grid Grid.Row="0" Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
			<Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
			<controls:WorkspaceTabControl
				Grid.Row="0"
				ActiveItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
				Style="{StaticResource WorkspaceTabControlStyle}"
				ItemContainerStyle="{StaticResource WorkspaceTabItemStyle}"
				ItemTemplate="{StaticResource WorkspaceTabHeaderTemplate}" />
			<ContentControl
				Grid.Row="1"
				Content="{Binding CurrentViewModel}"
				HorizontalContentAlignment="Stretch"
				VerticalContentAlignment="Stretch"
				Background="{DynamicResource BackgroundBrush}" />
		</Grid>

		<Border Grid.Row="1" Grid.ColumnSpan="3" Background="#202024" BorderBrush="{DynamicResource NavigationBorderBrush}" BorderThickness="0,1,0,0">
			<Grid Margin="8,0">
				<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessForegroundBrush}" Margin="0,0,6,0" />
					<TextBlock Text="{Binding ConnectionStatus.CompactStatus}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
				</StackPanel>
				<TextBlock Grid.Column="1" Text="{Binding SelectedNavigationItem.Name}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0" />
				<TextBlock Grid.Column="3" Text="{Binding CurrentUserDisplayName}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
			</Grid>
		</Border>
	</Grid>
</Window>
