<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Depot.Controls"
                    xmlns:viewModels="clr-namespace:Depot.ViewModels">
    <Style TargetType="{x:Type controls:StatusBadge}">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusBadge}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.L}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Variant" Value="Primary"><Setter Property="Background" Value="{DynamicResource NavigationSelectedBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Trigger>
                        <Trigger Property="Variant" Value="Success"><Setter Property="Background" Value="{DynamicResource SuccessBrush}"/><Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}"/></Trigger>
                        <Trigger Property="Variant" Value="Warning"><Setter Property="Background" Value="{DynamicResource WarningBrush}"/><Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/></Trigger>
                        <Trigger Property="Variant" Value="Error"><Setter Property="Background" Value="{DynamicResource ErrorBrush}"/><Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}"/></Trigger>
                        <Trigger Property="Variant" Value="Muted"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ConnectionStatusIndicator}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="DetailForeground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ConnectionStatusIndicator}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource ErrorForegroundBrush}"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource FontSize.Caption}" FontWeight="SemiBold" Text="{TemplateBinding Status}"/>
                            <TextBlock x:Name="DetailText" Margin="0,2,0,0" Foreground="{TemplateBinding DetailForeground}" FontSize="10" Text="{TemplateBinding Detail}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Connected"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource SuccessForegroundBrush}"/></Trigger>
                        <Trigger Property="State" Value="Pending"><Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource WarningForegroundBrush}"/></Trigger>
                        <Trigger Property="Compact" Value="True"><Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="Detail" Value=""><Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:OperationStatus}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OperationStatus}">
                    <Border x:Name="Container" Padding="10,7" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius.M}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ProgressBar x:Name="Progress" Height="2" VerticalAlignment="Center" IsIndeterminate="True"/>
                            <TextBlock x:Name="Message" Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource FontSize.Caption}" Text="{TemplateBinding StatusText}"/>
                            <TextBlock x:Name="Action" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource FontSize.Caption}" FontWeight="SemiBold" Text="{TemplateBinding ActionText}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsBusy" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Container" Property="Background" Value="{DynamicResource ErrorBrush}"/>
                            <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}"/>
                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}"/>
                            <Setter TargetName="Message" Property="Text" Value="{Binding ErrorText, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Progress" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="{x:Static viewModels:OperationSeverity.Warning}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Container" Property="Background" Value="{DynamicResource WarningBrush}"/>
                            <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource WarningForegroundBrush}"/>
                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="{x:Static viewModels:OperationSeverity.Success}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Container" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource SuccessForegroundBrush}"/>
                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}"/>
                            <Setter TargetName="Progress" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ActionText" Value=""><Setter TargetName="Action" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="ActionText" Value="{x:Null}"><Setter TargetName="Action" Property="Visibility" Value="Collapsed"/></Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasError" Value="True"/>
                                <Condition Property="Severity" Value="{x:Static viewModels:OperationSeverity.Warning}"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Action" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
