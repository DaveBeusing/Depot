<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls"
	xmlns:sys="clr-namespace:System;assembly=mscorlib">

	<!-- Canonical motion timing tokens. Runtime animation declarations should
	     prefer MotionDurationExtension when reduced-motion behavior is required. -->
	<Duration x:Key="Motion.Duration.Fast">0:0:0.10</Duration>
	<Duration x:Key="Motion.Duration.Standard">0:0:0.16</Duration>
	<Duration x:Key="Motion.Duration.Emphasis">0:0:0.22</Duration>

	<CubicEase x:Key="Motion.Ease.Out" EasingMode="EaseOut" />
	<QuadraticEase x:Key="Motion.Ease.InOut" EasingMode="EaseInOut" />

	<!-- Small render-transform distances used by reusable entrance transitions. -->
	<sys:Double x:Key="Motion.Offset.Workspace">8</sys:Double>
	<sys:Double x:Key="Motion.Offset.DetailPane">10</sys:Double>
	<sys:Double x:Key="Motion.Scale.Badge">0.92</sys:Double>

	<Style TargetType="{x:Type controls:MotionContentControl}">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:MotionContentControl}">
					<ContentPresenter
						HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
						VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
						Content="{TemplateBinding Content}"
						ContentStringFormat="{TemplateBinding ContentStringFormat}"
						ContentTemplate="{TemplateBinding ContentTemplate}"
						ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
