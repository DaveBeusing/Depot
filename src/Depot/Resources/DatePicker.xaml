<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls"
	xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

	<DropShadowEffect
		x:Key="DatePicker.Popup.Shadow"
		BlurRadius="18"
		Direction="270"
		Opacity="0.16"
		ShadowDepth="4" />

	<Style x:Key="AppDatePickerTextBoxStyle" TargetType="DatePickerTextBox">
		<Setter Property="Padding" Value="{DynamicResource Control.Padding}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DatePickerTextBox">
					<Grid>
						<ScrollViewer
							x:Name="PART_ContentHost"
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						<ContentControl
							x:Name="PART_Watermark"
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							Foreground="{DynamicResource SecondaryTextBrush}"
							Focusable="False"
							IsHitTestVisible="False"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="Text" Value="">
							<Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="Text" Value="{x:Null}">
							<Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsReadOnly" Value="True">
							<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="AppDatePickerButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="{DynamicResource DatePicker.Button.Width}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Surface" Background="{TemplateBinding Background}">
						<Path
							Width="{DynamicResource DatePicker.Icon.Size}"
							Height="{DynamicResource DatePicker.Icon.Size}"
							Data="M3,4.5 H13 V13 H3 Z M5.5,2.5 V6 M10.5,2.5 V6 M3,7 H13"
							Stroke="{TemplateBinding Foreground}"
							StrokeEndLineCap="Round"
							StrokeLineJoin="Round"
							StrokeThickness="1.4"
							Stretch="Uniform" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Surface" Property="Background" Value="{DynamicResource NavigationSelectedBackgroundBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Surface" Property="Opacity" Value="0.45" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="AppCalendarNavigationButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="{DynamicResource DatePicker.Calendar.NavigationButton.Size}" />
		<Setter Property="Height" Value="{DynamicResource DatePicker.Calendar.NavigationButton.Size}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="{DynamicResource Input.BorderThickness}" />
		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Surface"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{DynamicResource Input.CornerRadius}">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
						<Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="AppCalendarHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource AppCalendarNavigationButtonStyle}">
		<Setter Property="Width" Value="Auto" />
		<Setter Property="Padding" Value="{DynamicResource Tab.Item.Padding}" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}">
		<TextBlock
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Text="{Binding}"
			Style="{DynamicResource CaptionStyle}" />
	</DataTemplate>

	<Style x:Key="AppCalendarDayButtonStyle" TargetType="primitives:CalendarDayButton">
		<Setter Property="Width" Value="{DynamicResource DatePicker.Calendar.Day.Size}" />
		<Setter Property="Height" Value="{DynamicResource DatePicker.Calendar.Day.Size}" />
		<Setter Property="Margin" Value="{DynamicResource DatePicker.Calendar.Day.Margin}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="{DynamicResource Input.BorderThickness}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="primitives:CalendarDayButton">
					<Border
						x:Name="Surface"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{DynamicResource Input.CornerRadius}">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
						<Trigger Property="IsToday" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
						<Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter TargetName="Surface" Property="Opacity" Value="0.55" /></Trigger>
						<Trigger Property="IsBlackedOut" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceAltBrush}" /><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
						<Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimaryBrush}" /><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" /></Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource DatePicker.Calendar.FocusBorderThickness}" /></Trigger>
						<Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="AppCalendarButtonStyle" TargetType="primitives:CalendarButton">
		<Setter Property="Width" Value="{DynamicResource DatePicker.Calendar.Button.Width}" />
		<Setter Property="Height" Value="{DynamicResource DatePicker.Calendar.Button.Height}" />
		<Setter Property="Margin" Value="{DynamicResource DatePicker.Calendar.Button.Margin}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="{DynamicResource Input.BorderThickness}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="primitives:CalendarButton">
					<Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Input.CornerRadius}">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
						<Trigger Property="HasSelectedDays" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource NavigationSelectedBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" /></Trigger>
						<Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter TargetName="Surface" Property="Opacity" Value="0.55" /></Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource DatePicker.Calendar.FocusBorderThickness}" /></Trigger>
						<Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="AppCalendarItemStyle" TargetType="primitives:CalendarItem">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="primitives:CalendarItem">
					<Grid x:Name="PART_Root">
						<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
						<Grid Margin="{DynamicResource DatePicker.Calendar.Header.Margin}">
							<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
							<Button x:Name="PART_PreviousButton" Style="{StaticResource AppCalendarNavigationButtonStyle}">
								<Path Width="{DynamicResource DatePicker.Calendar.NavigationIcon.Size}" Height="{DynamicResource DatePicker.Calendar.NavigationIcon.Size}" Data="M8,2 L3,7 L8,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
							</Button>
							<Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource AppCalendarHeaderButtonStyle}" />
							<Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource AppCalendarNavigationButtonStyle}">
								<Path Width="{DynamicResource DatePicker.Calendar.NavigationIcon.Size}" Height="{DynamicResource DatePicker.Calendar.NavigationIcon.Size}" Data="M4,2 L9,7 L4,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
							</Button>
						</Grid>
						<Grid x:Name="PART_MonthView" Grid.Row="1">
							<Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
							<Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
						</Grid>
						<Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Collapsed">
							<Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
							<Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
						</Grid>
						<Border x:Name="PART_DisabledVisual" Grid.RowSpan="2" Background="{DynamicResource SurfaceAltBrush}" Opacity="0" IsHitTestVisible="False" />
					</Grid>
					<ControlTemplate.Triggers>
						<DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Month"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Visible" /><Setter TargetName="PART_YearView" Property="Visibility" Value="Collapsed" /></DataTrigger>
						<DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" /></DataTrigger>
						<DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" /></DataTrigger>
						<Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_DisabledVisual" Property="Opacity" Value="0.55" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="AppCalendarStyle" TargetType="Calendar">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="{DynamicResource Input.BorderThickness}" />
		<Setter Property="CalendarButtonStyle" Value="{StaticResource AppCalendarButtonStyle}" />
		<Setter Property="CalendarDayButtonStyle" Value="{StaticResource AppCalendarDayButtonStyle}" />
		<Setter Property="CalendarItemStyle" Value="{StaticResource AppCalendarItemStyle}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Calendar">
					<Grid x:Name="PART_Root" HorizontalAlignment="Center">
						<Border
							Padding="{DynamicResource DatePicker.Popup.Padding}"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{DynamicResource DatePicker.Popup.CornerRadius}"
							Effect="{StaticResource DatePicker.Popup.Shadow}">
							<primitives:CalendarItem
								x:Name="PART_CalendarItem"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="0"
								Style="{TemplateBinding CalendarItemStyle}" />
						</Border>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="AppDatePickerStyle" TargetType="DatePicker">
		<Setter Property="MinHeight" Value="{DynamicResource Input.MinHeight}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="{DynamicResource Input.BorderThickness}" />
		<Setter Property="CalendarStyle" Value="{StaticResource AppCalendarStyle}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DatePicker">
					<Grid x:Name="PART_Root">
						<Border
							x:Name="ControlBorder"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{DynamicResource Input.CornerRadius}"
							SnapsToDevicePixels="True">
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="{DynamicResource DatePicker.Button.ColumnWidth}" /></Grid.ColumnDefinitions>
								<DatePickerTextBox
									x:Name="PART_TextBox"
									Grid.Column="0"
									Background="Transparent"
									Foreground="{TemplateBinding Foreground}"
									HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
									IsReadOnly="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:DatePickerAssist.IsReadOnly)}"
									Style="{StaticResource AppDatePickerTextBoxStyle}" />
								<Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource AppDatePickerButtonStyle}" />
							</Grid>
						</Border>
						<Popup
							x:Name="PART_Popup"
							Margin="{DynamicResource DatePicker.Popup.Margin}"
							AllowsTransparency="True"
							Focusable="False"
							Placement="Bottom"
							PlacementTarget="{Binding ElementName=PART_Root}"
							PopupAnimation="Fade"
							StaysOpen="False" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ControlBorder" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" /></Trigger>
						<Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ControlBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter TargetName="ControlBorder" Property="BorderThickness" Value="{DynamicResource Input.FocusBorderThickness}" /></Trigger>
						<Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ControlBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /><Setter TargetName="ControlBorder" Property="BorderThickness" Value="{DynamicResource Input.FocusBorderThickness}" /></Trigger>
						<Trigger Property="controls:DatePickerAssist.IsReadOnly" Value="True"><Setter TargetName="ControlBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" /><Setter TargetName="PART_Button" Property="IsEnabled" Value="False" /><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /></Trigger>
						<Trigger Property="IsEnabled" Value="False"><Setter TargetName="ControlBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" /><Setter TargetName="ControlBorder" Property="Opacity" Value="0.5" /></Trigger>
						<Trigger Property="Validation.HasError" Value="True"><Setter TargetName="ControlBorder" Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" /><Setter TargetName="ControlBorder" Property="BorderThickness" Value="{DynamicResource Input.FocusBorderThickness}" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="DatePicker" BasedOn="{StaticResource AppDatePickerStyle}" />
	<Style TargetType="Calendar" BasedOn="{StaticResource AppCalendarStyle}" />

</ResourceDictionary>
