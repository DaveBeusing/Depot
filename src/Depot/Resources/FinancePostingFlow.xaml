<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls"
	xmlns:models="clr-namespace:Depot.Models">

	<Style TargetType="{x:Type controls:FinancePostingFlowCanvas}">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="16" />
		<Setter Property="MinHeight" Value="430" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
		<Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<Canvas Width="1060" Height="760" />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemContainerStyle">
			<Setter.Value>
				<Style TargetType="{x:Type ListBoxItem}">
					<Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
					<Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
					<Setter Property="Width" Value="{Binding CanvasWidth}" />
					<Setter Property="MinHeight" Value="{Binding CanvasHeight}" />
					<Setter Property="Padding" Value="0" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="VerticalContentAlignment" Value="Stretch" />
					<Setter Property="Background" Value="Transparent" />
					<Setter Property="BorderThickness" Value="0" />
					<Setter Property="FocusVisualStyle" Value="{DynamicResource AppKeyboardFocusVisualStyle}" />
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="{x:Type ListBoxItem}">
								<Border x:Name="SelectionBorder"
									Padding="0"
									Background="Transparent"
									BorderBrush="Transparent"
									BorderThickness="2"
									CornerRadius="{DynamicResource Radius.M}">
									<ContentPresenter />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
										<Setter TargetName="SelectionBorder" Property="Opacity" Value="0.94" />
									</Trigger>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</Setter.Value>
		</Setter>
		<Setter Property="ItemTemplate">
			<Setter.Value>
				<DataTemplate DataType="{x:Type models:FinancePostingFlowNode}">
					<Border x:Name="Node"
						controls:MotionBehavior.TransitionKind="State"
						MinHeight="58"
						Padding="12,9"
						Background="{DynamicResource SurfaceAltBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="{DynamicResource Radius.M}"
						AutomationProperties.Name="{Binding Title}">
						<StackPanel>
							<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
							<TextBlock Margin="0,3,0,0" Text="{Binding Subtitle}" Style="{DynamicResource CaptionStyle}" TextTrimming="CharacterEllipsis" />
						</StackPanel>
					</Border>
					<DataTemplate.Triggers>
						<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FinancePostingFlowNodeKind.BusinessEvent}">
							<Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FinancePostingFlowNodeKind.AmountKey}">
							<Setter TargetName="Node" Property="Background" Value="{DynamicResource NavigationSelectedBackgroundBrush}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FinancePostingFlowNodeKind.DirectionRule}">
							<Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource WarningForegroundBrush}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Kind}" Value="{x:Static models:FinancePostingFlowNodeKind.Journal}">
							<Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource SuccessForegroundBrush}" />
						</DataTrigger>
					</DataTemplate.Triggers>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
