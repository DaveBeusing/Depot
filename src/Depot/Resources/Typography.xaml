<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Body">12</sys:Double>
    <sys:Double x:Key="FontSize.Section">14</sys:Double>
    <sys:Double x:Key="FontSize.PageTitle">18</sys:Double>
    <sys:Double x:Key="FontSize.Metric">22</sys:Double>
    <sys:Double x:Key="FontSize.MetricLarge">26</sys:Double>

    <!-- Prevent unstyled TextBlock instances from falling back to WPF's black default foreground. -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="BodyStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="MetricStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Metric}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="MetricLargeStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.MetricLarge}" />
    </Style>
    <Style x:Key="SecondaryNavigationTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style x:Key="NavigationTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource NavigationForegroundBrush}" />
    </Style>
    <Style x:Key="NavigationShortcutTextStyle" TargetType="TextBlock" BasedOn="{StaticResource NavigationTextStyle}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource NavigationMutedTextBrush}" />
    </Style>
    <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
        <Setter Property="Margin" Value="{DynamicResource Label.Margin}" />
    </Style>
    <Style x:Key="HintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}" />
</ResourceDictionary>
