<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Base -->
	<SolidColorBrush x:Key="BackgroundBrush" Color="#18181B" />
	<SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E22" />
	<SolidColorBrush x:Key="SurfaceAltBrush" Color="#222226" />

	<!-- Primary -->
	<SolidColorBrush x:Key="PrimaryBrush" Color="#315ACB" />
	<SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF" />
	<SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3D66D6" />
	<SolidColorBrush x:Key="PrimaryPressedBrush" Color="#2448A8" />
	<SolidColorBrush x:Key="HoverBrush" Color="#27272C" />
	<SolidColorBrush x:Key="CardBorderBrush" Color="#303036" />

	<!-- Text -->
	<SolidColorBrush x:Key="PrimaryTextBrush" Color="#E4E4E7" />
	<SolidColorBrush x:Key="SecondaryTextBrush" Color="#A1A1AA" />

	<!-- Borders -->
	<SolidColorBrush x:Key="BorderBrush" Color="#303036" />

	<!-- Navigation -->
	<SolidColorBrush x:Key="NavigationBackgroundBrush" Color="#1B1B1F" />
	<SolidColorBrush x:Key="NavigationForegroundBrush" Color="#D4D4D8" />
	<SolidColorBrush x:Key="NavigationHoverBrush" Color="#29292E" />
	<SolidColorBrush x:Key="NavigationSelectedBrush" Color="#34343A" />

	<!-- Navigation Selection -->
	<SolidColorBrush x:Key="NavigationSelectedBackgroundBrush" Color="#2C2C32" />
	<SolidColorBrush x:Key="CopyableTextSelectionBrush" Color="#59315ACB" />
	<SolidColorBrush x:Key="NavigationAccentBrush" Color="#6C8FF5" />

	<!-- Sidebar -->
	<SolidColorBrush x:Key="NavigationBorderBrush" Color="#303036" />
	<SolidColorBrush x:Key="NavigationUserPanelBrush" Color="#202024" />
	<SolidColorBrush x:Key="NavigationUserPanelBorderBrush" Color="#303036" />
	<SolidColorBrush x:Key="NavigationMutedTextBrush" Color="#8D8D96" />

	<!-- Status -->
	<SolidColorBrush x:Key="SuccessBrush" Color="#173B2A" />
	<SolidColorBrush x:Key="SuccessForegroundBrush" Color="#74D99F" />
	<SolidColorBrush x:Key="WarningBrush" Color="#443616" />
	<SolidColorBrush x:Key="WarningForegroundBrush" Color="#F0C36A" />
	<SolidColorBrush x:Key="ErrorBrush" Color="#472024" />
	<SolidColorBrush x:Key="ErrorForegroundBrush" Color="#F28B91" />

</ResourceDictionary>
