<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Depot.Controls"
    xmlns:commands="clr-namespace:Depot.Commands"
    xmlns:models="clr-namespace:Depot.Models">

    <Style x:Key="MasterDataListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style x:Key="MasterDataListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource NavigationSelectedBackgroundBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:FilterBar}">
        <Setter Property="Margin" Value="{DynamicResource Workspace.Toolbar.Margin}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FilterBar}">
                    <Border Padding="{DynamicResource Workspace.Toolbar.Padding}" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius.M}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:PaginationControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PaginationControl}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Command="{TemplateBinding PreviousCommand}" Content="Previous" Style="{DynamicResource SecondaryButtonStyle}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding PageText}" Style="{DynamicResource CaptionStyle}" />
                        <Button Grid.Column="2" Command="{TemplateBinding NextCommand}" Content="Next" Style="{DynamicResource SecondaryButtonStyle}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:WorkflowHeader}">
        <Setter Property="Margin" Value="{DynamicResource Workspace.Section.Header.Margin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:WorkflowHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis" Style="{DynamicResource SectionTitleStyle}" />
                            <TextBlock Margin="0,3,0,0" Text="{TemplateBinding Subtitle}" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionStyle}" />
                        </StackPanel>
                        <controls:DocumentStatusBadge Grid.Column="1" Margin="16,0,0,0" Status="{TemplateBinding Status}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:WorkflowActionBar}">
        <Setter Property="Panel.ZIndex" Value="10" />
        <Setter Property="Margin" Value="{DynamicResource Control.Margin.Large}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:WorkflowActionBar}">
                    <Border Padding="{DynamicResource Workspace.Toolbar.Padding}" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius.M}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding SecondaryActions}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding PrimaryAction}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:OperationPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OperationPanel}">
                    <StackPanel>
                        <controls:OperationStatus ErrorText="{TemplateBinding ErrorText}" HasError="{TemplateBinding HasError}" IsBusy="{TemplateBinding IsBusy}" StatusText="{TemplateBinding StatusText}" />
                        <StackPanel x:Name="DiagnosticActions" Margin="{DynamicResource Control.Margin}" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Command="{x:Static commands:HelpCommands.CopyDiagnostics}" CommandParameter="{TemplateBinding ErrorText}" Content="Copy diagnostics" Style="{DynamicResource SecondaryButtonStyle}" />
                            <Button Margin="{DynamicResource Button.Margin}" Command="{x:Static commands:HelpCommands.OpenTopic}" CommandParameter="{TemplateBinding HelpTopicId}" Content="Open Help" Style="{DynamicResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasError" Value="True"><Setter TargetName="DiagnosticActions" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="HelpTopicId" Value=""><Setter TargetName="DiagnosticActions" Property="Visibility" Value="Collapsed" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:MasterDetailGrid}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:MasterDetailGrid}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource MasterPane.DefaultWidth}" MinWidth="{DynamicResource MasterPane.MinWidth}" MaxWidth="{DynamicResource MasterPane.MaxWidth}" /><ColumnDefinition Width="{DynamicResource MasterDetail.ColumnGap}" /><ColumnDefinition Width="*" MinWidth="360" /></Grid.ColumnDefinitions>
                        <ContentPresenter Content="{TemplateBinding Master}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <controls:MotionContentControl Grid.Column="2" TransitionKind="DetailPane" Content="{TemplateBinding Detail}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellContentHostStyle" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type controls:ShellModuleContentControl}" BasedOn="{StaticResource ShellContentHostStyle}" />

    <Style TargetType="{x:Type controls:WorkflowListState}">
        <Setter Property="Panel.ZIndex" Value="2" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:WorkflowListState}">
                    <Border Background="{TemplateBinding Background}" controls:MotionBehavior.TransitionKind="State"><controls:EmptyState x:Name="State" Title="No documents yet" Description="Create the first document to begin this workflow." /></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemCount" Value="0"><Setter Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsSearchActive" Value="True"><Setter TargetName="State" Property="Title" Value="No results" /><Setter TargetName="State" Property="Description" Value="No documents match the current search and filters." /></Trigger>
                        <Trigger Property="IsBusy" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter TargetName="State" Property="Title" Value="Loading" /><Setter TargetName="State" Property="Description" Value="Documents are being loaded." /></Trigger>
                        <Trigger Property="HasError" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter TargetName="State" Property="Title" Value="Documents could not be loaded" /><Setter TargetName="State" Property="Description" Value="{Binding ErrorText, RelativeSource={RelativeSource TemplatedParent}}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type controls:WorkflowTimeline}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:WorkflowTimeline}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="ProcessSummary"
                                Margin="0,0,0,10"
                                Padding="10,8"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                Visibility="Collapsed">
                            <TextBlock Text="{TemplateBinding CurrentStepText}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>
                        <ScrollViewer x:Name="TimelineScroll"
                                      Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                        <ToggleButton x:Name="CompactToggle"
                                      Grid.Row="2"
                                      Margin="34,4,0,0"
                                      Padding="10,5"
                                      HorizontalAlignment="Left"
                                      Background="{DynamicResource SurfaceAltBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="1"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      Content="Show all steps"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      AutomationProperties.Name="Show all workflow steps"
                                      Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasCurrentStep" Value="True">
                            <Setter TargetName="ProcessSummary" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasCompactOverflow" Value="True">
                            <Setter TargetName="CompactToggle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasCompactOverflow" Value="True" />
                                <Condition Property="IsExpanded" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TimelineScroll" Property="MaxHeight" Value="360" />
                        </MultiTrigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="CompactToggle" Property="Content" Value="Collapse timeline" />
                            <Setter TargetName="CompactToggle" Property="AutomationProperties.Name" Value="Collapse workflow timeline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type models:WorkflowTimelineItem}">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Border x:Name="ConnectorLine"
                                    Width="2"
                                    Margin="0,-2,0,-8"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource SuccessForegroundBrush}"
                                    Opacity="0.65" />
                            <Border x:Name="TimelineNode"
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource SuccessForegroundBrush}"
                                    BorderThickness="2"
                                    CornerRadius="11">
                                <TextBlock x:Name="TimelineGlyph"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessForegroundBrush}"
                                           Text="{Binding VisualGlyph}" />
                            </Border>
                        </Grid>
                        <Border x:Name="TimelineItemBorder"
                                Grid.Column="2"
                                controls:MotionBehavior.TransitionKind="Timeline"
                                Margin="0,0,0,6"
                                Padding="8,6"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}"
                                AutomationProperties.Name="{Binding AccessibleName}">
                            <Border.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DisplayNumber, StringFormat=Document: {0}}" />
                                    <TextBlock Text="{Binding Status, StringFormat=Status: {0}}" />
                                    <TextBlock Text="{Binding VisualStateLabel, StringFormat=Process state: {0}}" />
                                    <TextBlock Text="{Binding OccurredAtText, StringFormat=Date: {0}}" />
                                    <TextBlock Text="{Binding MetadataText}" Visibility="{Binding HasMetadata, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TimelineTitle"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <controls:DocumentStatusBadge Grid.Column="1"
                                                                      Margin="12,0,0,0"
                                                                      Status="{Binding Status}" />
                                    </Grid>
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock x:Name="StateLabel"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessForegroundBrush}"
                                                   Text="{Binding VisualStateLabel, StringFormat={}{0}:}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   Style="{DynamicResource CaptionStyle}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding DisplayNumber}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Kind}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding OccurredAtText}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{DynamicResource CaptionStyle}"
                                               Text="{Binding MetadataText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasMetadata, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        MinWidth="64"
                                        Command="{Binding NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:WorkflowTimeline}}}"
                                        CommandParameter="{Binding}"
                                        Content="Open"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        AutomationProperties.Name="{Binding AccessibleName}"
                                        AutomationProperties.HelpText="Open workflow document"
                                        Visibility="{Binding CanNavigate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding VisualState}" Value="{x:Static models:WorkflowTimelineVisualState.Current}">
                            <Setter TargetName="ConnectorLine" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="TimelineNode" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="TimelineGlyph" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="TimelineItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="TimelineItemBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="TimelineTitle" Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VisualState}" Value="{x:Static models:WorkflowTimelineVisualState.Pending}">
                            <Setter TargetName="ConnectorLine" Property="Background" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter TargetName="ConnectorLine" Property="Opacity" Value="0.35" />
                            <Setter TargetName="TimelineNode" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter TargetName="TimelineGlyph" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VisualState}" Value="{x:Static models:WorkflowTimelineVisualState.Rejected}">
                            <Setter TargetName="ConnectorLine" Property="Background" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="TimelineNode" Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="TimelineGlyph" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="TimelineItemBorder" Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VisualState}" Value="{x:Static models:WorkflowTimelineVisualState.Cancelled}">
                            <Setter TargetName="ConnectorLine" Property="Background" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter TargetName="TimelineNode" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter TargetName="TimelineGlyph" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter TargetName="TimelineItemBorder" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VisualState}" Value="{x:Static models:WorkflowTimelineVisualState.Correction}">
                            <Setter TargetName="ConnectorLine" Property="Background" Value="{DynamicResource WarningForegroundBrush}" />
                            <Setter TargetName="TimelineNode" Property="BorderBrush" Value="{DynamicResource WarningForegroundBrush}" />
                            <Setter TargetName="TimelineGlyph" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                            <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                            <Setter TargetName="TimelineItemBorder" Property="BorderBrush" Value="{DynamicResource WarningForegroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VisualState}" Value="{x:Static models:WorkflowTimelineVisualState.Reversal}">
                            <Setter TargetName="ConnectorLine" Property="Background" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="TimelineNode" Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="TimelineGlyph" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="TimelineItemBorder" Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding VisualState}" Value="{x:Static models:WorkflowTimelineVisualState.Error}">
                            <Setter TargetName="ConnectorLine" Property="Background" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="TimelineNode" Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="TimelineGlyph" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                            <Setter TargetName="TimelineItemBorder" Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>