<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls"
	xmlns:commands="clr-namespace:Depot.Commands">

	<Style x:Key="MasterDataListBoxStyle" TargetType="ListBox">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
		<Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
		<Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
	</Style>

	<Style x:Key="MasterDataListBoxItemStyle" TargetType="ListBoxItem">
		<Setter Property="Margin" Value="4" />
		<Setter Property="Padding" Value="{DynamicResource Control.Padding}" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
			<Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource NavigationSelectedBackgroundBrush}" /></Trigger>
		</Style.Triggers>
	</Style>

	<Style TargetType="{x:Type controls:FilterBar}">
		<Setter Property="Margin" Value="0,0,0,12" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:FilterBar}">
					<Border Padding="12" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="{DynamicResource CornerRadius.Small}">
						<ContentPresenter
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:PaginationControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:PaginationControl}">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
						<Button Command="{TemplateBinding PreviousCommand}" Content="Previous" Style="{DynamicResource SecondaryButtonStyle}" />
						<TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding PageText}" Style="{DynamicResource CaptionStyle}" />
						<Button Grid.Column="2" Command="{TemplateBinding NextCommand}" Content="Next" Style="{DynamicResource SecondaryButtonStyle}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:WorkflowHeader}">
		<Setter Property="Margin" Value="0,0,0,16" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:WorkflowHeader}">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
						<StackPanel>
							<TextBlock Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis" Style="{DynamicResource SectionTitleStyle}" />
							<TextBlock Margin="0,3,0,0" Text="{TemplateBinding Subtitle}" TextTrimming="CharacterEllipsis" Style="{DynamicResource CaptionStyle}" />
						</StackPanel>
						<controls:DocumentStatusBadge Grid.Column="1" Margin="16,0,0,0" Status="{TemplateBinding Status}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:WorkflowActionBar}">
		<Setter Property="Margin" Value="0,16,0,0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:WorkflowActionBar}">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
						<ContentPresenter Content="{TemplateBinding SecondaryActions}" HorizontalAlignment="Left" VerticalAlignment="Center" />
						<ContentPresenter Grid.Column="2" Content="{TemplateBinding PrimaryAction}" HorizontalAlignment="Right" VerticalAlignment="Center" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:OperationPanel}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:OperationPanel}">
					<StackPanel>
						<controls:OperationStatus ErrorText="{TemplateBinding ErrorText}" HasError="{TemplateBinding HasError}" IsBusy="{TemplateBinding IsBusy}" StatusText="{TemplateBinding StatusText}" />
						<StackPanel x:Name="DiagnosticActions" Margin="{DynamicResource Control.Margin}" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="Collapsed">
							<Button Command="{x:Static commands:HelpCommands.CopyDiagnostics}" CommandParameter="{TemplateBinding ErrorText}" Content="Copy diagnostics" Style="{DynamicResource SecondaryButtonStyle}" />
							<Button Margin="{DynamicResource Button.Margin}" Command="{x:Static commands:HelpCommands.OpenTopic}" CommandParameter="{TemplateBinding HelpTopicId}" Content="Open Help" Style="{DynamicResource SecondaryButtonStyle}" />
						</StackPanel>
					</StackPanel>
					<ControlTemplate.Triggers>
						<Trigger Property="HasError" Value="True"><Setter TargetName="DiagnosticActions" Property="Visibility" Value="Visible" /></Trigger>
						<Trigger Property="HelpTopicId" Value=""><Setter TargetName="DiagnosticActions" Property="Visibility" Value="Collapsed" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:MasterDetailGrid}">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:MasterDetailGrid}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="{DynamicResource MasterPane.DefaultWidth}" MinWidth="{DynamicResource MasterPane.MinWidth}" MaxWidth="{DynamicResource MasterPane.MaxWidth}" />
							<ColumnDefinition Width="{DynamicResource MasterDetail.ColumnGap}" />
							<ColumnDefinition Width="*" MinWidth="360" />
						</Grid.ColumnDefinitions>
						<ContentPresenter Content="{TemplateBinding Master}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
						<ContentPresenter Grid.Column="2" Content="{TemplateBinding Detail}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type controls:ShellModuleContentControl}">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
	</Style>

	<Style TargetType="{x:Type controls:WorkflowListState}">
		<Setter Property="Panel.ZIndex" Value="2" />
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="Visibility" Value="Collapsed" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type controls:WorkflowListState}">
					<Border Background="{TemplateBinding Background}">
						<controls:EmptyState x:Name="State" Title="No documents yet" Description="Create the first document to begin this workflow." />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="ItemCount" Value="0"><Setter Property="Visibility" Value="Visible" /></Trigger>
						<Trigger Property="IsSearchActive" Value="True"><Setter TargetName="State" Property="Title" Value="No results" /><Setter TargetName="State" Property="Description" Value="No documents match the current search and filters." /></Trigger>
						<Trigger Property="IsBusy" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter TargetName="State" Property="Title" Value="Loading" /><Setter TargetName="State" Property="Description" Value="Documents are being loaded." /></Trigger>
						<Trigger Property="HasError" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter TargetName="State" Property="Title" Value="Documents could not be loaded" /><Setter TargetName="State" Property="Description" Value="{Binding ErrorText, RelativeSource={RelativeSource TemplatedParent}}" /></Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
