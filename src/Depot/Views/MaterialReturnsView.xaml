<UserControl x:Class="Depot.Views.MaterialReturnsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:PageHeader Title="Material Returns" Subtitle="Record physical material coming back into stock as an independent return document."><controls:PageHeader.Actions><controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" /></controls:PageHeader.Actions></controls:PageHeader>
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource MasterPane.DefaultWidth}" MinWidth="{StaticResource MasterPane.MinWidth}" MaxWidth="{StaticResource MasterPane.MaxWidth}" /><ColumnDefinition Width="{StaticResource MasterDetail.ColumnGap}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<controls:FilterBar><controls:SearchBox Placeholder="Search return, source or reference" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /></controls:FilterBar>
				<ComboBox Grid.Row="2" DisplayMemberPath="Name" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource AppComboBoxStyle}" />
				<ListBox Grid.Row="4" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}" ItemsSource="{Binding Returns}" SelectedItem="{Binding SelectedReturn}" Style="{StaticResource MasterDataListBoxStyle}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding ReturnNumber}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding RecipientOrSource}" TextTrimming="CharacterEllipsis" /><TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding OriginalMaterialIssueNumber, StringFormat=Original: {0}}" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right"><controls:DocumentStatusBadge HorizontalAlignment="Right" Status="{Binding StatusDisplayName}" /><TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="{Binding ReturnDate, StringFormat={}{0:d}}" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
				<controls:WorkflowListState Grid.Row="4" ItemCount="{Binding Returns.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" />
				<controls:PaginationControl Grid.Row="6" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}" />
				<Button Grid.Row="8" Command="{Binding NewReturnCommand}" Content="New Material Return" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanCreate, Converter={StaticResource BooleanToVisibilityConverter}}" />
			</Grid>
			<ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<controls:Card>
						<controls:Card.Header><controls:WorkflowHeader Title="{Binding EditorTitle}" Subtitle="{Binding Draft.RecipientOrSource}" Status="{Binding Draft.Status}" /></controls:Card.Header>
						<StackPanel>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
								<StackPanel><TextBlock Style="{StaticResource FormLabelStyle}" Text="Returning Person / Source" /><controls:TextInput IsEnabled="{Binding IsDraft}" Text="{Binding Draft.RecipientOrSource, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
								<StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Original Material Issue (optional)" /><ComboBox DisplayMemberPath="IssueNumber" IsEnabled="{Binding IsDraft}" ItemsSource="{Binding OriginalIssues}" SelectedItem="{Binding SelectedOriginalIssue}" Style="{StaticResource AppComboBoxStyle}" /></StackPanel>
								<StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Return Date" /><DatePicker IsEnabled="{Binding IsDraft}" SelectedDate="{Binding Draft.ReturnDate}" Style="{StaticResource AppDatePickerStyle}" /></StackPanel>
							</Grid>
							<Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FormLabelStyle}" Text="Business Reference" /><controls:TextInput IsEnabled="{Binding IsDraft}" Text="{Binding Draft.Reference, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Notes / Explanation" /><TextBox AcceptsReturn="True" IsReadOnly="{Binding IsReadOnly}" MinHeight="56" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" /></StackPanel></Grid>
							<TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionStyle}" Text="Returns without an original material issue require a business reference or explanation." />
							<DataGrid MinHeight="180" Margin="0,16,0,0" IsReadOnly="True" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding LineNumber}" Header="#" Width="45" /><DataGridTextColumn Binding="{Binding PartNumber}" Header="Item" Width="110" /><DataGridTextColumn Binding="{Binding ItemDescription}" Header="Description" Width="*" /><DataGridTextColumn Binding="{Binding WarehouseName}" Header="Warehouse" Width="130" /><DataGridTextColumn Binding="{Binding StorageLocationName}" Header="Location" Width="120" /><DataGridTextColumn Binding="{Binding ReasonCodeName}" Header="Reason" Width="150" /><DataGridTextColumn Binding="{Binding Quantity, StringFormat={}{0:N0}}" Header="Return Qty" Width="90" /><DataGridTextColumn Binding="{Binding CurrentStock, StringFormat={}{0:N0}}" Header="Stock" Width="75" /><DataGridTextColumn Binding="{Binding ResultingStock, Mode=OneWay, StringFormat={}{0:N0}}" Header="After Return" Width="95" /></DataGrid.Columns></DataGrid>
							<Grid Margin="0,12,0,0" IsEnabled="{Binding IsDraft}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="90" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<StackPanel><TextBlock Style="{StaticResource FormLabelStyle}" Text="Destination Inventory" /><controls:SearchBox Margin="0,4,0,6" Placeholder="Search item, warehouse or location" Text="{Binding InventorySearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox ItemsSource="{Binding InventoryOptions}" SelectedItem="{Binding SelectedInventory}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><Run FontWeight="SemiBold" Text="{Binding PartNumber}" /><Run Text=" — " /><Run Text="{Binding WarehouseName}" /><Run Text=" / " /><Run Text="{Binding LocationName}" /><Run Text=" · Stock " /><Run Text="{Binding CurrentStock, StringFormat={}{0:N0}}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
								<StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Return Reason Code" /><ComboBox DisplayMemberPath="Name" ItemsSource="{Binding ReasonCodes}" SelectedItem="{Binding SelectedReasonCode}" Style="{StaticResource AppComboBoxStyle}" /><TextBlock Margin="0,8,0,0" Style="{StaticResource FormLabelStyle}" Text="Line Notes" /><controls:TextInput Text="{Binding LineNotes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
								<StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Quantity" /><controls:TextInput Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
								<StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Command="{Binding RemoveLineCommand}" Content="Remove" Style="{StaticResource SecondaryButtonStyle}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding AddLineCommand}" Content="{Binding SaveLineText}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel>
							</Grid>
							<controls:WorkflowActionBar><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CancelCommand}" Content="Cancel Draft" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanCreate, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding SaveCommand}" Content="Save Draft" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanCreate, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding PostCommand}" Content="Post Material Return" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanPost, Converter={StaticResource BooleanToVisibilityConverter}}" /></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
						</StackPanel>
					</controls:Card>
					<controls:Card Margin="0,16,0,0" Visibility="{Binding HasMovements, Converter={StaticResource BooleanToVisibilityConverter}}"><controls:Card.Header><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Return Movements" /></controls:Card.Header><DataGrid MinHeight="180" IsReadOnly="True" ItemsSource="{Binding Movements}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Header="Timestamp" Width="145" /><DataGridTextColumn Binding="{Binding MovementType}" Header="Type" Width="110" /><DataGridTextColumn Binding="{Binding PartNumber}" Header="Item" Width="120" /><DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*" /><DataGridTextColumn Binding="{Binding WarehouseName}" Header="Warehouse" Width="140" /><DataGridTextColumn Binding="{Binding LocationName}" Header="Location" Width="120" /><DataGridTextColumn Binding="{Binding Quantity, StringFormat={}{0:N0}}" Header="Quantity" Width="85" /><DataGridCheckBoxColumn Binding="{Binding IsReversed, Mode=OneWay}" Header="Corrected" Width="85" /></DataGrid.Columns></DataGrid></controls:Card>
					<controls:Card Margin="0,16,0,0" Visibility="{Binding CanCorrect, Converter={StaticResource BooleanToVisibilityConverter}}"><controls:Card.Header><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Correct by Counter-Booking" /></controls:Card.Header><StackPanel><TextBlock Style="{StaticResource BodyStyle}" Text="This is not a cancellation. The posted return remains immutable and correction creates explicit negative counter-movements." TextWrapping="Wrap" /><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox DisplayMemberPath="Name" ItemsSource="{Binding ReasonCodes}" SelectedItem="{Binding SelectedCorrectionReasonCode}" Style="{StaticResource AppComboBoxStyle}" /><controls:TextInput Grid.Column="2" Text="{Binding CorrectionReason, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="4" Command="{Binding CorrectCommand}" Content="Post Counter-Movements" Style="{StaticResource DangerButtonStyle}" /></Grid></StackPanel></controls:Card>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
