<UserControl x:Class="Depot.Views.MovementsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" xmlns:commands="clr-namespace:Depot.Commands" xmlns:controls="clr-namespace:Depot.Controls"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" HelpTopicId="inventory.movements" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}"/><Button Grid.Column="1" MinWidth="{DynamicResource Help.ContextButton.MinWidth}" automation:AutomationProperties.Name="Open movement and reversal help" Command="{x:Static commands:HelpCommands.OpenTopic}" CommandParameter="inventory.movements" Content="Help" Style="{StaticResource SecondaryButtonStyle}"/></Grid><TabControl Grid.Row="1" Style="{StaticResource AppTabControlStyle}"><TabItem Header="Movement history"><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:FilterBar><controls:SearchBox automation:AutomationProperties.Name="Search movements" Placeholder="Search movements" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/></controls:FilterBar><Grid Grid.Row="1"><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedMovement}" Style="{StaticResource AppDataGridStyle}" Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="125"/><DataGridTextColumn Header="Part number" Binding="{Binding PartNumber}" Width="115"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="95"/><DataGridTextColumn Header="Reason" Binding="{Binding ReasonCodeName}" Width="110"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="80" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="110"/></DataGrid.Columns></DataGrid><controls:WorkflowListState ItemCount="{Binding Items.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}"/></Grid><controls:PaginationControl Grid.Row="2" Margin="0,10,0,0" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageNumber, StringFormat=Page {0}}"/><Border Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource WorkspaceToolbarBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reversal reason code *" Style="{StaticResource FormLabelStyle}"/><ComboBox DisplayMemberPath="Name" ItemsSource="{Binding ReasonCodes}" SelectedItem="{Binding SelectedReversalReasonCode}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Reversal explanation *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><Button Grid.Column="4" VerticalAlignment="Bottom" Command="{Binding ReverseMovementCommand}" Content="Reverse withdrawal" Style="{StaticResource DangerButtonStyle}"/></Grid></Border></Grid></controls:Card></TabItem><TabItem Header="New movement"><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:WorkflowHeader Title="New movement" Subtitle="Purchases, withdrawals, and inventory corrections" Status="Draft"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Inventory *" Style="{StaticResource FormLabelStyle}"/><ComboBox automation:AutomationProperties.Name="Movement inventory" DisplayMemberPath="DisplayName" ItemsSource="{Binding AvailableInventories}" SelectedItem="{Binding SelectedInventory}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Movement type *" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding MovementTypes}" SelectedItem="{Binding Editor.MovementType}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Reason code" Style="{StaticResource FormLabelStyle}"/><ComboBox DisplayMemberPath="Name" ItemsSource="{Binding ReasonCodes}" SelectedValue="{Binding Editor.ReasonCodeId}" SelectedValuePath="Id" Style="{StaticResource AppComboBoxStyle}"/></StackPanel></Grid><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Quantity *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Editor.Quantity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Unit price" Style="{StaticResource FormLabelStyle}"/><controls:TextInput IsEnabled="{Binding Editor.RequiresUnitPrice}" Text="{Binding Editor.UnitPrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Reference" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Editor.Reference, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><Grid Grid.Row="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Notes" Style="{StaticResource FormLabelStyle}"/><TextBox Grid.Row="1" MinHeight="70" AcceptsReturn="True" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/></Grid><controls:WorkflowActionBar Grid.Row="7"><controls:WorkflowActionBar.SecondaryActions><TextBlock VerticalAlignment="Center" Text="Stock changes only through the resulting immutable movement." Style="{StaticResource CaptionStyle}"/></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding CreateMovementCommand}" Content="Create movement" Style="{StaticResource PrimaryButtonStyle}"/></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar></Grid></controls:Card></TabItem></TabControl></Grid></UserControl>