<UserControl x:Class="Depot.Views.MovementsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:PageHeader Title="Movements" Subtitle="Create controlled stock movements and review the immutable ledger." />
		<controls:OperationPanel Grid.Row="1" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" StatusText="{Binding StatusText}" ErrorText="{Binding OperationError}" />
		<controls:FilterBar Grid.Row="2"><controls:SearchBox automation:AutomationProperties.Name="Search movements" Placeholder="Search movements" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by item, location, reason, reference, or notes" /></controls:FilterBar>
		<TabControl Grid.Row="4" Style="{StaticResource AppTabControlStyle}">
			<TabItem Header="Movement history"><controls:Card Margin="0,16,0,0"><Grid>
				<Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<Grid><DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedMovement}" Style="{StaticResource AppDataGridStyle}" Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Part number" Binding="{Binding PartNumber}" Width="120" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="100" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Reason" Binding="{Binding ReasonCodeName}" Width="120" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="85" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="120" ElementStyle="{StaticResource AppDataGridTextStyle}" /></DataGrid.Columns></DataGrid><controls:WorkflowListState ItemCount="{Binding Items.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" /></Grid>
				<controls:PaginationControl Grid.Row="1" Margin="0,12,0,0" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageNumber, StringFormat=Page {0}}" />
				<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reversal reason code *" Style="{StaticResource FormLabelStyle}" /><ComboBox DisplayMemberPath="Name" ItemsSource="{Binding ReasonCodes}" SelectedItem="{Binding SelectedReversalReasonCode}" Style="{StaticResource AppComboBoxStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Reversal explanation *" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><Button Grid.Column="4" VerticalAlignment="Bottom" Command="{Binding ReverseMovementCommand}" Content="Reverse withdrawal" Style="{StaticResource DangerButtonStyle}" /></Grid>
			</Grid></controls:Card></TabItem>
			<TabItem Header="New movement"><controls:Card Margin="0,16,0,0"><Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<controls:WorkflowHeader Title="New movement" Subtitle="Purchases, withdrawals, and inventory corrections" Status="Draft" />
				<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Inventory *" Style="{StaticResource FormLabelStyle}" /><ComboBox automation:AutomationProperties.Name="Movement inventory" DisplayMemberPath="DisplayName" ItemsSource="{Binding AvailableInventories}" SelectedItem="{Binding SelectedInventory}" Style="{StaticResource AppComboBoxStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Movement type *" Style="{StaticResource FormLabelStyle}" /><ComboBox ItemsSource="{Binding MovementTypes}" SelectedItem="{Binding Editor.MovementType}" Style="{StaticResource AppComboBoxStyle}" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Reason code" Style="{StaticResource FormLabelStyle}" /><ComboBox DisplayMemberPath="Name" ItemsSource="{Binding ReasonCodes}" SelectedValue="{Binding Editor.ReasonCodeId}" SelectedValuePath="Id" Style="{StaticResource AppComboBoxStyle}" /></StackPanel></Grid>
				<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Quantity *" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Editor.Quantity, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Unit price" Style="{StaticResource FormLabelStyle}" /><controls:TextInput IsEnabled="{Binding Editor.RequiresUnitPrice}" Text="{Binding Editor.UnitPrice, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Reference" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Editor.Reference, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
				<StackPanel Grid.Row="6"><TextBlock Text="Notes" Style="{StaticResource FormLabelStyle}" /><TextBox MinHeight="72" AcceptsReturn="True" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" /></StackPanel>
				<controls:WorkflowActionBar Grid.Row="8"><controls:WorkflowActionBar.SecondaryActions><TextBlock VerticalAlignment="Center" Text="Stock is changed only through the resulting immutable movement." Style="{StaticResource CaptionStyle}" /></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding CreateMovementCommand}" Content="Create movement" Style="{StaticResource PrimaryButtonStyle}" /></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
			</Grid></controls:Card></TabItem>
		</TabControl>
	</Grid>
</UserControl>
