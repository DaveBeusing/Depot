<UserControl
	x:Class="Depot.Views.MovementsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:PageHeader
			Grid.Row="0"
			Title="Movements"
			Subtitle="Record purchases, withdrawals, and corrections while reviewing stock activity." />

		<controls:FilterBar Grid.Row="1">
			<controls:SearchBox Placeholder="Search movements" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by part number, location, reason, reference, or notes" />
		</controls:FilterBar>

		<controls:OperationPanel
			Grid.Row="2"
			IsBusy="{Binding IsBusy}"
			HasError="{Binding HasOperationError}"
			StatusText="{Binding StatusText}"
			ErrorText="{Binding OperationError}" />

		<controls:MasterDetailGrid Grid.Row="3">
			<controls:MasterDetailGrid.Master>

			<controls:Card>
				<controls:Card.Header>
					<controls:WorkflowHeader Title="Movement history" Subtitle="Immutable stock ledger" />
				</controls:Card.Header>
				<Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid>
					<DataGrid
						ItemsSource="{Binding Items}"
						SelectedItem="{Binding SelectedMovement}"
						Style="{StaticResource AppDataGridStyle}"
						Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="130" />
							<DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="120" />
							<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
							<DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="95" />
							<DataGridTextColumn Header="Reason" Binding="{Binding ReasonCodeName}" Width="120" />
							<DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="70" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
							<DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
							<DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="120" />
						</DataGrid.Columns>
					</DataGrid>

					<controls:WorkflowListState ItemCount="{Binding Items.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" />
				</Grid><controls:PaginationControl Grid.Row="1" Margin="0,12,0,0" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageNumber, StringFormat=Page {0}}" /></Grid>
			</controls:Card>
			</controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail>

			<controls:Card>
				<controls:Card.Header>
					<controls:WorkflowHeader Title="New movement" Subtitle="Create a purchase, withdrawal, or correction" />
				</controls:Card.Header>

				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<Border
							Padding="12"
							Background="{StaticResource ErrorBrush}"
							CornerRadius="6"
							Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock
								Foreground="{StaticResource ErrorForegroundBrush}"
								Text="{Binding ErrorMessage}"
								TextWrapping="Wrap" />
						</Border>

						<TextBlock Margin="0,16,0,4" Text="Inventory" Style="{StaticResource FormLabelStyle}" />
						<ComboBox
							DisplayMemberPath="DisplayName"
							ItemsSource="{Binding AvailableInventories}"
							SelectedItem="{Binding SelectedInventory}"
							Style="{StaticResource AppComboBoxStyle}" />

						<TextBlock Margin="0,16,0,4" Text="Movement Type" Style="{StaticResource FormLabelStyle}" />
						<ComboBox
							ItemsSource="{Binding MovementTypes}"
							SelectedItem="{Binding Editor.MovementType}"
							Style="{StaticResource AppComboBoxStyle}" />

						<TextBlock Margin="0,16,0,4" Text="Reason Code" Style="{StaticResource FormLabelStyle}" />
						<ComboBox
							DisplayMemberPath="Name"
							ItemsSource="{Binding ReasonCodes}"
							SelectedValue="{Binding Editor.ReasonCodeId}"
							SelectedValuePath="Id"
							Style="{StaticResource AppComboBoxStyle}" />

						<TextBlock Margin="0,16,0,4" Text="Quantity" Style="{StaticResource FormLabelStyle}" />
						<controls:TextInput Text="{Binding Editor.Quantity, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock Margin="0,16,0,4" Text="Unit Price" Style="{StaticResource FormLabelStyle}" />
						<controls:TextInput
							IsEnabled="{Binding Editor.RequiresUnitPrice}"
							Text="{Binding Editor.UnitPrice, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock Margin="0,16,0,4" Text="Reference" Style="{StaticResource FormLabelStyle}" />
						<controls:TextInput Text="{Binding Editor.Reference, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock Margin="0,16,0,4" Text="Notes" Style="{StaticResource FormLabelStyle}" />
						<TextBox
							Height="72"
							AcceptsReturn="True"
							Style="{StaticResource AppTextBoxStyle}"
							Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}"
							TextWrapping="Wrap" />

						<controls:WorkflowActionBar><controls:WorkflowActionBar.PrimaryAction><Button IsDefault="True" Command="{Binding CreateMovementCommand}" Content="Create movement" Style="{StaticResource PrimaryButtonStyle}" /></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>

						<Separator Margin="0,24,0,16" />
						<TextBlock Text="Reverse Material Withdrawal" Style="{StaticResource SectionTitleStyle}" />
						<TextBlock Margin="0,6,0,0" Text="Select an unreversed withdrawal in the history. A full counter-movement is created; the original remains unchanged." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
						<TextBlock Margin="0,16,0,4" Text="Reversal Reason Code" Style="{StaticResource FormLabelStyle}" />
						<ComboBox DisplayMemberPath="Name" ItemsSource="{Binding ReasonCodes}" SelectedItem="{Binding SelectedReversalReasonCode}" Style="{StaticResource AppComboBoxStyle}" />
						<TextBlock Margin="0,16,0,4" Text="Reason" Style="{StaticResource FormLabelStyle}" />
						<TextBox MinHeight="64" AcceptsReturn="True" Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" />
						<Button Margin="0,16,0,0" HorizontalAlignment="Right" Command="{Binding ReverseMovementCommand}" Content="Reverse Withdrawal" Style="{StaticResource DangerButtonStyle}" />
					</StackPanel>
				</ScrollViewer>
			</controls:Card>
			</controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>
