<UserControl x:Class="Depot.Views.PurchaseOrdersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls">
	<Grid DataContext="{Binding Workflow}">
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:PageHeader Title="Purchase Orders" Subtitle="Create, edit and progress purchase orders through their controlled lifecycle."><controls:PageHeader.Actions><controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" /></controls:PageHeader.Actions></controls:PageHeader>
		<controls:MasterDetailGrid Grid.Row="2">
			<controls:MasterDetailGrid.Master>
				<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<controls:FilterBar><StackPanel><controls:SearchBox Placeholder="Search order number, supplier or notes" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox Margin="0,8,0,0" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" /></StackPanel></controls:FilterBar>
					<Grid Grid.Row="1"><ListBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" /><TextBlock Text="{Binding SupplierName}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right"><controls:DocumentStatusBadge HorizontalAlignment="Right" Status="{Binding StatusDisplayName}" /><TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Text="{Binding OrderDate, StringFormat={}{0:d}}" Style="{StaticResource CaptionStyle}" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><controls:WorkflowListState ItemCount="{Binding Orders.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" /></Grid>
					<controls:PaginationControl Grid.Row="3" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}" />
					<Button Grid.Row="5" Command="{Binding NewOrderCommand}" Content="New Purchase Order" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanCreateOrders, Converter={StaticResource BooleanToVisibilityConverter}}" />
				</Grid>
			</controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail>
				<controls:Card>
					<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
						<controls:WorkflowHeader Title="{Binding EditorTitle}" Subtitle="{Binding Draft.SupplierName, TargetNullValue=Select a supplier}" Status="{Binding Draft.StatusDisplayName}" />
						<TabControl Grid.Row="1">
							<TabItem Header="Order"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
								<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Supplier *" Style="{StaticResource FormLabelStyle}" /><controls:SearchBox Margin="0,4,0,6" Placeholder="Search suppliers" Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox IsEnabled="{Binding IsDraft}" ItemsSource="{Binding Suppliers}" SelectedValue="{Binding Draft.SupplierId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Order date *" Style="{StaticResource FormLabelStyle}" /><DatePicker IsEnabled="{Binding IsDraft}" SelectedDate="{Binding Draft.OrderDate}" Style="{StaticResource AppDatePickerStyle}" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Expected delivery" Style="{StaticResource FormLabelStyle}" /><DatePicker IsEnabled="{Binding IsDraft}" SelectedDate="{Binding Draft.ExpectedDeliveryDate}" Style="{StaticResource AppDatePickerStyle}" /></StackPanel></Grid>
								<StackPanel Grid.Row="2"><TextBlock Text="Notes" Style="{StaticResource FormLabelStyle}" /><TextBox IsReadOnly="{Binding IsOrderReadOnly}" MinHeight="56" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
								<DataGrid Grid.Row="4" MinHeight="140" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="45" /><DataGridTextColumn Header="Item" Binding="{Binding ItemPartNumber}" Width="120" /><DataGridTextColumn Header="Description" Binding="{Binding ItemDescription}" Width="*" /><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="90" /><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="110" /><DataGridTextColumn Header="Received" Binding="{Binding ReceivedQuantity, StringFormat={}{0:N2}}" Width="90" /></DataGrid.Columns></DataGrid>
								<Grid Grid.Row="6" IsEnabled="{Binding IsDraft}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="100" /><ColumnDefinition Width="12" /><ColumnDefinition Width="120" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Item *" Style="{StaticResource FormLabelStyle}" /><controls:SearchBox Margin="0,4,0,6" Placeholder="Search items" Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding PartNumber}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding Description}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Quantity *" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Unit price *" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding LineUnitPrice, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Command="{Binding RemoveLineCommand}" Content="Remove" Style="{StaticResource SecondaryButtonStyle}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding AddLineCommand}" Content="{Binding SaveLineText}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></Grid>
							</Grid></TabItem>
							<TabItem Header="Status history"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Submitted by" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding Draft.SubmittedByUserDisplay, TargetNullValue=Not submitted}" Style="{StaticResource BodyStyle}" /><TextBlock Margin="0,12,0,0" Text="Decision by" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding Draft.ApprovalDecisionByUserDisplay, TargetNullValue=No decision}" Style="{StaticResource BodyStyle}" /><TextBlock Margin="0,12,0,0" Text="Decision comment" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding Draft.ApprovalComment, TargetNullValue=No comment}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Submitted" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding Draft.SubmittedAtLocal, StringFormat={}{0:g}, TargetNullValue=—}" Style="{StaticResource BodyStyle}" /><TextBlock Margin="0,12,0,0" Text="Decision" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding Draft.ApprovalDecisionAtLocal, StringFormat={}{0:g}, TargetNullValue=—}" Style="{StaticResource BodyStyle}" /><TextBlock Margin="0,12,0,0" Text="Closed" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding Draft.ClosedAtLocal, StringFormat={}{0:g}, TargetNullValue=—}" Style="{StaticResource BodyStyle}" /><TextBlock Margin="0,12,0,0" Text="Close reason" Style="{StaticResource FormLabelStyle}" /><TextBlock Text="{Binding Draft.CloseReason, TargetNullValue=Not closed}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}" /></StackPanel></Grid></TabItem>
						</TabControl>
						<StackPanel Grid.Row="2"><StackPanel Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Margin="0,12,0,0" Text="Close reason *" Style="{StaticResource FormLabelStyle}" /><TextBox MinHeight="48" AcceptsReturn="True" MaxLength="2000" Text="{Binding CloseReason, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" /></StackPanel><controls:WorkflowActionBar><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CancelOrderCommand}" Content="Cancel Order" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanCancelCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding CloseOrderCommand}" Content="Close Order" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding SaveOrderCommand}" Content="Save Draft" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsDraft, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><StackPanel Orientation="Horizontal"><Button Command="{Binding ReopenRejectedCommand}" Content="Reopen Draft" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanReopenCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Command="{Binding SubmitForApprovalCommand}" Content="Submit for Approval" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanSubmitCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Command="{Binding PlaceOrderCommand}" Content="Place Order" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanPlaceCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar></StackPanel>
					</Grid>
				</controls:Card>
			</controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>
