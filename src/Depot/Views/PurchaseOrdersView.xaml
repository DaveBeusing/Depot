<UserControl x:Class="Depot.Views.PurchaseOrdersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls">
<Grid DataContext="{Binding Workflow}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<controls:PageHeader Title="Purchase Orders" Subtitle="Create, approve, place and track supplier purchase orders through receipt."/>
<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}"/>
<controls:MasterDetailGrid Grid.Row="3"><controls:MasterDetailGrid.Master><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<controls:FilterBar><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:SearchBox Placeholder="Search order number, supplier or notes" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Grid.Row="2" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></Grid></controls:FilterBar>
<Grid Grid.Row="1"><ListBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding SupplierName}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right"><controls:DocumentStatusBadge HorizontalAlignment="Right" Status="{Binding StatusDisplayName}"/><TextBlock Margin="0,3,0,0" HorizontalAlignment="Right" Text="{Binding OrderDate, StringFormat={}{0:d}}" Style="{StaticResource CaptionStyle}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><controls:WorkflowListState ItemCount="{Binding Orders.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}"/></Grid>
<Grid Grid.Row="2" Margin="0,10,0,0"><controls:PaginationControl PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}"/><Button HorizontalAlignment="Right" Command="{Binding NewOrderCommand}" Content="New order" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanCreateOrders, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid>
</Grid></Border></controls:MasterDetailGrid.Master>
<controls:MasterDetailGrid.Detail><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:WorkflowHeader Title="{Binding EditorTitle}" Subtitle="{Binding Draft.SupplierName, TargetNullValue=Select a supplier}" Status="{Binding Draft.StatusDisplayName}"/>
<TabControl Grid.Row="1" Style="{StaticResource AppTabControlStyle}"><TabItem Header="Order"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Supplier *" Style="{StaticResource FormLabelStyle}"/><controls:SearchBox Margin="0,3,0,5" Placeholder="Search suppliers" Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"/><ComboBox IsEnabled="{Binding IsDraft}" ItemsSource="{Binding Suppliers}" SelectedValue="{Binding Draft.SupplierId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Order date *" Style="{StaticResource FormLabelStyle}"/><DatePicker IsEnabled="{Binding IsDraft}" SelectedDate="{Binding Draft.OrderDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Expected delivery" Style="{StaticResource FormLabelStyle}"/><DatePicker IsEnabled="{Binding IsDraft}" SelectedDate="{Binding Draft.ExpectedDeliveryDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel></Grid>
<StackPanel Grid.Row="2"><TextBlock Text="Notes" Style="{StaticResource FormLabelStyle}"/><TextBox IsReadOnly="{Binding IsOrderReadOnly}" MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
<DataGrid Grid.Row="4" MinHeight="150" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40"/><DataGridTextColumn Header="Item" Binding="{Binding ItemPartNumber}" Width="110"/><DataGridTextColumn Header="Description" Binding="{Binding ItemDescription}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="85" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Received" Binding="{Binding ReceivedQuantity, StringFormat={}{0:N2}}" Width="85" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns></DataGrid>
<Grid Grid.Row="6" IsEnabled="{Binding IsDraft}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Item *" Style="{StaticResource FormLabelStyle}"/><controls:SearchBox Margin="0,3,0,5" Placeholder="Search items" Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}"/><ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding PartNumber}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Description}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Quantity *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Unit price *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding LineUnitPrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Command="{Binding RemoveLineCommand}" Content="Remove" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding AddLineCommand}" Content="{Binding SaveLineText}" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></Grid>
</Grid></TabItem>
<TabItem Header="Status history"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions><controls:WorkflowHeader Title="Status history" Subtitle="Chronological purchase-order changes from the immutable audit journal" Status="{Binding Draft.StatusDisplayName}"/><Grid Grid.Row="2"><DataGrid ItemsSource="{Binding StatusHistory}" Style="{StaticResource AppDataGridCompactStyle}" Visibility="{Binding HasStatusHistory, Converter={StaticResource BooleanToVisibilityConverter}}"><DataGrid.Columns><DataGridTextColumn Header="Date and time" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="140" ElementStyle="{StaticResource AppDataGridTextStyle}"/><DataGridTextColumn Header="Previous" Binding="{Binding PreviousStatus}" Width="120"/><DataGridTextColumn Header="New" Binding="{Binding NewStatus}" Width="120"/><DataGridTextColumn Header="Changed by" Binding="{Binding ChangedBy}" Width="160"/><DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}"/></DataGrid.Columns></DataGrid><controls:EmptyState Title="No status history" Description="History will appear after the purchase order has been saved." Visibility="{Binding HasNoStatusHistory, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid></Grid></TabItem></TabControl>
<StackPanel Grid.Row="2"><StackPanel Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Margin="0,10,0,0" Text="Close reason *" Style="{StaticResource FormLabelStyle}"/><TextBox MinHeight="48" AcceptsReturn="True" MaxLength="2000" Text="{Binding CloseReason, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}"/></StackPanel><controls:WorkflowActionBar><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CancelOrderCommand}" Content="Cancel order" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanCancelCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding CloseOrderCommand}" Content="Close order" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding SaveOrderCommand}" Content="Save draft" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsDraft, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><StackPanel Orientation="Horizontal"><Button Command="{Binding ReopenRejectedCommand}" Content="Reopen draft" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanReopenCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Command="{Binding SubmitForApprovalCommand}" Content="Submit for approval" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanSubmitCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Command="{Binding PlaceOrderCommand}" Content="Place order" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanPlaceCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar></StackPanel>
</Grid></Border></controls:MasterDetailGrid.Detail></controls:MasterDetailGrid></Grid></UserControl>