<UserControl x:Class="Depot.Views.SalesLeadsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<controls:PageHeader Title="Leads" Subtitle="Capture prospects, schedule follow-up and qualify them into the existing customer and opportunity workflow."/>
		<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}"/>
		<controls:MasterDetailGrid Grid.Row="2" Margin="0,12,0,0">
			<controls:MasterDetailGrid.Master>
				<Border Style="{StaticResource WorkspaceSectionStyle}">
					<Grid>
						<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
						<controls:FilterBar>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
								<controls:SearchBox Placeholder="Search leads, contacts or source" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
								<Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Content="Search" Style="{StaticResource SecondaryButtonStyle}"/>
							</Grid>
						</controls:FilterBar>
						<ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Leads}" SelectedItem="{Binding SelectedLead}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}">
							<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
								<StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{Binding LeadNumber}"/><Run Text=" · "/><Run Text="{Binding Source, TargetNullValue=Direct}"/></TextBlock></StackPanel>
								<TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}"/>
							</Grid></DataTemplate></ListBox.ItemTemplate>
						</ListBox>
						<Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewLeadCommand}" Content="New lead" Style="{StaticResource PrimaryButtonStyle}"/>
					</Grid>
				</Border>
			</controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail>
				<Border Style="{StaticResource WorkspaceSectionStyle}">
					<Grid>
						<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
						<controls:WorkflowHeader Title="{Binding LeadDraft.DisplayName}" Subtitle="Prospect identity, qualification and follow-up" Status="{Binding LeadDraft.Status}"/>
						<TabControl Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource AppTabControlStyle}">
							<TabItem Header="Details"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,10,0,0">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
								<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
								<StackPanel><TextBlock Text="Company" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding LeadDraft.CompanyName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
								<StackPanel Grid.Column="2"><TextBlock Text="Person" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding LeadDraft.PersonName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
								<StackPanel Grid.Row="2"><TextBlock Text="Email" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding LeadDraft.Email, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
								<StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Phone" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding LeadDraft.Phone, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
								<StackPanel Grid.Row="4"><TextBlock Text="Source" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding LeadDraft.Source, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
								<StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Status" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding LeadStatuses}" SelectedItem="{Binding LeadDraft.Status}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
								<StackPanel Grid.Row="6" Grid.ColumnSpan="3"><TextBlock Text="Notes" Style="{StaticResource FormLabelStyle}"/><TextBox MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding LeadDraft.NotesSummary, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
							</Grid></ScrollViewer></TabItem>
							<TabItem Header="Activities"><Grid Margin="0,10,0,0">
								<Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
								<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
								<DataGrid ItemsSource="{Binding Activities}" SelectedItem="{Binding SelectedActivity}" Style="{StaticResource AppDataGridCompactStyle}">
									<DataGrid.Columns><DataGridTextColumn Header="Due" Binding="{Binding DueAtUtc, StringFormat={}{0:g}}" Width="130"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/></DataGrid.Columns>
								</DataGrid>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Type" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding ActivityTypes}" SelectedItem="{Binding ActivityDraft.Type}" Style="{StaticResource AppComboBoxStyle}"/>
									<TextBlock Text="Subject" Margin="0,8,0,0" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ActivityDraft.Subject, UpdateSourceTrigger=PropertyChanged}"/>
									<TextBlock Text="Due" Margin="0,8,0,0" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding ActivityDraft.DueAtUtc}" Style="{StaticResource AppDatePickerStyle}"/>
									<TextBlock Text="Notes" Margin="0,8,0,0" Style="{StaticResource FormLabelStyle}"/><TextBox MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding ActivityDraft.Notes, UpdateSourceTrigger=PropertyChanged}"/>
									<StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Command="{Binding NewActivityCommand}" Content="New" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SaveActivityCommand}" Content="Save" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
								</StackPanel>
								<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"><Button Command="{Binding CompleteActivityCommand}" Content="Complete" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding CancelActivityCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
							</Grid></TabItem>
						</TabControl>
						<controls:WorkflowActionBar Grid.Row="2">
							<controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Convert with customer:" Style="{StaticResource CaptionStyle}"/><ComboBox Width="180" ItemsSource="{Binding Customers}" SelectedItem="{Binding ConversionCustomer}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/><Button Margin="8,0,0,0" Command="{Binding ConvertLeadCommand}" Content="Qualify / Convert" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions>
							<controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding SaveLeadCommand}" Content="Save lead" Style="{StaticResource PrimaryButtonStyle}"/></controls:WorkflowActionBar.PrimaryAction>
						</controls:WorkflowActionBar>
					</Grid>
				</Border>
			</controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>
