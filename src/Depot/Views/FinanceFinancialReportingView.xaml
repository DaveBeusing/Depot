<UserControl x:Class="Depot.Views.FinanceFinancialReportingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:PageHeader Title="Financial Reporting" Subtitle="Trial balance, General Ledger, financial statements, cash flow, aging, tax, inventory and COGS reporting.">
            <controls:PageHeader.Actions><Button Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"/></controls:PageHeader.Actions>
        </controls:PageHeader>
        <controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}"/>
        <TabControl Grid.Row="2" Style="{StaticResource AppTabControlStyle}">
            <TabItem Header="Reports">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource WorkspaceToolbarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="260"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Report" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding ReportKinds}" SelectedItem="{Binding ReportKind}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Accounting book ID" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding AccountingBookId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="From" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding FromDate}"/></StackPanel>
                            <StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="To" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding ToDate}"/></StackPanel>
                            <StackPanel Grid.Column="4" Margin="8,0,0,0"><TextBlock Text="As of" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding AsOfDate}"/></StackPanel>
                            <StackPanel Grid.Column="5" Margin="8,0,0,0"><TextBlock Text="Dimension ID" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding DimensionId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="6" Margin="8,0,0,0"><TextBlock Text="Dimension value" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding DimensionValueId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="7" Margin="8,0,0,0"><TextBlock Text="Options" Style="{StaticResource FormLabelStyle}"/><controls:AppCheckBox Content="Include zero balances" IsChecked="{Binding IncludeZeroBalances}"/></StackPanel>
                            <Button Grid.Column="8" Margin="12,18,0,0" HorizontalAlignment="Right" Command="{Binding GenerateCommand}" Content="Generate" Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding WarningText}" TextWrapping="Wrap"/><WrapPanel Grid.Column="1"><TextBlock Margin="0,5,12,0" Text="{Binding ReportCurrency}"/><Button Command="{Binding CreateSnapshotCommand}" Content="Create snapshot" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding ExportCsvCommand}" Content="Export CSV" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" Style="{StaticResource AppDataGridStyle}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="140"/><DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="80"/><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/><DataGridTextColumn Header="Opening" Binding="{Binding OpeningBalance,StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Debit" Binding="{Binding Debit,StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Credit" Binding="{Binding Credit,StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Balance" Binding="{Binding Balance,StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount,StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Current" Binding="{Binding Current,StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="1-30" Binding="{Binding Days1To30,StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="31-60" Binding="{Binding Days31To60,StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="61-90" Binding="{Binding Days61To90,StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header=">90" Binding="{Binding Over90,StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Credits/Debits" Binding="{Binding Credits,StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Account Mapping">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" Style="{StaticResource AppDataGridStyle}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Account ID" Binding="{Binding AccountId}" Width="*"/><DataGridTextColumn Header="Statement" Binding="{Binding StatementSection}" Width="140"/><DataGridTextColumn Header="Cash flow" Binding="{Binding CashFlowCategory}" Width="110"/><DataGridTextColumn Header="Tax" Binding="{Binding TaxCategory}" Width="110"/><DataGridCheckBoxColumn Header="Cash" Binding="{Binding IsCashAccount}" Width="60"/><DataGridCheckBoxColumn Header="COGS" Binding="{Binding IsCostOfGoodsSold}" Width="60"/></DataGrid.Columns></DataGrid>
                    <Border Grid.Column="2" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Reporting account mapping" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,8,0,0" Text="Account" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Number" Style="{StaticResource AppComboBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Financial statement section" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding StatementSections}" SelectedItem="{Binding StatementSection}" Style="{StaticResource AppComboBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Cash-flow category" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding CashFlowCategories}" SelectedItem="{Binding CashFlowCategory}" Style="{StaticResource AppComboBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Tax category" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding TaxCategories}" SelectedItem="{Binding TaxCategory}" Style="{StaticResource AppComboBoxStyle}"/><WrapPanel Margin="0,8,0,0"><controls:AppCheckBox Content="Cash account" IsChecked="{Binding IsCashAccount}"/><controls:AppCheckBox Margin="16,0,0,0" Content="Cost of Goods Sold" IsChecked="{Binding IsCostOfGoodsSold}"/><controls:AppCheckBox Margin="16,0,0,0" Content="Active" IsChecked="{Binding MappingActive}"/></WrapPanel><TextBlock Margin="0,8,0,0" Text="Sort order" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding SortOrder}" Style="{StaticResource AppTextBoxStyle}"/><WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right"><Button Command="{Binding NewMappingCommand}" Content="New" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SaveMappingCommand}" Content="Save" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Snapshots">
                <DataGrid Margin="8" ItemsSource="{Binding Snapshots}" Style="{StaticResource AppDataGridStyle}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Report" Binding="{Binding Kind}" Width="160"/><DataGridTextColumn Header="Book" Binding="{Binding AccountingBookId}" Width="*"/><DataGridTextColumn Header="From" Binding="{Binding FromDate}" Width="100"/><DataGridTextColumn Header="To" Binding="{Binding ToDate}" Width="100"/><DataGridTextColumn Header="As of" Binding="{Binding AsOfDate}" Width="100"/><DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc}" Width="160"/><DataGridTextColumn Header="Content hash" Binding="{Binding ContentHash}" Width="2*"/></DataGrid.Columns></DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
