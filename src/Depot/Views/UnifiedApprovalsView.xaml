<UserControl x:Class="Depot.Views.UnifiedApprovalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Depot.Views">
    <Grid>
        <TabControl Style="{StaticResource AppTabControlStyle}">
            <TabItem Header="Purchase Approvals">
                <views:PurchaseOrderApprovalsView DataContext="{Binding}" />
            </TabItem>
            <TabItem x:Name="SalesApprovalsTab" Header="Sales Approvals">
                <ContentControl x:Name="SalesApprovalsHost" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>