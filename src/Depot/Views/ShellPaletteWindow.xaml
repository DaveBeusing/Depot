<Window x:Class="Depot.Views.ShellPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Depot" Width="760" Height="560" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent" AllowsTransparency="True">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="PromptGlyph" Text=">" Foreground="{DynamicResource PrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="4,0,10,0" VerticalAlignment="Center" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Height="36" Padding="10,6" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="13" VerticalContentAlignment="Center" TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                <TextBlock x:Name="ShortcutHint" Grid.Column="2" Margin="12,0,4,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
            </Grid>
            <ListBox x:Name="ResultsList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnResultsDoubleClick">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="8,10,8,5" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,7" /><Setter Property="Margin" Value="0,0,0,2" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource NavigationSelectedBackgroundBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="5" Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Center">
                                <Path Width="14" Height="14" Data="{Binding IconData}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2" Padding="7,3" CornerRadius="5" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="9" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="3" Margin="4,8,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" /><TextBlock Grid.Column="1" Text="↑↓ Navigate   Enter Open   Esc Close" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" /></Grid>
        </Grid>
    </Border>
</Window>