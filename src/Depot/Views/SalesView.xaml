<UserControl x:Class="Depot.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />

        <ScrollViewer Visibility="{Binding IsOverview, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <controls:WorkflowHeader Title="Sales overview" Subtitle="Order-to-cash operations, fulfillment and invoicing" Status="Live" />
                <UniformGrid Columns="3" Margin="0,14,0,0">
                    <controls:Card Margin="0,0,10,10"><StackPanel><TextBlock Text="Open orders" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding OpenOrdersCount, StringFormat={}{0:N0}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Sales orders still in progress" Style="{StaticResource CaptionStyle}"/></StackPanel></controls:Card>
                    <controls:Card Margin="0,0,10,10"><StackPanel><TextBlock Text="Pending approval" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding PendingApprovalCount, StringFormat={}{0:N0}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Orders waiting for a decision" Style="{StaticResource CaptionStyle}"/></StackPanel></controls:Card>
                    <controls:Card Margin="0,0,0,10"><StackPanel><TextBlock Text="Ready to ship" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding ReadyToShipCount, StringFormat={}{0:N0}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Released or partially shipped" Style="{StaticResource CaptionStyle}"/></StackPanel></controls:Card>
                    <controls:Card Margin="0,0,10,10"><StackPanel><TextBlock Text="Draft shipments" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding DraftShipmentCount, StringFormat={}{0:N0}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Prepared but not posted" Style="{StaticResource CaptionStyle}"/></StackPanel></controls:Card>
                    <controls:Card Margin="0,0,10,10"><StackPanel><TextBlock Text="Draft invoices" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding DraftInvoiceCount, StringFormat={}{0:N0}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Invoices waiting to be posted" Style="{StaticResource CaptionStyle}"/></StackPanel></controls:Card>
                    <controls:Card Margin="0,0,0,10"><StackPanel><TextBlock Text="Posted revenue" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding PostedRevenue, StringFormat={}{0:C2}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Net value of posted sales invoices" Style="{StaticResource CaptionStyle}"/></StackPanel></controls:Card>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <controls:MasterDetailGrid Visibility="{Binding IsCustomers, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:MasterDetailGrid.Master>
                <controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:SearchBox Placeholder="Search customers" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerNumber}" Style="{StaticResource CaptionStyle}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewCustomerCommand}" Content="New customer" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid></controls:Card>
            </controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail>
                <controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:WorkflowHeader Title="Customer" Subtitle="Billing, shipping and commercial master data" Status="{Binding CustomerDraft.CustomerNumber}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Name *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding CustomerDraft.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Contact" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding CustomerDraft.ContactName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="2"><TextBlock Text="Email" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding CustomerDraft.Email, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Phone" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding CustomerDraft.Phone, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="4"><TextBlock Text="Billing address" Style="{StaticResource FormLabelStyle}"/><TextBox MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding CustomerDraft.BillingAddress, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Shipping address" Style="{StaticResource FormLabelStyle}"/><TextBox MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding CustomerDraft.ShippingAddress, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="6"><TextBlock Text="Payment terms (days)" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding CustomerDraft.PaymentTermsDays, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="2"><TextBlock Text="Currency" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding CustomerDraft.Currency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </Grid></ScrollViewer>
                    <controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding SaveCustomerCommand}" Content="Save customer" Style="{StaticResource PrimaryButtonStyle}"/></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
                </Grid></controls:Card>
            </controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>

        <controls:MasterDetailGrid Visibility="{Binding IsSalesOrders, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:MasterDetailGrid.Master><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <controls:SearchBox Placeholder="Search sales orders or customers" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerName}" Style="{StaticResource CaptionStyle}"/></StackPanel><controls:DocumentStatusBadge Grid.Column="1" Status="{Binding Status}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewOrderCommand}" Content="New sales order" Style="{StaticResource PrimaryButtonStyle}"/>
            </Grid></controls:Card></controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <controls:WorkflowHeader Title="{Binding OrderTitle}" Subtitle="{Binding OrderDraft.CustomerName, TargetNullValue=Select a customer}" Status="{Binding OrderDraft.Status}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Customer *" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Customers}" SelectedValue="{Binding OrderDraft.CustomerId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Order date" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding OrderDraft.OrderDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Requested delivery" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding OrderDraft.RequestedDeliveryDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel>
                    </Grid>
                    <DataGrid Margin="0,12,0,0" MinHeight="150" ItemsSource="{Binding OrderLines}" SelectedItem="{Binding SelectedOrderLine}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40"/><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="110"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/><DataGridTextColumn Header="Reserved" Binding="{Binding ReservedQuantity}" Width="70"/><DataGridTextColumn Header="Shipped" Binding="{Binding ShippedQuantity}" Width="70"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="90"/></DataGrid.Columns></DataGrid>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="70"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="75"/><ColumnDefinition Width="8"/><ColumnDefinition Width="65"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding PartNumber}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Description}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <controls:TextInput Grid.Column="2" Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                        <controls:TextInput Grid.Column="4" Text="{Binding LineUnitPrice, UpdateSourceTrigger=PropertyChanged}"/>
                        <controls:TextInput Grid.Column="6" Text="{Binding LineDiscountPercent, UpdateSourceTrigger=PropertyChanged}"/>
                        <controls:TextInput Grid.Column="8" Text="{Binding LineTaxRate, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="10" Orientation="Horizontal"><Button Command="{Binding RemoveLineCommand}" Content="Remove" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding AddLineCommand}" Content="Add line" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Available inventory" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Availability}" SelectedItem="{Binding SelectedAvailability}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding WarehouseName}"/><Run Text=" / "/><Run Text="{Binding StorageLocationName}"/><Run Text=" · available "/><Run Text="{Binding AvailableQuantity}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><controls:TextInput Width="90" Text="{Binding ReservationQuantity, UpdateSourceTrigger=PropertyChanged}"/><Button Margin="8,0,0,0" Command="{Binding ReserveCommand}" Content="Reserve" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Reservations" Style="{StaticResource FormLabelStyle}"/><ListBox ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}" MinHeight="70"><ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="Inventory "/><Run Text="{Binding InventoryId}"/><Run Text=" · qty "/><Run Text="{Binding Quantity}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
                    </Grid>
                </StackPanel></ScrollViewer>
                <controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding SaveOrderCommand}" Content="Save draft" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding OrderConfirmationCommand}" Content="Order confirmation PDF" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><StackPanel Orientation="Horizontal"><Button Command="{Binding SubmitCommand}" Content="Submit" Style="{StaticResource PrimaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding ReleaseCommand}" Content="Release" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
            </Grid></controls:Card></controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>

        <controls:Card Visibility="{Binding IsApprovals, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <controls:WorkflowHeader Title="Sales approvals" Subtitle="Review submitted customer orders before allocation and release" Status="{Binding PendingApprovalCount}"/>
            <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding PendingApprovals}" SelectedItem="{Binding SelectedOrder}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="120"/><DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat={}{0:d}}" Width="110"/><DataGridTextColumn Header="Net" Binding="{Binding NetAmount, StringFormat={}{0:C2}}" Width="100"/></DataGrid.Columns></DataGrid>
            <controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><controls:TextInput Width="320" Text="{Binding ApprovalComment, UpdateSourceTrigger=PropertyChanged}"/><Button Margin="8,0,0,0" Command="{Binding RejectCommand}" Content="Reject" Style="{StaticResource DangerButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding ApproveCommand}" Content="Approve" Style="{StaticResource PrimaryButtonStyle}"/></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
        </Grid></controls:Card>

        <controls:MasterDetailGrid Visibility="{Binding IsShipping, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:MasterDetailGrid.Master><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><controls:WorkflowHeader Title="Shipping" Subtitle="Pick reserved stock and post physical goods issue" Status="{Binding DraftShipmentCount}"/><ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Shipments}" SelectedItem="{Binding SelectedShipment}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ShipmentNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding SalesOrderNumber}" Style="{StaticResource CaptionStyle}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></controls:Card></controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:WorkflowHeader Title="{Binding SelectedShipment.ShipmentNumber, TargetNullValue=Create shipment}" Subtitle="{Binding SelectedOrder.OrderNumber, TargetNullValue=Select a released sales order}" Status="{Binding SelectedShipment.Status}"/>
                <StackPanel Grid.Row="1" Margin="0,12,0,0"><ComboBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" Style="{StaticResource AppComboBoxStyle}" DisplayMemberPath="OrderNumber"/><ComboBox Margin="0,8,0,0" ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}" Style="{StaticResource AppComboBoxStyle}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:TextInput Text="{Binding ShipmentQuantity, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="2" Text="{Binding Carrier, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="4" Text="{Binding TrackingNumber, UpdateSourceTrigger=PropertyChanged}"/></Grid><DataGrid Margin="0,12,0,0" ItemsSource="{Binding SelectedShipment.Lines}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="120"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90"/></DataGrid.Columns></DataGrid></StackPanel>
                <controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CreateShipmentCommand}" Content="Create shipment" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding DeliveryNoteCommand}" Content="Delivery note PDF" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding PostShipmentCommand}" Content="Post shipment" Style="{StaticResource PrimaryButtonStyle}"/></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
            </Grid></controls:Card></controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>

        <controls:MasterDetailGrid Visibility="{Binding IsInvoices, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:MasterDetailGrid.Master><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><controls:WorkflowHeader Title="Sales invoices" Subtitle="Shipment-based invoicing and immutable posting" Status="{Binding DraftInvoiceCount}"/><ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding InvoiceNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerName}" Style="{StaticResource CaptionStyle}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></controls:Card></controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:WorkflowHeader Title="{Binding SelectedInvoice.InvoiceNumber, TargetNullValue=Invoice}" Subtitle="{Binding SelectedInvoice.SalesOrderNumber}" Status="{Binding SelectedInvoice.Status}"/>
                <StackPanel Grid.Row="1" Margin="0,12,0,0"><ComboBox ItemsSource="{Binding Shipments}" SelectedItem="{Binding SelectedShipment}" Style="{StaticResource AppComboBoxStyle}" DisplayMemberPath="ShipmentNumber"/><DataGrid Margin="0,12,0,0" ItemsSource="{Binding SelectedInvoice.Lines}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="120"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/><DataGridTextColumn Header="Net" Binding="{Binding NetAmount, StringFormat={}{0:C2}}" Width="100"/><DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat={}{0:C2}}" Width="100"/><DataGridTextColumn Header="Gross" Binding="{Binding GrossAmount, StringFormat={}{0:C2}}" Width="100"/></DataGrid.Columns></DataGrid><TextBlock Margin="0,12,0,0" HorizontalAlignment="Right" Text="{Binding SelectedInvoice.GrossAmount, StringFormat=Gross: {0:C2}}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                <controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CreateInvoiceCommand}" Content="Create from shipment" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding InvoicePdfCommand}" Content="Invoice PDF" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding PostInvoiceCommand}" Content="Post invoice" Style="{StaticResource PrimaryButtonStyle}"/></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
            </Grid></controls:Card></controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>
    </Grid>
</UserControl>
