<Window
	x:Class="Depot.Views.Login.FirstRunAdminWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls"
	Title="Secure Depot setup"
	Icon="/Resources/Images/Depot.ico"
	Style="{StaticResource AppDialogWindowStyle}"
	WindowStartupLocation="CenterScreen"
	ShowInTaskbar="true"
	ResizeMode="NoResize">
	<Border Padding="24" Background="{DynamicResource BackgroundBrush}">
		<controls:Card Width="420">
			<StackPanel>
				<Image Width="64" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16" Source="/Resources/Images/Depot.png" />
				<TextBlock HorizontalAlignment="Center" Text="Create the first administrator" TextAlignment="Center" Style="{StaticResource PageTitleStyle}" />
				<TextBlock Margin="0,4,0,20" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Secure this database with an individual administrator account before continuing." TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStyle}" />

				<TextBlock Text="Display name" Style="{StaticResource FormLabelStyle}" />
				<controls:TextInput x:Name="DisplayNameBox" />

				<TextBlock Margin="0,12,0,4" Text="Email" Style="{StaticResource FormLabelStyle}" />
				<controls:TextInput x:Name="EmailBox" />

				<TextBlock Margin="0,12,0,4" Text="Password" Style="{StaticResource FormLabelStyle}" />
				<controls:PasswordInput x:Name="PasswordBox" Style="{StaticResource RoundedPasswordInputStyle}" PasswordValueChanged="PasswordInput_Changed" />
				<StackPanel Margin="0,7,0,0">
					<TextBlock x:Name="LengthRequirementText" Text="○ 12–128 characters" Style="{StaticResource CaptionStyle}" />
					<TextBlock x:Name="UppercaseRequirementText" Margin="0,2,0,0" Text="○ At least one uppercase letter" Style="{StaticResource CaptionStyle}" />
					<TextBlock x:Name="LowercaseRequirementText" Margin="0,2,0,0" Text="○ At least one lowercase letter" Style="{StaticResource CaptionStyle}" />
					<TextBlock x:Name="DigitRequirementText" Margin="0,2,0,0" Text="○ At least one number" Style="{StaticResource CaptionStyle}" />
					<TextBlock x:Name="SymbolRequirementText" Margin="0,2,0,0" Text="○ At least one symbol" Style="{StaticResource CaptionStyle}" />
					<TextBlock x:Name="AccountNameRequirementText" Margin="0,2,0,0" Text="○ Must not contain the account name" Style="{StaticResource CaptionStyle}" />
				</StackPanel>

				<TextBlock Margin="0,12,0,4" Text="Confirm password" Style="{StaticResource FormLabelStyle}" />
				<controls:PasswordInput x:Name="ConfirmPasswordBox" Style="{StaticResource RoundedPasswordInputStyle}" PasswordValueChanged="PasswordInput_Changed" />
				<TextBlock x:Name="PasswordMatchText" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="○ Re-enter the password to confirm it." TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" />

				<Border Margin="0,12,0,0" Padding="10,8" Background="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorForegroundBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Visibility="Collapsed" x:Name="ErrorPanel">
					<TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorForegroundBrush}" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" />
				</Border>

				<Button x:Name="CreateButton" Margin="0,20,0,0" HorizontalAlignment="Stretch" Content="Create administrator" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="CreateAdministrator_Click" />
			</StackPanel>
		</controls:Card>
	</Border>
</Window>
