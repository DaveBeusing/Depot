<Window
	x:Class="Depot.Views.Login.LoginWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
	xmlns:controls="clr-namespace:Depot.Controls"
	Title="Sign in to Depot"
	Icon="/Resources/Images/Depot.ico"
	Style="{StaticResource AppDialogWindowStyle}"
	WindowStartupLocation="CenterScreen"
	ShowInTaskbar="true">
	<Border Padding="24" Background="{DynamicResource BackgroundBrush}">
		<controls:Card Width="380">
			<StackPanel>
				<Image Width="64" Height="56" HorizontalAlignment="Center" Margin="0,0,0,16" Source="/Resources/Images/Depot.png" />
				<TextBlock HorizontalAlignment="Center" Text="Sign in to Depot" TextAlignment="Center" Style="{StaticResource PageTitleStyle}" />
				<TextBlock Margin="0,4,0,20" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Use your Depot account or an approved organization identity." TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStyle}" />
				<TextBlock x:Name="EmailLabel" Text="Email" Style="{StaticResource FormLabelStyle}" />
				<controls:TextInput automation:AutomationProperties.LabeledBy="{Binding ElementName=EmailLabel}" automation:AutomationProperties.IsRequiredForForm="True" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock x:Name="PasswordLabel" Margin="0,12,0,4" Text="Password" Style="{StaticResource FormLabelStyle}" />
				<controls:PasswordInput automation:AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" automation:AutomationProperties.IsRequiredForForm="True" PasswordValue="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedPasswordInputStyle}" />
				<Button Margin="0,20,0,0" HorizontalAlignment="Stretch" Command="{Binding LoginCommand}" Content="Sign in" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" />

				<StackPanel Margin="0,18,0,0" Visibility="{Binding HasEnterpriseProviders, Converter={StaticResource BooleanToVisibilityConverter}}">
					<Grid Margin="0,0,0,14">
						<Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
						<Border Grid.Column="0" Height="1" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" />
						<TextBlock Grid.Column="1" Margin="10,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="or" Style="{StaticResource CaptionStyle}" />
						<Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" />
					</Grid>
					<TextBlock x:Name="OrganizationProviderLabel" Text="Organization" Style="{StaticResource FormLabelStyle}" />
					<ComboBox Margin="0,4,0,10"
						ItemsSource="{Binding EnterpriseProviders}"
						SelectedItem="{Binding SelectedEnterpriseProvider}"
						DisplayMemberPath="DisplayName"
						Style="{StaticResource AppComboBoxStyle}"
						automation:AutomationProperties.LabeledBy="{Binding ElementName=OrganizationProviderLabel}" />
					<Button HorizontalAlignment="Stretch"
						Command="{Binding EnterpriseLoginCommand}"
						Content="Sign in with organization"
						Style="{StaticResource SecondaryButtonStyle}" />
				</StackPanel>

				<Border Margin="0,12,0,0" Padding="10,8" Background="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorForegroundBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadius.Medium}" Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" automation:AutomationProperties.LiveSetting="Assertive" automation:AutomationProperties.Name="{Binding ErrorMessage}"><TextBlock Foreground="{DynamicResource ErrorForegroundBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" /></Border>
				<controls:OperationStatus Margin="0,12,0,0" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" StatusText="{Binding StatusText}" ErrorText="{Binding OperationError}" />
				<controls:ConnectionStatusIndicator Margin="0,16,0,0" HorizontalAlignment="Center" Compact="True" Foreground="{DynamicResource SecondaryTextBrush}" State="{Binding ConnectionStatus.CompactState}" Status="{Binding ConnectionStatus.DatabaseStatus}" />
			</StackPanel>
		</controls:Card>
	</Border>
</Window>
