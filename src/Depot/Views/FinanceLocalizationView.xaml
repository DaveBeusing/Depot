<UserControl x:Class="Depot.Views.FinanceLocalizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:PageHeader Title="Finance Localization" Subtitle="Effective-dated localization packs, reference capabilities, configuration boundaries and deployment acceptance requirements.">
            <controls:PageHeader.Actions><Button Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"/></controls:PageHeader.Actions>
        </controls:PageHeader>
        <controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}"/>
        <TabControl Grid.Row="2" Style="{StaticResource AppTabControlStyle}">
            <TabItem Header="Effective Profile">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource WorkspaceToolbarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Legal entity" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding LegalEntities}" SelectedItem="{Binding SelectedLegalEntity}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="As of" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding AsOfDate}"/></StackPanel>
                            <Button Grid.Column="2" Margin="12,18,0,0" Command="{Binding LoadProfileCommand}" Content="Resolve profile" Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Margin="4,8" Text="{Binding WarningText}" TextWrapping="Wrap"/>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Effective pack chain" Style="{StaticResource WorkspaceSectionTitleStyle}"/><DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding EffectivePacks}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/><DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="100"/><DataGridTextColumn Header="Country" Binding="{Binding CountryCode}" Width="70"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Border>
                        <Border Grid.Column="2" Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Effective capability / compliance registry" Style="{StaticResource WorkspaceSectionTitleStyle}"/><DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Requirements}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Pack" Binding="{Binding PackCode}" Width="80"/><DataGridTextColumn Header="Requirement" Binding="{Binding RequirementCode}" Width="150"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="Support" Binding="{Binding SupportLevel}" Width="160"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/></DataGrid.Columns></DataGrid></Grid></Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Assignments" IsEnabled="{Binding CanManage}">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Pack" Binding="{Binding PackCode}" Width="100"/><DataGridTextColumn Header="Effective from" Binding="{Binding EffectiveFrom}" Width="120"/><DataGridTextColumn Header="Effective to" Binding="{Binding EffectiveTo}" Width="120"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns></DataGrid>
                    <Border Grid.Column="2" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Localization assignment" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,10,0,0" Text="Legal entity" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding LegalEntities}" SelectedItem="{Binding SelectedLegalEntity}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Root pack" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedAssignmentPack}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Effective from" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding AssignmentFrom}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Effective to" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding AssignmentTo}"/></StackPanel></Grid><controls:AppCheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding AssignmentActive}"/><TextBlock Margin="0,8,0,0" Text="Only one root assignment may be effective for a legal entity at a time. Country packs are validated against the legal-entity country. The country itself never activates a pack automatically." TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"/><WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right"><Button Command="{Binding NewAssignmentCommand}" Content="New" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SaveAssignmentCommand}" Content="Save" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Pack Catalog" IsEnabled="{Binding CanManage}">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedCatalogPack}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="100"/><DataGridTextColumn Header="Country" Binding="{Binding CountryCode}" Width="70"/><DataGridTextColumn Header="Parent" Binding="{Binding ParentPackCode}" Width="90"/><DataGridCheckBoxColumn Header="Built-in" Binding="{Binding IsBuiltIn}" Width="70"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid>
                    <Border Grid.Column="2" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Pack definition" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,10,0,0" Text="Code" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PackCode}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PackName}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Layer" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding PackLayer}" Style="{StaticResource AppComboBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Country code (country layer only)" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PackCountryCode}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Parent pack code" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PackParentCode}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Description" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PackDescription}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" Style="{StaticResource AppTextBoxStyle}"/><controls:AppCheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding PackActive}"/><TextBlock Margin="0,8,0,0" Text="GENERIC, EU and DE are immutable built-in definitions. New regional/country packs can be added without a schema change." TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"/><WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right"><Button Command="{Binding NewPackCommand}" Content="New custom pack" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SavePackCommand}" Content="Save" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Registry" IsEnabled="{Binding CanManage}">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding RegistryEntries}" SelectedItem="{Binding SelectedRegistryEntry}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Pack" Binding="{Binding PackCode}" Width="80"/><DataGridTextColumn Header="Requirement" Binding="{Binding RequirementCode}" Width="150"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/><DataGridTextColumn Header="Support" Binding="{Binding SupportLevel}" Width="160"/><DataGridTextColumn Header="From" Binding="{Binding EffectiveFrom}" Width="100"/><DataGridTextColumn Header="To" Binding="{Binding EffectiveTo}" Width="100"/><DataGridCheckBoxColumn Header="Built-in" Binding="{Binding IsBuiltIn}" Width="70"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid>
                    <Border Grid.Column="2" Style="{StaticResource WorkspaceSectionStyle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Effective registry entry" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,10,0,0" Text="Pack" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Packs}" SelectedItem="{Binding SelectedRegistryPack}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Requirement code" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding RequirementCode}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Category" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding RequirementCategories}" SelectedItem="{Binding RegistryCategory}" Style="{StaticResource AppComboBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Support level" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding SupportLevels}" SelectedItem="{Binding RegistrySupportLevel}" Style="{StaticResource AppComboBoxStyle}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Effective from" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding RegistryFrom}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Effective to" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding RegistryTo}"/></StackPanel></Grid><TextBlock Margin="0,8,0,0" Text="Title" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding RegistryTitle}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Description" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding RegistryDescription}" TextWrapping="Wrap" AcceptsReturn="True" Height="90" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Reference" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding RegistryReference}" Style="{StaticResource AppTextBoxStyle}"/><controls:AppCheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding RegistryActive}"/><TextBlock Margin="0,8,0,0" Text="Support levels distinguish software capability, required configuration, external procedure and reference-only information. They are not compliance status flags." TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"/><WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right"><Button Command="{Binding NewRegistryEntryCommand}" Content="New" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SaveRegistryEntryCommand}" Content="Save" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel></ScrollViewer></Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>