<UserControl x:Class="Depot.Views.SalesQuotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:PageHeader Title="Sales quotes" Subtitle="Prepare customer quotes with scoped pricing and convert accepted offers into sales orders." />
        <controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
        <controls:MasterDetailGrid Grid.Row="2" Margin="0,12,0,0">
            <controls:MasterDetailGrid.Master>
                <Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:SearchBox Placeholder="Search quotes or customers" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Quotes}" SelectedItem="{Binding SelectedQuote}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding QuoteNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerName}" Style="{StaticResource CaptionStyle}"/></StackPanel><controls:DocumentStatusBadge Grid.Column="1" Status="{Binding Status}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewQuoteCommand}" Content="New quote" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid></Border>
            </controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail>
                <Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:WorkflowHeader Title="{Binding Title}" Subtitle="Quote, customer pricing and conversion to sales order" Status="{Binding Draft.Status}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Customer" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Quote date" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding Draft.QuoteDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Valid until" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding Draft.ValidUntil}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel></Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Contact" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Customer reference" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Draft.CustomerReference, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                        <DataGrid Margin="0,12,0,0" MinHeight="150" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="110"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Unit" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Discount %" Binding="{Binding DiscountPercent}" Width="80" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Price source" Binding="{Binding PriceSourceDisplay}" Width="170"/><DataGridTextColumn Header="Gross" Binding="{Binding GrossAmount, StringFormat={}{0:C2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns></DataGrid>
                        <Border Margin="0,10,0,0" Style="{StaticResource WorkspaceToolbarBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="70"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="75"/><ColumnDefinition Width="8"/><ColumnDefinition Width="65"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding PartNumber}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Description}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><controls:TextInput Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="4" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="6" Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="8" Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}"/><StackPanel Grid.Column="10" Orientation="Horizontal"><Button Command="{Binding RemoveLineCommand}" Content="Remove" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding AddLineCommand}" Content="Add line" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></Grid></Border>
                        <TextBlock Margin="0,12,0,0" Text="{Binding Draft.BillingAddress}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/><TextBlock Margin="0,4,0,0" Text="{Binding Draft.ShippingAddress}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                    </StackPanel></ScrollViewer>
                    <controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding SaveQuoteCommand}" Content="Save draft" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding QuotePdfCommand}" Content="Quote PDF" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Click="OnEmailQuoteClick" Content="Email quote" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding RejectQuoteCommand}" Content="Reject" Style="{StaticResource DangerButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><StackPanel Orientation="Horizontal"><Button Command="{Binding SendQuoteCommand}" Content="Mark sent" Style="{StaticResource PrimaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding AcceptQuoteCommand}" Content="Accept" Style="{StaticResource PrimaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding ConvertQuoteCommand}" Content="Convert to order" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
                </Grid></Border>
            </controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>
    </Grid>
</UserControl>
