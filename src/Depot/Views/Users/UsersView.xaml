<UserControl x:Class="Depot.Views.Users.UsersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" xmlns:controls="clr-namespace:Depot.Controls">
	<UserControl.Resources>
		<Style x:Key="PasswordRequirementTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
			<Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
			<Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" /></DataTrigger></Style.Triggers>
		</Style>
		<Style x:Key="PasswordValidationPanelStyle" TargetType="StackPanel">
			<Setter Property="Visibility" Value="Collapsed" />
			<Style.Triggers><DataTrigger Binding="{Binding Editor.PasswordValidationRequired}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
		</Style>
	</UserControl.Resources>
	<UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding NewUserCommand}" /></UserControl.InputBindings>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:PageHeader Title="Users" Subtitle="Maintain identities, activation state, and role assignments." />
		<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
		<controls:MasterDetailGrid Grid.Row="3">
			<controls:MasterDetailGrid.Master><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<controls:FilterBar><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><controls:SearchBox automation:AutomationProperties.Name="Search users" Placeholder="Search name or email" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox Grid.Row="2" automation:AutomationProperties.Name="User status filter" ItemsSource="{Binding ActivationFilters}" SelectedItem="{Binding SelectedActivationFilter}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" /></Grid></controls:FilterBar>
				<Grid Grid.Row="1"><ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /><TextBlock Margin="0,2,0,0" Text="{Binding Email}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Email}" Style="{StaticResource CaptionStyle}" /><TextBlock Margin="0,2,0,0" Text="{Binding Roles}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Roles}" Style="{StaticResource CaptionStyle}" /></StackPanel><controls:ActivationStatusBadge Grid.Column="1" IsActive="{Binding IsActive}" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><controls:WorkflowListState ItemCount="{Binding Users.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" /></Grid>
				<controls:PaginationControl Grid.Row="2" Margin="0,12,0,0" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageNumber, StringFormat=Page {0}}" />
				<Button Grid.Row="4" Command="{Binding NewUserCommand}" Content="New user" Style="{StaticResource PrimaryButtonStyle}" />
			</Grid></Border></controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<controls:WorkflowHeader Title="{Binding Editor.EditorTitle}" Subtitle="Identity and access configuration" Status="{Binding EditorStatus}" />
				<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0">
					<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Email *" Style="{StaticResource FormLabelStyle}" /><TextBox controls:FocusRequest.RequestId="{Binding EditorFocusRequest}" automation:AutomationProperties.Name="Email" MaxLength="320" Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Display name *" Style="{StaticResource FormLabelStyle}" /><TextBox automation:AutomationProperties.Name="Display name" MaxLength="200" Text="{Binding Editor.DisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBoxStyle}" /></StackPanel></Grid>
					<StackPanel Margin="0,16,0,0"><TextBlock Text="Password" Style="{StaticResource FormLabelStyle}" /><controls:PasswordInput automation:AutomationProperties.Name="Password" PasswordValue="{Binding Editor.Password, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,6,0,0" Text="{Binding Editor.PasswordHint}" Style="{StaticResource HintStyle}" />
						<StackPanel Margin="0,7,0,0" Style="{StaticResource PasswordValidationPanelStyle}">
							<TextBlock Tag="{Binding Editor.PasswordHasValidLength}" Text="12–128 characters" Style="{StaticResource PasswordRequirementTextStyle}" />
							<TextBlock Margin="0,2,0,0" Tag="{Binding Editor.PasswordHasUppercase}" Text="At least one uppercase letter" Style="{StaticResource PasswordRequirementTextStyle}" />
							<TextBlock Margin="0,2,0,0" Tag="{Binding Editor.PasswordHasLowercase}" Text="At least one lowercase letter" Style="{StaticResource PasswordRequirementTextStyle}" />
							<TextBlock Margin="0,2,0,0" Tag="{Binding Editor.PasswordHasDigit}" Text="At least one number" Style="{StaticResource PasswordRequirementTextStyle}" />
							<TextBlock Margin="0,2,0,0" Tag="{Binding Editor.PasswordHasSymbol}" Text="At least one symbol" Style="{StaticResource PasswordRequirementTextStyle}" />
							<TextBlock Margin="0,2,0,0" Tag="{Binding Editor.PasswordExcludesAccountName}" Text="Must not contain the account name" Style="{StaticResource PasswordRequirementTextStyle}" />
						</StackPanel>
					</StackPanel>
					<StackPanel Margin="0,12,0,0"><TextBlock Text="Confirm password" Style="{StaticResource FormLabelStyle}" /><controls:PasswordInput automation:AutomationProperties.Name="Confirm password" PasswordValue="{Binding Editor.ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,6,0,0" Tag="{Binding Editor.PasswordConfirmationMatches}" Text="Passwords must match"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PasswordRequirementTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Editor.PasswordValidationRequired}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Editor.PasswordConfirmationMatches}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
					<Separator Margin="0,24,0,20" />
					<TextBlock Text="Security" Style="{StaticResource WorkspaceSectionTitleStyle}" /><TextBlock Margin="0,4,0,12" Text="Role assignments change the user's effective permissions. This action is audited." TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" />
					<ItemsControl ItemsSource="{Binding Editor.Roles}"><ItemsControl.ItemTemplate><DataTemplate><controls:AppCheckBox Margin="0,4,0,0" Content="{Binding Name}" IsChecked="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
					<TextBlock Margin="0,16,0,0" Text="Effective permissions" Style="{StaticResource FormLabelStyle}" /><TextBox MinHeight="72" IsReadOnly="True" Text="{Binding Editor.EffectivePermissions}" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" />
				</StackPanel></ScrollViewer>
				<controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding NewUserCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding ToggleActiveCommand}" Content="{Binding Editor.ActivationButtonText}" Style="{StaticResource DangerButtonStyle}" /></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button IsDefault="True" Command="{Binding SaveUserCommand}" Content="Save user" Style="{StaticResource PrimaryButtonStyle}" /></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
			</Grid></Border></controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>
