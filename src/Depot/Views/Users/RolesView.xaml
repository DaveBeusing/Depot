<UserControl x:Class="Depot.Views.Users.RolesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls">
	<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<controls:PageHeader Title="Roles" Subtitle="Manage reusable permission sets and protected system roles." />
		<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
		<controls:MasterDetailGrid Grid.Row="3">
			<controls:MasterDetailGrid.Master><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:FilterBar><controls:SearchBox Placeholder="Search roles" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /></controls:FilterBar><ListBox Grid.Row="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Style="{StaticResource AppListBoxStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,2,0,0" Text="{Binding Code}" Style="{StaticResource CaptionStyle}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="3" Command="{Binding NewCommand}" Content="New role" Style="{StaticResource PrimaryButtonStyle}"/></Grid></Border></controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:WorkflowHeader Title="{Binding EditorTitle}" Subtitle="Permission assignments and role identity" /><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0"><Grid IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Code" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding Code}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding Name}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel></Grid><StackPanel Margin="0,12,0,0" IsEnabled="{Binding CanEdit}"><TextBlock Text="Description" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding Description}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><Separator Margin="0,16,0,12"/><TextBlock Text="Permissions" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,3,0,8" Text="Permissions assigned to this role become effective for every user with the role." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/><ItemsControl IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Permissions}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="0,4,0,0" Content="{Binding Name}" IsChecked="{Binding IsSelected}" Style="{StaticResource AppCheckBoxStyle}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer><controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding NewCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding ToggleActiveCommand}" Content="{Binding ActivationButtonText}" Style="{StaticResource DangerButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding SaveCommand}" Content="Save role" Style="{StaticResource PrimaryButtonStyle}"/></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar></Grid></Border></controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>