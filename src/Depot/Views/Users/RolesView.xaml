<UserControl
	x:Class="Depot.Views.Users.RolesView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:PageHeader Title="Roles" Subtitle="Manage reusable permission sets and protected system roles.">
			<controls:PageHeader.Actions><controls:OperationStatus ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" /></controls:PageHeader.Actions>
		</controls:PageHeader>
		<controls:SearchBox Grid.Row="1" Margin="{StaticResource Search.Margin}" Placeholder="Search roles" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
			<ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Style="{StaticResource AppListBoxStyle}">
				<ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Code}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
			</ListBox>
			<controls:Card Grid.Column="2">
				<Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleStyle}" />
					<StackPanel Grid.Row="1" Margin="0,16,0,0" IsEnabled="{Binding CanEdit}"><TextBlock Text="Code" Style="{StaticResource FormLabelStyle}" /><TextBox Text="{Binding Code}" Style="{StaticResource AppTextBoxStyle}" /></StackPanel>
					<StackPanel Grid.Row="2" Margin="0,12,0,0" IsEnabled="{Binding CanEdit}"><TextBlock Text="Name" Style="{StaticResource FormLabelStyle}" /><TextBox Text="{Binding Name}" Style="{StaticResource AppTextBoxStyle}" /></StackPanel>
					<StackPanel Grid.Row="3" Margin="0,12,0,0" IsEnabled="{Binding CanEdit}"><TextBlock Text="Description" Style="{StaticResource FormLabelStyle}" /><TextBox Text="{Binding Description}" Style="{StaticResource AppTextBoxStyle}" /></StackPanel>
					<ScrollViewer Grid.Row="4" Margin="0,16,0,0" IsEnabled="{Binding CanEdit}" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Permissions}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="0,4,0,0" Content="{Binding Name}" IsChecked="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
					<StackPanel Grid.Row="5" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button Command="{Binding NewCommand}" Content="New" Style="{StaticResource SecondaryButtonStyle}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding SaveCommand}" Content="Save" Style="{StaticResource PrimaryButtonStyle}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding ToggleActiveCommand}" Content="{Binding ActivationButtonText}" Style="{StaticResource DangerButtonStyle}" /></StackPanel>
				</Grid>
			</controls:Card>
		</Grid>
	</Grid>
</UserControl>
