<UserControl x:Class="Depot.Views.SalesCommercialHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls"
             xmlns:views="clr-namespace:Depot.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:PageHeader
            Title="Sales Commercial Hub"
            Subtitle="Monitor sales execution, prepare quotes, and manage customer pricing from one workspace." />
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedCommercialTab}" Style="{StaticResource AppTabControlStyle}">
            <TabItem Header="Overview">
                <views:SalesView DataContext="{Binding Workspace}"/>
            </TabItem>
            <TabItem Header="Quotes" Visibility="{Binding CanViewQuotes, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:SalesQuotesView DataContext="{Binding Quotes}"/>
            </TabItem>
            <TabItem Header="Pricing" Visibility="{Binding CanViewPricing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:SalesPricingView DataContext="{Binding Pricing}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
