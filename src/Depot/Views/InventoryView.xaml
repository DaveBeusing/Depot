<UserControl x:Class="Depot.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:OperationPanel
            IsBusy="{Binding IsBusy}"
            HasError="{Binding HasOperationError}"
            StatusText="{Binding StatusText}"
            ErrorText="{Binding OperationError}" />

        <controls:MasterDetailGrid Grid.Row="1">
            <controls:MasterDetailGrid.Master>
                <controls:Card>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:FilterBar>
                            <controls:SearchBox
                                Placeholder="Search inventory"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Search by item, purpose, warehouse, or storage location" />
                        </controls:FilterBar>

                        <Grid Grid.Row="1">
                            <DataGrid
                                ItemsSource="{Binding Items}"
                                SelectedItem="{Binding SelectedItem}"
                                Style="{StaticResource AppDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Part number" Binding="{Binding PartNumber}" Width="120" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                    <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock, StringFormat={}{0:N2}}" Width="82" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <controls:EmptyState
                                Title="No inventory positions yet"
                                Description="Inventory positions are created when stock is received, issued, returned, transferred, or otherwise moved into a storage location."
                                Visibility="{Binding HasNoItems, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <controls:PaginationControl
                            Grid.Row="2"
                            Margin="0,10,0,0"
                            PreviousCommand="{Binding PreviousPageCommand}"
                            NextCommand="{Binding NextPageCommand}"
                            PageText="{Binding PageNumber, StringFormat=Page {0}}" />
                    </Grid>
                </controls:Card>
            </controls:MasterDetailGrid.Master>

            <controls:MasterDetailGrid.Detail>
                <controls:Card>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <controls:WorkflowHeader
                            Title="Inventory details"
                            Subtitle="Stock is calculated from immutable movements." />

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <controls:EmptyState
                                Title="Select an inventory row"
                                Description="Item, storage, valuation, and recent movements will appear here."
                                Visibility="{Binding HasNoSelectedItem, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <ScrollViewer
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding HasSelectedItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Part number" Style="{StaticResource FormLabelStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Details.PartNumber}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="2" Text="Description" Style="{StaticResource FormLabelStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details.Description}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="4" Text="Purpose" Style="{StaticResource FormLabelStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Details.PurposeName}" />
                                        <TextBlock Grid.Row="6" Text="Storage" Style="{StaticResource FormLabelStyle}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Details.StorageDisplay}" />
                                    </Grid>

                                    <UniformGrid Columns="3" Margin="0,16,0,0">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Current stock" Style="{StaticResource FormLabelStyle}" />
                                            <TextBlock Text="{Binding Details.CurrentStock, StringFormat={}{0:N2}}" FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Average cost" Style="{StaticResource FormLabelStyle}" />
                                            <TextBlock Text="{Binding Details.AverageCost, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Inventory value" Style="{StaticResource FormLabelStyle}" />
                                            <TextBlock Text="{Binding Details.InventoryValue, StringFormat={}{0:C2}}" FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="Recent movements" Style="{StaticResource WorkspaceTitleStyle}" Margin="0,18,0,8" />
                                    <Grid MinHeight="180">
                                        <DataGrid
                                            ItemsSource="{Binding Details.RecentMovements}"
                                            Style="{StaticResource AppDataGridStyle}"
                                            Visibility="{Binding Details.HasRecentMovements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                                <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="110" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                                <DataGridTextColumn Header="Reason" Binding="{Binding ReasonCodeName}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
                                                <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <controls:EmptyState
                                            Title="No movements recorded"
                                            Description="Recent activity for this inventory will appear here."
                                            Visibility="{Binding Details.HasNoRecentMovements, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </controls:Card>
            </controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>
    </Grid>
</UserControl>
