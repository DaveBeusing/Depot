<UserControl x:Class="Depot.Views.InventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:PageHeader Title="Inventory" Subtitle="Review stock, valuation, and activity by physical storage location." />
		<controls:OperationPanel Grid.Row="1" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" StatusText="{Binding StatusText}" ErrorText="{Binding OperationError}" />
		<controls:MasterDetailGrid Grid.Row="2">
			<controls:MasterDetailGrid.Master>
				<controls:Card><Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<controls:FilterBar><controls:SearchBox Placeholder="Search inventory" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by item, purpose, warehouse, or storage location" /></controls:FilterBar>
					<Grid Grid.Row="1">
						<DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource AppDataGridStyle}" Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
							<DataGrid.Columns>
								<DataGridTextColumn Header="Part number" Binding="{Binding PartNumber}" Width="120" ElementStyle="{StaticResource AppDataGridTextStyle}" />
								<DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
								<DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock, StringFormat={}{0:N2}}" Width="82" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
							</DataGrid.Columns>
						</DataGrid>
						<controls:WorkflowListState ItemCount="{Binding Items.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" />
					</Grid>
					<controls:PaginationControl Grid.Row="2" Margin="0,12,0,0" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageNumber, StringFormat=Page {0}}" />
				</Grid></controls:Card>
			</controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail>
				<controls:Card><Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
					<controls:WorkflowHeader Title="Inventory details" Subtitle="Stock is calculated from immutable movements." />
					<Grid Grid.Row="1">
						<controls:EmptyState Title="Select an inventory row" Description="Item, storage, valuation, and recent movements will appear here." Visibility="{Binding HasNoSelectedItem, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<Grid Visibility="{Binding HasSelectedItem, Converter={StaticResource BooleanToVisibilityConverter}}">
							<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
								<TextBlock Text="Part number" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Column="1" Text="{Binding Details.PartNumber}" FontWeight="SemiBold" />
								<TextBlock Grid.Row="2" Text="Description" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details.Description}" TextWrapping="Wrap" />
								<TextBlock Grid.Row="4" Text="Purpose" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Details.PurposeName}" />
								<TextBlock Grid.Row="6" Text="Storage" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="6" Grid.Column="1"><Run Text="{Binding Details.WarehouseName, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Details.LocationName, Mode=OneWay}" /></TextBlock>
							</Grid>
							<Grid Grid.Row="2">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<controls:MetricCard Title="Current stock" Value="{Binding Details.CurrentStock, StringFormat={}{0:N2}}" />
								<controls:MetricCard Grid.Column="2" Title="Average cost" Value="{Binding Details.AverageCost, StringFormat={}{0:C2}}" />
								<controls:MetricCard Grid.Column="4" Title="Inventory value" Value="{Binding Details.InventoryValue, StringFormat={}{0:C2}}" />
							</Grid>
							<Grid Grid.Row="4">
								<DataGrid ItemsSource="{Binding Details.RecentMovements}" Style="{StaticResource AppDataGridStyle}" Visibility="{Binding Details.HasRecentMovements, Converter={StaticResource BooleanToVisibilityConverter}}">
									<DataGrid.Columns>
										<DataGridTextColumn Header="Date" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}" />
										<DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="110" ElementStyle="{StaticResource AppDataGridTextStyle}" />
										<DataGridTextColumn Header="Reason" Binding="{Binding ReasonCodeName}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
										<DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
										<DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
									</DataGrid.Columns>
								</DataGrid>
								<controls:EmptyState Title="No movements recorded" Description="Recent activity for this inventory will appear here." Visibility="{Binding Details.HasNoRecentMovements, Converter={StaticResource BooleanToVisibilityConverter}}" />
							</Grid>
						</Grid>
					</Grid>
				</Grid></controls:Card>
			</controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>
