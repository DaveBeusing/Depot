<UserControl x:Class="Depot.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions><controls:PageHeader Title="Reports" Subtitle="Analyze inventory value and stock distribution, then export the current result."><controls:PageHeader.Actions><StackPanel Orientation="Horizontal"><TextBlock MaxWidth="360" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource SuccessForegroundBrush}" Text="{Binding ExportStatusText}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasExportSuccessStatus, Converter={StaticResource BooleanToVisibilityConverter}}" /><TextBlock MaxWidth="360" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource ErrorForegroundBrush}" Text="{Binding ExportStatusText}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasExportErrorStatus, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Command="{Binding ExportCommand}" Content="Export" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></controls:PageHeader.Actions></controls:PageHeader><controls:FilterBar Grid.Row="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding ReportOptions}" SelectedItem="{Binding SelectedReport, Mode=TwoWay}" Style="{StaticResource AppComboBoxStyle}" ToolTip="Select report" /><controls:SearchBox Grid.Column="2" Placeholder="Search report" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SearchToolTip}" /></Grid></controls:FilterBar><StackPanel Grid.Row="2"><controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:MetricCard Title="Inventory Rows" Value="{Binding TotalInventoryRows}" SupportingText="Rows in result" /><controls:MetricCard Grid.Column="2" Title="Items" Value="{Binding TotalItems}" SupportingText="Distinct catalog items" /><controls:MetricCard Grid.Column="4" Title="Total Stock" Value="{Binding TotalStockQuantity}" SupportingText="Units represented" /><controls:MetricCard Grid.Column="6" Title="Inventory Value" Value="{Binding TotalInventoryValue}" ValueStringFormat="{}{0:C2}" SupportingText="Current valuation" /></Grid></StackPanel><Border Grid.Row="4" Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{Binding ReportTitle}" Style="{StaticResource SectionTitleStyle}" /><Grid Grid.Row="2"><DataGrid ItemsSource="{Binding InventoryValueItems}" Style="{StaticResource AppDataGridCompactStyle}" Visibility="{Binding ShowInventoryValueRows, Converter={StaticResource BooleanToVisibilityConverter}}"><DataGrid.Columns><DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="140" /><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Purpose" Binding="{Binding PurposeName}" Width="110" /><DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="110" /><DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="110" /><DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock, StringFormat={}{0:N2}}" Width="80" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridTextColumn Header="Avg Cost" Binding="{Binding AverageCost, StringFormat={}{0:C2}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridTextColumn Header="Value" Binding="{Binding InventoryValue, StringFormat={}{0:C2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /></DataGrid.Columns></DataGrid><DataGrid ItemsSource="{Binding GroupedItems}" Style="{StaticResource AppDataGridCompactStyle}" Visibility="{Binding ShowGroupedRows, Converter={StaticResource BooleanToVisibilityConverter}}"><DataGrid.Columns><DataGridTextColumn Header="Group" Binding="{Binding GroupName}" Width="*" /><DataGridTextColumn Header="Inventory Rows" Binding="{Binding InventoryRows, StringFormat={}{0:N0}}" Width="130" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridTextColumn Header="Items" Binding="{Binding TotalItems, StringFormat={}{0:N0}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridTextColumn Header="Total Stock" Binding="{Binding TotalStockQuantity, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridTextColumn Header="Inventory Value" Binding="{Binding InventoryValue, StringFormat={}{0:C2}}" Width="140" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /></DataGrid.Columns></DataGrid><controls:EmptyState Title="No report data" Description="{Binding EmptyReportMessage}" Visibility="{Binding HasNoReportRows, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid><controls:PaginationControl Grid.Row="3" Margin="0,10,0,0" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}" Visibility="{Binding ShowPaging, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid></Border></Grid></UserControl>