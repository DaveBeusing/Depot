<UserControl x:Class="Depot.Views.SalesPricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:PageHeader Title="Sales pricing" Subtitle="Manage scoped price lists, item pricing, regional fallback and bulk price generation." />
        <controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
        <controls:MasterDetailGrid Grid.Row="2" Margin="0,12,0,0">
            <controls:MasterDetailGrid.Master>
                <Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Price lists" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding PriceLists}" SelectedItem="{Binding SelectedPriceList}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{Binding Code}"/><Run Text=" · "/><Run Text="{Binding Scope}"/><Run Text=" · "/><Run Text="{Binding Currency}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewPriceListCommand}" Content="New price list" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid></Border>
            </controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Border Style="{StaticResource WorkspaceSectionStyle}"><StackPanel>
                        <controls:WorkflowHeader Title="{Binding Draft.Name, TargetNullValue=Price list}" Subtitle="Customer, regional and global item-level pricing" Status="{Binding Draft.IsActive}"/>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Code" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Draft.Code, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Currency" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Draft.Currency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Scope" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="2" Visibility="{Binding IsRegionScope, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Region *" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedPriceListRegion}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel></Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding Draft.ValidFrom}" Style="{StaticResource AppDatePickerStyle}"/><DatePicker Grid.Column="2" SelectedDate="{Binding Draft.ValidTo}" Style="{StaticResource AppDatePickerStyle}"/><controls:AppCheckBox Grid.Column="4" VerticalAlignment="Center" Content="Active" IsChecked="{Binding Draft.IsActive}"/></Grid>
                        <Button Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding SavePriceListCommand}" Content="Save price list" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel></Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Items and pricing" Style="{StaticResource WorkspaceSectionTitleStyle}"/><DataGrid Margin="0,10,0,0" ItemsSource="{Binding PriceItems}" SelectedItem="{Binding SelectedPriceItem}" Style="{StaticResource AppDataGridCompactStyle}" MaxHeight="220"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="120"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Discount %" Binding="{Binding DiscountPercent}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns></DataGrid><Border Margin="0,10,0,0" Style="{StaticResource WorkspaceToolbarBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="PartNumber" Style="{StaticResource AppComboBoxStyle}"/><controls:TextInput Grid.Column="2" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="4" Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="6" Command="{Binding SavePriceItemCommand}" Content="Set price" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="8" Command="{Binding DeletePriceItemCommand}" Content="Remove selected price" Style="{StaticResource SecondaryButtonStyle}"/></Grid></Border></StackPanel></Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel>
                        <TextBlock Text="Bulk price generation" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                        <TextBlock Margin="0,4,0,10" Text="Prices are derived from calculated item cost plus Percentage Markup. Markup is not Gross Margin. A preview is mandatory before any price-list write." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Item filter" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BulkFilterTypes}" SelectedItem="{Binding BulkFilterType}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding IsBulkCategoryFilter, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Category" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BulkCategories}" SelectedItem="{Binding BulkCategory}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding IsBulkManufacturerFilter, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Manufacturer" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BulkManufacturers}" SelectedItem="{Binding BulkManufacturer}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Markup %" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding BulkMarkupPercentage, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="Apply mode" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BulkApplyModes}" SelectedItem="{Binding BulkApplyMode}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                        </Grid>
                        <Border Margin="0,10,0,0" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Visibility="{Binding IsBulkSelectedItemsFilter, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Selected items" Style="{StaticResource FormLabelStyle}"/><ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding BulkItemSelections}"><ItemsControl.ItemTemplate><DataTemplate><controls:AppCheckBox Margin="0,3" IsChecked="{Binding IsSelected}"><TextBlock><Run Text="{Binding PartNumber}"/><Run Text=" · "/><Run Text="{Binding Description}"/></TextBlock></controls:AppCheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Command="{Binding CalculateBulkPreviewCommand}" Content="Calculate preview" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding ApplyBulkPricesCommand}" Content="Apply preview" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
                        <TextBlock Margin="0,10,0,4" Text="{Binding BulkPreviewSummary}" FontWeight="SemiBold"/>
                        <DataGrid ItemsSource="{Binding BulkPreviewRows}" SelectedItem="{Binding SelectedBulkPreviewRow}" Style="{StaticResource AppDataGridCompactStyle}" MaxHeight="260"><DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="105"/><DataGridTextColumn Header="Calculated cost" Binding="{Binding CalculatedCost, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Current" Binding="{Binding CurrentPrice, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Markup %" Binding="{Binding MarkupPercentage, StringFormat={}{0:N2}}" Width="80" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="New price" Binding="{Binding CalculatedNewPrice, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Change" Binding="{Binding AbsoluteChange, StringFormat={}{0:N2}}" Width="85" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Change %" Binding="{Binding PercentageChange, StringFormat={}{0:N2}}" Width="80" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="75"/><DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                        </DataGrid.Columns></DataGrid>
                        <TextBlock Margin="0,10,0,4" Text="Selected item cost evidence" Style="{StaticResource FormLabelStyle}"/>
                        <DataGrid ItemsSource="{Binding SelectedBulkPreviewRow.CostComponents}" Style="{StaticResource AppDataGridCompactStyle}" MaxHeight="150"><DataGrid.Columns><DataGridTextColumn Header="Seq" Binding="{Binding Sequence}" Width="50" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding CalculationType}" Width="90"/><DataGridTextColumn Header="Base" Binding="{Binding CalculationBase}" Width="105"/><DataGridTextColumn Header="Configured" Binding="{Binding ConfiguredValue, StringFormat={}{0:N4}}" Width="85" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Basis amount" Binding="{Binding CalculationBasisAmount, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Applied" Binding="{Binding AppliedAmount, StringFormat={}{0:N2}}" Width="85" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Running total" Binding="{Binding RunningTotal, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns></DataGrid>
                    </StackPanel></Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Sales regions" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,4,0,10" Text="Regions group customers for regional default pricing. Customers may remain without a region." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegionDefinition}" DisplayMemberPath="Name" MinHeight="80"/><StackPanel Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Code" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding RegionDraft.Code, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding RegionDraft.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><controls:AppCheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding RegionDraft.IsActive}"/><StackPanel Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button Command="{Binding NewRegionCommand}" Content="New region" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SaveRegionCommand}" Content="Save region" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></StackPanel></Grid></StackPanel></Border>
                    <Border Margin="0,12,0,0" Style="{StaticResource WorkspaceSectionStyle}" Visibility="{Binding IsCustomerScope, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Optional customer-specific pricing" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,4,0,6" Text="New customer lists start inactive. Assign at least one customer, then activate the list; or use automatic Region → Global fallback." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/><TextBlock Margin="0,0,0,10" Text="{Binding CustomerPricingStatus}" FontWeight="SemiBold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/><Button Grid.Column="2" Command="{Binding AssignCustomerCommand}" Content="Use selected list" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="4" Command="{Binding ClearCustomerAssignmentCommand}" Content="Use automatic pricing" Style="{StaticResource SecondaryButtonStyle}"/></Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>
    </Grid>
</UserControl>