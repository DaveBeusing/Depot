<UserControl x:Class="Depot.Views.SalesPricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:PageHeader Title="Sales pricing" Subtitle="Manage scoped price lists, commercial price calculation, FX evidence and bulk generation." />
        <controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
        <TabControl Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource AppTabControlStyle}">
            <TabItem Header="Strategy designer">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource WorkspaceSectionStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Pricing hierarchy" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                            <TextBlock Grid.Row="1" Margin="0,4,0,10" Text="{Binding PricingStrategySummary}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding PricingStrategyRows}"
                                     SelectedItem="{Binding SelectedPricingStrategyRow}"
                                     Style="{StaticResource AppListBoxStyle}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="{Binding Indent}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Kind}"/><Run Text=" · "/><Run Text="{Binding State}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource WorkspaceSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="Resolution cascade" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                            <TextBlock Margin="0,4,0,14" Text="Depot resolves the most specific valid price first. The visual hierarchy is a projection of the existing pricing model and does not create alternate fallback rules." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Padding="12" Style="{StaticResource WorkspaceToolbarBorderStyle}">
                                    <StackPanel><TextBlock Text="GLOBAL" FontWeight="Bold"/><TextBlock Margin="0,4,0,0" Text="Default item price" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
                                </Border>
                                <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                <Border Grid.Column="2" Padding="12" Style="{StaticResource WorkspaceToolbarBorderStyle}">
                                    <StackPanel><TextBlock Text="REGION" FontWeight="Bold"/><TextBlock Margin="0,4,0,0" Text="Regional override" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
                                </Border>
                                <TextBlock Grid.Column="3" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                <Border Grid.Column="4" Padding="12" Style="{StaticResource WorkspaceToolbarBorderStyle}">
                                    <StackPanel><TextBlock Text="CUSTOMER" FontWeight="Bold"/><TextBlock Margin="0,4,0,0" Text="Explicit assignment" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
                                </Border>
                            </Grid>
                            <Border Margin="0,16,0,0" Padding="12" Style="{StaticResource WorkspaceToolbarBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Selected strategy node" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding PricingStrategySelectionTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,3,0,0" Text="{Binding PricingStrategySelectionSubtitle}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource WorkspaceSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="Inspector" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                            <TextBlock Margin="0,4,0,12" Text="{Binding PricingStrategySelectionIdentity}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock Margin="0,4,0,10" Text="{Binding SelectedPricingStrategyRow.Title, TargetNullValue=—}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Context" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock Margin="0,4,0,10" Text="{Binding SelectedPricingStrategyRow.Subtitle, TargetNullValue=—}" TextWrapping="Wrap"/>
                            <TextBlock Text="Scope" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock Margin="0,4,0,10" Text="{Binding SelectedPricingStrategyRow.Scope, TargetNullValue=—}"/>
                            <TextBlock Text="State" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock Margin="0,4,0,10" Text="{Binding SelectedPricingStrategyRow.State, TargetNullValue=—}"/>
                            <TextBlock Text="Identifiers" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap">
                                <Run Text="List "/><Run Text="{Binding SelectedPricingStrategyRow.PriceListId, TargetNullValue=—}"/>
                                <Run Text=" · Region "/><Run Text="{Binding SelectedPricingStrategyRow.RegionId, TargetNullValue=—}"/>
                                <Run Text=" · Customer "/><Run Text="{Binding SelectedPricingStrategyRow.CustomerId, TargetNullValue=—}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Price list editor">
        <controls:MasterDetailGrid Grid.Row="2" Margin="0,12,0,0">
            <controls:MasterDetailGrid.Master>
                <Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Price lists" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding PriceLists}" SelectedItem="{Binding SelectedPriceList}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{Binding Code}"/><Run Text=" · "/><Run Text="{Binding Scope}"/><Run Text=" · "/><Run Text="{Binding Currency}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewPriceListCommand}" Content="New price list" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid></Border>
            </controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Border Style="{StaticResource WorkspaceSectionStyle}"><StackPanel>
                        <controls:WorkflowHeader Title="{Binding Draft.Name, TargetNullValue=Price list}" Subtitle="Customer, regional and global item-level pricing" Status="{Binding Draft.IsActive}"/>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Code" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Draft.Code, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Currency" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Draft.Currency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Scope" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="2" Visibility="{Binding IsRegionScope, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Region *" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedPriceListRegion}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel></Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding Draft.ValidFrom}" Style="{StaticResource AppDatePickerStyle}"/><DatePicker Grid.Column="2" SelectedDate="{Binding Draft.ValidTo}" Style="{StaticResource AppDatePickerStyle}"/><controls:AppCheckBox Grid.Column="4" VerticalAlignment="Center" Content="Active" IsChecked="{Binding Draft.IsActive}"/></Grid>
                        <Button Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding SavePriceListCommand}" Content="Save price list" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel></Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Items and pricing" Style="{StaticResource WorkspaceSectionTitleStyle}"/><DataGrid Margin="0,10,0,0" ItemsSource="{Binding PriceItems}" SelectedItem="{Binding SelectedPriceItem}" Style="{StaticResource AppDataGridCompactStyle}" MaxHeight="220"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="120"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Discount %" Binding="{Binding DiscountPercent}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns></DataGrid><Border Margin="0,10,0,0" Style="{StaticResource WorkspaceToolbarBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="PartNumber" Style="{StaticResource AppComboBoxStyle}"/><controls:TextInput Grid.Column="2" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="4" Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="6" Command="{Binding SavePriceItemCommand}" Content="Set price" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="8" Command="{Binding DeletePriceItemCommand}" Content="Remove selected price" Style="{StaticResource SecondaryButtonStyle}"/></Grid></Border></StackPanel></Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel>
                        <TextBlock Text="Advanced bulk price generation" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                        <TextBlock Margin="0,4,0,10" Text="Choose Percentage Markup or Target Gross Margin explicitly. Cost currency is converted only through a matching effective direct FX rate. Preview is mandatory and exposes every calculation step before any price-list write." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="8"/><ColumnDefinition Width="160"/><ColumnDefinition Width="8"/><ColumnDefinition Width="105"/><ColumnDefinition Width="8"/><ColumnDefinition Width="145"/><ColumnDefinition Width="8"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Item filter" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BulkFilterTypes}" SelectedItem="{Binding BulkFilterType}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Pricing method" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BulkPricingMethods}" SelectedItem="{Binding BulkPricingMethod}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Markup / margin %" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding BulkPricingPercentage, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="Rounding" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BulkRoundingStrategies}" SelectedItem="{Binding BulkRoundingStrategy}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="8"><TextBlock Text="Apply mode" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BulkApplyModes}" SelectedItem="{Binding BulkApplyMode}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Visibility="{Binding IsBulkCategoryFilter, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Category" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BulkCategories}" SelectedItem="{Binding BulkCategory}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                            <StackPanel Visibility="{Binding IsBulkManufacturerFilter, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Manufacturer" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BulkManufacturers}" SelectedItem="{Binding BulkManufacturer}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                        </Grid>
                        <Border Margin="0,10,0,0" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Visibility="{Binding IsBulkSelectedItemsFilter, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Selected items" Style="{StaticResource FormLabelStyle}"/><ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding BulkItemSelections}"><ItemsControl.ItemTemplate><DataTemplate><controls:AppCheckBox Margin="0,3" IsChecked="{Binding IsSelected}"><TextBlock><Run Text="{Binding PartNumber}"/><Run Text=" · "/><Run Text="{Binding Description}"/></TextBlock></controls:AppCheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Command="{Binding CalculateBulkPreviewCommand}" Content="Calculate preview" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding ApplyBulkPricesCommand}" Content="Apply preview" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
                        <TextBlock Margin="0,10,0,4" Text="{Binding BulkPreviewSummary}" FontWeight="SemiBold"/>
                        <DataGrid ItemsSource="{Binding BulkPreviewRows}" SelectedItem="{Binding SelectedBulkPreviewRow}" Style="{StaticResource AppDataGridCompactStyle}" MaxHeight="300" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="105"/>
                            <DataGridTextColumn Header="Base source" Binding="{Binding BaseCostSource}" Width="125"/>
                            <DataGridTextColumn Header="Base cost" Binding="{Binding BaseCost, StringFormat={}{0:N2}}" Width="85" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                            <DataGridTextColumn Header="Cost" Binding="{Binding CalculatedCost, StringFormat={}{0:N2}}" Width="80" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                            <DataGridTextColumn Header="Cost CCY" Binding="{Binding SourceCurrency}" Width="70"/>
                            <DataGridTextColumn Header="FX source" Binding="{Binding ExchangeRate.RateSource}" Width="120"/>
                            <DataGridTextColumn Header="FX date" Binding="{Binding ExchangeRate.EffectiveDate, StringFormat={}{0:yyyy-MM-dd}}" Width="90"/>
                            <DataGridTextColumn Header="FX rate" Binding="{Binding ExchangeRate.Rate, StringFormat={}{0:N6}}" Width="80" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                            <DataGridTextColumn Header="Converted" Binding="{Binding ConvertedCost, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                            <DataGridTextColumn Header="Method" Binding="{Binding PricingMethod}" Width="120"/>
                            <DataGridTextColumn Header="%" Binding="{Binding PricingPercentage, StringFormat={}{0:N2}}" Width="65" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                            <DataGridTextColumn Header="Raw price" Binding="{Binding UnroundedPrice, StringFormat={}{0:N4}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                            <DataGridTextColumn Header="Rounding" Binding="{Binding RoundingStrategy}" Width="110"/>
                            <DataGridTextColumn Header="Adjustment" Binding="{Binding RoundingAdjustment, StringFormat={}{0:N4}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                            <DataGridTextColumn Header="New price" Binding="{Binding CalculatedNewPrice, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding CurrentPrice, StringFormat={}{0:N2}}" Width="85" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                            <DataGridTextColumn Header="Change %" Binding="{Binding PercentageChange, StringFormat={}{0:N2}}" Width="80" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="75"/><DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="220"/>
                        </DataGrid.Columns></DataGrid>
                        <TextBlock Margin="0,10,0,4" Text="Selected item cost component evidence" Style="{StaticResource FormLabelStyle}"/>
                        <DataGrid ItemsSource="{Binding SelectedBulkPreviewRow.CostComponents}" Style="{StaticResource AppDataGridCompactStyle}" MaxHeight="150"><DataGrid.Columns><DataGridTextColumn Header="Seq" Binding="{Binding Sequence}" Width="50" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding CalculationType}" Width="90"/><DataGridTextColumn Header="Base" Binding="{Binding CalculationBase}" Width="105"/><DataGridTextColumn Header="Configured" Binding="{Binding ConfiguredValue, StringFormat={}{0:N4}}" Width="85" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Basis amount" Binding="{Binding CalculationBasisAmount, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Applied" Binding="{Binding AppliedAmount, StringFormat={}{0:N2}}" Width="85" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Running total" Binding="{Binding RunningTotal, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns></DataGrid>
                    </StackPanel></Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel>
                        <TextBlock Text="Pricing exchange rates" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                        <TextBlock Margin="0,4,0,10" Text="Rates are directional and effective-dated. Depot never inverts, triangulates or assumes a missing rate. Source text is retained as calculation evidence." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                        <DataGrid ItemsSource="{Binding ExchangeRates}" SelectedItem="{Binding SelectedExchangeRate}" Style="{StaticResource AppDataGridCompactStyle}" MaxHeight="180"><DataGrid.Columns><DataGridTextColumn Header="From" Binding="{Binding SourceCurrency}" Width="65"/><DataGridTextColumn Header="To" Binding="{Binding TargetCurrency}" Width="65"/><DataGridTextColumn Header="Effective" Binding="{Binding EffectiveDate, StringFormat={}{0:yyyy-MM-dd}}" Width="90"/><DataGridTextColumn Header="Source" Binding="{Binding RateSource}" Width="*"/><DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat={}{0:N8}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"/></DataGrid.Columns></DataGrid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="8"/><ColumnDefinition Width="70"/><ColumnDefinition Width="8"/><ColumnDefinition Width="130"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="From" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ExchangeRateSourceCurrency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="To" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ExchangeRateTargetCurrency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Effective date" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding ExchangeRateEffectiveDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="Rate source" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ExchangeRateSource, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="8"><TextBlock Text="Rate" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ExchangeRateValue, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Command="{Binding NewExchangeRateCommand}" Content="New rate" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SaveExchangeRateCommand}" Content="Save rate" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
                    </StackPanel></Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Sales regions" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,4,0,10" Text="Regions group customers for regional default pricing. Customers may remain without a region." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegionDefinition}" DisplayMemberPath="Name" MinHeight="80"/><StackPanel Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Code" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding RegionDraft.Code, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding RegionDraft.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><controls:AppCheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding RegionDraft.IsActive}"/><StackPanel Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button Command="{Binding NewRegionCommand}" Content="New region" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SaveRegionCommand}" Content="Save region" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></StackPanel></Grid></StackPanel></Border>
                    <Border Margin="0,12,0,0" Style="{StaticResource WorkspaceSectionStyle}" Visibility="{Binding IsCustomerScope, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Optional customer-specific pricing" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,4,0,6" Text="New customer lists start inactive. Assign at least one customer, then activate the list; or use automatic Region → Global fallback." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/><TextBlock Margin="0,0,0,10" Text="{Binding CustomerPricingStatus}" FontWeight="SemiBold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/><Button Grid.Column="2" Command="{Binding AssignCustomerCommand}" Content="Use selected list" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="4" Command="{Binding ClearCustomerAssignmentCommand}" Content="Use automatic pricing" Style="{StaticResource SecondaryButtonStyle}"/></Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
