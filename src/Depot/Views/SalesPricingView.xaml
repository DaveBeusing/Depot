<UserControl x:Class="Depot.Views.SalesPricingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
        <controls:MasterDetailGrid>
            <controls:MasterDetailGrid.Master>
                <controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Price lists" Style="{StaticResource WorkspaceTitleStyle}"/>
                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding PriceLists}" SelectedItem="{Binding SelectedPriceList}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{Binding Code}"/><Run Text=" · "/><Run Text="{Binding Scope}"/><Run Text=" · "/><Run Text="{Binding Currency}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewPriceListCommand}" Content="New price list" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid></controls:Card>
            </controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <controls:Card><StackPanel>
                        <controls:WorkflowHeader Title="{Binding Draft.Name, TargetNullValue=Price list}" Subtitle="Customer, regional and global item-level pricing" Status="{Binding Draft.IsActive}"/>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Code" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Draft.Code, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Currency" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Draft.Currency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Scope" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="2" Visibility="{Binding IsRegionScope, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Region *" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedPriceListRegion}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel></Grid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding Draft.ValidFrom}" Style="{StaticResource AppDatePickerStyle}"/><DatePicker Grid.Column="2" SelectedDate="{Binding Draft.ValidTo}" Style="{StaticResource AppDatePickerStyle}"/><CheckBox Grid.Column="4" VerticalAlignment="Center" Content="Active" IsChecked="{Binding Draft.IsActive}"/></Grid>
                        <Button Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding SavePriceListCommand}" Content="Save price list" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel></controls:Card>
                    <controls:Card Margin="0,12,0,0"><StackPanel><TextBlock Text="Items and pricing" Style="{StaticResource WorkspaceTitleStyle}"/><DataGrid Margin="0,10,0,0" ItemsSource="{Binding PriceItems}" Style="{StaticResource AppDataGridStyle}" MaxHeight="220"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="120"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="100"/><DataGridTextColumn Header="Discount %" Binding="{Binding DiscountPercent}" Width="90"/></DataGrid.Columns></DataGrid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="PartNumber" Style="{StaticResource AppComboBoxStyle}"/><controls:TextInput Grid.Column="2" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="4" Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="6" Command="{Binding SavePriceItemCommand}" Content="Set price" Style="{StaticResource SecondaryButtonStyle}"/></Grid></StackPanel></controls:Card>
                    <controls:Card Margin="0,12,0,0"><StackPanel><TextBlock Text="Sales regions" Style="{StaticResource WorkspaceTitleStyle}"/><TextBlock Margin="0,4,0,10" Text="Regions group customers for regional default pricing. Customers may remain without a region." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegionDefinition}" DisplayMemberPath="Name" MinHeight="80"/><StackPanel Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Code" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding RegionDraft.Code, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding RegionDraft.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><CheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding RegionDraft.IsActive}"/><StackPanel Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button Command="{Binding NewRegionCommand}" Content="New region" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SaveRegionCommand}" Content="Save region" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></StackPanel></Grid></StackPanel></controls:Card>
                    <controls:Card Margin="0,12,0,0" Visibility="{Binding IsCustomerScope, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Optional customer-specific pricing" Style="{StaticResource WorkspaceTitleStyle}"/><TextBlock Margin="0,4,0,6" Text="New customer lists start inactive. Assign at least one customer, then activate the list; or use automatic Region → Global fallback." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/><TextBlock Margin="0,0,0,10" Text="{Binding CustomerPricingStatus}" FontWeight="SemiBold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/><Button Grid.Column="2" Command="{Binding AssignCustomerCommand}" Content="Use selected list" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="4" Command="{Binding ClearCustomerAssignmentCommand}" Content="Use automatic pricing" Style="{StaticResource SecondaryButtonStyle}"/></Grid></StackPanel></controls:Card>
                </StackPanel></ScrollViewer>
            </controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>
    </Grid>
</UserControl>
