<UserControl x:Class="Depot.Views.ReasonCodes.ReasonCodesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:PageHeader Title="Reason Codes" Subtitle="Maintain stable technical reasons and their editable display names."><controls:PageHeader.Actions><controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" /></controls:PageHeader.Actions></controls:PageHeader>
		<controls:MasterDetailGrid Grid.Row="2">
			<controls:MasterDetailGrid.Master><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<controls:FilterBar><StackPanel><controls:SearchBox Placeholder="Search code, name or description" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox Margin="0,8,0,0" ItemsSource="{Binding ActivationFilters}" SelectedItem="{Binding SelectedActivationFilter}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" /></StackPanel></controls:FilterBar>
				<Grid Grid.Row="1"><DataGrid ItemsSource="{Binding ReasonCodes}" SelectedItem="{Binding SelectedReasonCode}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="150" /><DataGridTextColumn Header="Display name" Binding="{Binding Name}" Width="*" /><DataGridTemplateColumn Header="Status" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:ActivationStatusBadge IsActive="{Binding IsActive}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><controls:WorkflowListState ItemCount="{Binding ReasonCodes.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" /></Grid>
				<Button Grid.Row="3" Command="{Binding NewCommand}" Content="New Reason Code" Style="{StaticResource PrimaryButtonStyle}" />
			</Grid></controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<controls:WorkflowHeader Title="{Binding EditorTitle}" Subtitle="System codes remain immutable after creation." Status="{Binding EditorStatus}" />
				<StackPanel Grid.Row="2"><TextBlock Text="Technical code *" Style="{StaticResource FormLabelStyle}" /><TextBox IsReadOnly="{Binding IsCodeReadOnly}" MaxLength="100" Style="{StaticResource AppTextBoxStyle}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Margin="0,6,0,0" Text="Used by workflows and integrations; it cannot be changed later." Style="{StaticResource CaptionStyle}" /></StackPanel>
				<StackPanel Grid.Row="4"><TextBlock Text="Display name *" Style="{StaticResource FormLabelStyle}" /><TextBox MaxLength="200" Style="{StaticResource AppTextBoxStyle}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
				<StackPanel Grid.Row="6"><TextBlock Text="Description" Style="{StaticResource FormLabelStyle}" /><TextBox MinHeight="96" AcceptsReturn="True" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" /></StackPanel>
				<controls:WorkflowActionBar Grid.Row="8"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding NewCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding ToggleActiveCommand}" Content="{Binding ActionText}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding SaveCommand}" Content="Save" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" /></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
			</Grid></controls:Card></controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
	<UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding NewCommand}" /></UserControl.InputBindings>
</UserControl>
