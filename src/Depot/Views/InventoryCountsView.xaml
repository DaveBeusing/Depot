<UserControl x:Class="Depot.Views.InventoryCountsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><controls:PageHeader Title="Inventory counts" Subtitle="Plan, execute, review and post physical stock counts with explicit variance evidence."/><controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" HelpTopicId="warehouse.inventory-counts" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}"/><controls:MasterDetailGrid Grid.Row="2" Margin="0,12,0,0"><controls:MasterDetailGrid.Master><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:FilterBar><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:SearchBox Placeholder="Search count number, warehouse or notes" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Grid.Row="2" DisplayMemberPath="Name" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource AppComboBoxStyle}"/><ComboBox Grid.Row="4" DisplayMemberPath="Name" ItemsSource="{Binding WarehouseFilters}" SelectedItem="{Binding SelectedWarehouseFilter}" Style="{StaticResource AppComboBoxStyle}"/></Grid></controls:FilterBar><Grid Grid.Row="1"><ListBox ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}" ItemsSource="{Binding InventoryCounts}" SelectedItem="{Binding SelectedCount}" Style="{StaticResource MasterDataListBoxStyle}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding CountNumber}"/><TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding WarehouseName}"/><TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding ProgressDisplay}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><controls:DocumentStatusBadge HorizontalAlignment="Right" Status="{Binding StatusDisplayName}"/><TextBlock Margin="0,3,0,0" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="{Binding CreatedAtLocal, StringFormat={}{0:d}}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><controls:WorkflowListState ItemCount="{Binding InventoryCounts.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}"/></Grid><Grid Grid.Row="2" Margin="0,10,0,0"><controls:PaginationControl PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}"/><Button HorizontalAlignment="Right" Command="{Binding NewCommand}" Content="New count" Style="{StaticResource PrimaryButtonStyle}"/></Grid></Grid></Border></controls:MasterDetailGrid.Master><controls:MasterDetailGrid.Detail><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><controls:WorkflowHeader Title="{Binding EditorTitle}" Subtitle="{Binding SelectedWarehouse.Name, TargetNullValue=Select a warehouse}" Status="{Binding Editor.Status}"/><StackPanel Grid.Row="1" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FormLabelStyle}" Text="Warehouse"/><ComboBox DisplayMemberPath="Name" IsEnabled="{Binding IsDraft}" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedDraftWarehouse}" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Created"/><TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStyle}" Text="{Binding Editor.CreatedAtLocal, StringFormat={}{0:g}}"/></StackPanel></Grid><TextBlock Margin="0,10,0,0" Style="{StaticResource FormLabelStyle}" Text="Notes"/><TextBox IsReadOnly="{Binding IsDraftReadOnly}" MinHeight="52" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}"/><Grid Margin="0,12,0,0" Visibility="{Binding HasSelectedCount, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FormLabelStyle}" Text="Started"/><TextBlock Style="{StaticResource BodyStyle}" Text="{Binding Editor.StartedAtLocal, StringFormat={}{0:g}, TargetNullValue=Not started}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Progress"/><TextBlock Style="{StaticResource BodyStyle}" Text="{Binding CountProgressDisplay}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Review summary"/><TextBlock Style="{StaticResource BodyStyle}" Text="{Binding DifferenceSummary}"/></StackPanel></Grid><controls:WorkflowActionBar><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CancelCommand}" Content="Cancel count" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding SaveDraftCommand}" Content="Save draft" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsDraft, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding ReturnToCountingCommand}" Content="Return to counting" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsReview, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><StackPanel Orientation="Horizontal"><Button Command="{Binding StartCommand}" Content="Start count" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding IsDraft, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Command="{Binding PostCommand}" Content="Post count" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding IsReview, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Command="{Binding MoveToReviewCommand}" Content="Move to review" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding IsCounting, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar><Border Margin="0,10,0,0" Style="{StaticResource WorkspaceToolbarBorderStyle}" Visibility="{Binding CanReverse, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding ReversalReasonCodes}" SelectedItem="{Binding SelectedReversalReasonCode}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/><controls:TextInput Grid.Column="2" Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="4" Command="{Binding ReverseCommand}" Content="Reverse count" Style="{StaticResource DangerButtonStyle}"/></Grid></Border></StackPanel></Grid></Border><Border Margin="0,12,0,0" Style="{StaticResource WorkspaceSectionStyle}" Visibility="{Binding HasCountLines, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Style="{StaticResource WorkspaceSectionTitleStyle}" Text="Count positions"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><controls:SearchBox Placeholder="Search item, location or purpose" Text="{Binding LineSearchText, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Grid.Column="2" VerticalAlignment="Center" Content="Uncounted only" IsChecked="{Binding UncountedOnly}"/><CheckBox Grid.Column="4" VerticalAlignment="Center" Content="Differences only" IsChecked="{Binding DifferencesOnly}"/></Grid><DataGrid MinHeight="230" Margin="0,10,0,0" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding PartNumber}" Header="Item" Width="110"/><DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*"/><DataGridTextColumn Binding="{Binding StorageLocationName}" Header="Location" Width="125"/><DataGridTextColumn Binding="{Binding PurposeName}" Header="Purpose" Width="105"/><DataGridTextColumn Binding="{Binding ExpectedQuantity, StringFormat={}{0:N0}}" Header="Expected" Width="75" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Binding="{Binding CountedQuantity, StringFormat={}{0:N0}}" Header="Counted" Width="75" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Binding="{Binding Difference, StringFormat={}{0:+#;-#;0}}" Header="Diff." Width="65" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Binding="{Binding CountedByUserName}" Header="Counted by" Width="115"/><DataGridTextColumn Binding="{Binding CountedAtLocal, StringFormat={}{0:g}}" Header="Counted at" Width="120"/></DataGrid.Columns></DataGrid><Border Margin="0,10,0,0" Style="{StaticResource WorkspaceToolbarBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="150"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}" Text="Quick quantity"/><TextBox Grid.Column="2" IsEnabled="{Binding IsCounting}" Style="{StaticResource AppTextBoxStyle}" Text="{Binding SelectedLine.CountedQuantity, UpdateSourceTrigger=PropertyChanged}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SaveQuantityCommand}"/></TextBox.InputBindings></TextBox><Button Grid.Column="4" Command="{Binding SaveQuantityCommand}" Content="Save &amp; next" Style="{StaticResource PrimaryButtonStyle}"/><TextBlock Grid.Column="5" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="Enter the physical quantity and press Enter."/></Grid></Border><controls:PaginationControl Margin="0,10,0,0" PreviousCommand="{Binding PreviousLinePageCommand}" NextCommand="{Binding NextLinePageCommand}" PageText="{Binding LinePageDisplay}"/></StackPanel></Border></StackPanel></ScrollViewer></controls:MasterDetailGrid.Detail></controls:MasterDetailGrid></Grid></UserControl>