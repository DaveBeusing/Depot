<UserControl
	x:Class="Depot.Views.InventoryCountsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls"
	xmlns:commands="clr-namespace:Depot.Commands">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="16" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:PageHeader Title="Inventory Counts" Subtitle="Create warehouse snapshots, record physical quantities, and review differences.">
			<controls:PageHeader.Actions>
				<StackPanel Orientation="Horizontal"><controls:OperationPanel
					ErrorText="{Binding OperationError}"
					HasError="{Binding HasOperationError}" HelpTopicId="warehouse.inventory-counts"
					IsBusy="{Binding IsBusy}"
					StatusText="{Binding StatusText}" /><Button MinWidth="{DynamicResource Help.ContextButton.MinWidth}" Margin="{DynamicResource Button.Margin}" AutomationProperties.Name="Open inventory counts help" Command="{x:Static commands:HelpCommands.OpenTopic}" CommandParameter="warehouse.inventory-counts" Content="Help" Style="{DynamicResource SecondaryButtonStyle}" /></StackPanel>
			</controls:PageHeader.Actions>
		</controls:PageHeader>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{StaticResource MasterPane.DefaultWidth}" MinWidth="{StaticResource MasterPane.MinWidth}" MaxWidth="{StaticResource MasterPane.MaxWidth}" />
				<ColumnDefinition Width="{StaticResource MasterDetail.ColumnGap}" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="8" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="8" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="8" />
					<RowDefinition Height="*" />
					<RowDefinition Height="12" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="12" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<controls:FilterBar><controls:SearchBox Placeholder="Search count number, warehouse or notes" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /></controls:FilterBar>
				<ComboBox Grid.Row="2" DisplayMemberPath="Name" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource AppComboBoxStyle}" />
				<ComboBox Grid.Row="4" DisplayMemberPath="Name" ItemsSource="{Binding WarehouseFilters}" SelectedItem="{Binding SelectedWarehouseFilter}" Style="{StaticResource AppComboBoxStyle}" />
				<ListBox
					Grid.Row="6"
					ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"
					ItemsSource="{Binding InventoryCounts}"
					SelectedItem="{Binding SelectedCount}"
					Style="{StaticResource MasterDataListBoxStyle}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid Margin="4">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock FontWeight="SemiBold" Text="{Binding CountNumber}" />
									<TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding WarehouseName}" />
									<TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding ProgressDisplay, Mode=OneWay}" />
								</StackPanel>
								<StackPanel Grid.Column="1" HorizontalAlignment="Right">
									<controls:DocumentStatusBadge HorizontalAlignment="Right" Status="{Binding StatusDisplayName, Mode=OneWay}" />
									<TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="{Binding CreatedAtLocal, StringFormat={}{0:d}}" />
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<controls:WorkflowListState Grid.Row="6" ItemCount="{Binding InventoryCounts.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" />
				<controls:PaginationControl Grid.Row="8" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}" />
				<Button Grid.Row="10" Command="{Binding NewCommand}" Content="New Inventory Count" Style="{StaticResource PrimaryButtonStyle}" />
			</Grid>

			<ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<controls:Card>
						<controls:Card.Header><controls:WorkflowHeader Title="{Binding EditorTitle}" Subtitle="{Binding SelectedWarehouse.Name, TargetNullValue=Select a warehouse}" Status="{Binding Editor.Status}" /></controls:Card.Header>
						<StackPanel>
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Style="{StaticResource FormLabelStyle}" Text="Warehouse" />
									<ComboBox
										DisplayMemberPath="Name"
										IsEnabled="{Binding IsDraft}"
										ItemsSource="{Binding Warehouses}"
										SelectedItem="{Binding SelectedDraftWarehouse}"
										Style="{StaticResource AppComboBoxStyle}" />
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Style="{StaticResource FormLabelStyle}" Text="Created" />
									<TextBlock Margin="0,9,0,0" Style="{StaticResource BodyStyle}" Text="{Binding Editor.CreatedAtLocal, StringFormat={}{0:g}}" />
								</StackPanel>
							</Grid>
							<TextBlock Margin="0,12,0,0" Style="{StaticResource FormLabelStyle}" Text="Notes" />
							<TextBox
								AcceptsReturn="True"
								IsReadOnly="{Binding IsDraftReadOnly}"
								MinHeight="58"
								Style="{StaticResource MultilineTextBoxStyle}"
								Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}"
								TextWrapping="Wrap" />
							<Grid Margin="0,16,0,0" Visibility="{Binding HasSelectedCount, Converter={StaticResource BooleanToVisibilityConverter}}">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<StackPanel><TextBlock Style="{StaticResource FormLabelStyle}" Text="Started" /><TextBlock Style="{StaticResource BodyStyle}" Text="{Binding Editor.StartedAtLocal, StringFormat={}{0:g}, TargetNullValue=Not started}" /></StackPanel>
								<StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Progress" /><TextBlock Style="{StaticResource BodyStyle}" Text="{Binding CountProgressDisplay, Mode=OneWay}" /></StackPanel>
								<StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Review summary" /><TextBlock Style="{StaticResource BodyStyle}" Text="{Binding DifferenceSummary, Mode=OneWay}" /></StackPanel>
							</Grid>
							<controls:WorkflowActionBar>
								<controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CancelCommand}" Content="Cancel Count" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding SaveDraftCommand}" Content="Save Draft" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsDraft, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding ReturnToCountingCommand}" Content="Return to Counting" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsReview, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></controls:WorkflowActionBar.SecondaryActions>
								<controls:WorkflowActionBar.PrimaryAction><StackPanel Orientation="Horizontal"><Button Command="{Binding StartCommand}" Content="Start Count" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding IsDraft, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Command="{Binding PostCommand}" Content="Post Count" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding IsReview, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Command="{Binding MoveToReviewCommand}" Content="Move to Review" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding IsCounting, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></controls:WorkflowActionBar.PrimaryAction>
							</controls:WorkflowActionBar>
							<StackPanel Margin="0,20,0,0" Visibility="{Binding CanReverse, Converter={StaticResource BooleanToVisibilityConverter}}">
								<Separator Margin="0,0,0,16" />
								<TextBlock Text="Reverse Posted Inventory Count" Style="{StaticResource SectionTitleStyle}" />
								<TextBlock Margin="0,6,0,0" Text="All inventory-count corrections are counter-posted atomically. The count and original movements remain immutable." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
								<Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
									<ComboBox ItemsSource="{Binding ReversalReasonCodes}" SelectedItem="{Binding SelectedReversalReasonCode}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" />
									<controls:TextInput Grid.Column="2" Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" />
									<Button Grid.Column="4" Command="{Binding ReverseCommand}" Content="Reverse Count" Style="{StaticResource DangerButtonStyle}" />
								</Grid>
							</StackPanel>
						</StackPanel>
					</controls:Card>

					<controls:Card Margin="0,16,0,0" Visibility="{Binding HasCountLines, Converter={StaticResource BooleanToVisibilityConverter}}">
						<controls:Card.Header><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Count Positions" /></controls:Card.Header>
						<StackPanel>
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<controls:SearchBox Placeholder="Search item, location or purpose" Text="{Binding LineSearchText, UpdateSourceTrigger=PropertyChanged}" />
								<CheckBox Grid.Column="2" VerticalAlignment="Center" Content="Uncounted only" IsChecked="{Binding UncountedOnly}" />
								<CheckBox Grid.Column="4" VerticalAlignment="Center" Content="Differences only" IsChecked="{Binding DifferencesOnly}" />
							</Grid>
							<DataGrid
								MinHeight="220"
								Margin="0,12,0,0"
								IsReadOnly="True"
								ItemsSource="{Binding Lines}"
								KeyboardNavigation.TabNavigation="Continue"
								SelectedItem="{Binding SelectedLine}"
								SelectionUnit="FullRow"
								Style="{StaticResource AppDataGridStyle}">
								<DataGrid.Columns>
									<DataGridTextColumn Binding="{Binding PartNumber}" Header="Item" Width="120" />
									<DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*" />
									<DataGridTextColumn Binding="{Binding StorageLocationName}" Header="Location" Width="145" />
									<DataGridTextColumn Binding="{Binding PurposeName}" Header="Purpose" Width="115" />
									<DataGridTextColumn Binding="{Binding ExpectedQuantity, StringFormat={}{0:N0}}" Header="Expected" Width="85" />
									<DataGridTextColumn Binding="{Binding CountedQuantity, StringFormat={}{0:N0}}" Header="Counted" Width="85" />
									<DataGridTextColumn Binding="{Binding Difference, Mode=OneWay, StringFormat={}{0:+#;-#;0}}" Header="Difference" Width="90" />
									<DataGridTextColumn Binding="{Binding CountedByUserName}" Header="Counted by" Width="130" />
									<DataGridTextColumn Binding="{Binding CountedAtLocal, StringFormat={}{0:g}}" Header="Counted at" Width="130" />
								</DataGrid.Columns>
							</DataGrid>
							<Grid Margin="0,12,0,0">
								<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="180" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<TextBlock VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}" Text="Quick quantity" />
								<TextBox Grid.Column="2" IsEnabled="{Binding IsCounting}" Style="{StaticResource AppTextBoxStyle}" Text="{Binding SelectedLine.CountedQuantity, UpdateSourceTrigger=PropertyChanged}">
									<TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SaveQuantityCommand}" /></TextBox.InputBindings>
								</TextBox>
								<Button Grid.Column="4" Command="{Binding SaveQuantityCommand}" Content="Save &amp; Next" Style="{StaticResource PrimaryButtonStyle}" />
								<TextBlock Grid.Column="5" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="Select a row, enter the physical quantity, then press Enter. Leave empty to mark it uncounted." />
							</Grid>
							<controls:PaginationControl Margin="0,12,0,0" PreviousCommand="{Binding PreviousLinePageCommand}" NextCommand="{Binding NextLinePageCommand}" PageText="{Binding LinePageDisplay}" />
						</StackPanel>
					</controls:Card>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
