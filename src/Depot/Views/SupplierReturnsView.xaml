<UserControl x:Class="Depot.Views.SupplierReturnsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource MasterPane.DefaultWidth}" MinWidth="{StaticResource MasterPane.MinWidth}" MaxWidth="{StaticResource MasterPane.MaxWidth}" /><ColumnDefinition Width="{StaticResource MasterDetail.ColumnGap}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<controls:FilterBar><controls:SearchBox Placeholder="Search return, supplier, PO or receipt" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /></controls:FilterBar>
				<ComboBox Grid.Row="2" DisplayMemberPath="Name" ItemsSource="{Binding SupplierFilters}" SelectedItem="{Binding SelectedSupplierFilter}" Style="{StaticResource AppComboBoxStyle}" />
				<ComboBox Grid.Row="4" DisplayMemberPath="Name" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Style="{StaticResource AppComboBoxStyle}" />
				<ListBox Grid.Row="6" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}" ItemsSource="{Binding Returns}" SelectedItem="{Binding SelectedReturn}" Style="{StaticResource MasterDataListBoxStyle}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding ReturnNumber}" /><TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding SupplierName}" TextTrimming="CharacterEllipsis" /><TextBlock Style="{StaticResource CaptionStyle}" Text="{Binding GoodsReceiptNumber, StringFormat=Receipt: {0}}" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right"><controls:DocumentStatusBadge HorizontalAlignment="Right" Status="{Binding StatusDisplayName}" /><TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="{Binding ReturnDate, StringFormat={}{0:d}}" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
				<controls:WorkflowListState Grid.Row="6" ItemCount="{Binding Returns.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" />
				<controls:PaginationControl Grid.Row="8" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}" />
				<Button Grid.Row="10" Command="{Binding NewReturnCommand}" Content="New Supplier Return" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanCreate, Converter={StaticResource BooleanToVisibilityConverter}}" />
			</Grid>
			<ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<controls:Card>
						<controls:Card.Header><controls:WorkflowHeader Title="{Binding EditorTitle}" Subtitle="{Binding Draft.SupplierName}" Status="{Binding Draft.StatusDisplayName}" /></controls:Card.Header>
						<StackPanel>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FormLabelStyle}" Text="Goods Receipt" /><controls:SearchBox Margin="0,4,0,6" Placeholder="Search receipt, PO or supplier" Text="{Binding ReceiptSearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox DisplayMemberPath="DisplayName" IsEnabled="{Binding IsDraft}" ItemsSource="{Binding ReceiptOptions}" SelectedItem="{Binding SelectedReceipt}" Style="{StaticResource AppComboBoxStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Return Date" /><DatePicker IsEnabled="{Binding IsDraft}" SelectedDate="{Binding Draft.ReturnDate}" Style="{StaticResource AppDatePickerStyle}" /></StackPanel></Grid>
							<Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FormLabelStyle}" Text="Supplier" /><TextBlock Style="{StaticResource BodyStyle}" Text="{Binding Draft.SupplierName}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Purchase Order" /><TextBlock Style="{StaticResource BodyStyle}" Text="{Binding Draft.PurchaseOrderNumber}" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Supplier Reference" /><controls:TextInput IsEnabled="{Binding IsDraft}" Text="{Binding Draft.SupplierReference, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
							<StackPanel Margin="0,12,0,0"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Notes" /><TextBox AcceptsReturn="True" IsReadOnly="{Binding IsReadOnly}" MinHeight="56" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" /></StackPanel>
							<DataGrid MinHeight="180" Margin="0,16,0,0" IsReadOnly="True" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding PartNumber}" Header="Item" Width="110" /><DataGridTextColumn Binding="{Binding ItemDescription}" Header="Description" Width="*" /><DataGridTextColumn Binding="{Binding InventoryDisplay}" Header="Inventory" Width="210" /><DataGridTextColumn Binding="{Binding ReceivedQuantity, StringFormat={}{0:N0}}" Header="Received" Width="80" /><DataGridTextColumn Binding="{Binding AlreadyReturnedQuantity, StringFormat={}{0:N0}}" Header="Returned" Width="80" /><DataGridTextColumn Binding="{Binding AvailableStock, StringFormat={}{0:N0}}" Header="Stock" Width="75" /><DataGridTextColumn Binding="{Binding Quantity, StringFormat={}{0:N0}}" Header="Return Qty" Width="90" /><DataGridTextColumn Binding="{Binding UnitCost, StringFormat={}{0:C2}}" Header="Unit Cost" Width="90" /><DataGridTextColumn Binding="{Binding ReasonCodeName}" Header="Reason" Width="140" /></DataGrid.Columns></DataGrid>
							<Grid Margin="0,12,0,0" IsEnabled="{Binding IsDraft}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="90" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource FormLabelStyle}" Text="Returnable Receipt Position" /><ComboBox ItemsSource="{Binding ReturnableLines}" SelectedItem="{Binding SelectedAvailableLine}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><Run FontWeight="SemiBold" Text="{Binding PartNumber}" /><Run Text=" · Returnable " /><Run Text="{Binding ReturnableQuantity, StringFormat={}{0:N0}}" /><Run Text=" · Stock " /><Run Text="{Binding AvailableStock, StringFormat={}{0:N0}}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Reason Code" /><ComboBox DisplayMemberPath="Name" ItemsSource="{Binding ReasonCodes}" SelectedItem="{Binding SelectedReasonCode}" Style="{StaticResource AppComboBoxStyle}" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FormLabelStyle}" Text="Quantity" /><controls:TextInput Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Command="{Binding RemoveLineCommand}" Content="Remove" Style="{StaticResource SecondaryButtonStyle}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding AddLineCommand}" Content="{Binding SaveLineText}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></Grid>
							<TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionStyle}" Text="Receipt quantities remain historical facts. Posted supplier returns are evaluated separately as net returned quantities." TextWrapping="Wrap" />
							<controls:WorkflowActionBar><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CancelCommand}" Content="Cancel Draft" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanCreate, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding SaveCommand}" Content="Save Draft" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanCreate, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding PostCommand}" Content="Post Supplier Return" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanPost, Converter={StaticResource BooleanToVisibilityConverter}}" /></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
						</StackPanel>
					</controls:Card>
					<controls:Card Margin="0,16,0,0" Visibility="{Binding HasMovements, Converter={StaticResource BooleanToVisibilityConverter}}"><controls:Card.Header><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Return Movements" /></controls:Card.Header><DataGrid MinHeight="180" IsReadOnly="True" ItemsSource="{Binding Movements}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Header="Timestamp" Width="145" /><DataGridTextColumn Binding="{Binding MovementType}" Header="Type" Width="120" /><DataGridTextColumn Binding="{Binding PartNumber}" Header="Item" Width="120" /><DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*" /><DataGridTextColumn Binding="{Binding WarehouseName}" Header="Warehouse" Width="130" /><DataGridTextColumn Binding="{Binding LocationName}" Header="Location" Width="120" /><DataGridTextColumn Binding="{Binding Quantity, StringFormat={}{0:N0}}" Header="Quantity" Width="80" /><DataGridCheckBoxColumn Binding="{Binding IsReversed, Mode=OneWay}" Header="Reversed" Width="80" /></DataGrid.Columns></DataGrid></controls:Card>
					<controls:Card Margin="0,16,0,0" Visibility="{Binding CanReverse, Converter={StaticResource BooleanToVisibilityConverter}}"><controls:Card.Header><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Reverse by Counter-Booking" /></controls:Card.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox DisplayMemberPath="Name" ItemsSource="{Binding ReasonCodes}" SelectedItem="{Binding SelectedReversalReasonCode}" Style="{StaticResource AppComboBoxStyle}" /><controls:TextInput Grid.Column="2" Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="4" Command="{Binding ReverseCommand}" Content="Post Counter-Movements" Style="{StaticResource DangerButtonStyle}" /></Grid></controls:Card>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
