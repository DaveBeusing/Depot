<UserControl x:Class="Depot.Views.SalesApprovalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:OperationPanel ErrorText="{Binding Workspace.OperationError}" HasError="{Binding Workspace.HasOperationError}" IsBusy="{Binding Workspace.IsBusy}" StatusText="{Binding Workspace.StatusText}" />

        <StackPanel Grid.Row="2">
            <controls:WorkflowHeader Title="Sales approvals" Subtitle="Review submitted customer orders before allocation and release" Status="Live" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <controls:Card><StackPanel><TextBlock Text="Open approvals" Style="{StaticResource CardTitleStyle}"/><TextBlock Margin="0,6,0,0" Text="{Binding Workspace.PendingApprovals.Count, StringFormat={}{0:N0}}" Style="{StaticResource PageTitleStyle}"/></StackPanel></controls:Card>
                <controls:Card Grid.Column="2"><StackPanel><TextBlock Text="Selected order value" Style="{StaticResource CardTitleStyle}"/><TextBlock Margin="0,6,0,0" Text="{Binding Workspace.SelectedOrder.NetAmount, Mode=OneWay, StringFormat={}{0:C2}, TargetNullValue=—}" Style="{StaticResource SectionTitleStyle}"/></StackPanel></controls:Card>
                <controls:Card Grid.Column="4"><StackPanel><TextBlock Text="Selected customer" Style="{StaticResource CardTitleStyle}"/><TextBlock Margin="0,6,0,0" Text="{Binding Workspace.SelectedOrder.CustomerName, Mode=OneWay, TargetNullValue=—}" Style="{StaticResource SectionTitleStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></controls:Card>
            </Grid>
        </StackPanel>

        <controls:MasterDetailGrid Grid.Row="4">
            <controls:MasterDetailGrid.Master>
                <controls:Card><Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Open approval queue" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <ListBox ItemsSource="{Binding Workspace.PendingApprovals}" SelectedItem="{Binding Workspace.SelectedOrder}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}">
                            <ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding OrderNumber}"/><TextBlock Text="{Binding CustomerName}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding OrderDate, StringFormat={}{0:d}}" Style="{StaticResource CaptionStyle}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right"><TextBlock HorizontalAlignment="Right" Text="{Binding NetAmount, Mode=OneWay, StringFormat={}{0:C2}}" FontWeight="SemiBold"/><TextBlock HorizontalAlignment="Right" Text="{Binding RequestedDeliveryDate, StringFormat={}{0:d}, TargetNullValue=No due date}" Style="{StaticResource CaptionStyle}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <controls:EmptyState Title="No sales approvals pending" Description="Submitted sales orders that require a decision will appear here.">
                            <controls:EmptyState.Style><Style TargetType="{x:Type controls:EmptyState}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.PendingApprovals.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></controls:EmptyState.Style>
                        </controls:EmptyState>
                    </Grid>
                </Grid></controls:Card>
            </controls:MasterDetailGrid.Master>

            <controls:MasterDetailGrid.Detail>
                <controls:Card><Grid>
                    <controls:EmptyState Title="No sales order selected" Description="Select an order from the approval queue to review its details.">
                        <controls:EmptyState.Style><Style TargetType="{x:Type controls:EmptyState}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.SelectedOrder}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></controls:EmptyState.Style>
                    </controls:EmptyState>
                    <Grid>
                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Workspace.SelectedOrder}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <controls:WorkflowHeader Title="{Binding Workspace.OrderDraft.OrderNumber}" Subtitle="{Binding Workspace.OrderDraft.CustomerName}" Status="{Binding Workspace.OrderDraft.Status}"/>
                        <TabControl Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource AppTabControlStyle}">
                            <TabItem Header="Order"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Order date" Style="{StaticResource FormLabelStyle}"/><TextBlock Text="{Binding Workspace.OrderDraft.OrderDate, StringFormat={}{0:d}}" Style="{StaticResource BodyStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Requested delivery" Style="{StaticResource FormLabelStyle}"/><TextBlock Text="{Binding Workspace.OrderDraft.RequestedDeliveryDate, StringFormat={}{0:d}, TargetNullValue=—}" Style="{StaticResource BodyStyle}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Currency" Style="{StaticResource FormLabelStyle}"/><TextBlock Text="{Binding Workspace.OrderDraft.Currency}" Style="{StaticResource BodyStyle}"/></StackPanel></Grid><DataGrid Grid.Row="2" ItemsSource="{Binding Workspace.OrderLines}" IsReadOnly="True" AutoGenerateColumns="False" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="45"/><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="120"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="85"/><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="110"/><DataGridTextColumn Header="Net" Binding="{Binding NetAmount, Mode=OneWay, StringFormat={}{0:C2}}" Width="110"/></DataGrid.Columns></DataGrid></Grid></TabItem>
                            <TabItem Header="Notes"><TextBlock Margin="0,12,0,0" Text="{Binding Workspace.OrderDraft.Notes, TargetNullValue=No notes provided.}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}"/></TabItem>
                            <TabItem Header="Addresses"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Billing address" Style="{StaticResource FormLabelStyle}"/><TextBlock Text="{Binding Workspace.OrderDraft.BillingAddress, TargetNullValue=—}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Shipping address" Style="{StaticResource FormLabelStyle}"/><TextBlock Text="{Binding Workspace.OrderDraft.ShippingAddress, TargetNullValue=—}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}"/></StackPanel></Grid></TabItem>
                        </TabControl>
                        <controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><Button Command="{Binding Workspace.RejectCommand}" Content="Reject" Style="{StaticResource DangerButtonStyle}"/></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><StackPanel><TextBlock Text="Decision comment (optional)" Style="{StaticResource FormLabelStyle}"/><TextBox Width="360" MinHeight="48" AcceptsReturn="True" Text="{Binding Workspace.ApprovalComment, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}"/><Button Margin="0,8,0,0" HorizontalAlignment="Right" Command="{Binding Workspace.ApproveCommand}" Content="Approve" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
                    </Grid>
                </Grid></controls:Card>
            </controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>
    </Grid>
</UserControl>
