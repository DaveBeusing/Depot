<UserControl x:Class="Depot.Views.FinanceReceivablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:PageHeader Title="Accounts Receivable" Subtitle="Manage customer open items, settlements, aging, dunning, and controlled corrections."><controls:PageHeader.Actions><Button Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"/></controls:PageHeader.Actions></controls:PageHeader>
        <controls:FilterBar Grid.Row="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><controls:SearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Placeholder="Customer or reference" ToolTip="Search receivable open items"/><CheckBox Grid.Column="2" VerticalAlignment="Center" Content="Include settled" IsChecked="{Binding IncludeSettled}"/><DatePicker Grid.Column="4" SelectedDate="{Binding AgingDate}" ToolTip="Aging reference date"/></Grid></controls:FilterBar>
        <StackPanel Grid.Row="2"><controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:MetricCard Title="Open Receivables" Value="{Binding TotalReceivable}" ValueStringFormat="{}{0:N2}" SupportingText="Debit open items"/><controls:MetricCard Grid.Column="2" Title="Customer Credits" Value="{Binding UnappliedCredits}" ValueStringFormat="{}{0:N2}" SupportingText="Unallocated credits"/><controls:MetricCard Grid.Column="4" Title="Net Exposure" Value="{Binding NetExposure}" ValueStringFormat="{}{0:N2}" SupportingText="Receivables less credits"/><controls:MetricCard Grid.Column="6" Title="Rows" Value="{Binding TotalCount}" SupportingText="Current open-item filter"/></Grid></StackPanel>
        <TabControl Grid.Row="4" Style="{StaticResource AppTabControlStyle}">
            <TabItem Header="Open Items"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding OpenItems}" SelectedItem="{Binding SelectedOpenItem}" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="Reference" Binding="{Binding SourceReference}" Width="150"/><DataGridTextColumn Header="Document" Binding="{Binding DocumentDate}" Width="105"/><DataGridTextColumn Header="Due" Binding="{Binding DueDate}" Width="105"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="85"/><DataGridTextColumn Header="Original" Binding="{Binding OriginalAmount, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Status" Binding="{Binding SettlementStatus}" Width="100"/></DataGrid.Columns></DataGrid><controls:PaginationControl Grid.Row="1" Margin="0,10,0,0" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}" Visibility="{Binding ShowPaging, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid></TabItem>
            <TabItem Header="Payments &amp; Allocation"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><controls:Card Margin="0,0,0,12"><controls:Card.Header><TextBlock Text="Post customer payment" Style="{StaticResource SectionTitleStyle}"/></controls:Card.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Customer ID"/><TextBox Text="{Binding PaymentCustomerId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Currency"/><TextBox Text="{Binding PaymentCurrency}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Payment date"/><DatePicker SelectedDate="{Binding PaymentDate}"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="Amount"/><TextBox Text="{Binding PaymentAmount}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Allocate to selected invoice"/><TextBox Text="{Binding PaymentAllocationAmount}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="4"><TextBlock Text="Reference"/><TextBox Text="{Binding PaymentReference}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Row="4" Grid.ColumnSpan="5"><TextBlock Text="Description"/><TextBox Text="{Binding PaymentDescription}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><Button Grid.Row="6" Grid.Column="4" HorizontalAlignment="Right" Command="{Binding PostPaymentCommand}" Content="Post payment" Style="{StaticResource PrimaryButtonStyle}"/></Grid></controls:Card><controls:Card Margin="0,0,0,12"><controls:Card.Header><TextBlock Text="Allocate existing customer credit" Style="{StaticResource SectionTitleStyle}"/></controls:Card.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Credit open-item ID"/><TextBox Text="{Binding AllocationCreditOpenItemId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Debit open-item ID"/><TextBox Text="{Binding AllocationDebitOpenItemId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Amount"/><TextBox Text="{Binding AllocationAmount}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="Date"/><DatePicker SelectedDate="{Binding AllocationDate}"/><Button Margin="0,8,0,0" Command="{Binding AllocateCreditCommand}" Content="Allocate" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Grid></controls:Card><controls:Card><controls:Card.Header><TextBlock Text="Reverse payment" Style="{StaticResource SectionTitleStyle}"/></controls:Card.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Payment ID"/><TextBox Text="{Binding PaymentReversalId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Posting date"/><DatePicker SelectedDate="{Binding PaymentReversalDate}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Reason"/><TextBox Text="{Binding PaymentReversalReason}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><Button Grid.Column="6" VerticalAlignment="Bottom" Command="{Binding ReversePaymentCommand}" Content="Reverse payment" Style="{StaticResource DangerButtonStyle}"/></Grid></controls:Card></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Aging &amp; Statement"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Aging}" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90"/><DataGridTextColumn Header="Current" Binding="{Binding Current, StringFormat={}{0:N2}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="1-30" Binding="{Binding Days1To30, StringFormat={}{0:N2}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="31-60" Binding="{Binding Days31To60, StringFormat={}{0:N2}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="61-90" Binding="{Binding Days61To90, StringFormat={}{0:N2}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="90+" Binding="{Binding DaysOver90, StringFormat={}{0:N2}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Credits" Binding="{Binding UnappliedCredits, StringFormat={}{0:N2}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns></DataGrid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="160"/><ColumnDefinition Width="10"/><ColumnDefinition Width="160"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding StatementCustomerId}" Style="{StaticResource AppTextBoxStyle}" ToolTip="Customer ID"/><TextBox Grid.Column="2" Text="{Binding StatementCurrency}" Style="{StaticResource AppTextBoxStyle}" ToolTip="Currency"/><DatePicker Grid.Column="4" SelectedDate="{Binding StatementFromDate}" ToolTip="From date"/><DatePicker Grid.Column="6" SelectedDate="{Binding StatementToDate}" ToolTip="To date"/><Button Grid.Column="8" Command="{Binding LoadStatementCommand}" Content="Load statement" Style="{StaticResource SecondaryButtonStyle}"/></Grid><DataGrid Grid.Row="4" ItemsSource="{Binding StatementRows}" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="105"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="160"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Open" Binding="{Binding OpenAmount, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns></DataGrid></Grid></TabItem>
            <TabItem Header="Dunning" Visibility="{Binding CanViewDunning, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><controls:Card><controls:Card.Header><TextBlock Text="Dunning policy" Style="{StaticResource SectionTitleStyle}"/></controls:Card.Header><StackPanel><ComboBox ItemsSource="{Binding DunningPolicies}" SelectedItem="{Binding SelectedDunningPolicy}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" ToolTip="Existing policy"/><TextBlock Margin="0,10,0,0" Text="Code"/><TextBox Text="{Binding DunningPolicyCode}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Name"/><TextBox Text="{Binding DunningPolicyName}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Level 1 days overdue"/><TextBox Text="{Binding DunningLevel1Days}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Level 2 days overdue"/><TextBox Text="{Binding DunningLevel2Days}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Level 3 days overdue"/><TextBox Text="{Binding DunningLevel3Days}" Style="{StaticResource AppTextBoxStyle}"/><Button Margin="0,12,0,0" Command="{Binding SaveDunningPolicyCommand}" Content="Save policy" Style="{StaticResource PrimaryButtonStyle}"/><TextBlock Margin="0,16,0,0" Text="Assessment date"/><DatePicker SelectedDate="{Binding DunningAsOfDate}"/><Button Margin="0,8,0,0" Command="{Binding RunDunningCommand}" Content="Run assessment" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></controls:Card><Border Grid.Column="2" Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Dunning run snapshot" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding DunningRunLines}" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="80"/><DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingAmount, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Days" Binding="{Binding DaysOverdue}" Width="70" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Level" Binding="{Binding LevelCode}" Width="100"/></DataGrid.Columns></DataGrid></Grid></Border></Grid></TabItem>
            <TabItem Header="Write-off" Visibility="{Binding CanPostWriteOffs, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Margin="8"><controls:Card Margin="0,0,0,12"><controls:Card.Header><TextBlock Text="Post write-off" Style="{StaticResource SectionTitleStyle}"/></controls:Card.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding WriteOffOpenItemId}" Style="{StaticResource AppTextBoxStyle}" ToolTip="Open-item ID"/><TextBox Grid.Column="2" Text="{Binding WriteOffAmount}" Style="{StaticResource AppTextBoxStyle}" ToolTip="Amount"/><DatePicker Grid.Column="4" SelectedDate="{Binding WriteOffDate}" ToolTip="Posting date"/><TextBox Grid.Column="6" Text="{Binding WriteOffReason}" Style="{StaticResource AppTextBoxStyle}" ToolTip="Reason"/><Button Grid.Column="8" Command="{Binding PostWriteOffCommand}" Content="Post write-off" Style="{StaticResource DangerButtonStyle}"/></Grid></controls:Card><controls:Card Visibility="{Binding CanReverseWriteOffs, Converter={StaticResource BooleanToVisibilityConverter}}"><controls:Card.Header><TextBlock Text="Reverse write-off" Style="{StaticResource SectionTitleStyle}"/></controls:Card.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding WriteOffReversalId}" Style="{StaticResource AppTextBoxStyle}" ToolTip="Write-off ID"/><DatePicker Grid.Column="2" SelectedDate="{Binding WriteOffReversalDate}" ToolTip="Posting date"/><TextBox Grid.Column="4" Text="{Binding WriteOffReversalReason}" Style="{StaticResource AppTextBoxStyle}" ToolTip="Reason"/><Button Grid.Column="6" Command="{Binding ReverseWriteOffCommand}" Content="Reverse write-off" Style="{StaticResource DangerButtonStyle}"/></Grid></controls:Card></StackPanel></TabItem>
            <TabItem Header="Setup" Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibilityConverter}}"><ScrollViewer VerticalScrollBarVisibility="Auto"><controls:Card Margin="8"><controls:Card.Header><TextBlock Text="Accounts Receivable configuration" Style="{StaticResource SectionTitleStyle}"/></controls:Card.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Legal entity ID"/><TextBox Text="{Binding ConfigurationLegalEntityId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Fiscal calendar ID"/><TextBox Text="{Binding ConfigurationFiscalCalendarId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="Invoice posting profile ID"/><TextBox Text="{Binding InvoiceProfileId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Credit-note posting profile ID"/><TextBox Text="{Binding CreditNoteProfileId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Row="4"><TextBlock Text="Payment posting profile ID"/><TextBox Text="{Binding PaymentProfileId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Write-off posting profile ID"/><TextBox Text="{Binding WriteOffProfileId}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><CheckBox Grid.Row="6" Content="Active" IsChecked="{Binding ConfigurationIsActive}"/><Button Grid.Row="8" Grid.Column="2" HorizontalAlignment="Right" Command="{Binding SaveConfigurationCommand}" Content="Save configuration" Style="{StaticResource PrimaryButtonStyle}"/></Grid></controls:Card></ScrollViewer></TabItem>
        </TabControl>
    </Grid>
</UserControl>