<UserControl x:Class="Depot.Views.Suppliers.SuppliersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" xmlns:controls="clr-namespace:Depot.Controls">
	<UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding NewSupplierCommand}" /></UserControl.InputBindings>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:PageHeader Title="Suppliers" Subtitle="Maintain commercial supplier data and supplier-specific item conditions." />
		<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
		<controls:MasterDetailGrid Grid.Row="3">
			<controls:MasterDetailGrid.Master><controls:Card><Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<controls:FilterBar><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><controls:SearchBox automation:AutomationProperties.Name="Search suppliers" Placeholder="Search suppliers" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox Grid.Row="2" automation:AutomationProperties.Name="Supplier status filter" ItemsSource="{Binding ActivationFilters}" SelectedItem="{Binding SelectedActivationFilter}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" /></Grid></controls:FilterBar>
				<Grid Grid.Row="1"><ListBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding AccountNumber, StringFormat=Account {0:N0}}" Style="{StaticResource CaptionStyle}" /></StackPanel><controls:ActivationStatusBadge Grid.Column="1" IsActive="{Binding IsActive}" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><controls:WorkflowListState ItemCount="{Binding Suppliers.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" /></Grid>
				<Button Grid.Row="3" Command="{Binding NewSupplierCommand}" Content="New supplier" Style="{StaticResource PrimaryButtonStyle}" />
			</Grid></controls:Card></controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail><controls:Card><TabControl Style="{StaticResource AppTabControlStyle}">
				<TabItem Header="Supplier details"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<controls:WorkflowHeader Title="{Binding SupplierEditorTitle}" Subtitle="Commercial data and supplier account settings" Status="{Binding SupplierStatus}" />
					<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel>
						<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Depot account number" Style="{StaticResource FormLabelStyle}" /><controls:TextInput automation:AutomationProperties.Name="Depot account number" IsReadOnly="True" Text="{Binding AccountNumberText, Mode=OneWay}" /><TextBlock Margin="0,6,0,0" Text="Assigned automatically" Style="{StaticResource HintStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Name *" Style="{StaticResource FormLabelStyle}" /><controls:TextInput controls:FocusRequest.RequestId="{Binding EditorFocusRequest}" automation:AutomationProperties.Name="Supplier name" Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
						<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Our customer number" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.CustomerNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Loyalty" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.Loyalty, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Quality" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.Quality, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
						<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Contact" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.Contact, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Supplier category" Style="{StaticResource FormLabelStyle}" /><ComboBox ItemsSource="{Binding Categories}" SelectedValue="{Binding Draft.SupplierCategoryId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" /></StackPanel></Grid>
						<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Email" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.Email, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Phone" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.Phone, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
						<TextBlock Margin="0,16,0,0" Text="Address" Style="{StaticResource FormLabelStyle}" /><TextBox MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Draft.Address, UpdateSourceTrigger=PropertyChanged}" />
						<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="URL" Style="{StaticResource FormLabelStyle}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><controls:TextInput Text="{Binding Draft.Url, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="2" automation:AutomationProperties.Name="Open supplier website" Command="{Binding OpenUrlCommand}" Content="Open" Style="{StaticResource SecondaryButtonStyle}" /></Grid></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="VAT number" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.VatNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
						<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Payment term" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.PaymentTerm, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Account name" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.AccountName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
						<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IBAN" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.Iban, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SEPA mandate" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Draft.SepaMandate, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
						<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RMA terms" Style="{StaticResource FormLabelStyle}" /><TextBox MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Draft.RmaTerms, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Notes" Style="{StaticResource FormLabelStyle}" /><TextBox MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
					</StackPanel></ScrollViewer>
					<controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding NewSupplierCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding ToggleSupplierCommand}" Content="{Binding SupplierActionText}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button IsDefault="True" Command="{Binding SaveSupplierCommand}" Content="Save supplier" Style="{StaticResource PrimaryButtonStyle}" /></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
				</Grid></TabItem>
				<TabItem Header="Supplier items" IsEnabled="{Binding HasSelectedSupplier}"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<controls:WorkflowHeader Title="{Binding SupplierItemEditorTitle}" Subtitle="Supplier-specific purchasing conditions" Status="{Binding SupplierItemStatus}" />
					<controls:FilterBar Grid.Row="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><controls:SearchBox Placeholder="Search assigned items" Text="{Binding SupplierItemSearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox Grid.Column="2" ItemsSource="{Binding ActivationFilters}" SelectedItem="{Binding SelectedSupplierItemActivationFilter}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" /></Grid></controls:FilterBar>
					<DataGrid Grid.Row="2" ItemsSource="{Binding SupplierItems}" SelectedItem="{Binding SelectedSupplierItem}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding ItemPartNumber}" Width="120" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Supplier part number" Binding="{Binding SupplierPartNumber}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Purchase price" Binding="{Binding PurchasePrice, StringFormat={}{0:C2}}" Width="120" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridCheckBoxColumn Header="Preferred" Binding="{Binding IsPreferredSupplier, Mode=OneWay}" Width="80" /><DataGridTemplateColumn Header="Status" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:ActivationStatusBadge IsActive="{Binding IsActive}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
					<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Item *" Style="{StaticResource FormLabelStyle}" /><controls:SearchBox Placeholder="Search item master" Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox Margin="0,8,0,0" ItemsSource="{Binding ItemOptions}" SelectedItem="{Binding SelectedItemOption}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding PartNumber}" FontWeight="SemiBold" /><Run Text=" - " /><Run Text="{Binding Description}" /></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Margin="0,12,0,0" Text="Supplier part number *" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding SupplierItemDraft.SupplierPartNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Purchase price" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding SupplierItemDraft.PurchasePrice, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Lead time (days)" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding SupplierItemDraft.LeadTimeDays, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid><TextBlock Margin="0,12,0,0" Text="Minimum order quantity *" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding SupplierItemDraft.MinimumOrderQuantity, UpdateSourceTrigger=PropertyChanged}" /><CheckBox Margin="0,12,0,0" Content="Preferred supplier for this item" IsChecked="{Binding SupplierItemDraft.IsPreferredSupplier}" Style="{StaticResource AppCheckBoxStyle}" /></StackPanel></Grid>
					<controls:WorkflowActionBar Grid.Row="5"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding NewSupplierItemCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding ToggleSupplierItemCommand}" Content="{Binding SupplierItemActionText}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding SaveSupplierItemCommand}" Content="Save assignment" Style="{StaticResource PrimaryButtonStyle}" /></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
				</Grid></TabItem>
			</TabControl></controls:Card></controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>
