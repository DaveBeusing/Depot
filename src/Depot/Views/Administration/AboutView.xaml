<UserControl
	x:Class="Depot.Views.Administration.AboutView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="12" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:PageHeader Title="About Depot" Subtitle="Application, runtime, database-schema and repository information for this installation." />
		<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />

		<ScrollViewer Grid.Row="3" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<StackPanel HorizontalAlignment="Stretch">
				<Border Style="{StaticResource WorkspaceSectionStyle}">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
						<Image Width="{DynamicResource About.Logo.Size}" Height="{DynamicResource About.Logo.Size}" Source="/Resources/Images/Depot.png" Stretch="Uniform" />
						<StackPanel Grid.Column="2" VerticalAlignment="Center">
							<TextBlock Text="{Binding Information.ProductName}" Style="{StaticResource SectionTitleStyle}" />
							<TextBlock Margin="{DynamicResource Control.Margin}" Text="{Binding Information.Description}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}" />
							<StackPanel Margin="{DynamicResource Control.Margin.Large}" Orientation="Horizontal">
								<controls:StatusBadge Content="{Binding VersionBadgeText}" Variant="Success" />
								<controls:StatusBadge Margin="{DynamicResource Button.Margin}" Content="{Binding Information.ReleaseChannel}" Variant="Neutral" />
								<controls:StatusBadge Margin="{DynamicResource Button.Margin}" Content="{Binding DatabaseSchemaDisplay}" Variant="Neutral" />
							</StackPanel>
						</StackPanel>
					</Grid>
				</Border>

				<Grid Margin="{DynamicResource About.Section.Margin}">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
					<controls:Card><StackPanel><TextBlock Text="Local and server databases" Style="{StaticResource CardTitleStyle}" /><TextBlock Margin="{DynamicResource Control.Margin}" Text="Use SQLite locally or connect to SQL Server and MySQL/MariaDB." TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" /></StackPanel></controls:Card>
					<controls:Card Grid.Column="2"><StackPanel><TextBlock Text="Offline-capable desktop app" Style="{StaticResource CardTitleStyle}" /><TextBlock Margin="{DynamicResource Control.Margin}" Text="Core workflows and integrated help remain available without online services." TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" /></StackPanel></controls:Card>
					<controls:Card Grid.Column="4"><StackPanel><TextBlock Text="Immutable movement journal" Style="{StaticResource CardTitleStyle}" /><TextBlock Margin="{DynamicResource Control.Margin}" Text="Posted stock changes remain traceable and corrections use counter-movements." TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" /></StackPanel></controls:Card>
					<controls:Card Grid.Column="6"><StackPanel><TextBlock Text="Multi-user ready" Style="{StaticResource CardTitleStyle}" /><TextBlock Margin="{DynamicResource Control.Margin}" Text="Transactions, audit entries and optimistic concurrency protect shared workflows." TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" /></StackPanel></controls:Card>
				</Grid>

				<Border Margin="{DynamicResource About.Section.Margin}" Style="{StaticResource WorkspaceSectionStyle}">
					<StackPanel>
						<TextBlock Text="Technical information" Style="{StaticResource SectionTitleStyle}" />
						<Grid Margin="0,12,0,0">
							<Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource About.Details.LabelWidth}" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
							<TextBlock Text="Application version" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Column="2" Text="{Binding Information.Version, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
							<TextBlock Grid.Row="2" Text="Build metadata" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Information.BuildMetadata, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
							<TextBlock Grid.Row="4" Text="Runtime" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Information.Runtime, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
							<TextBlock Grid.Row="6" Text="Operating system" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Information.OperatingSystem, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
							<TextBlock Grid.Row="8" Text="Architecture" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Row="8" Grid.Column="2" Text="{Binding Information.ProcessArchitecture, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
							<TextBlock Grid.Row="10" Text="Database schema" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Row="10" Grid.Column="2" Text="{Binding Information.DatabaseSchemaVersion, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
							<TextBlock Grid.Row="12" Text="License" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Row="12" Grid.Column="2" Text="{Binding Information.License, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
							<TextBlock Grid.Row="14" Text="Repository" Style="{StaticResource FormLabelStyle}" /><Button Grid.Row="14" Grid.Column="2" AutomationProperties.Name="Open Depot repository" Command="{Binding OpenRepositoryCommand}" Content="{Binding Information.RepositoryUrl}" Style="{StaticResource AppLinkButtonStyle}" ToolTip="{Binding Information.RepositoryUrl}" />
						</Grid>
					</StackPanel>
				</Border>

				<Grid Margin="{DynamicResource About.Section.Margin}">
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
					<StackPanel><TextBlock Text="{Binding Information.Copyright}" Style="{StaticResource CaptionStyle}" /><TextBlock Margin="{DynamicResource Control.Margin}" Text="Licensed under the MIT License. Third-party components retain their respective licenses." TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" /></StackPanel>
					<Button Grid.Column="1" VerticalAlignment="Bottom" Command="{Binding CopyInformationCommand}" Content="Copy all information" Style="{StaticResource SecondaryButtonStyle}" />
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
