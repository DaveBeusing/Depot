<UserControl
	x:Class="Depot.Views.Administration.AboutView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="8" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:OperationPanel
			ErrorText="{Binding OperationError}"
			HasError="{Binding HasOperationError}"
			IsBusy="{Binding IsBusy}"
			StatusText="{Binding StatusText}" />

		<ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<StackPanel MaxWidth="{DynamicResource About.Content.MaxWidth}" HorizontalAlignment="Left">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="24" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Image
						Width="{DynamicResource About.Logo.Size}"
						Height="{DynamicResource About.Logo.Size}"
						Source="/Resources/Images/Depot.png"
						Stretch="Uniform" />
					<StackPanel Grid.Column="2" VerticalAlignment="Center">
						<TextBlock Text="{Binding Information.ProductName}" Style="{StaticResource PageTitleStyle}" />
						<TextBlock Margin="{DynamicResource Control.Margin}" Text="{Binding Information.Description}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}" />
						<StackPanel Margin="{DynamicResource Control.Margin.Large}" Orientation="Horizontal">
							<controls:StatusBadge Content="{Binding VersionBadgeText}" Variant="Success" />
							<controls:StatusBadge Margin="{DynamicResource Button.Margin}" Content="{Binding Information.ReleaseChannel}" Variant="Neutral" />
							<controls:StatusBadge Margin="{DynamicResource Button.Margin}" Content="{Binding DatabaseSchemaDisplay}" Variant="Neutral" />
						</StackPanel>
					</StackPanel>
				</Grid>

				<Separator Margin="0,24,0,20" />

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="{DynamicResource About.Details.LabelWidth}" />
						<ColumnDefinition Width="16" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" /><RowDefinition Height="12" />
						<RowDefinition Height="Auto" /><RowDefinition Height="12" />
						<RowDefinition Height="Auto" /><RowDefinition Height="12" />
						<RowDefinition Height="Auto" /><RowDefinition Height="12" />
						<RowDefinition Height="Auto" /><RowDefinition Height="12" />
						<RowDefinition Height="Auto" /><RowDefinition Height="12" />
						<RowDefinition Height="Auto" /><RowDefinition Height="12" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock Text="Application version" Style="{StaticResource FormLabelStyle}" />
					<TextBox Grid.Column="2" Text="{Binding Information.Version, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
					<TextBlock Grid.Row="2" Text="Build metadata" Style="{StaticResource FormLabelStyle}" />
					<TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Information.BuildMetadata, Mode=OneWay}" ToolTip="{Binding Information.BuildMetadata}" Style="{StaticResource CopyableTextStyle}" />
					<TextBlock Grid.Row="4" Text="Runtime" Style="{StaticResource FormLabelStyle}" />
					<TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Information.Runtime, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
					<TextBlock Grid.Row="6" Text="Operating system" Style="{StaticResource FormLabelStyle}" />
					<TextBox Grid.Row="6" Grid.Column="2" Text="{Binding Information.OperatingSystem, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
					<TextBlock Grid.Row="8" Text="Architecture" Style="{StaticResource FormLabelStyle}" />
					<TextBox Grid.Row="8" Grid.Column="2" Text="{Binding Information.ProcessArchitecture, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
					<TextBlock Grid.Row="10" Text="Database schema" Style="{StaticResource FormLabelStyle}" />
					<TextBox Grid.Row="10" Grid.Column="2" Text="{Binding Information.DatabaseSchemaVersion, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
					<TextBlock Grid.Row="12" Text="License" Style="{StaticResource FormLabelStyle}" />
					<TextBox Grid.Row="12" Grid.Column="2" Text="{Binding Information.License, Mode=OneWay}" Style="{StaticResource CopyableTextStyle}" />
					<TextBlock Grid.Row="14" Text="Repository" Style="{StaticResource FormLabelStyle}" />
					<Button
						Grid.Row="14"
						Grid.Column="2"
						AutomationProperties.Name="Open Depot repository"
						Command="{Binding OpenRepositoryCommand}"
						Content="{Binding Information.RepositoryUrl}"
						Style="{StaticResource AppLinkButtonStyle}"
						ToolTip="{Binding Information.RepositoryUrl}" />
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
