<UserControl x:Class="Depot.Views.Administration.UserSessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WorkflowHeader Title="User Sessions"
                                 Subtitle="Review active clients, session lifetime and concurrency policy, history retention, and administrative revocation."
                                 Status="{Binding ActiveSessions, StringFormat={}{0:N0} active}" />

        <controls:OperationPanel Grid.Row="1" Margin="0,10,0,0"
                                 IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}"
                                 StatusText="{Binding StatusText}" ErrorText="{Binding OperationError}" />

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,12,0,12">
            <controls:Card Margin="0,0,6,0"><StackPanel>
                <TextBlock Text="Online Users" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{Binding OnlineUsers, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" Margin="0,8,0,0" />
                <TextBlock Text="Distinct users currently within the presence timeout" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
            </StackPanel></controls:Card>
            <controls:Card Margin="6,0,0,0"><StackPanel>
                <TextBlock Text="Active Sessions" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{Binding ActiveSessions, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" Margin="0,8,0,0" />
                <TextBlock Text="One row per online user/client login" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
            </StackPanel></controls:Card>
        </UniformGrid>

        <controls:Card Grid.Row="3" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Session policy" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Lifetime, concurrent-login behavior and session-history retention are centrally enforced for every Depot client." Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PolicyRangeHint}" Style="{StaticResource HintStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0"
                            automation:AutomationProperties.Name="Save user session policy"
                            Command="{Binding SavePolicyCommand}" Content="Save policy"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{Binding CanManagePolicy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <UniformGrid Columns="3" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,12,10">
                        <TextBlock Text="Idle timeout (minutes)" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Margin="0,4,0,0" Style="{StaticResource AppTextBoxStyle}" Text="{Binding IdleTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanManagePolicy}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,10">
                        <TextBlock Text="Maximum lifetime (hours)" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Margin="0,4,0,0" Style="{StaticResource AppTextBoxStyle}" Text="{Binding MaximumSessionAgeHours, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanManagePolicy}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Concurrent session mode" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox Margin="0,4,0,0" Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding ConcurrentSessionModeOptions}" SelectedItem="{Binding ConcurrentSessionMode}" IsEnabled="{Binding CanManagePolicy}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Maximum concurrent sessions" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Margin="0,4,0,0" Style="{StaticResource AppTextBoxStyle}" Text="{Binding MaximumConcurrentSessions, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsMaximumConcurrentSessionsEnabled}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="When limit is reached" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox Margin="0,4,0,0" Style="{StaticResource AppComboBoxStyle}" ItemsSource="{Binding ConcurrentSessionLimitActionOptions}" SelectedItem="{Binding ConcurrentSessionLimitAction}" IsEnabled="{Binding CanManagePolicy}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="History retention (days)" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Margin="0,4,0,0" Style="{StaticResource AppTextBoxStyle}" Text="{Binding SessionHistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanManagePolicy}" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </controls:Card>

        <controls:FilterBar Grid.Row="4" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <controls:SearchBox automation:AutomationProperties.Name="Search user sessions" Placeholder="Search user, email or client" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" automation:AutomationProperties.Name="Terminate selected user session" Command="{Binding TerminateSessionCommand}" Content="Terminate session" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanTerminateSessions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button Grid.Column="4" automation:AutomationProperties.Name="Terminate all sessions for selected user" Command="{Binding TerminateUserSessionsCommand}" Content="Terminate all for user" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanTerminateSessions, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </controls:FilterBar>

        <TabControl Grid.Row="5" Style="{StaticResource AppTabControlStyle}">
            <TabItem Header="Active">
                <controls:Card Margin="0,10,0,0"><Grid MinHeight="220">
                    <DataGrid automation:AutomationProperties.Name="Currently online users and sessions" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Style="{StaticResource AppDataGridStyle}" Visibility="{Binding HasSessions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User" Binding="{Binding UserDisplayName}" Width="1.35*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Email" Binding="{Binding UserEmail}" Width="1.65*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Client" Binding="{Binding MachineName}" Width="1.15*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Online Since" Binding="{Binding OnlineSince}" Width="135" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Online For" Binding="{Binding OnlineFor}" Width="100" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}" Width="110" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Version" Binding="{Binding AppVersion}" Width="110" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:EmptyState Title="Nobody is online" Description="No heartbeat-active authenticated session is currently available." Visibility="{Binding HasNoSessions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid></controls:Card>
            </TabItem>
            <TabItem Header="History">
                <controls:Card Margin="0,10,0,0"><Grid MinHeight="220">
                    <DataGrid automation:AutomationProperties.Name="Recent ended user sessions" ItemsSource="{Binding History}" Style="{StaticResource AppDataGridStyle}" Visibility="{Binding HasHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User" Binding="{Binding UserDisplayName}" Width="1.25*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Email" Binding="{Binding UserEmail}" Width="1.5*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Client" Binding="{Binding MachineName}" Width="1.1*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Signed In" Binding="{Binding Started}" Width="135" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Ended" Binding="{Binding Ended}" Width="135" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding EndReason}" Width="150" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:EmptyState Title="No session history" Description="Ended sessions appear here until the configured history-retention period removes them." Visibility="{Binding HasNoHistory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid></controls:Card>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
