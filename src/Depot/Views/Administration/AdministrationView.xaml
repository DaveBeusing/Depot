<UserControl
	x:Class="Depot.Views.Administration.AdministrationView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<ListBox
			Margin="{DynamicResource SecondaryNavigation.Margin}"
			ItemsSource="{Binding NavigationItems}"
			SelectedItem="{Binding SelectedNavigationItem}"
			Style="{DynamicResource SecondaryNavigationListBoxStyle}"
			ItemContainerStyle="{DynamicResource SecondaryNavigationItemStyle}" />

		<controls:ShellModuleContentControl
			Grid.Row="1"
			Margin="{DynamicResource Shell.Module.Content.Margin}"
			Content="{Binding CurrentViewModel}" />
	</Grid>
</UserControl>
