<UserControl x:Class="Depot.Views.Administration.DocumentTemplateDesignerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
	xmlns:controls="clr-namespace:Depot.Controls"
	MinWidth="980"
	MinHeight="640">
	<UserControl.InputBindings>
		<KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
		<KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
	</UserControl.InputBindings>
	<UserControl.Resources>
		<Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}" />
		<Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource AppComboBoxStyle}" />
		<Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource AppTextBoxStyle}" />

		<DrawingBrush x:Key="DesignerGridBrush" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
			<DrawingBrush.Drawing>
				<GeometryDrawing Brush="White">
					<GeometryDrawing.Pen>
						<Pen Brush="{DynamicResource BorderBrush}" Thickness="0.5" />
					</GeometryDrawing.Pen>
					<GeometryDrawing.Geometry>
						<GeometryGroup>
							<LineGeometry StartPoint="10,0" EndPoint="10,10" />
							<LineGeometry StartPoint="0,10" EndPoint="10,10" />
						</GeometryGroup>
					</GeometryDrawing.Geometry>
				</GeometryDrawing>
			</DrawingBrush.Drawing>
		</DrawingBrush>

		<Style x:Key="DesignerResizeHandleStyle" TargetType="{x:Type primitives:Thumb}">
			<Setter Property="Width" Value="9" />
			<Setter Property="Height" Value="9" />
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
			<Setter Property="BorderThickness" Value="1.5" />
			<Setter Property="Visibility" Value="Collapsed" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type primitives:Thumb}">
						<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<controls:PageHeader Grid.Row="0" Title="{Binding Title}" Subtitle="{Binding Subtitle}">
			<controls:PageHeader.Actions>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
						<TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
						<TextBlock Text="{Binding ModeText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
					</StackPanel>
					<controls:StatusBadge Content="Unsaved changes"
						Variant="Warning"
						Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
				</StackPanel>
			</controls:PageHeader.Actions>
		</controls:PageHeader>

		<Grid Grid.Row="1" Margin="0,0,0,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="220" />
				<ColumnDefinition Width="250" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" Margin="0,0,10,0">
				<TextBlock Text="Document type" FontWeight="SemiBold" />
				<ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding SelectedType}" Margin="0,4,0,0" Style="{StaticResource AppComboBoxStyle}"
					IsEnabled="{Binding CanChangeTemplateSelection}" AutomationProperties.Name="Document template type" />
			</StackPanel>
			<StackPanel Grid.Column="1" Margin="0,0,10,0">
				<TextBlock Text="Version" FontWeight="SemiBold" />
				<ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="DisplayName" Margin="0,4,0,0" Style="{StaticResource AppComboBoxStyle}"
					IsEnabled="{Binding CanChangeTemplateSelection}" AutomationProperties.Name="Document template version" />
			</StackPanel>
			<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
				<Button Content="Save Draft" Command="{Binding SaveDraftCommand}" Margin="0,0,6,0" Padding="12,6" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Save document template draft" />
				<Button Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,6,0" Padding="12,6" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Preview document template" />
				<Button Content="Activate" Command="{Binding ActivateCommand}" Padding="12,6" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Activate selected document template version" />
			</StackPanel>
			<Button x:Name="SecondaryActionsButton" Grid.Column="3" Content="More…" Margin="10,0,0,0" Padding="12,6" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButtonStyle}"
				Click="SecondaryActions_Click" AutomationProperties.Name="More document designer actions">
				<Button.ContextMenu>
					<ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
						<MenuItem Header="New from Default" Command="{Binding NewFromDefaultCommand}" />
						<MenuItem Header="Duplicate current draft" Command="{Binding DuplicateCommand}" />
						<MenuItem Header="Copy selected version as draft" Command="{Binding CopySelectedVersionAsDraftCommand}" />
						<Separator />
						<MenuItem Header="Discard changes" Command="{Binding DiscardChangesCommand}"
							Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<MenuItem Header="Reset Default" Command="{Binding ResetDefaultCommand}" />
					</ContextMenu>
				</Button.ContextMenu>
			</Button>
		</Grid>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="180" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="300" />
			</Grid.ColumnDefinitions>

			<controls:Card Grid.Column="0" Style="{StaticResource WorkspaceCardStyle}" Margin="0,0,12,0">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Text="Toolbox" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
						<Button Content="Text" Tag="Text" Click="AddElement_Click" Margin="0,0,0,6" />
						<Button Content="Bound Text" Tag="BoundText" Click="AddElement_Click" Margin="0,0,0,6" />
						<Button Content="Image / Logo" Tag="Image" Click="AddElement_Click" Margin="0,0,0,6" />
						<Button Content="Line" Tag="Line" Click="AddElement_Click" Margin="0,0,0,6" />
						<Button Content="Rectangle" Tag="Rectangle" Click="AddElement_Click" Margin="0,0,0,6" />
						<Button Content="Line Table" Tag="LineTable" Click="AddElement_Click" Margin="0,0,0,6" />
						<Button Content="Totals Block" Tag="TotalsBlock" Click="AddElement_Click" Margin="0,0,0,6" />
						<Button Content="Page Number" Tag="PageNumber" Click="AddElement_Click" Margin="0,0,0,12" />
						<Separator Margin="0,2,0,10" />
						<Button Content="Duplicate selection" Command="{Binding DuplicateElementsCommand}" Margin="0,0,0,6" />
						<Button Content="Delete selection" Command="{Binding DeleteElementsCommand}" Style="{StaticResource DangerButtonStyle}" />
						<TextBlock Text="Ctrl/Shift-click selects multiple elements. Arrow keys move; Shift+Arrow moves faster. Ctrl+D duplicates; Delete removes. Ctrl+Z/Ctrl+Y undo and redo."
							TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0" />
					</StackPanel>
				</ScrollViewer>
			</controls:Card>

			<Grid Grid.Column="1" Margin="0,0,12,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<WrapPanel Margin="0,0,0,8">
					<Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,6,0" Padding="8,4" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo designer change" />
					<Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,12,0" Padding="8,4" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo designer change" />
					<TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" />
					<Slider Minimum="25" Maximum="200" Width="120" Value="{Binding ZoomPercent}" TickFrequency="25" IsSnapToTickEnabled="False"
						AutomationProperties.Name="Canvas zoom" />
					<TextBlock Text="{Binding ZoomPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" Width="48" Margin="6,0,4,0" />
					<TextBlock Text="PDF scale" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="100% maps PDF points to their correct WPF display size (96/72)." />
					<controls:AppCheckBox Content="Grid" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center" Margin="0,0,10,0" />
					<controls:AppCheckBox Content="Snap" IsChecked="{Binding SnapToGrid}" VerticalAlignment="Center" Margin="0,0,8,0" />
					<TextBlock Text="Grid" VerticalAlignment="Center" Margin="0,0,4,0" />
					<controls:TextInput Width="42" Text="{Binding GridSize, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Grid size" />
				</WrapPanel>

				<WrapPanel Grid.Row="1" Margin="0,0,0,8">
					<TextBlock Text="Align" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource SecondaryTextBrush}" />
					<Button Content="Left" Command="{Binding AlignLeftCommand}" Margin="0,0,4,0" Padding="7,3" ToolTip="Align left" />
					<Button Content="Center" Command="{Binding AlignCenterCommand}" Margin="0,0,4,0" Padding="7,3" ToolTip="Align horizontal centers" />
					<Button Content="Right" Command="{Binding AlignRightCommand}" Margin="0,0,8,0" Padding="7,3" ToolTip="Align right" />
					<Button Content="Top" Command="{Binding AlignTopCommand}" Margin="0,0,4,0" Padding="7,3" ToolTip="Align top" />
					<Button Content="Middle" Command="{Binding AlignMiddleCommand}" Margin="0,0,4,0" Padding="7,3" ToolTip="Align vertical centers" />
					<Button Content="Bottom" Command="{Binding AlignBottomCommand}" Margin="0,0,8,0" Padding="7,3" ToolTip="Align bottom" />
					<Button Content="Distribute H" Command="{Binding DistributeHorizontallyCommand}" Margin="0,0,4,0" Padding="7,3" ToolTip="Distribute horizontally" />
					<Button Content="Distribute V" Command="{Binding DistributeVerticallyCommand}" Margin="0,0,8,0" Padding="7,3" ToolTip="Distribute vertically" />
					<Button Content="Same Width" Command="{Binding SameWidthCommand}" Margin="0,0,4,0" Padding="7,3" />
					<Button Content="Same Height" Command="{Binding SameHeightCommand}" Padding="7,3" />
				</WrapPanel>

				<ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceAltBrush}" PanningMode="Both">
					<Border x:Name="DesignerPage" Width="{Binding PageWidth}" Height="{Binding PageHeight}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
						HorizontalAlignment="Center" VerticalAlignment="Top" Margin="28" SnapsToDevicePixels="True" UseLayoutRounding="True"
						TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
						<Border.LayoutTransform>
							<ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
						</Border.LayoutTransform>
						<Border.Style>
							<Style TargetType="Border">
								<Setter Property="Background" Value="{StaticResource DesignerGridBrush}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding ShowGrid}" Value="False">
										<Setter Property="Background" Value="White" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<ListBox x:Name="CanvasElements"
							ItemsSource="{Binding Elements}"
							SelectionMode="Extended"
							Background="Transparent"
							BorderThickness="0"
							Width="{Binding PageWidth}"
							Height="{Binding PageHeight}"
							SelectionChanged="CanvasElements_SelectionChanged"
							PreviewKeyDown="CanvasElements_PreviewKeyDown"
							PreviewMouseLeftButtonDown="CanvasElements_PreviewMouseLeftButtonDown"
							PreviewMouseMove="CanvasElements_PreviewMouseMove"
							PreviewMouseLeftButtonUp="CanvasElements_PreviewMouseLeftButtonUp"
							AutomationProperties.Name="Document design canvas">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<Canvas />
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.ItemContainerStyle>
								<Style TargetType="ListBoxItem">
									<Setter Property="Canvas.Left" Value="{Binding X}" />
									<Setter Property="Canvas.Top" Value="{Binding Y}" />
									<Setter Property="Width" Value="{Binding Width}" />
									<Setter Property="Height" Value="{Binding Height}" />
									<Setter Property="MinWidth" Value="4" />
									<Setter Property="MinHeight" Value="4" />
									<Setter Property="Padding" Value="0" />
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="BorderThickness" Value="0" />
									<Setter Property="HorizontalContentAlignment" Value="Stretch" />
									<Setter Property="VerticalContentAlignment" Value="Stretch" />
									<Setter Property="AutomationProperties.Name" Value="{Binding ElementType}" />
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="ListBoxItem">
												<Grid Background="Transparent">
													<Border x:Name="ElementFrame" BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Padding="2">
														<ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
															HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
													</Border>

													<primitives:Thumb x:Name="ResizeNW" Tag="NW" Style="{StaticResource DesignerResizeHandleStyle}" Cursor="SizeNWSE"
														HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
													<primitives:Thumb x:Name="ResizeN" Tag="N" Style="{StaticResource DesignerResizeHandleStyle}" Cursor="SizeNS"
														HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
													<primitives:Thumb x:Name="ResizeNE" Tag="NE" Style="{StaticResource DesignerResizeHandleStyle}" Cursor="SizeNESW"
														HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
													<primitives:Thumb x:Name="ResizeE" Tag="E" Style="{StaticResource DesignerResizeHandleStyle}" Cursor="SizeWE"
														HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,0" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
													<primitives:Thumb x:Name="ResizeSE" Tag="SE" Style="{StaticResource DesignerResizeHandleStyle}" Cursor="SizeNWSE"
														HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
													<primitives:Thumb x:Name="ResizeS" Tag="S" Style="{StaticResource DesignerResizeHandleStyle}" Cursor="SizeNS"
														HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
													<primitives:Thumb x:Name="ResizeSW" Tag="SW" Style="{StaticResource DesignerResizeHandleStyle}" Cursor="SizeNESW"
														HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-4" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
													<primitives:Thumb x:Name="ResizeW" Tag="W" Style="{StaticResource DesignerResizeHandleStyle}" Cursor="SizeWE"
														HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,0,0,0" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
												</Grid>
												<ControlTemplate.Triggers>
													<DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
														<Setter TargetName="ElementFrame" Property="BorderBrush" Value="#406B7280" />
														<Setter TargetName="ElementFrame" Property="Background" Value="#08111827" />
													</DataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
															<Condition Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter TargetName="ElementFrame" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
														<Setter TargetName="ElementFrame" Property="BorderThickness" Value="2" />
														<Setter TargetName="ResizeNW" Property="Visibility" Value="Visible" />
														<Setter TargetName="ResizeN" Property="Visibility" Value="Visible" />
														<Setter TargetName="ResizeNE" Property="Visibility" Value="Visible" />
														<Setter TargetName="ResizeE" Property="Visibility" Value="Visible" />
														<Setter TargetName="ResizeSE" Property="Visibility" Value="Visible" />
														<Setter TargetName="ResizeS" Property="Visibility" Value="Visible" />
														<Setter TargetName="ResizeSW" Property="Visibility" Value="Visible" />
														<Setter TargetName="ResizeW" Property="Visibility" Value="Visible" />
													</MultiDataTrigger>
													<Trigger Property="IsEnabled" Value="False">
														<Setter TargetName="ResizeNW" Property="Visibility" Value="Collapsed" />
														<Setter TargetName="ResizeN" Property="Visibility" Value="Collapsed" />
														<Setter TargetName="ResizeNE" Property="Visibility" Value="Collapsed" />
														<Setter TargetName="ResizeE" Property="Visibility" Value="Collapsed" />
														<Setter TargetName="ResizeSE" Property="Visibility" Value="Collapsed" />
														<Setter TargetName="ResizeS" Property="Visibility" Value="Collapsed" />
														<Setter TargetName="ResizeSW" Property="Visibility" Value="Collapsed" />
														<Setter TargetName="ResizeW" Property="Visibility" Value="Collapsed" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</ListBox.ItemContainerStyle>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding DisplayText}" FontSize="{Binding FontSize}" Foreground="#FF111827" TextTrimming="CharacterEllipsis" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
										VerticalAlignment="Center" HorizontalAlignment="Stretch" IsHitTestVisible="False" />
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Border>
				</ScrollViewer>
			</Grid>

			<controls:Card Grid.Column="2" Style="{StaticResource WorkspaceCardStyle}">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel IsEnabled="{Binding IsEditing}">
						<TextBlock Text="Properties" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
						<TextBlock Text="Template name" />
						<controls:TextInput Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" AutomationProperties.Name="Template name" />

						<Separator Margin="0,2,0,10" />
						<TextBlock Text="Element" FontWeight="SemiBold" Margin="0,0,0,8" />
						<TextBlock Text="Element ID" />
						<controls:TextInput Text="{Binding SelectedElement.Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" AutomationProperties.Name="Element ID" />

						<TextBlock Text="Geometry" FontWeight="SemiBold" Margin="0,4,0,6" />
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="X" /><controls:TextInput Text="{Binding SelectedElement.X, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Element X" /></StackPanel>
							<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Y" /><controls:TextInput Text="{Binding SelectedElement.Y, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Element Y" /></StackPanel>
						</Grid>
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Width" /><controls:TextInput Text="{Binding SelectedElement.Width, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Element width" /></StackPanel>
							<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Height" /><controls:TextInput Text="{Binding SelectedElement.Height, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Element height" /></StackPanel>
						</Grid>

						<StackPanel Visibility="{Binding ShowBindingProperty, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock Text="Binding" />
							<ComboBox ItemsSource="{Binding Bindings}" SelectedItem="{Binding SelectedElement.Binding, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,3,0,8" AutomationProperties.Name="Element binding" />
						</StackPanel>

						<StackPanel Visibility="{Binding ShowTextProperty, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock Text="Text" />
							<TextBox Text="{Binding SelectedElement.Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Style="{StaticResource MultilineTextBoxStyle}" AutomationProperties.Name="Element text" />
						</StackPanel>

						<StackPanel Visibility="{Binding ShowTypographyProperties, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock Text="Typography" FontWeight="SemiBold" Margin="0,4,0,6" />
							<TextBlock Text="Font" />
							<controls:TextInput Text="{Binding SelectedElement.Font, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" AutomationProperties.Name="Font family" />
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Font size" /><controls:TextInput Text="{Binding SelectedElement.FontSize, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Font size" /></StackPanel>
								<StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Weight" /><ComboBox ItemsSource="{Binding FontWeights}" SelectedItem="{Binding SelectedElement.FontWeight}" AutomationProperties.Name="Font weight" /></StackPanel>
							</Grid>
							<TextBlock Text="Alignment" />
							<ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding SelectedElement.Alignment}" Margin="0,3,0,8" AutomationProperties.Name="Text alignment" />
						</StackPanel>

						<StackPanel Visibility="{Binding ShowFormatProperty, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock Text="Format" />
							<controls:TextInput Text="{Binding SelectedElement.Format, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" AutomationProperties.Name="Element format" />
						</StackPanel>

						<StackPanel Visibility="{Binding ShowVisibilityProperty, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock Text="Visibility binding" />
							<ComboBox ItemsSource="{Binding Bindings}" SelectedItem="{Binding SelectedElement.Visibility, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,3,0,8" AutomationProperties.Name="Visibility binding" />
						</StackPanel>

						<controls:AppCheckBox Content="Border" IsChecked="{Binding SelectedElement.Border}" Margin="0,2,0,6"
							Visibility="{Binding ShowBorderProperty, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<controls:AppCheckBox Content="Repeat on every page" IsChecked="{Binding SelectedElement.RepeatOnEveryPage}" Margin="0,0,0,6"
							Visibility="{Binding ShowRepeatProperty, Converter={StaticResource BooleanToVisibilityConverter}}" />

						<StackPanel Visibility="{Binding ShowPlacementProperty, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock Text="Placement" />
							<ComboBox ItemsSource="{Binding Placements}" SelectedItem="{Binding SelectedElement.Placement}" Margin="0,3,0,8" AutomationProperties.Name="Element placement" />
						</StackPanel>

						<StackPanel Visibility="{Binding ShowRowHeightProperty, Converter={StaticResource BooleanToVisibilityConverter}}">
							<TextBlock Text="Table options" FontWeight="SemiBold" Margin="0,4,0,6" />
							<TextBlock Text="Row height" />
							<controls:TextInput Text="{Binding SelectedElement.RowHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8" AutomationProperties.Name="Table row height" />
						</StackPanel>
						<TextBlock Text="Line tables use the validated column bindings already stored in the template; no unrelated element-level binding options are shown."
							TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"
							Visibility="{Binding ShowLineTableHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
					</StackPanel>
				</ScrollViewer>
			</controls:Card>
		</Grid>

		<Grid Grid.Row="3" Margin="0,12,0,0">
			<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
			<StackPanel>
				<TextBlock Text="{Binding ValidationSummary}" FontWeight="SemiBold" />
				<ItemsControl ItemsSource="{Binding ValidationErrors}">
					<ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" /></DataTemplate></ItemsControl.ItemTemplate>
				</ItemsControl>
				<TextBlock Text="{Binding PreviewStatus}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
