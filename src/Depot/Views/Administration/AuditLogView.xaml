<UserControl
	x:Class="Depot.Views.Administration.AuditLogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="12" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="8" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="12" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:PageHeader Grid.Row="0" Title="Audit Log" Subtitle="Read-only history of security and business changes.">
			<controls:PageHeader.Actions>
				<StackPanel Orientation="Horizontal">
					<controls:OperationStatus ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
					<Button Margin="12,0,0,0" Command="{Binding ExportCommand}" Content="Export CSV" Style="{StaticResource SecondaryButtonStyle}" />
				</StackPanel>
			</controls:PageHeader.Actions>
		</controls:PageHeader>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="12" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="12" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="12" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="12" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<controls:SearchBox Grid.Column="0" Placeholder="Search user, action or entity" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
			<TextBox Grid.Column="2" Style="{StaticResource AppTextBoxStyle}" Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="User email filter" />
			<ComboBox Grid.Column="4" ItemsSource="{Binding EntityTypes}" SelectedItem="{Binding SelectedEntityType}" ToolTip="Entity type (blank means all)" />
			<ComboBox Grid.Column="6" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" ToolTip="Action (blank means all)" />
			<TextBox Grid.Column="8" Style="{StaticResource AppTextBoxStyle}" Text="{Binding EntityIdFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Entity ID" />
		</Grid>

		<Grid Grid.Row="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="140" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="140" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<TextBlock VerticalAlignment="Center" Text="From (local)" Style="{StaticResource FormLabelStyle}" />
			<DatePicker Grid.Column="1" Margin="8,0,0,0" SelectedDate="{Binding FromDate}" />
			<TextBlock Grid.Column="3" VerticalAlignment="Center" Text="To (local)" Style="{StaticResource FormLabelStyle}" />
			<DatePicker Grid.Column="4" Margin="8,0,0,0" SelectedDate="{Binding ToDate}" />
			<Button Grid.Column="6" Command="{Binding ClearFiltersCommand}" Content="Clear filters" Style="{StaticResource SecondaryButtonStyle}" />
		</Grid>

		<Grid Grid.Row="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="5*" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="4*" />
			</Grid.ColumnDefinitions>

			<Grid Grid.Column="0">
				<Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" IsReadOnly="True" AutoGenerateColumns="False" Style="{StaticResource AppDataGridStyle}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Local time" Binding="{Binding TimestampLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145" />
						<DataGridTextColumn Header="User" Binding="{Binding UserEmail}" Width="*" />
						<DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100" />
						<DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="130" />
						<DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="75" />
					</DataGrid.Columns>
				</DataGrid>
				<StackPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
					<TextBlock VerticalAlignment="Center" Text="{Binding TotalCount, StringFormat={}{0:N0} entries}" />
					<Button Margin="16,0,0,0" Command="{Binding PreviousPageCommand}" Content="Previous" Style="{StaticResource SecondaryButtonStyle}" />
					<TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding PageNumber, StringFormat=Page {0}}" />
					<Button Command="{Binding NextPageCommand}" Content="Next" Style="{StaticResource SecondaryButtonStyle}" />
				</StackPanel>
			</Grid>

			<controls:Card Grid.Column="2">
				<Grid>
					<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="Select an audit entry to load details." Visibility="{Binding HasNoDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
					<ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
						<StackPanel>
							<TextBlock Text="Audit details" Style="{StaticResource SectionTitleStyle}" />
							<TextBlock Margin="0,8,0,0" Text="{Binding Details.Entry.UserEmail, StringFormat=User: {0}}" />
							<TextBlock Text="{Binding Details.Entry.TimestampUtc, StringFormat=UTC: {0:yyyy-MM-dd HH:mm:ss}Z}" />
							<TextBlock Text="{Binding Details.Entry.TimestampLocal, StringFormat=Local: {0:yyyy-MM-dd HH:mm:ss zzz}}" />
							<TextBlock Text="{Binding Details.Entry.Action, StringFormat=Action: {0}}" />
							<TextBlock Text="{Binding Details.Entry.EntityType, StringFormat=Entity: {0}}" />
							<TextBlock Text="{Binding Details.Entry.EntityId, StringFormat=Entity ID: {0}}" />
							<TextBlock Margin="0,16,0,6" Text="Changed values" Style="{StaticResource FormLabelStyle}" />
							<DataGrid Height="180" ItemsSource="{Binding Details.Changes}" IsReadOnly="True" AutoGenerateColumns="False" Style="{StaticResource AppDataGridStyle}">
								<DataGrid.Columns>
									<DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="*" />
									<DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*" />
									<DataGridTextColumn Header="After" Binding="{Binding After}" Width="*" />
								</DataGrid.Columns>
							</DataGrid>
							<TextBlock Margin="0,16,0,6" Text="Before (sanitized)" Style="{StaticResource FormLabelStyle}" />
							<TextBox Height="180" IsReadOnly="True" AcceptsReturn="True" Text="{Binding Details.BeforeJson}" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
							<TextBlock Margin="0,16,0,6" Text="After (sanitized)" Style="{StaticResource FormLabelStyle}" />
							<TextBox Height="180" IsReadOnly="True" AcceptsReturn="True" Text="{Binding Details.AfterJson}" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
						</StackPanel>
					</ScrollViewer>
				</Grid>
			</controls:Card>
		</Grid>
	</Grid>
</UserControl>
