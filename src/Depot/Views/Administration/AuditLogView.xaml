<UserControl x:Class="Depot.Views.Administration.AuditLogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" /><Button Grid.Column="1" Command="{Binding ExportCommand}" Content="Export CSV" Style="{StaticResource SecondaryButtonStyle}" /></Grid>
		<controls:FilterBar Grid.Row="1"><Grid>
			<Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
			<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
			<TextBlock Text="Search" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Column="2" Text="User" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Column="4" Text="Entity type" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Column="6" Text="Action" Style="{StaticResource FormLabelStyle}" />
			<controls:SearchBox Grid.Row="2" automation:AutomationProperties.Name="Search audit log" Placeholder="User, action, or entity" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /><TextBox Grid.Row="2" Grid.Column="2" automation:AutomationProperties.Name="User filter" Style="{StaticResource AppTextBoxStyle}" Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" /><ComboBox Grid.Row="2" Grid.Column="4" automation:AutomationProperties.Name="Entity type filter" ItemsSource="{Binding EntityTypes}" SelectedItem="{Binding SelectedEntityType}" Style="{StaticResource AppComboBoxStyle}" /><ComboBox Grid.Row="2" Grid.Column="6" automation:AutomationProperties.Name="Action filter" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" Style="{StaticResource AppComboBoxStyle}" />
			<TextBlock Grid.Row="4" Text="Entity ID" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="2" Text="From (local)" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="4" Text="To (local)" Style="{StaticResource FormLabelStyle}" />
			<TextBox Grid.Row="6" automation:AutomationProperties.Name="Entity ID filter" Style="{StaticResource AppTextBoxStyle}" Text="{Binding EntityIdFilter, UpdateSourceTrigger=PropertyChanged}" /><DatePicker Grid.Row="6" Grid.Column="2" automation:AutomationProperties.Name="Audit from date local" SelectedDate="{Binding FromDate}" /><DatePicker Grid.Row="6" Grid.Column="4" automation:AutomationProperties.Name="Audit to date local" SelectedDate="{Binding ToDate}" /><Button Grid.Row="6" Grid.Column="6" HorizontalAlignment="Right" Command="{Binding ClearFiltersCommand}" Content="Clear filters" Style="{StaticResource SecondaryButtonStyle}" />
		</Grid></controls:FilterBar>
		<controls:MasterDetailGrid Grid.Row="3">
			<controls:MasterDetailGrid.Master><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid>
				<DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Local time" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="User" Binding="{Binding UserEmail}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="120" ElementStyle="{StaticResource AppDataGridTextStyle}" /></DataGrid.Columns></DataGrid>
				<controls:WorkflowListState ItemCount="{Binding Entries.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" />
			</Grid><controls:PaginationControl Grid.Row="1" Margin="0,12,0,0" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageNumber, StringFormat=Page {0}}" ToolTip="{Binding TotalCount, StringFormat={}{0:N0} entries}" /></Grid></controls:Card></controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail><controls:Card><Grid>
				<controls:EmptyState Title="No audit entry selected" Description="Select an entry to load its sanitized details." Visibility="{Binding HasNoDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
				<Grid Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
					<controls:WorkflowHeader Title="Audit details" Subtitle="{Binding Details.Entry.EntityType}" Status="{Binding Details.Entry.Action}" />
					<TabControl Grid.Row="2" Style="{StaticResource AppTabControlStyle}">
						<TabItem Header="Summary"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="User" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Column="2" Text="Entity" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Row="2" IsReadOnly="True" Style="{StaticResource AppTextBoxStyle}" Text="{Binding Details.Entry.UserEmail, Mode=OneWay}" ToolTip="{Binding Details.Entry.UserEmail}" /><TextBox Grid.Row="2" Grid.Column="2" IsReadOnly="True" Style="{StaticResource AppTextBoxStyle}" Text="{Binding Details.Entry.EntityType, Mode=OneWay}" /><TextBlock Grid.Row="4" Text="Local time" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="2" Text="UTC time" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Row="6" IsReadOnly="True" Style="{StaticResource AppTextBoxStyle}" Text="{Binding Details.Entry.TimestampLocal, Mode=OneWay, StringFormat={}{0:G}}" /><TextBox Grid.Row="6" Grid.Column="2" IsReadOnly="True" Style="{StaticResource AppTextBoxStyle}" Text="{Binding Details.Entry.TimestampUtc, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" /><TextBlock Grid.Row="8" Text="Entity ID" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Row="10" IsReadOnly="True" Style="{StaticResource AppTextBoxStyle}" Text="{Binding Details.Entry.EntityId, Mode=OneWay, StringFormat={}{0:N0}}" /></Grid></TabItem>
						<TabItem Header="Changes"><DataGrid ItemsSource="{Binding Details.Changes}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="160" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="After" Binding="{Binding After}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" /></DataGrid.Columns></DataGrid></TabItem>
						<TabItem Header="Sanitized JSON"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Before" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Column="2" Text="After" Style="{StaticResource FormLabelStyle}" /><TextBox Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" Text="{Binding Details.BeforeJson}" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{StaticResource MultilineTextBoxStyle}" /><TextBox Grid.Row="2" Grid.Column="2" IsReadOnly="True" AcceptsReturn="True" Text="{Binding Details.AfterJson}" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{StaticResource MultilineTextBoxStyle}" /></Grid></TabItem>
					</TabControl>
				</Grid>
			</Grid></controls:Card></controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>
