<UserControl x:Class="Depot.Views.Administration.SecurityCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Security Center"
                             Subtitle="Investigate authentication and session risk, apply controlled response actions, and manage authentication security policy." />

        <controls:OperationPanel Grid.Row="1" Margin="0,10,0,0"
                                 IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}"
                                 StatusText="{Binding StatusText}" ErrorText="{Binding OperationError}" />

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,12,0,12">
            <controls:Card Margin="0,0,6,6"><StackPanel><TextBlock Text="Events 24h" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding Events24Hours, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" Margin="0,8,0,0" /></StackPanel></controls:Card>
            <controls:Card Margin="6,0,6,6"><StackPanel><TextBlock Text="Suspicious 24h" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding Suspicious24Hours, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" Margin="0,8,0,0" /></StackPanel></controls:Card>
            <controls:Card Margin="6,0,0,6"><StackPanel><TextBlock Text="High Risk Open" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding HighRiskOpen, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" Margin="0,8,0,0" /></StackPanel></controls:Card>
            <controls:Card Margin="0,6,6,0"><StackPanel><TextBlock Text="Blocked 24h" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding Blocked24Hours, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" Margin="0,8,0,0" /></StackPanel></controls:Card>
            <controls:Card Margin="6,6,6,0"><StackPanel><TextBlock Text="Reviewed 24h" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding Reviewed24Hours, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" Margin="0,8,0,0" /></StackPanel></controls:Card>
            <controls:Card Margin="6,6,0,0"><StackPanel><TextBlock Text="Open Unreviewed" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding OpenUnreviewed, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" Margin="0,8,0,0" /></StackPanel></controls:Card>
        </UniformGrid>

        <controls:FilterBar Grid.Row="3" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:SearchBox automation:AutomationProperties.Name="Search security events" Placeholder="Search account, client, summary or details" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding MinimumSeverity}" Style="{StaticResource AppComboBoxStyle}" ToolTip="Minimum severity" />
                <controls:AppCheckBox Grid.Column="4" VerticalAlignment="Center" Content="Only unreviewed" IsChecked="{Binding OnlyUnreviewed}" />
                <Button Grid.Column="6" Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </controls:FilterBar>

        <TabControl Grid.Row="4" Style="{StaticResource AppTabControlStyle}">
            <TabItem Header="Events &amp; Response">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource WorkspaceSectionStyle}">
                        <Grid MinHeight="420">
                            <DataGrid automation:AutomationProperties.Name="Security events" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" Style="{StaticResource AppDataGridCompactStyle}" Visibility="{Binding HasEvents, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="135" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                    <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="1.15*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                    <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="1.25*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                    <DataGridTextColumn Header="Client" Binding="{Binding MachineName}" Width="1*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="1.6*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <controls:EmptyState Title="No matching security events" Description="No security events match the current filters." Visibility="{Binding HasNoEvents, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource WorkspaceSectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Selected event" Style="{StaticResource WorkspaceSectionTitleStyle}" />
                                    <TextBlock Text="{Binding SelectedEvent.Summary}" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedEvent.Details}" Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Session" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding SelectedEvent.SessionId}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="Client instance" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding SelectedEvent.ClientInstanceId}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <Button Margin="0,12,0,0" automation:AutomationProperties.Name="Mark selected security event reviewed" Command="{Binding MarkReviewedCommand}" Content="Mark reviewed" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <controls:Card Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Investigation context" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{Binding InvestigationUser}" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding InvestigationUserStatus, StringFormat=Account status: {0}}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Margin="0,0,8,8" Command="{Binding TerminateSessionCommand}" Content="Terminate session" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanTerminateSessions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Margin="0,0,8,8" Command="{Binding TerminateUserSessionsCommand}" Content="Terminate all sessions" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanTerminateSessions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Margin="0,0,0,8" Command="{Binding DeactivateUserCommand}" Content="Deactivate user" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanDeactivateUsers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </WrapPanel>
                                    <TextBlock Text="Open sessions" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,4" />
                                    <ItemsControl ItemsSource="{Binding InvestigationSessions}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Client, StringFormat={}{0}}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" ToolTip="{Binding SessionId}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Related events" Style="{StaticResource FormLabelStyle}" Margin="0,12,0,4" />
                                    <ItemsControl ItemsSource="{Binding RelatedEvents}">
                                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,2,0,6"><TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" /><TextBlock Text="{Binding TimestampLocal, StringFormat={}{0:g}}" Style="{StaticResource HintStyle}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Authentication Policy">
                <Border Margin="0,10,0,0" Style="{StaticResource WorkspaceSectionStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Authentication security policy" Style="{StaticResource WorkspaceSectionTitleStyle}" />
                                <TextBlock Text="Controls shared failed-login throttling, lockout and Security Event retention across all Depot clients." Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AuthenticationPolicyRangeHint}" Style="{StaticResource HintStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Command="{Binding SaveAuthenticationPolicyCommand}" Content="Save policy" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanManageAuthenticationPolicy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <StackPanel Margin="0,0,12,12"><TextBlock Text="Failure window (minutes)" Style="{StaticResource FormLabelStyle}" /><TextBox Margin="0,4,0,0" Style="{StaticResource AppTextBoxStyle}" Text="{Binding FailureWindowMinutes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanManageAuthenticationPolicy}" /></StackPanel>
                            <StackPanel Margin="0,0,0,12"><TextBlock Text="Lockout threshold" Style="{StaticResource FormLabelStyle}" /><TextBox Margin="0,4,0,0" Style="{StaticResource AppTextBoxStyle}" Text="{Binding LockoutThreshold, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanManageAuthenticationPolicy}" /></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Lockout duration (minutes)" Style="{StaticResource FormLabelStyle}" /><TextBox Margin="0,4,0,0" Style="{StaticResource AppTextBoxStyle}" Text="{Binding LockoutDurationMinutes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanManageAuthenticationPolicy}" /></StackPanel>
                            <StackPanel><TextBlock Text="Security Event retention (days)" Style="{StaticResource FormLabelStyle}" /><TextBox Margin="0,4,0,0" Style="{StaticResource AppTextBoxStyle}" Text="{Binding SecurityEventRetentionDays, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanManageAuthenticationPolicy}" /></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
