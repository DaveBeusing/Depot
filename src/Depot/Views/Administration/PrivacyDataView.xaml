<UserControl
	x:Class="Depot.Views.Administration.PrivacyDataView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="12" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="12" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:PageHeader Title="Privacy Data" Subtitle="Locate personal data stored in Depot and create machine-readable discovery evidence without bypassing legal retention requirements." />
		<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />

		<controls:FilterBar Grid.Row="3">
			<Grid>
				<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
				<controls:SearchBox AutomationProperties.Name="Personal data search" Placeholder="Search name, email or identifier" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
				<Button Grid.Column="2" Command="{Binding SearchCommand}" Content="Search" Style="{StaticResource SecondaryButtonStyle}" />
				<Button Grid.Column="4" Command="{Binding ExportCommand}" Content="Export JSON" Style="{StaticResource SecondaryButtonStyle}" />
			</Grid>
		</controls:FilterBar>

		<Border Grid.Row="5" Style="{StaticResource WorkspaceSectionStyle}">
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
				<TextBlock Text="{Binding GeneratedDisplay}" Style="{StaticResource CaptionStyle}" />
				<Grid Grid.Row="2">
					<DataGrid AutomationProperties.Name="Personal data matches" ItemsSource="{Binding Records}" IsReadOnly="True" SelectionMode="Single" Style="{StaticResource AppDataGridCompactStyle}">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
							<DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150" />
							<DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="80" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
							<DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="2*" />
							<DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
						</DataGrid.Columns>
					</DataGrid>
					<controls:WorkflowListState ItemCount="{Binding Records.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" />
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
