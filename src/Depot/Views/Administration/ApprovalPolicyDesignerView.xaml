<UserControl x:Class="Depot.Views.Administration.ApprovalPolicyDesignerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls"
	xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
	<Grid Margin="20">
		<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
			<StackPanel>
				<TextBlock Text="Approval Policies" Style="{StaticResource PageTitleStyle}"/>
				<TextBlock Text="Configure bounded approval routing while domain services remain authoritative." Style="{StaticResource BodyStyle}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
			</StackPanel>
			<WrapPanel Grid.Column="1" VerticalAlignment="Center">
				<Button Content="New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
				<Button Content="Discard" Command="{Binding DiscardCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
				<Button Content="{Binding ActivationButtonText}" Command="{Binding ToggleActiveCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
				<Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
			</WrapPanel>
		</Grid>
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
			<controls:Card Grid.Column="0" Style="{StaticResource WorkspaceCardStyle}">
				<Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
					<TextBlock Text="Policies" Style="{StaticResource SectionTitleStyle}"/>
					<ListBox Grid.Row="2" ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy}" Style="{StaticResource AppListBoxStyle}" automation:AutomationProperties.Name="Approval policies">
						<ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SubjectKind}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{Binding Priority, StringFormat=Priority {0}}" Style="{StaticResource CaptionStyle}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</controls:Card>
			<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<controls:Card Style="{StaticResource WorkspaceCardStyle}" Margin="0,0,0,12">
						<StackPanel>
							<TextBlock Text="Policy" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
							<TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
							<TextBlock Text="Description" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Margin="0,3,0,8"/>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
								<StackPanel><TextBlock Text="Subject" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding SubjectKinds}" SelectedItem="{Binding SubjectKind}" Margin="0,3,0,8"/></StackPanel>
								<StackPanel Grid.Column="2"><TextBlock Text="Priority" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Priority,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/></StackPanel>
							</Grid>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
								<StackPanel><TextBlock Text="Effective from (UTC)" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding EffectiveFromUtc}"/></StackPanel>
								<StackPanel Grid.Column="2"><TextBlock Text="Effective to (UTC)" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding EffectiveToUtc}"/></StackPanel>
							</Grid>
						</StackPanel>
					</controls:Card>
					<controls:Card Style="{StaticResource WorkspaceCardStyle}" Margin="0,0,0,12">
						<Grid>
							<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="175"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
							<TextBlock Text="Conditions" Style="{StaticResource SectionTitleStyle}"/>
							<DataGrid Grid.Row="2" ItemsSource="{Binding Conditions}" SelectedItem="{Binding SelectedCondition}" AutoGenerateColumns="False" Style="{StaticResource AppDataGridCompactStyle}">
								<DataGrid.Columns>
									<DataGridTemplateColumn Header="Kind" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.ConditionKinds,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Kind,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
									<DataGridTextColumn Header="Decimal" Binding="{Binding DecimalValue,UpdateSourceTrigger=PropertyChanged}" Width="90"/>
									<DataGridTextColumn Header="Text" Binding="{Binding StringValue,UpdateSourceTrigger=PropertyChanged}" Width="*"/>
									<DataGridTextColumn Header="Identifier" Binding="{Binding GuidValue,UpdateSourceTrigger=PropertyChanged}" Width="220"/>
								</DataGrid.Columns>
							</DataGrid>
							<WrapPanel Grid.Row="4"><Button Content="Add condition" Command="{Binding AddConditionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Remove" Command="{Binding RemoveConditionCommand}" Style="{StaticResource DangerButtonStyle}"/></WrapPanel>
						</Grid>
					</controls:Card>
					<controls:Card Style="{StaticResource WorkspaceCardStyle}">
						<Grid>
							<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="320"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
							<TextBlock Text="Approval stages" Style="{StaticResource SectionTitleStyle}"/>
							<ListBox Grid.Row="2" ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage}" Style="{StaticResource AppListBoxStyle}">
								<ListBox.ItemTemplate><DataTemplate>
									<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
										<StackPanel>
											<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:TextInput Text="{Binding Order,UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="2" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/></Grid>
											<DataGrid Margin="0,8,0,0" Height="120" ItemsSource="{Binding Approvers}" SelectedItem="{Binding DataContext.SelectedApprover,RelativeSource={RelativeSource AncestorType=UserControl},Mode=TwoWay}" AutoGenerateColumns="False" Style="{StaticResource AppDataGridCompactStyle}">
												<DataGrid.Columns>
													<DataGridTemplateColumn Header="Kind" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.ApproverKinds,RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Kind,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
													<DataGridTextColumn Header="Role code" Binding="{Binding RoleCode,UpdateSourceTrigger=PropertyChanged}" Width="*"/>
													<DataGridTextColumn Header="User ID" Binding="{Binding UserId,UpdateSourceTrigger=PropertyChanged}" Width="90"/>
												</DataGrid.Columns>
											</DataGrid>
										</StackPanel>
									</Border>
								</DataTemplate></ListBox.ItemTemplate>
							</ListBox>
							<WrapPanel Grid.Row="4"><Button Content="Add stage" Command="{Binding AddStageCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Remove stage" Command="{Binding RemoveStageCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,16,0"/><Button Content="Add approver" Command="{Binding AddApproverCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Remove approver" Command="{Binding RemoveApproverCommand}" Style="{StaticResource DangerButtonStyle}"/></WrapPanel>
						</Grid>
					</controls:Card>
				</StackPanel>
			</ScrollViewer>
			<ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<controls:Card Style="{StaticResource WorkspaceCardStyle}" Margin="0,0,0,12">
						<StackPanel>
							<TextBlock Text="Preview / test" Style="{StaticResource SectionTitleStyle}"/>
							<TextBlock Text="Sample values never mutate business data." Style="{StaticResource CaptionStyle}" Margin="0,2,0,10"/>
							<TextBlock Text="Amount" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding PreviewAmount,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
							<TextBlock Text="Currency" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding PreviewCurrency,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
							<TextBlock Text="Legal entity ID" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding PreviewLegalEntityId,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
							<TextBlock Text="Accounting book ID" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding PreviewAccountingBookId,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"/>
							<Button Content="Resolve preview" Command="{Binding PreviewCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
							<TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource CaptionStyle}"/>
						</StackPanel>
					</controls:Card>
					<controls:Card Style="{StaticResource WorkspaceCardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Resolved flow" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/><controls:ApprovalFlowVisualizer Projection="{Binding PreviewFlow}"/></StackPanel></controls:Card>
					<controls:Card Style="{StaticResource WorkspaceCardStyle}"><StackPanel><TextBlock Text="Validation" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding ValidationIssues}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></controls:Card>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
