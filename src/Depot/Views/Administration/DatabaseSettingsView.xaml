<UserControl
	x:Class="Depot.Views.Administration.DatabaseSettingsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:commands="clr-namespace:Depot.Commands"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="8" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid>
			<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
			<controls:OperationPanel
				ErrorText="{Binding OperationError}"
				HasError="{Binding HasOperationError}"
				HelpTopicId="troubleshooting.database-connection-failures"
				IsBusy="{Binding IsBusy}"
				StatusText="{Binding StatusText}" />
			<StackPanel Grid.Column="1" Orientation="Horizontal">
				<Button MinWidth="{DynamicResource Help.ContextButton.MinWidth}" AutomationProperties.Name="Open database configuration help" Command="{x:Static commands:HelpCommands.OpenTopic}" CommandParameter="administration.database" Content="Help" Style="{DynamicResource SecondaryButtonStyle}" />
				<Button MinWidth="{DynamicResource Help.ContextButton.MinWidth}" Margin="{DynamicResource Button.Margin}" AutomationProperties.Name="Open backup and restore help" Command="{x:Static commands:HelpCommands.OpenTopic}" CommandParameter="administration.backup-restore" Content="Backup Help" Style="{DynamicResource SecondaryButtonStyle}" />
			</StackPanel>
		</Grid>

		<TabControl Grid.Row="2" Style="{StaticResource AppTabControlStyle}">
			<TabItem Header="Connection">
				<Grid>
					<Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<StackPanel HorizontalAlignment="Stretch">
						<controls:ConnectionStatusIndicator
							Margin="0,0,0,16"
							State="{Binding ConnectionStatus.State}"
							Status="{Binding ConnectionStatus.Status}"
							Detail="{Binding ConnectionStatus.Detail}" />

						<controls:FilterBar>
							<WrapPanel>
								<RadioButton Content="Local database" GroupName="DatabaseProvider" IsChecked="{Binding UseLocalDatabase}" Style="{StaticResource OptionRadioButtonStyle}" />
								<RadioButton Margin="{DynamicResource Button.Margin}" Content="SQL Server" GroupName="DatabaseProvider" IsChecked="{Binding UseSqlServer}" Style="{StaticResource OptionRadioButtonStyle}" />
								<RadioButton Margin="{DynamicResource Button.Margin}" Content="MySQL / MariaDB" GroupName="DatabaseProvider" IsChecked="{Binding UseMySql}" Style="{StaticResource OptionRadioButtonStyle}" />
							</WrapPanel>
						</controls:FilterBar>

						<controls:Card Visibility="{Binding UseLocalDatabase, Converter={StaticResource BooleanToVisibilityConverter}}">
							<StackPanel>
								<TextBlock Text="Local SQLite database" Style="{StaticResource CardTitleStyle}" />
								<TextBlock Margin="{DynamicResource Control.Margin.Large}" Text="Database file" Style="{StaticResource FormLabelStyle}" />
								<TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding LocalDatabasePath}" />
								<TextBlock Margin="{DynamicResource Control.Margin}" Text="Used on first installation and as the current fallback database." Style="{StaticResource HintStyle}" />
							</StackPanel>
						</controls:Card>

						<controls:Card Visibility="{Binding IsMySqlSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
							<StackPanel>
								<TextBlock Text="MySQL / MariaDB connection" Style="{StaticResource CardTitleStyle}" />
								<Grid Margin="{DynamicResource Control.Margin.Large}">
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
									<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
									<TextBlock Text="Server" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Column="2" Text="Port" Style="{StaticResource FormLabelStyle}" />
									<TextBox Grid.Row="2" Style="{StaticResource AppTextBoxStyle}" Text="{Binding MySqlHost}" /><TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource AppTextBoxStyle}" Text="{Binding MySqlPort}" />
									<TextBlock Grid.Row="4" Text="Database" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="2" Text="User name" Style="{StaticResource FormLabelStyle}" />
									<TextBox Grid.Row="6" Style="{StaticResource AppTextBoxStyle}" Text="{Binding MySqlDatabase}" /><TextBox Grid.Row="6" Grid.Column="2" Style="{StaticResource AppTextBoxStyle}" Text="{Binding MySqlUserName}" />
									<TextBlock Grid.Row="8" Text="Password" Style="{StaticResource FormLabelStyle}" />
									<controls:PasswordInput Grid.Row="10" PasswordValue="{Binding MySqlPassword, UpdateSourceTrigger=PropertyChanged}" />
									<CheckBox Grid.Row="10" Grid.Column="2" VerticalAlignment="Center" Content="Require TLS encryption" IsChecked="{Binding UseMySqlTls}" Style="{StaticResource AppCheckBoxStyle}" />
								</Grid>
							</StackPanel>
						</controls:Card>

						<controls:Card Visibility="{Binding IsSqlServerSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
							<StackPanel>
								<TextBlock Text="SQL Server connection" Style="{StaticResource CardTitleStyle}" />
								<Grid Margin="{DynamicResource Control.Margin.Large}">
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
									<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
									<TextBlock Text="Server" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Column="2" Text="Port" Style="{StaticResource FormLabelStyle}" />
									<TextBox Grid.Row="2" Style="{StaticResource AppTextBoxStyle}" Text="{Binding SqlServerHost}" /><TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource AppTextBoxStyle}" Text="{Binding SqlServerPort}" />
									<TextBlock Grid.Row="4" Text="Database" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="2" Text="User name" Style="{StaticResource FormLabelStyle}" />
									<TextBox Grid.Row="6" Style="{StaticResource AppTextBoxStyle}" Text="{Binding SqlServerDatabase}" /><TextBox Grid.Row="6" Grid.Column="2" Style="{StaticResource AppTextBoxStyle}" Text="{Binding SqlServerUserName}" />
									<TextBlock Grid.Row="8" Text="Password" Style="{StaticResource FormLabelStyle}" />
									<controls:PasswordInput Grid.Row="10" PasswordValue="{Binding SqlServerPassword, UpdateSourceTrigger=PropertyChanged}" />
									<StackPanel Grid.Row="10" Grid.Column="2"><CheckBox Content="Encrypt connection" IsChecked="{Binding EncryptSqlServerConnection}" Style="{StaticResource AppCheckBoxStyle}" /><CheckBox Margin="{DynamicResource Control.Margin}" Content="Trust server certificate" IsChecked="{Binding TrustSqlServerCertificate}" Style="{StaticResource AppCheckBoxStyle}" /></StackPanel>
								</Grid>
							</StackPanel>
						</controls:Card>

						<Border Margin="{DynamicResource Control.Margin.Large}" Padding="{DynamicResource Card.Padding}" Background="{StaticResource WarningBrush}" CornerRadius="{StaticResource CornerRadius.Small}">
							<TextBlock Foreground="{StaticResource WarningForegroundBrush}" Text="Provider changes are verified before saving and become active after restarting Depot. Server credentials remain encrypted in depot.settings." TextWrapping="Wrap" />
						</Border>

						<Grid Margin="{DynamicResource Control.Margin.Large}">
							<Border Padding="{DynamicResource Card.Padding}" Background="{StaticResource SuccessBrush}" CornerRadius="{StaticResource CornerRadius.Small}" Visibility="{Binding HasSuccessMessage, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Foreground="{StaticResource SuccessForegroundBrush}" Text="{Binding Message}" TextWrapping="Wrap" /></Border>
							<Border Padding="{DynamicResource Card.Padding}" Background="{StaticResource ErrorBrush}" CornerRadius="{StaticResource CornerRadius.Small}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Foreground="{StaticResource ErrorForegroundBrush}" Text="{Binding Message}" TextWrapping="Wrap" /></Border>
						</Grid>

					</StackPanel>
				</ScrollViewer>
					<controls:WorkflowActionBar Grid.Row="1">
						<controls:WorkflowActionBar.SecondaryActions><Button Command="{Binding TestConnectionCommand}" Content="Test connection" Style="{StaticResource SecondaryButtonStyle}" /></controls:WorkflowActionBar.SecondaryActions>
						<controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding SaveCommand}" Content="Save settings" Style="{StaticResource PrimaryButtonStyle}" /></controls:WorkflowActionBar.PrimaryAction>
					</controls:WorkflowActionBar>
				</Grid>
			</TabItem>

			<TabItem Header="Maintenance">
				<ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<StackPanel HorizontalAlignment="Stretch">
						<ProgressBar Height="4" Margin="0,0,0,16" Maximum="100" Value="{Binding OperationProgress, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

						<controls:Card>
							<controls:Card.Header><TextBlock Text="Database overview" Style="{StaticResource SectionTitleStyle}" /></controls:Card.Header>
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
								<TextBlock Text="Provider" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Column="2" Text="Schema version" Style="{StaticResource FormLabelStyle}" />
								<TextBlock Grid.Row="2" Text="{Binding ProviderDisplay}" Style="{StaticResource CardTitleStyle}" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SchemaVersionDisplay}" Style="{StaticResource CardTitleStyle}" />
								<TextBlock Grid.Row="4" Text="Active connection" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="2" Text="Database size" Style="{StaticResource FormLabelStyle}" />
								<TextBox Grid.Row="6" Text="{Binding ConnectionDisplay, Mode=OneWay}" ToolTip="{Binding ConnectionDisplay}" Style="{StaticResource CopyableTextStyle}" /><TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding DatabaseSizeDisplay}" />
								<TextBlock Grid.Row="8" Text="Last successful backup" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="8" Grid.Column="2" Text="Next scheduled backup" Style="{StaticResource FormLabelStyle}" />
								<TextBlock Grid.Row="10" Text="{Binding LastBackupDisplay}" /><TextBlock Grid.Row="10" Grid.Column="2" Text="{Binding NextBackupDisplay}" />
							</Grid>
						</controls:Card>

						<Grid Margin="{DynamicResource Control.Margin.Large}">
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
							<controls:Card>
								<StackPanel>
									<TextBlock Text="Automatic backups" Style="{StaticResource CardTitleStyle}" />
									<CheckBox Margin="{DynamicResource Control.Margin.Large}" Content="Create backups automatically" IsChecked="{Binding AutomaticBackupsEnabled}" Style="{StaticResource AppCheckBoxStyle}" />
									<TextBlock Margin="{DynamicResource Control.Margin.Large}" Text="Backup directory" Style="{StaticResource FormLabelStyle}" /><TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding BackupDirectory}" />
									<TextBlock Margin="{DynamicResource Control.Margin.Large}" Text="Interval in days" Style="{StaticResource FormLabelStyle}" /><TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding BackupIntervalDays}" />
									<TextBlock Margin="{DynamicResource Control.Margin}" Text="The encrypted depot.settings file stores the schedule. Due backups resume automatically after a restart." Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
									<Button Margin="{DynamicResource Control.Margin.Large}" HorizontalAlignment="Right" Command="{Binding SaveCommand}" Content="Save backup schedule" Style="{StaticResource PrimaryButtonStyle}" />
								</StackPanel>
							</controls:Card>

							<controls:Card Grid.Column="2">
								<StackPanel>
									<TextBlock Text="Backup and maintenance" Style="{StaticResource CardTitleStyle}" />
									<TextBlock Margin="{DynamicResource Control.Margin}" Text="Create and verify backups, check integrity, or refresh the current overview." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
									<WrapPanel Margin="{DynamicResource Control.Margin.Large}"><Button Command="{Binding CreateBackupCommand}" Content="Create backup" Style="{StaticResource PrimaryButtonStyle}" /><Button Margin="{DynamicResource Button.Margin}" Command="{Binding ValidateBackupCommand}" Content="Validate backup" Style="{StaticResource SecondaryButtonStyle}" /><Button Margin="{DynamicResource Button.Margin}" Command="{Binding CheckIntegrityCommand}" Content="Check integrity" Style="{StaticResource SecondaryButtonStyle}" /><Button Margin="{DynamicResource Button.Margin}" Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" /></WrapPanel>
									<Separator Margin="0,20,0,16" />
									<TextBlock Text="Destructive maintenance" Style="{StaticResource CardTitleStyle}" />
									<TextBlock Margin="{DynamicResource Control.Margin}" Text="Restore validates the selected backup and creates a safety backup first. Compact is available for SQLite only." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
									<WrapPanel Margin="{DynamicResource Control.Margin.Large}"><Button Command="{Binding RestoreBackupCommand}" Content="Restore backup" Style="{StaticResource DangerButtonStyle}" /><Button Margin="{DynamicResource Button.Margin}" Command="{Binding CompactCommand}" Content="Compact SQLite" Style="{StaticResource SecondaryButtonStyle}" /></WrapPanel>
								</StackPanel>
							</controls:Card>
						</Grid>

						<controls:Card Margin="{DynamicResource Control.Margin.Large}">
							<controls:Card.Header><TextBlock Text="Available backups" Style="{StaticResource SectionTitleStyle}" /></controls:Card.Header>
							<Grid>
								<Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
								<DataGrid MinHeight="220" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" Style="{StaticResource AppDataGridStyle}">
									<DataGrid.Columns>
										<DataGridTextColumn Width="145" Binding="{Binding CreatedDisplay}" Header="Created" ElementStyle="{StaticResource AppDataGridTextStyle}" />
										<DataGridTextColumn Width="90" Binding="{Binding SizeDisplay}" Header="Size" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
										<DataGridTextColumn Width="90" Binding="{Binding Provider}" Header="Provider" ElementStyle="{StaticResource AppDataGridTextStyle}" />
										<DataGridCheckBoxColumn Width="70" Binding="{Binding IsValid}" Header="Valid" IsReadOnly="True" />
										<DataGridTextColumn Width="*" Binding="{Binding FilePath}" Header="Path" ElementStyle="{StaticResource AppDataGridTextStyle}" />
									</DataGrid.Columns>
								</DataGrid>
								<TextBlock Grid.Row="1" Margin="{DynamicResource Control.Margin}" Text="{Binding SelectedBackup.ValidationMessage}" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" />
							</Grid>
						</controls:Card>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>
