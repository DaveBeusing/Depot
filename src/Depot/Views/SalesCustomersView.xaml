<UserControl x:Class="Depot.Views.SalesCustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <controls:OperationPanel ErrorText="{Binding Workspace.OperationError}" HasError="{Binding Workspace.HasOperationError}" IsBusy="{Binding Workspace.IsBusy}" StatusText="{Binding Workspace.StatusText}" />
        <controls:MasterDetailGrid>
            <controls:MasterDetailGrid.Master>
                <controls:Card>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <controls:SearchBox Placeholder="Search customers" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Workspace.Customers}" SelectedItem="{Binding SelectedCustomer}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerNumber}" Style="{StaticResource CaptionStyle}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewCustomerCommand}" Content="New customer" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </controls:Card>
            </controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="1.15*"/></Grid.RowDefinitions>
                    <controls:Card>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <controls:WorkflowHeader Title="Customer" Subtitle="Contact and commercial master data" Status="{Binding Workspace.CustomerDraft.CustomerNumber}" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="Name *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Primary contact summary" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.ContactName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Row="2"><TextBlock Text="Email" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.Email, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Phone" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.Phone, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Row="4"><TextBlock Text="Payment terms (days)" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.PaymentTermsDays, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Currency" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.Currency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding SaveCustomerCommand}" Content="Save customer" Style="{StaticResource PrimaryButtonStyle}"/></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
                        </Grid>
                    </controls:Card>
                    <controls:Card Grid.Row="2">
                        <TabControl>
                            <TabItem Header="Addresses">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Customer addresses" FontWeight="SemiBold"/><TextBlock Text="Maintain billing, shipping and additional destinations." Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Command="{Binding NewAddressCommand}" Content="New address" Style="{StaticResource SecondaryButtonStyle}"/></Grid>
                                    <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}">
                                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold"><Run Text="{Binding Type}"/><Run Text=" · "/><Run Text="{Binding Name, TargetNullValue=Address}"/></TextBlock><TextBlock Text="{Binding Address}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="Default" Foreground="{DynamicResource PrimaryBrush}" Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                        <TextBlock Text="Type" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding AddressTypes}" SelectedItem="{Binding AddressDraft.Type}" Style="{StaticResource AppComboBoxStyle}"/>
                                        <TextBlock Text="Name" Style="{StaticResource FormLabelStyle}" Margin="0,10,0,0"/><controls:TextInput Text="{Binding AddressDraft.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Address *" Style="{StaticResource FormLabelStyle}" Margin="0,10,0,0"/><TextBox MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding AddressDraft.Address, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Margin="0,10,0,0" Content="Use as default for this address type" IsChecked="{Binding AddressDraft.IsDefault}"/>
                                        <Button Margin="0,12,0,0" HorizontalAlignment="Right" Command="{Binding SaveAddressCommand}" Content="Save address" Style="{StaticResource PrimaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Contacts">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid Grid.ColumnSpan="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Customer contacts" FontWeight="SemiBold"/><TextBlock Text="Maintain commercial, purchasing, logistics, accounting and technical contacts." Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Command="{Binding NewContactCommand}" Content="New contact" Style="{StaticResource SecondaryButtonStyle}"/></Grid>
                                    <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}">
                                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{Binding Role}"/><Run Text=" · "/><Run Text="{Binding Department, TargetNullValue=General}"/><Run Text=" · "/><Run Text="{Binding Email, TargetNullValue=No email}"/></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="Primary" Foreground="{DynamicResource PrimaryBrush}" Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <ScrollViewer Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
                                        <TextBlock Text="Name *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ContactDraft.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Role" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding ContactRoles}" SelectedItem="{Binding ContactDraft.Role}" Style="{StaticResource AppComboBoxStyle}"/>
                                        <TextBlock Text="Department" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,0"/><controls:TextInput Text="{Binding ContactDraft.Department, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Email" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,0"/><controls:TextInput Text="{Binding ContactDraft.Email, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Phone" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ContactDraft.Phone, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Mobile" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ContactDraft.Mobile, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                                        <CheckBox Margin="0,8,0,0" Content="Primary contact" IsChecked="{Binding ContactDraft.IsPrimary}"/>
                                        <Button Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding SaveContactCommand}" Content="Save contact" Style="{StaticResource PrimaryButtonStyle}"/>
                                    </StackPanel></ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem Header="E-Invoice Identity">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.ColumnSpan="3">
                                            <TextBlock Text="Electronic invoice buyer identity" FontWeight="SemiBold"/>
                                            <TextBlock Text="These structured fields are frozen together with the billing-address snapshot when an invoice is posted. Complete data is required for XRechnung finalization." Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2"><TextBlock Text="Buyer reference (BT-10) *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.BuyerReference, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Electronic address (BT-49) *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.EInvoiceEndpoint, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                        <StackPanel Grid.Row="4"><TextBlock Text="Tax ID" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.TaxId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="VAT ID" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.VatId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                        <StackPanel Grid.Row="6"><TextBlock Text="Endpoint scheme *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.EInvoiceEndpointScheme, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                        <StackPanel Grid.Row="6" Grid.Column="2"><TextBlock Text="Billing street *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.BillingStreet, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                        <StackPanel Grid.Row="8">
                                            <TextBlock Text="Address line 2" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.BillingAddressLine2, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Postal code *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.BillingPostalCode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="City *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.BillingCity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Row="8" Grid.Column="2"><TextBlock Text="Country code (ISO alpha-2) *" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding Workspace.CustomerDraft.BillingCountryCode, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,8,0,0" Text="At least one of Tax ID or VAT ID must be present before an invoice can be posted." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </controls:Card>
                </Grid>
            </controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>
    </Grid>
</UserControl>
