<UserControl x:Class="Depot.Views.WorkspaceProductivityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=WorkspaceProductivity}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Continue working" Style="{DynamicResource WorkspaceSectionTitleStyle}" />
                    <TextBlock Text="Favorites and recent workspaces keep your daily context close." Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Default landing:" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding DefaultLandingLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Reset" Click="OnClearDefaultClick" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Favorites" Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding Favorites}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Content="{Binding Title}" Click="OnOpenClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" />
                                        <Button Grid.Column="1" Content="Default" Click="OnSetDefaultClick" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" />
                                        <Button Grid.Column="2" Content="Unpin" Click="OnToggleFavoriteClick" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Recent" Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding Recents}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Content="{Binding Title}" Click="OnOpenClick" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" />
                                        <Button Grid.Column="1" Content="Default" Click="OnSetDefaultClick" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" />
                                        <Button Grid.Column="2" Content="Pin / Unpin" Click="OnToggleFavoriteClick" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
