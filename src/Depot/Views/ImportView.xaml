<UserControl x:Class="Depot.Views.ImportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:PageHeader Title="Import" Subtitle="Choose a file, review the validated preview, and confirm the import." />
		<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
		<controls:Card Grid.Row="2">
			<Grid>
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<TextBlock Text="1  Choose file     2  Validate     3  Preview     4  Confirm     5  Import     6  Result" Style="{StaticResource CardTitleStyle}" />
				<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox IsReadOnly="True" Text="{Binding FilePath, Mode=OneWay}" Style="{StaticResource AppTextBoxStyle}" /><Button Grid.Column="2" Command="{Binding BrowseCommand}" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}" /></Grid>
				<controls:WorkflowActionBar Grid.Row="4"><controls:WorkflowActionBar.SecondaryActions><TextBlock VerticalAlignment="Center" Text="{Binding TotalItems, StringFormat={}{0:N0} preview rows}" Style="{StaticResource CaptionStyle}" /></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding ImportCommand}" Content="Confirm and import" Style="{StaticResource PrimaryButtonStyle}" /></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
			</Grid>
		</controls:Card>
		<Grid Grid.Row="4">
			<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
			<Grid>
				<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
				<TextBlock Text="{Binding TotalItems, StringFormat=Total: {0:N0}}" /><TextBlock Grid.Column="1" Text="{Binding NewItems, StringFormat=New: {0:N0}}" /><TextBlock Grid.Column="2" Text="{Binding ExistingItems, StringFormat=Existing: {0:N0}}" /><TextBlock Grid.Column="3" Text="{Binding Warnings, StringFormat=Warnings: {0:N0}}" /><TextBlock Grid.Column="4" Text="{Binding TotalQuantity, StringFormat=Quantity: {0:N2}}" /><TextBlock Grid.Column="5" HorizontalAlignment="Right" Text="{Binding TotalValue, StringFormat=Value: {0:C2}}" />
			</Grid>
			<Border Grid.Row="2" Padding="12" Background="{StaticResource SuccessBrush}" CornerRadius="{StaticResource CornerRadius.Small}" Visibility="{Binding Result.HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Foreground="{StaticResource SuccessForegroundBrush}"><Run Text="Import completed - " /><Run Text="{Binding Result.ImportedItems, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text=" items, " /><Run Text="{Binding Result.ImportedMovements, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text=" movements, " /><Run Text="{Binding Result.SkippedItems, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text=" skipped." /></TextBlock></Border>
			<DataGrid Grid.Row="4" Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding Items}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Part number" Binding="{Binding PartNumber}" Width="140" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Warehouse" Binding="{Binding Warehouse}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120" ElementStyle="{StaticResource AppDataGridTextStyle}" /><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridTextColumn Header="Total" Binding="{Binding TotalValue, StringFormat={}{0:C2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridCheckBoxColumn Header="Exists" Binding="{Binding ItemAlreadyExists, Mode=OneWay}" Width="70" />
				</DataGrid.Columns>
			</DataGrid>
			<Expander Grid.Row="6" Header="{Binding Warnings, StringFormat=Warnings ({0:N0})}" Visibility="{Binding Warnings, Converter={StaticResource NonZeroToVisibilityConverter}}">
				<DataGrid MaxHeight="220" Margin="0,8,0,0" Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding WarningItems}"><DataGrid.Columns><DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="80" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" /><DataGridTextColumn Header="Warning" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" /></DataGrid.Columns></DataGrid>
			</Expander>
		</Grid>
	</Grid>
</UserControl>
