<UserControl x:Class="Depot.Views.MyWorkPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="My Work" Style="{DynamicResource WorkspaceSectionTitleStyle}" />
                    <TextBlock Text="Your permission-aware work queue from existing ERP workflows." Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="OnRefreshClick" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
            </Grid>

            <TabControl ItemsSource="{Binding MyWorkSections}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding Items.Count, StringFormat={} ({0})}" Margin="4,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid MinHeight="170">
                            <DataGrid ItemsSource="{Binding Items}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      MouseDoubleClick="OnItemsDoubleClick"
                                      MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Reference" Binding="{Binding DisplayNumber}" Width="130" />
                                    <DataGridTextColumn Header="Work" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="180" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                                    <DataGridTextColumn Header="Amount / Qty" Binding="{Binding AmountOrQuantity, StringFormat={}{0:N2}}" Width="105" />
                                    <DataGridTextColumn Header="Due / Age" Binding="{Binding DueOrAgeDisplay}" SortMemberPath="DueAt" Width="105" />
                                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90" />
                                    <DataGridTemplateColumn Header="" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding PrimaryAction}" Click="OnOpenClick" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Nothing to work on in this section."
                                       Style="{StaticResource CaptionStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <TextBlock Text="{Binding MyWorkStatusText}" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
