<UserControl x:Class="Depot.Views.MyWorkPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:Depot.Controls"
             KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>
    <controls:Card Style="{StaticResource WorkspaceCardStyle}" Margin="0,0,0,16">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Needs my action" Style="{DynamicResource WorkspaceSectionTitleStyle}" />
                    <TextBlock Text="Your permission-aware work queue from existing ERP workflows." Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Click="OnRefreshClick"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        automation:AutomationProperties.Name="Refresh My Work" />
            </Grid>

            <controls:FilterBar Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quick filter:" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="All" Tag="All" Click="OnFilterClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" automation:AutomationProperties.Name="Show all work" />
                <Button Content="Overdue" Tag="Overdue" Click="OnFilterClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" automation:AutomationProperties.Name="Show overdue work" />
                <Button Content="Today" Tag="Today" Click="OnFilterClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" automation:AutomationProperties.Name="Show work due today" />
                <Button Content="High priority" Tag="HighPriority" Click="OnFilterClick" Style="{StaticResource SecondaryButtonStyle}" automation:AutomationProperties.Name="Show high priority work" />
                </StackPanel>
            </controls:FilterBar>
            <TextBlock Text="{Binding MyWorkFilterSummaryText}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" />

            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         Margin="0,0,0,8"
                         Visibility="{Binding IsMyWorkLoading, Converter={StaticResource BooleanToVisibility}}" />

            <TabControl ItemsSource="{Binding MyWorkSections}"
                        SelectedIndex="0"
                        Style="{StaticResource AppTabControlStyle}"
                        automation:AutomationProperties.Name="My Work sections">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SectionTitle" Text="{Binding Title}" />
                            <TextBlock x:Name="SectionCount" Text="{Binding Items.Count, StringFormat={} ({0})}" Margin="4,0,0,0" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter TargetName="SectionTitle" Property="Opacity" Value="0.55" />
                                <Setter TargetName="SectionCount" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid MinHeight="170">
                            <DataGrid ItemsSource="{Binding Items}"
                                      Style="{StaticResource AppDataGridCompactStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      MouseDoubleClick="OnItemsDoubleClick"
                                      MaxHeight="300"
                                      KeyboardNavigation.TabNavigation="Continue">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Reference" Binding="{Binding DisplayNumber}" Width="130" />
                                    <DataGridTextColumn Header="Work" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="180" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="125" />
                                    <DataGridTextColumn Header="Amount / Qty" Binding="{Binding AmountOrQuantityDisplay}" Width="120" />
                                    <DataGridTextColumn Header="Due state" Binding="{Binding DueStateDisplay}" SortMemberPath="DueAt" Width="105" />
                                    <DataGridTextColumn Header="Priority" Binding="{Binding PriorityDisplay}" Width="85" />
                                    <DataGridTemplateColumn Header="" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding PrimaryAction}"
                                                        Click="OnOpenClick"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8,3"
                                                        automation:AutomationProperties.Name="{Binding PrimaryAction}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <controls:EmptyState Title="Nothing to work on"
                                                 Description="This section has no items that currently need your attention."
                                                 Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <TextBlock Text="{Binding MyWorkStatusText}" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0" />
        </StackPanel>
    </controls:Card>
</UserControl>
