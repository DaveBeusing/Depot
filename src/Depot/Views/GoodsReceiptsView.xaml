<UserControl x:Class="Depot.Views.GoodsReceiptsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls" xmlns:commands="clr-namespace:Depot.Commands">
	<Grid DataContext="{Binding Workflow}">
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:PageHeader Title="Goods Receipts" Subtitle="Receive open purchase-order quantities into their destination inventories."><controls:PageHeader.Actions><StackPanel Orientation="Horizontal"><controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" HelpTopicId="purchasing.goods-receipts" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" /><Button MinWidth="{DynamicResource Help.ContextButton.MinWidth}" Margin="{DynamicResource Button.Margin}" AutomationProperties.Name="Open goods receipts help" Command="{x:Static commands:HelpCommands.OpenTopic}" CommandParameter="purchasing.goods-receipts" Content="Help" Style="{DynamicResource SecondaryButtonStyle}" /></StackPanel></controls:PageHeader.Actions></controls:PageHeader>
		<controls:MasterDetailGrid Grid.Row="2">
			<controls:MasterDetailGrid.Master>
				<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<controls:FilterBar><controls:SearchBox Placeholder="Search open orders, suppliers or notes" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /></controls:FilterBar>
					<Grid Grid.Row="1"><ListBox ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" /><TextBlock Text="{Binding SupplierName}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right"><controls:DocumentStatusBadge HorizontalAlignment="Right" Status="{Binding StatusDisplayName}" /><TextBlock Margin="0,4,0,0" Text="{Binding ExpectedDeliveryDate, StringFormat={}{0:d}, TargetNullValue=No due date}" Style="{StaticResource CaptionStyle}" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><controls:WorkflowListState ItemCount="{Binding Orders.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" /></Grid>
					<controls:PaginationControl Grid.Row="3" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}" />
				</Grid>
			</controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail>
				<controls:Card>
					<Grid>
						<controls:EmptyState Title="No purchase order selected" Description="Select an open purchase order to record or review its goods receipts." Visibility="{Binding HasNoSelectedOrder, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<Grid Visibility="{Binding HasSelectedOrder, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
							<controls:WorkflowHeader Title="{Binding Draft.OrderNumber}" Subtitle="{Binding Draft.SupplierName}" Status="{Binding Draft.StatusDisplayName}" />
							<TabControl Grid.Row="1" Style="{StaticResource AppTabControlStyle}">
								<TabItem Header="Receive"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Supplier delivery note number *" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding SupplierDeliveryNoteNumber, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Receipt date *" Style="{StaticResource FormLabelStyle}" /><DatePicker SelectedDate="{Binding ReceiptDate}" Style="{StaticResource AppDatePickerStyle}" /></StackPanel></Grid><DataGrid Grid.Row="2" MinHeight="180" IsReadOnly="False" ItemsSource="{Binding ReceiptLines}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding ItemPartNumber}" IsReadOnly="True" Width="120" /><DataGridTextColumn Header="Description" Binding="{Binding ItemDescription}" IsReadOnly="True" Width="*" /><DataGridTextColumn Header="Open quantity" Binding="{Binding OpenQuantity, StringFormat={}{0:N2}}" IsReadOnly="True" Width="105" /><DataGridTextColumn Header="Received quantity *" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="125" /><DataGridTemplateColumn Header="Destination inventory *" Width="280"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding InventoryOptions}" SelectedItem="{Binding SelectedInventory}" DisplayMemberPath="DisplayName" Style="{StaticResource AppComboBoxStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel Grid.Row="4"><TextBlock Text="Notes" Style="{StaticResource FormLabelStyle}" /><TextBox MinHeight="56" AcceptsReturn="True" Text="{Binding ReceiptNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" /></StackPanel></Grid></TabItem>
								<TabItem Header="Earlier receipts"><DataGrid Margin="0,12,0,0" IsReadOnly="True" ItemsSource="{Binding GoodsReceipts}" SelectedItem="{Binding SelectedReceipt}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNumber}" Width="120" /><DataGridTextColumn Header="Receipt date" Binding="{Binding ReceiptDate, StringFormat={}{0:d}}" Width="110" /><DataGridTextColumn Header="Delivery note" Binding="{Binding SupplierDeliveryNoteNumber}" Width="*" /><DataGridCheckBoxColumn Header="Reversed" Binding="{Binding IsReversed, Mode=OneWay}" Width="85" /></DataGrid.Columns></DataGrid></TabItem>
								<TabItem Header="Movements"><DataGrid Margin="0,12,0,0" IsReadOnly="True" ItemsSource="{Binding ReceiptMovements}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="140" /><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="120" /><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" /><DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="130" /><DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="120" /><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="90" /></DataGrid.Columns></DataGrid></TabItem>
							</TabControl>
							<StackPanel Grid.Row="2"><Grid Margin="0,12,0,0" Visibility="{Binding CanReverseReceipt, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reversal reason code *" Style="{StaticResource FormLabelStyle}" /><ComboBox ItemsSource="{Binding ReversalReasonCodes}" SelectedItem="{Binding SelectedReversalReasonCode}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Reversal explanation *" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid><controls:WorkflowActionBar><controls:WorkflowActionBar.SecondaryActions><Button Command="{Binding ReverseReceiptCommand}" Content="Reverse Receipt" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanReverseReceipt, Converter={StaticResource BooleanToVisibilityConverter}}" /></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding PostReceiptCommand}" Content="Post Goods Receipt" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanReceive, Converter={StaticResource BooleanToVisibilityConverter}}" /></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar></StackPanel>
						</Grid>
					</Grid>
				</controls:Card>
			</controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>
