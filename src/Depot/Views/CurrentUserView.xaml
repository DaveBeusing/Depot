<UserControl x:Class="Depot.Views.CurrentUserView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Depot.Controls">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MaxWidth="1100" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource PrimaryBrush}"><TextBlock Text="{Binding Initials}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="10,1,20,0"><TextBlock Text="{Binding User.DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding User.Email}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3,0,0" /><TextBlock Text="{Binding RolesSummary}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0" /></StackPanel><Button Grid.Column="2" Content="Sign out" Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" /></Grid>
<Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:Card><StackPanel><TextBlock Text="Account" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="User ID" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" /><TextBlock Grid.Column="1" Text="{Binding User.Id}" Margin="0,0,0,8" /><TextBlock Grid.Row="1" Text="Display name" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding User.DisplayName}" Margin="0,0,0,8" /><TextBlock Grid.Row="2" Text="Email" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding User.Email}" Margin="0,0,0,8" /><TextBlock Grid.Row="3" Text="Active" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding User.IsActive}" Margin="0,0,0,8" /><TextBlock Grid.Row="4" Text="Created" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding User.CreatedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" Margin="0,0,0,8" /><TextBlock Grid.Row="5" Text="Version" Style="{StaticResource CaptionStyle}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding User.Version}" /></Grid></StackPanel></controls:Card><controls:Card Grid.Column="2"><StackPanel><TextBlock Text="Authorization" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="175" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Administrator" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" /><TextBlock Grid.Column="1" Text="{Binding User.IsAdministrator}" Margin="0,0,0,8" /><TextBlock Grid.Row="1" Text="Purchase order approval" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding User.CanApprovePurchaseOrders}" Margin="0,0,0,8" /><TextBlock Grid.Row="2" Text="Primary role" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding User.Role}" Margin="0,0,0,8" /><TextBlock Grid.Row="3" Text="Assigned roles" Style="{StaticResource CaptionStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RolesSummary}" TextWrapping="Wrap" /></Grid></StackPanel></controls:Card></Grid>
<controls:Card Grid.Row="2" Margin="0,12,0,0"><StackPanel><TextBlock Text="Roles" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" /><ItemsControl ItemsSource="{Binding Roles}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Code}" Style="{StaticResource CaptionStyle}" /><TextBlock Grid.Column="2" Text="{Binding Description}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" /><TextBlock Grid.Column="3" Text="{Binding IsSystem, StringFormat=System: {0}}" Style="{StaticResource CaptionStyle}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></controls:Card>
<controls:Card Grid.Row="3" Margin="0,12,0,0"><StackPanel><TextBlock Text="Effective permissions" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding EffectivePermissions.Count, StringFormat={}{0} permissions}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,10" /><ItemsControl ItemsSource="{Binding EffectivePermissions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,6,6"><TextBlock Text="{Binding}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></controls:Card>
</Grid></ScrollViewer></UserControl>