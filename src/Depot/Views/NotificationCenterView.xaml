<UserControl
	x:Class="Depot.Views.NotificationCenterView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="16" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:PageHeader Title="Notification Center" Subtitle="Review workflow and system notifications assigned to you.">
			<controls:PageHeader.Actions>
				<StackPanel Orientation="Horizontal">
					<controls:OperationPanel IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" StatusText="{Binding StatusText}" ErrorText="{Binding OperationError}" />
					<Button Command="{Binding MarkPageReadCommand}" Content="Mark page read" Style="{StaticResource SecondaryButtonStyle}" />
					<Button Command="{Binding CloseCommand}" Content="Close" Style="{StaticResource SecondaryButtonStyle}" />
				</StackPanel>
			</controls:PageHeader.Actions>
		</controls:PageHeader>

		<controls:MasterDetailGrid Grid.Row="2">
			<controls:MasterDetailGrid.Master>
				<Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
					<controls:FilterBar>
						<StackPanel>
							<controls:SearchBox Placeholder="Search notifications" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
							<Grid Margin="0,8,0,0">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<ComboBox ItemsSource="{Binding InboxFilters}" SelectedItem="{Binding InboxFilter}" Style="{StaticResource AppComboBoxStyle}" />
								<ComboBox Grid.Column="2" ItemsSource="{Binding TypeFilters}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedType}" Style="{StaticResource AppComboBoxStyle}" />
							</Grid>
							<Grid Margin="0,8,0,0">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
								<ComboBox ItemsSource="{Binding SeverityFilters}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSeverity}" Style="{StaticResource AppComboBoxStyle}" />
								<Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><DatePicker SelectedDate="{Binding FromDate}" ToolTip="From date" Style="{StaticResource AppDatePickerStyle}" /><DatePicker Grid.Column="2" SelectedDate="{Binding ToDate}" ToolTip="To date" Style="{StaticResource AppDatePickerStyle}" /></Grid>
							</Grid>
						</StackPanel>
					</controls:FilterBar>
					<Grid Grid.Row="1">
						<ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<Ellipse Width="6" Height="6" VerticalAlignment="Top" Margin="0,7,0,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsUnread, Converter={StaticResource BooleanToVisibilityConverter}}" />
										<StackPanel Grid.Column="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /><controls:DocumentStatusBadge Grid.Column="1" Margin="{DynamicResource Notification.List.Badge.Margin}" Status="{Binding Severity}" /></Grid><TextBlock Text="{Binding MessagePreview}" MaxHeight="38" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionStyle}" /><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SourceNumber, TargetNullValue=Depot}" Style="{StaticResource CaptionStyle}" /><TextBlock Grid.Column="1" Text="{Binding CreatedLocal, StringFormat={}{0:g}}" Style="{StaticResource CaptionStyle}" /></Grid></StackPanel>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<controls:WorkflowListState ItemCount="{Binding Items.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" />
					</Grid>
					<controls:PaginationControl Grid.Row="3" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}" />
				</Grid>
			</controls:MasterDetailGrid.Master>

			<controls:MasterDetailGrid.Detail>
				<controls:Card>
					<Grid>
						<controls:EmptyState Title="No notification selected" Description="Select a notification to read its details." Visibility="{Binding HasNoDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<Grid Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
							<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
							<controls:WorkflowHeader Title="{Binding Details.Title}" Subtitle="{Binding Details.SourceNumber, TargetNullValue=Depot notification}" Status="{Binding Details.Severity}" />
							<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Details.Message}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}" /><Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Created" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Column="1" Text="{Binding Details.CreatedLocal, StringFormat={}{0:g}}" Style="{StaticResource BodyStyle}" /><TextBlock Grid.Row="2" Text="Type" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details.Type}" Style="{StaticResource BodyStyle}" /><TextBlock Grid.Row="4" Text="Source" Style="{StaticResource FormLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Details.SourceType, TargetNullValue=Not linked}" Style="{StaticResource BodyStyle}" /></Grid></StackPanel></ScrollViewer>
							<controls:WorkflowActionBar Grid.Row="4">
								<controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding MarkUnreadCommand}" Content="Mark unread" Style="{StaticResource SecondaryButtonStyle}" /><Button Command="{Binding ArchiveCommand}" Content="Archive" Style="{StaticResource SecondaryButtonStyle}" /><Button Command="{Binding RestoreCommand}" Content="Restore" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></controls:WorkflowActionBar.SecondaryActions>
								<controls:WorkflowActionBar.PrimaryAction><StackPanel Orientation="Horizontal"><Button Command="{Binding MarkReadCommand}" Content="Mark read" Style="{StaticResource SecondaryButtonStyle}" /><Button Command="{Binding OpenRelatedCommand}" Content="Open related record" Style="{StaticResource PrimaryButtonStyle}" /></StackPanel></controls:WorkflowActionBar.PrimaryAction>
							</controls:WorkflowActionBar>
						</Grid>
					</Grid>
				</controls:Card>
			</controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>
