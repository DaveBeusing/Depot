<UserControl x:Class="Depot.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Dashboard" Subtitle="Operational overview, attention items and recent activity across Depot." />
        <controls:OperationPanel Grid.Row="1"
                                 IsBusy="{Binding IsBusy}"
                                 HasError="{Binding HasOperationError}"
                                 StatusText="{Binding StatusText}"
                                 ErrorText="{Binding OperationError}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Needs attention" Style="{DynamicResource WorkspaceSectionTitleStyle}" />
                <UniformGrid Columns="3">
                    <Button automation:AutomationProperties.Name="Open purchasing attention"
                            Style="{DynamicResource DashboardActionCardStyle}"
                            Tag="Purchasing"
                            Click="OnDashboardActionClick"
                            Visibility="{Binding HasPurchasingMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Purchasing" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Purchase orders, receipts and supplier returns" Style="{StaticResource CaptionStyle}" Margin="0,4,0,12" />
                            <TextBlock Text="{Binding PurchasingAttentionCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" Foreground="{DynamicResource WarningForegroundBrush}" />
                            <TextBlock Text="Items requiring attention" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding PurchasingSupportingText}" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button automation:AutomationProperties.Name="Open warehouse work"
                            Style="{DynamicResource DashboardActionCardStyle}"
                            Tag="Warehouse"
                            Click="OnDashboardActionClick"
                            Visibility="{Binding HasWarehouseMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Warehouse" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Counts, transfers and warehouse execution" Style="{StaticResource CaptionStyle}" Margin="0,4,0,12" />
                            <TextBlock Text="{Binding WarehouseWorkCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" />
                            <TextBlock Text="Open warehouse work" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding WarehouseSupportingText}" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button automation:AutomationProperties.Name="Open sales attention"
                            Style="{DynamicResource DashboardActionCardStyle}"
                            Tag="Sales"
                            Click="OnDashboardActionClick"
                            Visibility="{Binding HasSalesMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Sales" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Orders, fulfillment, invoices and commercial activity" Style="{StaticResource CaptionStyle}" Margin="0,4,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SalesAttentionCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" />
                                    <TextBlock Text="Workflow attention" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SalesMetrics.NetSalesThisMonth, StringFormat={}{0:C2}}" Style="{StaticResource MetricStyle}" />
                                    <TextBlock Text="Net sales this month" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SalesSupportingText}" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SalesCommercialText}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button automation:AutomationProperties.Name="Open approvals"
                            Style="{DynamicResource DashboardActionCardStyle}"
                            Tag="Approvals"
                            Click="OnDashboardActionClick"
                            Visibility="{Binding HasApprovalMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Approvals" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Pending purchase and sales decisions" Style="{StaticResource CaptionStyle}" Margin="0,4,0,12" />
                            <TextBlock Text="{Binding ApprovalSummary.OpenCount, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="Open approvals" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding ApprovalSupportingText}" Style="{StaticResource CaptionStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <TextBlock Text="Key metrics and workspaces" Style="{DynamicResource WorkspaceSectionTitleStyle}" Margin="0,8,0,10" />
                <UniformGrid Columns="3">
                    <Button automation:AutomationProperties.Name="Open inventory workspace"
                            Style="{DynamicResource DashboardActionCardStyle}"
                            Tag="Inventory"
                            Click="OnDashboardActionClick"
                            Visibility="{Binding HasCoreInventoryMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Inventory" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Catalog, stock, value and movement activity" Style="{StaticResource CaptionStyle}" Margin="0,4,0,12" />
                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalItems, StringFormat={}{0:N0}}" Style="{StaticResource MetricStyle}" />
                                    <TextBlock Text="Items" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalStockQuantity, StringFormat={}{0:N0}}" Style="{StaticResource MetricStyle}" />
                                    <TextBlock Text="Stock units" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding TotalInventoryValue, StringFormat={}{0:C2}}" Style="{StaticResource MetricStyle}" />
                                    <TextBlock Text="Inventory value" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding TotalMovements, StringFormat={}{0:N0}}" Style="{StaticResource MetricStyle}" />
                                    <TextBlock Text="Movements" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Button>

                    <Button automation:AutomationProperties.Name="Open active user sessions"
                            Style="{DynamicResource DashboardActionCardStyle}"
                            Tag="AdministrationUserSessions"
                            Click="OnDashboardActionClick"
                            Visibility="{Binding HasAdministrationMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="User Presence" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Authenticated users and heartbeat-active sessions" Style="{StaticResource CaptionStyle}" Margin="0,4,0,12" />
                            <UniformGrid Columns="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding AdministrationMetrics.OnlineUsers, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" />
                                    <TextBlock Text="Online Users" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding AdministrationMetrics.ActiveSessions, StringFormat={}{0:N0}}" Style="{StaticResource MetricLargeStyle}" />
                                    <TextBlock Text="Active Sessions" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Button>

                    <Button automation:AutomationProperties.Name="Open reports workspace"
                            Style="{DynamicResource DashboardActionCardStyle}"
                            Tag="Reports"
                            Click="OnDashboardActionClick"
                            Visibility="{Binding HasAdministrationMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Reports" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Inventory value and stock distribution reporting" Style="{StaticResource CaptionStyle}" Margin="0,4,0,12" />
                            <TextBlock Text="Open reporting workspace" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Analyze and export the current report result." Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <TextBlock Text="Recent activity" Style="{DynamicResource WorkspaceSectionTitleStyle}" Margin="0,8,0,10" />
                <controls:Card Style="{StaticResource WorkspaceCardStyle}" Margin="0,0,0,12">
                    <controls:Card.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Latest inventory movements" Style="{StaticResource WorkspaceTitleStyle}" />
                                <TextBlock Text="Recent stock activity across inventory." Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    automation:AutomationProperties.Name="Open inventory movements"
                                    Content="Open movements"
                                    Tag="InventoryMovements"
                                    Click="OnDashboardActionClick"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </controls:Card.Header>
                    <Grid MinHeight="260">
                        <DataGrid Style="{StaticResource AppDataGridStyle}"
                                  ItemsSource="{Binding RecentMovements}"
                                  Visibility="{Binding HasRecentMovements, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  MouseDoubleClick="OnRecentMovementDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="120" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="100" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <controls:EmptyState Title="No recent movements"
                                             Description="Recent stock activity will appear here."
                                             Visibility="{Binding HasNoRecentMovements, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </controls:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>