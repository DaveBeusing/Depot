<UserControl x:Class="Depot.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:Depot.Controls"
             xmlns:views="clr-namespace:Depot.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Home" Subtitle="A focused, permission-aware workspace for today's work." />
        <controls:OperationPanel Grid.Row="1"
                                 IsBusy="{Binding IsBusy}"
                                 HasError="{Binding HasOperationError}"
                                 StatusText="{Binding StatusText}"
                                 ErrorText="{Binding OperationError}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding GreetingText}" Style="{DynamicResource WorkspaceSectionTitleStyle}" />
                        <TextBlock Text="{Binding HomeContextText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <views:MyWorkPanel />

                <TextBlock Text="Key metrics"
                           Style="{DynamicResource WorkspaceSectionTitleStyle}"
                           Margin="0,0,0,10"
                           Visibility="{Binding HasAdaptiveKpis, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding AdaptiveKpis}"
                              Margin="0,0,0,16"
                              Visibility="{Binding HasAdaptiveKpis, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource DashboardActionCardStyle}"
                                    Tag="{Binding RouteId}"
                                    Click="OnKpiClick"
                                    automation:AutomationProperties.Name="{Binding Title}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource MetricLargeStyle}" Margin="0,10,0,2" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Quick actions"
                           Style="{DynamicResource WorkspaceSectionTitleStyle}"
                           Margin="0,0,0,10"
                           Visibility="{Binding HasHomeQuickActions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding HomeQuickActions}"
                              Margin="0,0,0,16"
                              Visibility="{Binding HasHomeQuickActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Click="OnQuickActionClick"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,8"
                                    MinWidth="120"
                                    automation:AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <views:WorkspaceProductivityPanel />

                <TextBlock Text="Recent activity" Style="{DynamicResource WorkspaceSectionTitleStyle}" Margin="0,0,0,10" />
                <controls:Card Style="{StaticResource WorkspaceCardStyle}" Margin="0,0,0,12">
                    <controls:Card.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Latest inventory movements" Style="{StaticResource WorkspaceTitleStyle}" />
                                <TextBlock Text="Secondary activity stays available without competing with today's work." Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    automation:AutomationProperties.Name="Open inventory movements"
                                    Content="Open movements"
                                    Tag="inventory.movements"
                                    Click="OnKpiClick"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </controls:Card.Header>
                    <Grid MinHeight="220">
                        <DataGrid Style="{StaticResource AppDataGridStyle}"
                                  ItemsSource="{Binding RecentMovements}"
                                  Visibility="{Binding HasRecentMovements, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  MouseDoubleClick="OnRecentMovementDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="130" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="120" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="100" ElementStyle="{StaticResource AppDataGridTextStyle}" />
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <controls:EmptyState Title="No recent movements"
                                             Description="Recent stock activity will appear here."
                                             Visibility="{Binding HasNoRecentMovements, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </controls:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
