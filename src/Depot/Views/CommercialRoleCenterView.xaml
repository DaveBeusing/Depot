<UserControl x:Class="Depot.Views.CommercialRoleCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls"
             SizeChanged="OnViewSizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <controls:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" />
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,0,0"
                    Content="Details"
                    Click="OnDetailPaneToggleClick"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,6"
                    ToolTip="Show or hide the selected work-item preview" />
        </Grid>

        <controls:OperationPanel Grid.Row="1"
                                 ErrorText="{Binding OperationError}"
                                 HasError="{Binding HasOperationError}"
                                 IsBusy="{Binding IsBusy}"
                                 StatusText="{Binding StatusText}" />

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding Kpis}" Visibility="{Binding HasKpis, Converter={StaticResource BooleanToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource WorkspaceSectionStyle}" Width="190" Margin="0,0,10,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SupportingText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <controls:WorkflowActionBar Visibility="{Binding HasQuickActions, Converter={StaticResource BooleanToVisibility}}"
                                        IsOverflowVisible="{Binding HasOverflowQuickActions}"
                                        controls:MotionBehavior.TransitionKind="State">
                <controls:WorkflowActionBar.SecondaryActions>
                    <ItemsControl ItemsSource="{Binding SecondaryQuickActions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Click="OnQuickActionClick" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" MinWidth="120" Margin="0,0,8,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:WorkflowActionBar.SecondaryActions>
                <controls:WorkflowActionBar.OverflowActions>
                    <ItemsControl ItemsSource="{Binding OverflowQuickActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Click="OnQuickActionClick" Style="{StaticResource AppLinkButtonStyle}" MinWidth="170" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:WorkflowActionBar.OverflowActions>
                <controls:WorkflowActionBar.PrimaryAction>
                    <ItemsControl ItemsSource="{Binding PrimaryQuickActions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Click="OnQuickActionClick" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" MinWidth="128" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:WorkflowActionBar.PrimaryAction>
            </controls:WorkflowActionBar>

            <TextBox Text="{Binding DecisionComment, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsApprovalInbox, Converter={StaticResource BooleanToVisibility}}"
                     Margin="0,10,0,0"
                     MinWidth="320"
                     ToolTip="Optional approval comment or rejection reason" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource WorkspaceSectionStyle}" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <controls:SearchBox Width="320"
                                        Margin="0,0,10,6"
                                        Placeholder="Filter this role center"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Filter by reference, title, requester, counterparty, status or next action"
                                        controls:WorkspaceViewPersistence.WorkspaceId="{Binding WorkspaceId}"
                                        controls:WorkspaceViewPersistence.FilterId="role-center.search" />
                </WrapPanel>
                <controls:WorkspaceViewBar WorkspaceId="{Binding WorkspaceId}" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding PartialFailureText}"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionStyle}"
                           Visibility="{Binding HasPartialFailures, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WorkspaceSectionStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource WorkspaceSectionTitleStyle}" Margin="0,0,0,8" />
                                    <Grid>
                                        <DataGrid ItemsSource="{Binding Items}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  Style="{StaticResource AppDataGridStyle}"
                                                  MouseDoubleClick="OnItemsDoubleClick"
                                                  KeyDown="OnItemsKeyDown"
                                                  Loaded="OnRoleCenterGridLoaded"
                                                  SelectionChanged="OnItemsSelectionChanged"
                                                  MinHeight="120"
                                                  MaxHeight="300"
                                                  controls:WorkspaceViewPersistence.WorkspaceId="{Binding DataContext.WorkspaceId, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Type / Work" Binding="{Binding Title}" SortMemberPath="Title" Width="170" controls:WorkspaceViewPersistence.ColumnId="role.type" />
                                                <DataGridTextColumn Header="Reference" Binding="{Binding DisplayNumber}" SortMemberPath="DisplayNumber" Width="140" controls:WorkspaceViewPersistence.ColumnId="role.reference" />
                                                <DataGridTextColumn Header="Requester / Creator" Binding="{Binding Requester}" SortMemberPath="Requester" Width="140" controls:WorkspaceViewPersistence.ColumnId="role.requester" />
                                                <DataGridTextColumn Header="Counterparty / Context" Binding="{Binding Context}" SortMemberPath="Context" Width="*" controls:WorkspaceViewPersistence.ColumnId="role.context" />
                                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" SortMemberPath="Amount" Width="105" controls:WorkspaceViewPersistence.ColumnId="role.amount" />
                                                <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" SortMemberPath="Currency" Width="76" controls:WorkspaceViewPersistence.ColumnId="role.currency" />
                                                <DataGridTextColumn Header="Submitted / Activity" Binding="{Binding SubmittedDisplay}" SortMemberPath="SubmittedAtUtc" Width="145" controls:WorkspaceViewPersistence.ColumnId="role.submitted" />
                                                <DataGridTextColumn Header="Due" Binding="{Binding DueDisplay}" SortMemberPath="DueAt" Width="100" controls:WorkspaceViewPersistence.ColumnId="role.due" />
                                                <DataGridTextColumn Header="Age" Binding="{Binding AgeDisplay}" SortMemberPath="AgeDays" Width="78" controls:WorkspaceViewPersistence.ColumnId="role.age" />
                                                <DataGridTextColumn Header="Match / Allocation" Binding="{Binding StateDetail}" SortMemberPath="StateDetail" Width="145" controls:WorkspaceViewPersistence.ColumnId="role.state-detail" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="135" controls:WorkspaceViewPersistence.ColumnId="role.status" />
                                                <DataGridTextColumn Header="Next Action" Binding="{Binding NextAction}" SortMemberPath="NextAction" Width="150" controls:WorkspaceViewPersistence.ColumnId="role.next-action" />
                                                <DataGridTemplateColumn Header="Actions" Width="Auto" controls:WorkspaceViewPersistence.ColumnId="role.actions">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Content="Open"
                                                                        Click="OnOpenClick"
                                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                                        Padding="8,3"
                                                                        Margin="0,0,5,0"
                                                                        Visibility="{Binding OpenIsPrimary, Converter={StaticResource BooleanToVisibility}}" />
                                                                <Button Content="Approve"
                                                                        Click="OnApproveClick"
                                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                                        Padding="8,3"
                                                                        Margin="0,0,5,0"
                                                                        Visibility="{Binding CanApprove, Converter={StaticResource BooleanToVisibility}}" />
                                                                <Button Content="Open"
                                                                        Click="OnOpenClick"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Padding="8,3"
                                                                        Visibility="{Binding CanApprove, Converter={StaticResource BooleanToVisibility}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Text="{Binding DisplayEmptyText}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="24"
                                                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}" />

                                        <TextBlock Text="Loading work items..."
                                                   Style="{StaticResource CaptionStyle}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibility}}" />

                                        <TextBlock Text="{Binding DataContext.OperationError, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="24"
                                                   Visibility="{Binding DataContext.HasOperationError, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BooleanToVisibility}}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding IsDetailPaneVisible, Converter={StaticResource BooleanToVisibility}}" />

            <Border Grid.Column="2"
                    Width="340"
                    Margin="10,0,0,0"
                    Style="{StaticResource WorkspaceSectionStyle}"
                    Visibility="{Binding IsDetailPaneVisible, Converter={StaticResource BooleanToVisibility}}">
                <Grid>
                    <TextBlock Text="Select a work item to preview its operational details."
                               Style="{StaticResource CaptionStyle}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasNoSelectedItem, Converter={StaticResource BooleanToVisibility}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedItem, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedItem}">
                            <TextBlock Text="{Binding Title}" Style="{DynamicResource WorkspaceSectionTitleStyle}" />
                            <TextBlock Text="{Binding DisplayNumber}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Status" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Text="Counterparty" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Context}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="4" Text="Amount" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:N2}}" />

                                <TextBlock Grid.Row="6" Text="Due / age" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Grid.Row="6" Grid.Column="1">
                                    <Run Text="{Binding DueDisplay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding AgeDisplay}" />
                                </TextBlock>

                                <TextBlock Grid.Row="8" Text="State" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding StateDetail}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="10" Text="Next action" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding NextAction}" TextWrapping="Wrap" />
                            </Grid>

                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="Open"
                                        Click="OnOpenClick"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="12,6"
                                        Margin="0,0,6,6"
                                        Visibility="{Binding OpenIsPrimary, Converter={StaticResource BooleanToVisibility}}" />
                                <Button Content="Approve"
                                        Click="OnApproveClick"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="12,6"
                                        Margin="0,0,6,6"
                                        Visibility="{Binding CanApprove, Converter={StaticResource BooleanToVisibility}}" />
                                <Button Content="Open"
                                        Click="OnOpenClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        Margin="0,0,6,6"
                                        Visibility="{Binding CanApprove, Converter={StaticResource BooleanToVisibility}}" />
                                <Button Content="Reject"
                                        Click="OnRejectClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        Margin="0,0,6,6"
                                        Visibility="{Binding CanReject, Converter={StaticResource BooleanToVisibility}}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
