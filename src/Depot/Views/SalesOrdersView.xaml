<UserControl x:Class="Depot.Views.SalesOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:OperationPanel ErrorText="{Binding Workspace.OperationError}" HasError="{Binding Workspace.HasOperationError}" IsBusy="{Binding Workspace.IsBusy}" StatusText="{Binding Workspace.StatusText}" />
        <controls:MasterDetailGrid Grid.Row="1">
            <controls:MasterDetailGrid.Master>
                <controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:SearchBox Placeholder="Search sales orders or customers" Text="{Binding Workspace.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Workspace.Orders}" SelectedItem="{Binding SelectedOrder}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}">
                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerName}" Style="{StaticResource CaptionStyle}"/></StackPanel><controls:DocumentStatusBadge Grid.Column="1" Status="{Binding Status}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding Workspace.NewOrderCommand}" Content="New sales order" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid></controls:Card>
            </controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <controls:WorkflowHeader Title="{Binding Workspace.OrderTitle}" Subtitle="{Binding Workspace.OrderDraft.CustomerName, TargetNullValue=Select a customer}" Status="{Binding Workspace.OrderDraft.Status}"/>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Customer *" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Workspace.Customers}" SelectedItem="{Binding Workspace.SelectedOrderCustomer}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Order date" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding Workspace.OrderDraft.OrderDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Requested delivery" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding Workspace.OrderDraft.RequestedDeliveryDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Billing address snapshot" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Workspace.BillingAddresses}" SelectedItem="{Binding Workspace.SelectedBillingAddress}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name, TargetNullValue=Billing}"/><TextBlock Text="{Binding Address}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Shipping address snapshot" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Workspace.ShippingAddresses}" SelectedItem="{Binding Workspace.SelectedShippingAddress}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name, TargetNullValue=Shipping}"/><TextBlock Text="{Binding Address}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            </Grid>
                            <DataGrid Margin="0,12,0,0" MinHeight="150" ItemsSource="{Binding Workspace.OrderLines}" SelectedItem="{Binding Workspace.SelectedOrderLine}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40"/><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="110"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Ordered" Binding="{Binding Quantity}" Width="65"/><DataGridTextColumn Header="Reserved" Binding="{Binding ReservedQuantity}" Width="70"/><DataGridTextColumn Header="Backorder" Binding="{Binding BackorderedQuantity}" Width="75"/><DataGridTextColumn Header="Shipped" Binding="{Binding ShippedQuantity}" Width="70"/><DataGridTextColumn Header="Invoiced" Binding="{Binding InvoicedQuantity}" Width="70"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="90"/><DataGridTextColumn Header="Price source" Binding="{Binding PriceSourceDisplay}" Width="170"/>
                            </DataGrid.Columns></DataGrid>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="70"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="75"/><ColumnDefinition Width="8"/><ColumnDefinition Width="65"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Workspace.Items}" SelectedItem="{Binding Workspace.SelectedItem}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding PartNumber}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Description}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <controls:TextInput Grid.Column="2" Text="{Binding Workspace.LineQuantity, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="4" Text="{Binding Workspace.LineUnitPrice, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="6" Text="{Binding Workspace.LineDiscountPercent, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="8" Text="{Binding Workspace.LineTaxRate, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Grid.Column="10" Orientation="Horizontal"><Button Command="{Binding ApplyCustomerPriceCommand}" Content="Resolve price" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding Workspace.RemoveLineCommand}" Content="Remove" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding Workspace.AddLineCommand}" Content="Add line" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Allocation / availability" Style="{StaticResource WorkspaceTitleStyle}"/><TextBlock Margin="0,4,0,8" Text="Reserve only what is available. Remaining demand stays visible as backorder and can be allocated later." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding Workspace.Availability}" SelectedItem="{Binding Workspace.SelectedAvailability}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding WarehouseName}"/><Run Text=" / "/><Run Text="{Binding StorageLocationName}"/><Run Text=" · available "/><Run Text="{Binding AvailableQuantity, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><controls:TextInput Width="90" Text="{Binding Workspace.ReservationQuantity, UpdateSourceTrigger=PropertyChanged}"/><Button Margin="8,0,0,0" Command="{Binding Workspace.ReserveCommand}" Content="Reserve selected source" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Active reservations" Style="{StaticResource WorkspaceTitleStyle}"/><ListBox Margin="0,8,0,0" ItemsSource="{Binding Workspace.Reservations}" SelectedItem="{Binding Workspace.SelectedReservation}" MinHeight="95"><ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="Inventory "/><Run Text="{Binding InventoryId}"/><Run Text=" · qty "/><Run Text="{Binding Quantity}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
                            </Grid>
                        </StackPanel>
                        <controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding Workspace.SaveOrderCommand}" Content="Save draft" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding Workspace.OrderConfirmationCommand}" Content="Order confirmation PDF" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><StackPanel Orientation="Horizontal"><Button Command="{Binding Workspace.SubmitCommand}" Content="Submit" Style="{StaticResource PrimaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding Workspace.ReleaseCommand}" Content="Release reserved" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
                    </Grid></controls:Card>
                    <controls:Card Margin="0,12,0,0"><StackPanel><TextBlock Text="Order timeline" Style="{StaticResource WorkspaceTitleStyle}"/><TextBlock Margin="0,4,0,10" Text="Operational history across approval, release, shipment, invoice, returns and credit notes." Style="{StaticResource CaptionStyle}"/><ItemsControl ItemsSource="{Binding Timeline}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimestampLocal, StringFormat={}{0:g}}" Style="{StaticResource CaptionStyle}"/><TextBlock Grid.Column="1" Text="{Binding EventType}" FontWeight="SemiBold"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Details}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></controls:Card>
                </StackPanel></ScrollViewer>
            </controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>
    </Grid>
</UserControl>
