<UserControl x:Class="Depot.Views.SalesOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" />
        <controls:MasterDetailGrid>
            <controls:MasterDetailGrid.Master>
                <controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:SearchBox Placeholder="Search sales orders or customers" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}">
                        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerName}" Style="{StaticResource CaptionStyle}"/></StackPanel><controls:DocumentStatusBadge Grid.Column="1" Status="{Binding Status}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewOrderCommand}" Content="New sales order" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid></controls:Card>
            </controls:MasterDetailGrid.Master>
            <controls:MasterDetailGrid.Detail>
                <controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:WorkflowHeader Title="{Binding OrderTitle}" Subtitle="{Binding OrderDraft.CustomerName, TargetNullValue=Select a customer}" Status="{Binding OrderDraft.Status}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Customer *" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedOrderCustomer}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Order date" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding OrderDraft.OrderDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Requested delivery" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding OrderDraft.RequestedDeliveryDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Billing address snapshot" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BillingAddresses}" SelectedItem="{Binding SelectedBillingAddress}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name, TargetNullValue=Billing}"/><TextBlock Text="{Binding Address}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{Binding OrderDraft.BillingAddress}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Shipping address snapshot" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding ShippingAddresses}" SelectedItem="{Binding SelectedShippingAddress}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name, TargetNullValue=Shipping}"/><TextBlock Text="{Binding Address}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{Binding OrderDraft.ShippingAddress}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                        <DataGrid Margin="0,12,0,0" MinHeight="150" ItemsSource="{Binding OrderLines}" SelectedItem="{Binding SelectedOrderLine}" Style="{StaticResource AppDataGridStyle}"><DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40"/><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="110"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Ordered" Binding="{Binding Quantity}" Width="65"/><DataGridTextColumn Header="Reserved" Binding="{Binding ReservedQuantity}" Width="70"/><DataGridTextColumn Header="Backorder" Binding="{Binding BackorderedQuantity}" Width="75"/><DataGridTextColumn Header="Shipped" Binding="{Binding ShippedQuantity}" Width="70"/><DataGridTextColumn Header="Invoiced" Binding="{Binding InvoicedQuantity}" Width="70"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="90"/>
                        </DataGrid.Columns></DataGrid>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="70"/><ColumnDefinition Width="8"/><ColumnDefinition Width="90"/><ColumnDefinition Width="8"/><ColumnDefinition Width="75"/><ColumnDefinition Width="8"/><ColumnDefinition Width="65"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding PartNumber}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Description}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <controls:TextInput Grid.Column="2" Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="4" Text="{Binding LineUnitPrice, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="6" Text="{Binding LineDiscountPercent, UpdateSourceTrigger=PropertyChanged}"/><controls:TextInput Grid.Column="8" Text="{Binding LineTaxRate, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="10" Orientation="Horizontal"><Button Command="{Binding RemoveLineCommand}" Content="Remove" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding AddLineCommand}" Content="Add line" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Available inventory" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Availability}" SelectedItem="{Binding SelectedAvailability}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding WarehouseName}"/><Run Text=" / "/><Run Text="{Binding StorageLocationName}"/><Run Text=" · available "/><Run Text="{Binding AvailableQuantity}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><controls:TextInput Width="90" Text="{Binding ReservationQuantity, UpdateSourceTrigger=PropertyChanged}"/><Button Margin="8,0,0,0" Command="{Binding ReserveCommand}" Content="Reserve" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Reservations" Style="{StaticResource FormLabelStyle}"/><ListBox ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}" MinHeight="70"><ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="Inventory "/><Run Text="{Binding InventoryId}"/><Run Text=" · qty "/><Run Text="{Binding Quantity}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
                        </Grid>
                    </StackPanel></ScrollViewer>
                    <controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding SaveOrderCommand}" Content="Save draft" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding OrderConfirmationCommand}" Content="Order confirmation PDF" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><StackPanel Orientation="Horizontal"><Button Command="{Binding SubmitCommand}" Content="Submit" Style="{StaticResource PrimaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding ReleaseCommand}" Content="Release reserved" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
                </Grid></controls:Card>
            </controls:MasterDetailGrid.Detail>
        </controls:MasterDetailGrid>
    </Grid>
</UserControl>
