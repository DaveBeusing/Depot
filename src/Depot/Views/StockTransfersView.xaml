<UserControl
	x:Class="Depot.Views.StockTransfersView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="16" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:PageHeader
			Title="Transfers"
			Subtitle="Plan and post stock movements between warehouses.">
			<controls:PageHeader.Actions>
				<controls:OperationPanel
					ErrorText="{Binding OperationError}"
					HasError="{Binding HasOperationError}"
					IsBusy="{Binding IsBusy}"
					StatusText="{Binding StatusText}" />
			</controls:PageHeader.Actions>
		</controls:PageHeader>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{StaticResource MasterPane.DefaultWidth}" MinWidth="{StaticResource MasterPane.MinWidth}" MaxWidth="{StaticResource MasterPane.MaxWidth}" />
				<ColumnDefinition Width="{StaticResource MasterDetail.ColumnGap}" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="8" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="8" />
					<RowDefinition Height="*" />
					<RowDefinition Height="12" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="12" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<controls:FilterBar><controls:SearchBox
					Placeholder="Search number, warehouse or notes"
					Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /></controls:FilterBar>
				<ComboBox
					Grid.Row="2"
					DisplayMemberPath="Name"
					ItemsSource="{Binding StatusFilters}"
					SelectedItem="{Binding SelectedStatusFilter}"
					Style="{StaticResource AppComboBoxStyle}" />
				<ListBox
					Grid.Row="4"
					ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"
					ItemsSource="{Binding Transfers}"
					SelectedItem="{Binding SelectedTransfer}"
					Style="{StaticResource MasterDataListBoxStyle}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid Margin="4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock FontWeight="SemiBold" Text="{Binding TransferNumber}" />
									<TextBlock Style="{StaticResource CaptionStyle}">
										<Run Text="{Binding SourceWarehouseName, Mode=OneWay}" />
										<Run Text=" → " />
										<Run Text="{Binding DestinationWarehouseName, Mode=OneWay}" />
									</TextBlock>
								</StackPanel>
								<StackPanel Grid.Column="1" HorizontalAlignment="Right">
									<controls:DocumentStatusBadge HorizontalAlignment="Right" Status="{Binding StatusDisplayName}" />
									<TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="{Binding TransferDate, StringFormat={}{0:d}}" />
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<controls:WorkflowListState Grid.Row="4" ItemCount="{Binding Transfers.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}" />
				<controls:PaginationControl Grid.Row="6" PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" PageText="{Binding PageDisplay}" />
				<Button Grid.Row="8" Command="{Binding NewTransferCommand}" Content="New Transfer" Style="{StaticResource PrimaryButtonStyle}" />
			</Grid>

			<ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<controls:Card>
						<controls:Card.Header><controls:WorkflowHeader Title="{Binding EditorTitle}" Subtitle="{Binding Draft.TransferNumber}" Status="{Binding Draft.Status}" /></controls:Card.Header>
						<StackPanel>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="16" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="16" />
									<ColumnDefinition Width="180" />
								</Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Style="{StaticResource FormLabelStyle}" Text="Source Warehouse" />
									<ComboBox
										DisplayMemberPath="Name"
										IsEnabled="{Binding IsDraft}"
										ItemsSource="{Binding Warehouses}"
										SelectedItem="{Binding SelectedSourceWarehouse}"
										Style="{StaticResource AppComboBoxStyle}" />
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Style="{StaticResource FormLabelStyle}" Text="Destination Warehouse" />
									<ComboBox
										DisplayMemberPath="Name"
										IsEnabled="{Binding IsDraft}"
										ItemsSource="{Binding DestinationWarehouses}"
										SelectedItem="{Binding SelectedDestinationWarehouse}"
										Style="{StaticResource AppComboBoxStyle}" />
								</StackPanel>
								<StackPanel Grid.Column="4">
									<TextBlock Style="{StaticResource FormLabelStyle}" Text="Transfer Date" />
									<DatePicker IsEnabled="{Binding IsDraft}" SelectedDate="{Binding Draft.TransferDate}" Style="{StaticResource AppDatePickerStyle}" />
								</StackPanel>
							</Grid>

							<TextBlock Margin="0,12,0,0" Style="{StaticResource FormLabelStyle}" Text="Notes" />
							<TextBox
								AcceptsReturn="True"
								IsReadOnly="{Binding IsReadOnly}"
								MinHeight="58"
								Style="{StaticResource MultilineTextBoxStyle}"
								Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}"
								TextWrapping="Wrap" />

							<DataGrid
								MinHeight="180"
								Margin="0,16,0,0"
								IsReadOnly="True"
								ItemsSource="{Binding Lines}"
								SelectedItem="{Binding SelectedLine}"
								Style="{StaticResource AppDataGridStyle}">
								<DataGrid.Columns>
									<DataGridTextColumn Binding="{Binding LineNumber}" Header="#" Width="45" />
									<DataGridTextColumn Binding="{Binding ItemDisplay}" Header="Item" Width="*" />
									<DataGridTextColumn Binding="{Binding SourceDisplay}" Header="Source Inventory" Width="220" />
									<DataGridTextColumn Binding="{Binding DestinationDisplay}" Header="Destination Inventory" Width="220" />
									<DataGridTextColumn Binding="{Binding Quantity, StringFormat={}{0:N0}}" Header="Quantity" Width="85" />
									<DataGridTextColumn Binding="{Binding AvailableStock, StringFormat={}{0:N0}}" Header="Available" Width="85" />
									<DataGridTextColumn Binding="{Binding RemainingStock, StringFormat={}{0:N0}}" Header="Remaining" Width="90" />
									<DataGridTextColumn Binding="{Binding AvailabilityStatus}" Header="Stock Check" Width="95" />
								</DataGrid.Columns>
							</DataGrid>

							<Grid Margin="0,12,0,0" IsEnabled="{Binding IsDraft}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="12" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="12" />
									<ColumnDefinition Width="110" />
									<ColumnDefinition Width="12" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Style="{StaticResource FormLabelStyle}" Text="Source Inventory" />
									<ComboBox ItemsSource="{Binding SourceInventoryOptions}" SelectedItem="{Binding SelectedSourceInventory}" Style="{StaticResource AppComboBoxStyle}">
										<ComboBox.ItemTemplate>
											<DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Style="{StaticResource FormLabelStyle}" Text="Matching Destination Inventory" />
									<ComboBox ItemsSource="{Binding DestinationInventoryOptions}" SelectedItem="{Binding SelectedDestinationInventory}" Style="{StaticResource AppComboBoxStyle}">
										<ComboBox.ItemTemplate>
											<DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
								</StackPanel>
								<StackPanel Grid.Column="4">
									<TextBlock Style="{StaticResource FormLabelStyle}" Text="Quantity" />
									<controls:TextInput Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" />
								</StackPanel>
								<StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal">
									<Button Command="{Binding RemoveLineCommand}" Content="Remove" Style="{StaticResource SecondaryButtonStyle}" />
									<Button Margin="{StaticResource Button.Margin}" Command="{Binding AddLineCommand}" Content="{Binding SaveLineText}" Style="{StaticResource SecondaryButtonStyle}" />
								</StackPanel>
							</Grid>
							<Grid Margin="0,8,0,0">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<TextBlock Style="{StaticResource CaptionStyle}" Text="Destination inventories are restricted to the selected source item." />
								<TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}">
									<Run Text="Available: " /><Run FontWeight="SemiBold" Text="{Binding SelectedSourceInventory.CurrentStock, Mode=OneWay, StringFormat={}{0:N0}}" />
									<Run Text="   Remaining: " /><Run FontWeight="SemiBold" Text="{Binding SelectedSourceRemainingStock, Mode=OneWay, StringFormat={}{0:N0}}" />
								</TextBlock>
							</Grid>

							<controls:WorkflowActionBar>
								<controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CancelTransferCommand}" Content="Cancel Draft" Style="{StaticResource DangerButtonStyle}" /><Button Margin="{StaticResource Button.Margin}" Command="{Binding SaveTransferCommand}" Content="Save Draft" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel></controls:WorkflowActionBar.SecondaryActions>
								<controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding PostTransferCommand}" Content="Post Transfer" Style="{StaticResource PrimaryButtonStyle}" /></controls:WorkflowActionBar.PrimaryAction>
							</controls:WorkflowActionBar>
						</StackPanel>
					</controls:Card>

					<controls:Card Margin="0,16,0,0" Visibility="{Binding HasMovements, Converter={StaticResource BooleanToVisibilityConverter}}">
						<controls:Card.Header>
							<TextBlock Style="{StaticResource SectionTitleStyle}" Text="Generated Transfer Movements" />
						</controls:Card.Header>
						<DataGrid MinHeight="180" IsReadOnly="True" ItemsSource="{Binding Movements}" Style="{StaticResource AppDataGridStyle}">
							<DataGrid.Columns>
								<DataGridTextColumn Binding="{Binding TimestampLocal, StringFormat={}{0:g}}" Header="Time" Width="145" />
								<DataGridTextColumn Binding="{Binding MovementType}" Header="Direction" Width="105" />
								<DataGridTextColumn Binding="{Binding PartNumber}" Header="Item" Width="120" />
								<DataGridTextColumn Binding="{Binding Description}" Header="Description" Width="*" />
								<DataGridTextColumn Binding="{Binding WarehouseName}" Header="Warehouse" Width="150" />
								<DataGridTextColumn Binding="{Binding LocationName}" Header="Location" Width="140" />
								<DataGridTextColumn Binding="{Binding Quantity, StringFormat={}{0:N0}}" Header="Quantity" Width="85" />
								<DataGridTextColumn Binding="{Binding Reference}" Header="Reference" Width="140" />
							</DataGrid.Columns>
						</DataGrid>
					</controls:Card>

					<controls:Card Margin="0,16,0,0" Visibility="{Binding CanReverse, Converter={StaticResource BooleanToVisibilityConverter}}">
						<controls:Card.Header><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Reverse Posted Transfer" /></controls:Card.Header>
						<StackPanel>
							<TextBlock Text="A full counter-movement is created for every TransferOut and TransferIn movement. The posted transfer remains immutable." Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />
							<TextBlock Margin="0,12,0,4" Text="Reason Code" Style="{StaticResource FormLabelStyle}" />
							<ComboBox ItemsSource="{Binding ReversalReasonCodes}" SelectedItem="{Binding SelectedReversalReasonCode}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}" />
							<TextBlock Margin="0,12,0,4" Text="Reason" Style="{StaticResource FormLabelStyle}" />
							<TextBox MinHeight="64" AcceptsReturn="True" Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" />
							<Button Margin="0,16,0,0" HorizontalAlignment="Right" Command="{Binding ReverseTransferCommand}" Content="Reverse Transfer" Style="{StaticResource DangerButtonStyle}" />
						</StackPanel>
					</controls:Card>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
