<UserControl x:Class="Depot.Views.ProcurementSourcingView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<controls:PageHeader Title="Procurement Sourcing" Subtitle="Control purchase demand, approvals, supplier quotations, explicit award and purchase-order conversion."/>
		<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}"/>
		<TabControl Grid.Row="3" Style="{StaticResource AppTabControlStyle}">
			<TabItem Header="Requisitions">
				<controls:MasterDetailGrid>
					<controls:MasterDetailGrid.Master>
						<Border Style="{StaticResource WorkspaceSectionStyle}">
							<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
								<controls:FilterBar><StackPanel><controls:SearchBox Placeholder="Search requisition, requester, supplier or justification" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></controls:FilterBar>
								<Grid Grid.Row="1"><ListBox ItemsSource="{Binding Requisitions}" SelectedItem="{Binding SelectedRequisition}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding RequisitionNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding RequestedByUserDisplay}" Style="{StaticResource CaptionStyle}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><controls:DocumentStatusBadge Status="{Binding Status}"/><TextBlock HorizontalAlignment="Right" Text="{Binding RequiredByDate, StringFormat={}{0:d}}" Style="{StaticResource CaptionStyle}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><controls:WorkflowListState ItemCount="{Binding Requisitions.Count}" SearchText="{Binding SearchText}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}"/></Grid>
								<Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewRequisitionCommand}" Content="New requisition" Style="{StaticResource SecondaryButtonStyle}"/>
							</Grid>
						</Border>
					</controls:MasterDetailGrid.Master>
					<controls:MasterDetailGrid.Detail>
						<Border Style="{StaticResource WorkspaceSectionStyle}">
							<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
								<controls:WorkflowHeader Title="{Binding RequisitionDraft.RequisitionNumber, TargetNullValue=New purchase requisition}" Subtitle="{Binding RequisitionDraft.RequestedByUserDisplay, TargetNullValue=Purchase demand}" Status="{Binding RequisitionDraft.Status}"/>
								<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,0,0">
									<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Required by" Style="{StaticResource FormLabelStyle}"/><DatePicker IsEnabled="{Binding CanEditRequisition}" SelectedDate="{Binding RequisitionDraft.RequiredByDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Preferred supplier" Style="{StaticResource FormLabelStyle}"/><ComboBox IsEnabled="{Binding CanEditRequisition}" ItemsSource="{Binding Suppliers}" SelectedValue="{Binding RequisitionDraft.PreferredSupplierId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel></Grid>
									<TextBlock Margin="0,10,0,0" Text="Business justification" Style="{StaticResource FormLabelStyle}"/><TextBox MinHeight="64" IsEnabled="{Binding CanEditRequisition}" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding RequisitionDraft.BusinessJustification, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBoxStyle}"/>
									<DataGrid Margin="0,12,0,0" MinHeight="150" ItemsSource="{Binding RequisitionLines}" SelectedItem="{Binding SelectedRequisitionLine}" IsReadOnly="True" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40"/><DataGridTextColumn Header="Item" Binding="{Binding ItemPartNumber}" Width="120"/><DataGridTextColumn Header="Description" Binding="{Binding ItemDescription}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/><DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="180"/></DataGrid.Columns></DataGrid>
									<Grid Margin="0,10,0,0" IsEnabled="{Binding CanEditRequisition}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/><ColumnDefinition Width="10"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Item" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource AppComboBoxStyle}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding PartNumber}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Description}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Quantity" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Notes" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding LineNotes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal"><Button Command="{Binding RemoveLineCommand}" Content="Remove" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding AddLineCommand}" Content="Add line" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></Grid>
									<Separator Margin="0,16,0,12"/><TextBlock Text="Approval decision comment" Style="{StaticResource FormLabelStyle}"/><TextBox MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding DecisionComment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBoxStyle}"/>
									<StackPanel Margin="0,12,0,0" Visibility="{Binding CanCreateRfq, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="RFQ recipients" Style="{StaticResource WorkspaceSectionTitleStyle}"/><ItemsControl ItemsSource="{Binding RfqSupplierOptions}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="0,4,0,0" Content="{Binding Name}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Margin="0,8,0,0" Text="Response due date" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding ResponseDueDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel>
								</StackPanel></ScrollViewer>
								<controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><WrapPanel><Button Command="{Binding SaveRequisitionCommand}" Content="Save" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanEditRequisition, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding CancelRequisitionCommand}" Content="Cancel" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanCancelRequisition, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding ReturnRequisitionCommand}" Content="Return" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanApproveRequisition, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding RejectRequisitionCommand}" Content="Reject" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanApproveRequisition, Converter={StaticResource BooleanToVisibilityConverter}}"/></WrapPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Grid><Button Command="{Binding SubmitRequisitionCommand}" Content="Submit for approval" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanSubmitRequisition, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Command="{Binding ApproveRequisitionCommand}" Content="Approve" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanApproveRequisition, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Command="{Binding CreateRfqCommand}" Content="Create RFQ" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanCreateRfq, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
							</Grid>
						</Border>
					</controls:MasterDetailGrid.Detail>
				</controls:MasterDetailGrid>
			</TabItem>
			<TabItem Header="RFQs and Quotes">
				<controls:MasterDetailGrid>
					<controls:MasterDetailGrid.Master><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><ListBox ItemsSource="{Binding Rfqs}" SelectedItem="{Binding SelectedRfq}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding RfqNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding RequisitionNumber}" Style="{StaticResource CaptionStyle}"/></StackPanel><StackPanel Grid.Column="1"><controls:DocumentStatusBadge Status="{Binding Status}"/><TextBlock HorizontalAlignment="Right" Text="{Binding ResponseDueDate, StringFormat={}{0:d}}" Style="{StaticResource CaptionStyle}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><controls:WorkflowListState ItemCount="{Binding Rfqs.Count}" IsBusy="{Binding IsBusy}" HasError="{Binding HasOperationError}" ErrorText="{Binding OperationError}"/></Grid></Grid></Border></controls:MasterDetailGrid.Master>
					<controls:MasterDetailGrid.Detail><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><controls:WorkflowHeader Title="{Binding SelectedRfq.RfqNumber, TargetNullValue=Select an RFQ}" Subtitle="{Binding SelectedRfq.RequisitionNumber}" Status="{Binding SelectedRfq.Status}"/>
						<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,0,0"><TextBlock Text="Capture supplier quote" Style="{StaticResource WorkspaceSectionTitleStyle}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Supplier" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding RfqRecipientOptions}" SelectedItem="{Binding SelectedQuoteSupplier}" DisplayMemberPath="SupplierName" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Currency" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding QuoteCurrency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Valid until" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding QuoteValidUntil}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel></Grid><TextBlock Margin="0,8,0,0" Text="Supplier reference" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding SupplierReference, UpdateSourceTrigger=PropertyChanged}"/>
						<DataGrid Margin="0,10,0,0" ItemsSource="{Binding QuoteLines}" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" IsReadOnly="True" Width="65"/><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="90"/><DataGridTextColumn Header="MOQ" Binding="{Binding MinimumOrderQuantity, UpdateSourceTrigger=PropertyChanged}" Width="70"/><DataGridTextColumn Header="Lead days" Binding="{Binding LeadTimeDays, UpdateSourceTrigger=PropertyChanged}" Width="80"/></DataGrid.Columns></DataGrid>
						<Button Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding CaptureQuoteCommand}" Content="Capture quote" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding CanCaptureQuote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
						<TextBlock Margin="0,16,0,6" Text="Supplier responses" Style="{StaticResource WorkspaceSectionTitleStyle}"/><ListBox ItemsSource="{Binding QuoteResponses}" SelectedItem="{Binding SelectedQuoteResponse}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SupplierName}" FontWeight="SemiBold"/><TextBlock Text="{Binding SupplierReference}" Style="{StaticResource CaptionStyle}"/></StackPanel><StackPanel Grid.Column="1"><controls:DocumentStatusBadge Status="{Binding Status}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Currency}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
						<TextBlock Margin="0,10,0,0" Text="{Binding ConversionStatus}" Style="{StaticResource CaptionStyle}"/></StackPanel></ScrollViewer>
						<controls:WorkflowActionBar Grid.Row="2"><controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CancelRfqCommand}" Content="Cancel RFQ" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding CanCancelRfq, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Margin="{StaticResource Button.Margin}" Command="{Binding RefreshComparisonCommand}" Content="Refresh comparison" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions><controls:WorkflowActionBar.PrimaryAction><Grid><Button Command="{Binding SelectQuoteCommand}" Content="Select supplier quote" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanSelectQuote, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Command="{Binding ConvertToPurchaseOrderCommand}" Content="Create purchase order draft" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding CanConvertToPurchaseOrder, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid></controls:WorkflowActionBar.PrimaryAction></controls:WorkflowActionBar>
					</Grid></Border></controls:MasterDetailGrid.Detail>
				</controls:MasterDetailGrid>
			</TabItem>
			<TabItem Header="Quote Comparison"><Border Style="{StaticResource WorkspaceSectionStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions><controls:WorkflowHeader Title="Supplier quote comparison" Subtitle="Comparison is deterministic; supplier selection is always explicit." Status="{Binding SelectedRfq.Status}"/><DataGrid Grid.Row="2" ItemsSource="{Binding ComparisonRows}" SelectedItem="{Binding SelectedComparisonRow}" IsReadOnly="True" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="110"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Requested" Binding="{Binding RequestedQuantity}" Width="80"/><DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="170"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="70"/><DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="90"/><DataGridTextColumn Header="Line total" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="100"/><DataGridTextColumn Header="MOQ" Binding="{Binding MinimumOrderQuantity}" Width="70"/><DataGridTextColumn Header="Lead days" Binding="{Binding LeadTimeDays}" Width="80"/><DataGridCheckBoxColumn Header="Expired" Binding="{Binding IsExpired}" Width="70"/><DataGridCheckBoxColumn Header="Selected" Binding="{Binding IsSelected}" Width="75"/></DataGrid.Columns></DataGrid></Grid></Border></TabItem>
		</TabControl>
	</Grid>
</UserControl>
