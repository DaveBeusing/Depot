<UserControl x:Class="Depot.Views.SalesOpportunitiesView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<controls:PageHeader Title="Opportunities" Subtitle="Manage pipeline stages, expected value, follow-up and controlled conversion into Sales Quotes."/>
		<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}"/>
		<ItemsControl Grid.Row="2" Margin="0,10,0,10" ItemsSource="{Binding Pipeline}">
			<ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,8,0" Padding="12,8" Style="{StaticResource WorkspaceToolbarBorderStyle}"><StackPanel><TextBlock Text="{Binding StageName}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{Binding OpportunityCount}"/><Run Text=" opportunities · "/><Run Text="{Binding ExpectedAmount, StringFormat={}{0:C0}}"/></TextBlock></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
		</ItemsControl>
		<controls:MasterDetailGrid Grid.Row="3">
			<controls:MasterDetailGrid.Master>
				<Border Style="{StaticResource WorkspaceSectionStyle}"><Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
					<controls:FilterBar><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><controls:SearchBox Placeholder="Search opportunities or customers" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Content="Search" Style="{StaticResource SecondaryButtonStyle}"/></Grid></controls:FilterBar>
					<ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Opportunities}" SelectedItem="{Binding SelectedOpportunity}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}">
						<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{Binding OpportunityNumber}"/><Run Text=" · "/><Run Text="{Binding StageName}"/></TextBlock></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding ExpectedAmount, StringFormat={}{0:C0}}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProbabilityPercent, StringFormat={}{0}%}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
					</ListBox>
					<Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding NewOpportunityCommand}" Content="New opportunity" Style="{StaticResource PrimaryButtonStyle}"/>
				</Grid></Border>
			</controls:MasterDetailGrid.Master>
			<controls:MasterDetailGrid.Detail>
				<Border Style="{StaticResource WorkspaceSectionStyle}"><Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
					<controls:WorkflowHeader Title="{Binding OpportunityDraft.OpportunityNumber, TargetNullValue=New opportunity}" Subtitle="Pipeline value, stage, close plan and activities" Status="{Binding OpportunityDraft.Outcome}"/>
					<TabControl Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource AppTabControlStyle}">
						<TabItem Header="Details"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,10,0,0">
							<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
							<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
							<StackPanel><TextBlock Text="Customer *" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
							<StackPanel Grid.Column="2"><TextBlock Text="Stage *" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage}" DisplayMemberPath="Name" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
							<StackPanel Grid.Row="2"><TextBlock Text="Expected close" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding OpportunityDraft.ExpectedCloseDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel>
							<StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Next activity" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding OpportunityDraft.NextActivityDate}" Style="{StaticResource AppDatePickerStyle}"/></StackPanel>
							<StackPanel Grid.Row="4"><TextBlock Text="Expected amount" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding OpportunityDraft.ExpectedAmount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
							<StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Probability %" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding OpportunityDraft.ProbabilityPercent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
							<StackPanel Grid.Row="6"><TextBlock Text="Currency" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding OpportunityDraft.Currency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
							<StackPanel Grid.Row="6" Grid.Column="2"><TextBlock Text="Close reason" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding CloseReason, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
						</Grid></ScrollViewer></TabItem>
						<TabItem Header="Activities"><Grid Margin="0,10,0,0">
							<Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
							<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
							<DataGrid ItemsSource="{Binding Activities}" SelectedItem="{Binding SelectedActivity}" Style="{StaticResource AppDataGridCompactStyle}">
								<DataGrid.Columns><DataGridTextColumn Header="Due" Binding="{Binding DueAtUtc, StringFormat={}{0:g}}" Width="130"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/><DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/></DataGrid.Columns>
							</DataGrid>
							<StackPanel Grid.Column="2"><TextBlock Text="Type" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding ActivityTypes}" SelectedItem="{Binding ActivityDraft.Type}" Style="{StaticResource AppComboBoxStyle}"/><TextBlock Text="Subject" Margin="0,8,0,0" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ActivityDraft.Subject, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Due" Margin="0,8,0,0" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding ActivityDraft.DueAtUtc}" Style="{StaticResource AppDatePickerStyle}"/><TextBlock Text="Notes" Margin="0,8,0,0" Style="{StaticResource FormLabelStyle}"/><TextBox MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MultilineTextBoxStyle}" Text="{Binding ActivityDraft.Notes, UpdateSourceTrigger=PropertyChanged}"/><StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Command="{Binding NewActivityCommand}" Content="New" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SaveActivityCommand}" Content="Save" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></StackPanel>
							<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"><Button Command="{Binding CompleteActivityCommand}" Content="Complete" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding CancelActivityCommand}" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
						</Grid></TabItem>
					</TabControl>
					<controls:WorkflowActionBar Grid.Row="2">
						<controls:WorkflowActionBar.SecondaryActions><StackPanel Orientation="Horizontal"><Button Command="{Binding CreateQuoteCommand}" Content="Create quote" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding LoseCommand}" Content="Mark lost" Style="{StaticResource DangerButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding WinCommand}" Content="Mark won" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></controls:WorkflowActionBar.SecondaryActions>
						<controls:WorkflowActionBar.PrimaryAction><Button Command="{Binding SaveOpportunityCommand}" Content="Save opportunity" Style="{StaticResource PrimaryButtonStyle}"/></controls:WorkflowActionBar.PrimaryAction>
					</controls:WorkflowActionBar>
				</Grid></Border>
			</controls:MasterDetailGrid.Detail>
		</controls:MasterDetailGrid>
	</Grid>
</UserControl>
