<UserControl x:Class="Depot.Views.ProjectAccountingView" AutomationProperties.Name="Projects workspace"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<controls:PageHeader Title="Projects" Subtitle="Operational project and cost-object tracking over authoritative Finance, Purchasing and Sales evidence.">
			<controls:PageHeader.Actions>
				<StackPanel Orientation="Horizontal">
					<Button Command="{Binding NewProjectCommand}" Content="New project" IsEnabled="{Binding CanManage}" Style="{StaticResource SecondaryButtonStyle}"/>
					<Button Margin="6,0,0,0" Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"/>
				</StackPanel>
			</controls:PageHeader.Actions>
		</controls:PageHeader>
		<controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}"/>
		<Grid Grid.Row="2" Margin="8">
			<Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
			<DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppDataGridCompactStyle}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120"/>
					<DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="*"/>
					<DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
					<DataGridTextColumn Header="Start" Binding="{Binding PlannedStartDate}" Width="110"/>
					<DataGridTextColumn Header="End" Binding="{Binding PlannedEndDate}" Width="110"/>
				</DataGrid.Columns>
			</DataGrid>
			<TabControl Grid.Column="2" Style="{StaticResource AppTabControlStyle}">
				<TabItem Header="Project">
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<StackPanel Margin="8">
							<TextBlock Text="Project master" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
							<TextBlock Margin="0,8,0,0" Text="Code" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ProjectCode,UpdateSourceTrigger=PropertyChanged}"/>
							<TextBlock Margin="0,8,0,0" Text="Name" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ProjectName,UpdateSourceTrigger=PropertyChanged}"/>
							<TextBlock Margin="0,8,0,0" Text="Legal entity ID" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding LegalEntityId,UpdateSourceTrigger=PropertyChanged}"/>
							<TextBlock Margin="0,8,0,0" Text="Owner user ID" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding OwnerUserId,UpdateSourceTrigger=PropertyChanged}"/>
							<TextBlock Margin="0,8,0,0" Text="Customer ID (optional)" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding CustomerId,UpdateSourceTrigger=PropertyChanged}"/>
							<TextBlock Margin="0,8,0,0" Text="Planned start" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding PlannedStartDate}"/>
							<TextBlock Margin="0,8,0,0" Text="Planned end" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding PlannedEndDate}"/>
							<TextBlock Margin="0,8,0,0" Text="Description" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding ProjectDescription,UpdateSourceTrigger=PropertyChanged}"/>
							<WrapPanel Margin="0,12,0,0">
								<Button Command="{Binding SaveProjectCommand}" Content="Save" IsEnabled="{Binding CanManage}" Style="{StaticResource PrimaryButtonStyle}"/>
								<Button Margin="6,0,0,0" Command="{Binding ActivateCommand}" Content="Activate" Style="{StaticResource SecondaryButtonStyle}"/>
								<Button Margin="6,0,0,0" Command="{Binding HoldCommand}" Content="Hold" Style="{StaticResource SecondaryButtonStyle}"/>
								<Button Margin="6,0,0,0" Command="{Binding CloseCommand}" Content="Close" Style="{StaticResource SecondaryButtonStyle}"/>
								<Button Margin="6,0,0,0" Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource DangerButtonStyle}"/>
							</WrapPanel>
						</StackPanel>
					</ScrollViewer>
				</TabItem>
				<TabItem Header="Attachments">
					<controls:BusinessAttachmentPanel Margin="8" DataContext="{Binding Attachments}"/>
				</TabItem>
				<TabItem Header="Phases">
					<Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
						<DataGrid ItemsSource="{Binding Phases}" SelectedItem="{Binding SelectedPhase}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppDataGridCompactStyle}">
							<DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Phase" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Start" Binding="{Binding PlannedStartDate}" Width="105"/><DataGridTextColumn Header="End" Binding="{Binding PlannedEndDate}" Width="105"/></DataGrid.Columns>
						</DataGrid>
						<StackPanel Grid.Column="2">
							<TextBlock Text="Phase" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
							<TextBlock Margin="0,8,0,0" Text="Code" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding PhaseCode,UpdateSourceTrigger=PropertyChanged}"/>
							<TextBlock Margin="0,8,0,0" Text="Name" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding PhaseName,UpdateSourceTrigger=PropertyChanged}"/>
							<TextBlock Margin="0,8,0,0" Text="Planned start" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding PhasePlannedStartDate}"/>
							<TextBlock Margin="0,8,0,0" Text="Planned end" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding PhasePlannedEndDate}"/>
							<TextBlock Margin="0,8,0,0" Text="Description" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding PhaseDescription,UpdateSourceTrigger=PropertyChanged}"/>
							<WrapPanel Margin="0,12,0,0">
								<Button Command="{Binding NewPhaseCommand}" Content="New" Style="{StaticResource SecondaryButtonStyle}"/>
								<Button Margin="6,0,0,0" Command="{Binding SavePhaseCommand}" Content="Save" Style="{StaticResource PrimaryButtonStyle}"/>
								<Button Margin="6,0,0,0" Command="{Binding ActivatePhaseCommand}" Content="Activate" Style="{StaticResource SecondaryButtonStyle}"/>
								<Button Margin="6,0,0,0" Command="{Binding CompletePhaseCommand}" Content="Complete" Style="{StaticResource SecondaryButtonStyle}"/>
								<Button Margin="6,0,0,0" Command="{Binding CancelPhaseCommand}" Content="Cancel" Style="{StaticResource DangerButtonStyle}"/>
							</WrapPanel>
						</StackPanel>
					</Grid>
				</TabItem>
				<TabItem Header="Attribution">
					<Grid Margin="8">
						<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
						<Border Style="{StaticResource WorkspaceSectionStyle}">
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
								<StackPanel Margin="0,0,8,0"><TextBlock Text="Source type" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding AttributionKinds}" SelectedItem="{Binding SelectedAttributionKind}"/></StackPanel>
								<StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Source entity ID" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding AttributionEntityId,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
								<StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Phase" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding Phases}" SelectedItem="{Binding SelectedPhase}" DisplayMemberPath="Name"/></StackPanel>
								<StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Command="{Binding AttributeCommand}" Content="Attribute" Style="{StaticResource PrimaryButtonStyle}"/><Button Margin="6,0,0,0" Command="{Binding RemoveAttributionCommand}" Content="Remove" Style="{StaticResource DangerButtonStyle}"/></StackPanel>
							</Grid>
						</Border>
						<DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Attributions}" SelectedItem="{Binding SelectedAttribution}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppDataGridCompactStyle}">
							<DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding EntityKind}" Width="140"/><DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="100"/><DataGridTextColumn Header="Phase ID" Binding="{Binding ProjectPhaseId}" Width="100"/><DataGridTextColumn Header="Source" Binding="{Binding SourceType}" Width="*"/><DataGridTextColumn Header="Source ID" Binding="{Binding SourceId}" Width="*"/><DataGridCheckBoxColumn Header="Immutable" Binding="{Binding IsImmutable}" Width="90"/></DataGrid.Columns>
						</DataGrid>
					</Grid>
				</TabItem>
				<TabItem Header="Budget links">
					<Grid Margin="8">
						<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
						<Border Style="{StaticResource WorkspaceSectionStyle}">
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
								<StackPanel Margin="0,0,8,0"><TextBlock Text="Available Finance budget line" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding BudgetLineOptions}" SelectedItem="{Binding SelectedBudgetLineOption}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding BudgetName}"/><Run Text=" · "/><Run Text="{Binding FiscalYear}"/><Run Text=" · "/><Run Text="{Binding PeriodCode}"/><Run Text=" · "/><Run Text="{Binding AccountNumber}"/><Run Text=" · "/><Run Text="{Binding Amount,StringFormat=N2}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
								<StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Category (optional)" Style="{StaticResource FormLabelStyle}"/><controls:TextInput Text="{Binding BudgetCategoryCode,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
								<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Command="{Binding LinkBudgetLineCommand}" Content="Link" Style="{StaticResource PrimaryButtonStyle}"/><Button Margin="6,0,0,0" Command="{Binding UnlinkBudgetLineCommand}" Content="Unlink selected" Style="{StaticResource DangerButtonStyle}"/></StackPanel>
							</Grid>
						</Border>
						<DataGrid Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding BudgetLinks}" SelectedItem="{Binding SelectedBudgetLink}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppDataGridCompactStyle}">
							<DataGrid.Columns><DataGridTextColumn Header="Finance line ID" Binding="{Binding FinanceBudgetLineId}" Width="140"/><DataGridTextColumn Header="Phase ID" Binding="{Binding ProjectPhaseId}" Width="100"/><DataGridTextColumn Header="Category" Binding="{Binding CategoryCode}" Width="*"/></DataGrid.Columns>
						</DataGrid>
					</Grid>
				</TabItem>
				<TabItem Header="Financials">
					<Grid Margin="8">
						<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
						<TextBlock Text="{Binding FinancialSummaryText}" TextWrapping="Wrap"/>
						<TabControl Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource AppTabControlStyle}">
							<TabItem Header="Actuals"><DataGrid ItemsSource="{Binding Actuals}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding PostingDate}" Width="105"/><DataGridTextColumn Header="Entry" Binding="{Binding EntryNumber}" Width="120"/><DataGridTextColumn Header="Account" Binding="{Binding AccountNumber}" Width="110"/><DataGridTextColumn Header="Name" Binding="{Binding AccountName}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount,StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
							<TabItem Header="Commitments"><DataGrid ItemsSource="{Binding Commitments}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="PO" Binding="{Binding OrderNumber}" Width="120"/><DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/><DataGridTextColumn Header="Item" Binding="{Binding PartNumber}" Width="120"/><DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount,StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
							<TabItem Header="Budget variance"><DataGrid ItemsSource="{Binding VarianceRows}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppDataGridCompactStyle}"><DataGrid.Columns><DataGridTextColumn Header="Period" Binding="{Binding PeriodCode}" Width="100"/><DataGridTextColumn Header="Account" Binding="{Binding AccountNumber}" Width="110"/><DataGridTextColumn Header="Actual" Binding="{Binding Actual,StringFormat=N2}" Width="120"/><DataGridTextColumn Header="Budget" Binding="{Binding Budget,StringFormat=N2}" Width="120"/><DataGridTextColumn Header="Variance" Binding="{Binding Variance,StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
						</TabControl>
					</Grid>
				</TabItem>
			</TabControl>
		</Grid>
	</Grid>
</UserControl>
