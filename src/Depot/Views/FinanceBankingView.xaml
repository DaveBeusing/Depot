<UserControl x:Class="Depot.Views.FinanceBankingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Depot.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <controls:PageHeader Title="Banking and Payments" Subtitle="Bank accounts, statements, payment proposals, reconciliation, and cash position.">
            <controls:PageHeader.Actions><Button Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"/></controls:PageHeader.Actions>
        </controls:PageHeader>
        <controls:OperationPanel Grid.Row="1" ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" Severity="{Binding OperationSeverity}" ActionText="{Binding OperationActionText}" ActionCommand="{Binding RefreshCommand}" />
        <TabControl Grid.Row="2" Style="{StaticResource AppTabControlStyle}">
            <TabItem Header="Cash Position">
                <DataGrid Margin="8" ItemsSource="{Binding CashPositions}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bank account" Binding="{Binding BankAccountName}" Width="*"/>
                        <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90"/>
                        <DataGridTextColumn Header="Statement date" Binding="{Binding StatementDate}" Width="120"/>
                        <DataGridTextColumn Header="Statement balance" Binding="{Binding StatementBalance, StringFormat={}{0:N2}}" Width="140" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                        <DataGridTextColumn Header="GL balance" Binding="{Binding GeneralLedgerBalance, StringFormat={}{0:N2}}" Width="140" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                        <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat={}{0:N2}}" Width="120" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                        <DataGridTextColumn Header="Unreconciled" Binding="{Binding UnreconciledLineCount}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Bank Accounts">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False">
                        <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Bank" Binding="{Binding BankName}" Width="*"/><DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource WorkspaceSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="Bank account configuration" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                                <TextBlock Margin="0,10,0,0" Text="Name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding AccountName}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Bank name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding BankName}" Style="{StaticResource AppTextBoxStyle}"/>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IBAN" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding Iban}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="BIC" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding Bic}" Style="{StaticResource AppTextBoxStyle}"/></StackPanel></Grid>
                                <TextBlock Margin="0,8,0,0" Text="Local account number" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding LocalAccountNumber}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Legal entity ID" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding LegalEntityId}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Accounting book ID" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding AccountingBookId}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Bank GL account ID" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding GeneralLedgerAccountId}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Currency" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding Currency}" Style="{StaticResource AppTextBoxStyle}"/>
                                <controls:AppCheckBox Margin="0,8,0,0" Content="Active" IsChecked="{Binding AccountActive}"/>
                                <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right"><Button Command="{Binding NewBankAccountCommand}" Content="New" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding SaveBankAccountCommand}" Content="Save" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Statements">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="12"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Statements}" SelectedItem="{Binding SelectedStatement}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False">
                            <DataGrid.Columns><DataGridTextColumn Header="Reference" Binding="{Binding StatementReference}" Width="*"/><DataGridTextColumn Header="From" Binding="{Binding FromDate}" Width="105"/><DataGridTextColumn Header="To" Binding="{Binding ToDate}" Width="105"/><DataGridTextColumn Header="Closing" Binding="{Binding ClosingBalance, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="2" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Import bank statement" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,10,0,0" Text="Import format" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding StatementFormats}" SelectedItem="{Binding StatementFormat}" Style="{StaticResource AppComboBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Statement reference (CSV optional)" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding StatementReference}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Source filename" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding StatementFileName}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="CSV or ISO 20022 camt.053 content" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding StatementContent}" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource AppTextBoxStyle}"/><WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right"><Button Command="{Binding LoadStatementCommand}" Content="Load lines" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Command="{Binding ImportStatementCommand}" Content="Import" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                    </Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding StatementLines}" SelectedItem="{Binding SelectedStatementLine}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False">
                            <DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding BookingDate}" Width="105"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/><DataGridTextColumn Header="Counterparty" Binding="{Binding CounterpartyName}" Width="*"/><DataGridCheckBoxColumn Header="Matched" Binding="{Binding IsReconciled}" Width="75"/></DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="2" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Reconciliation" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,10,0,0" Text="Target" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding ReconciliationTargets}" SelectedItem="{Binding TargetKind}" Style="{StaticResource AppComboBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Target ID" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding TargetId}" Style="{StaticResource AppTextBoxStyle}"/><Button Margin="0,10,0,0" Command="{Binding ReconcileCommand}" Content="Reconcile" Style="{StaticResource PrimaryButtonStyle}"/><TextBlock Margin="0,14,0,0" Text="Reversal reason" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding ReversalReason}" Style="{StaticResource AppTextBoxStyle}"/><Button Margin="0,8,0,0" Command="{Binding ReverseReconciliationCommand}" Content="Reverse reconciliation" Style="{StaticResource DangerButtonStyle}"/></StackPanel></Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Reconciliation Designer">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource WorkspaceSectionStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Unreconciled bank lines" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                            <TextBlock Grid.Row="1" Margin="0,4,0,8" Text="{Binding ReconciliationPageSummary}" Style="{StaticResource CaptionStyle}"/>
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding ReconciliationDesignerLines}"
                                      SelectedItem="{Binding SelectedReconciliationLine}"
                                      Style="{StaticResource AppDataGridCompactStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding BookingDate}" Width="100"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                                    <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="75"/>
                                    <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/>
                                    <DataGridTextColumn Header="Counterparty" Binding="{Binding CounterpartyName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                                <Button Command="{Binding PreviousReconciliationPageCommand}" Content="Previous" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Margin="8,0,0,0" Command="{Binding NextReconciliationPageCommand}" Content="Next" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Margin="8,0,0,0" Command="{Binding LoadReconciliationPageCommand}" Content="Refresh page" Style="{StaticResource SecondaryButtonStyle}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ReconciliationPreviewDropZone"
                            Grid.Column="2"
                            Style="{StaticResource WorkspaceSectionStyle}"
                            AllowDrop="True"
                            Drop="OnReconciliationPreviewDrop">
                        <StackPanel>
                            <TextBlock Text="Match preview" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                            <TextBlock Margin="0,10,0,0" Text="Bank evidence" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock Margin="0,3,0,0" Text="{Binding ReconciliationBankEvidence}" TextWrapping="Wrap"/>
                            <Separator Margin="0,12"/>
                            <TextBlock Text="Target evidence" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock Margin="0,3,0,0" Text="{Binding ReconciliationTargetEvidence}" TextWrapping="Wrap"/>
                            <Separator Margin="0,12"/>
                            <TextBlock Text="Amount" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock Margin="0,3,0,0" Text="{Binding ReconciliationMatchAmountEvidence}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,10,0,0" Text="Reference" Style="{StaticResource FormLabelStyle}"/>
                            <TextBlock Margin="0,3,0,0" Text="{Binding ReconciliationMatchReferenceEvidence}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,14,0,0" Text="A preview never creates a reconciliation. Match is always an explicit user action." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                            <Button Margin="0,14,0,0"
                                    Command="{Binding MatchReconciliationCandidateCommand}"
                                    Content="Match"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                            <Separator Margin="0,16,0,12"/>
                            <TextBlock Text="Match history" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                            <ListBox Margin="0,6,0,0"
                                     MaxHeight="220"
                                     ItemsSource="{Binding ReconciliationHistory}"
                                     SelectedItem="{Binding SelectedReconciliationHistoryItem}"
                                     Style="{StaticResource AppListBoxStyle}"
                                     IsTabStop="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Line Grid.Column="0" X1="3" X2="3" Y1="0" Y2="28" Stroke="{DynamicResource NavigationAccentBrush}" StrokeThickness="2">
                                                <Line.Style>
                                                    <Style TargetType="Line">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReversed}" Value="True">
                                                                <Setter Property="StrokeDashArray" Value="3 2"/>
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Line.Style>
                                            </Line>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock FontWeight="SemiBold"><Run Text="{Binding TargetDisplay}"/><Run Text=" · "/><Run Text="{Binding Status}"/></TextBlock>
                                                <TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{Binding Reconciliation.CreatedAtUtc}"/><Run Text=" · "/><Run Text="{Binding Reconciliation.MatchedAmount, StringFormat={}{0:N2}}"/></TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,8,0,0" Text="{Binding ReconciliationHistoryBankEvidence}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" Text="{Binding ReconciliationHistoryTargetEvidence}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,10,0,0" Text="Reversal reason" Style="{StaticResource FormLabelStyle}"/>
                            <controls:TextInput Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Margin="0,8,0,0" Command="{Binding ReverseSelectedReconciliationCommand}" Content="Reverse selected active match" Style="{StaticResource DangerButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource WorkspaceSectionStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Match targets" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                            <TextBlock Grid.Row="1" Margin="0,4,0,8" Text="Candidates are exact existing payment or General Ledger evidence. No target is selected automatically." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                            <DataGrid x:Name="ReconciliationCandidateGrid"
                                      Grid.Row="2"
                                      ItemsSource="{Binding ReconciliationCandidates}"
                                      SelectedItem="{Binding SelectedReconciliationCandidate}"
                                      Style="{StaticResource AppDataGridCompactStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      PreviewMouseLeftButtonDown="OnReconciliationCandidateMouseLeftButtonDown"
                                      PreviewMouseMove="OnReconciliationCandidateMouseMove"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TargetKind}" Width="125"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="105" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                                    <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/>
                                    <DataGridTextColumn Header="Counterparty" Binding="{Binding Counterparty}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Right">
                                <Button Command="{Binding LoadReconciliationCandidatesCommand}" Content="Load candidates" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Margin="8,0,0,0" Command="{Binding UseReconciliationCandidateCommand}" Content="Use selected target" Style="{StaticResource PrimaryButtonStyle}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Payment Runs">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding PaymentRuns}" SelectedItem="{Binding SelectedPaymentRun}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Date" Binding="{Binding PaymentDate}" Width="105"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid><DataGrid Grid.Row="1" ItemsSource="{Binding PaymentRunLines}" SelectedItem="{Binding SelectedPaymentRunLine}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Open item" Binding="{Binding PayableOpenItemId}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Supplier" Binding="{Binding SupplierId}" Width="90" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="110" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="AP payment" Binding="{Binding PayablePaymentId}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/></DataGrid.Columns></DataGrid></Grid>
                    <StackPanel Grid.Column="2"><Border Margin="0,0,0,12" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="New supplier payment proposal" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,10,0,0" Text="Payable open-item ID" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PayableOpenItemId}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Amount" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PaymentAmount}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Payment date" Style="{StaticResource FormLabelStyle}"/><DatePicker SelectedDate="{Binding PaymentDate}"/><TextBlock Margin="0,8,0,0" Text="Reference" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PaymentReference}" Style="{StaticResource AppTextBoxStyle}"/><TextBlock Margin="0,8,0,0" Text="Description" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PaymentDescription}" Style="{StaticResource AppTextBoxStyle}"/><Button Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding CreatePaymentRunCommand}" Content="Create proposal" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Border><Border Margin="0,0,0,12" Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Approval flow" Style="{StaticResource WorkspaceSectionTitleStyle}"/><controls:ApprovalFlowVisualizer Margin="0,10,0,0" Projection="{Binding PaymentApprovalFlow}"/></StackPanel></Border><Border Style="{StaticResource WorkspaceSectionStyle}"><StackPanel><TextBlock Text="Approval and execution" Style="{StaticResource WorkspaceSectionTitleStyle}"/><TextBlock Margin="0,10,0,0" Text="Approval comment" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding ApprovalComment}" Style="{StaticResource AppTextBoxStyle}"/><Button Margin="0,8,0,0" HorizontalAlignment="Right" Command="{Binding ApprovePaymentRunCommand}" Content="Approve selected run" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock Margin="0,12,0,0" Text="Execution reference" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding ExecutionReference}" Style="{StaticResource AppTextBoxStyle}"/><Button Margin="0,8,0,0" HorizontalAlignment="Right" Command="{Binding ExecutePaymentRunLineCommand}" Content="Execute selected line" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Border></StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="SEPA Export">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource WorkspaceSectionStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Payment export history" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                            <TextBlock Grid.Row="1" Margin="0,4,0,8" Text="Select an approved payment run on the Payment Runs tab. Export retries return the retained artifact; regeneration requires explicit supersede." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding SepaExports}" SelectedItem="{Binding SelectedSepaExport}" Style="{StaticResource AppDataGridCompactStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Seq" Binding="{Binding ExportSequence}" Width="55" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                                    <DataGridTextColumn Header="Message ID" Binding="{Binding MessageId}" Width="*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding CurrentStatus}" Width="120"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding ControlSum, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource AppDataGridNumericTextStyle}"/>
                                    <DataGridTextColumn Header="SHA-256" Binding="{Binding XmlSha256}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Text="{Binding SepaPreviewText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Command="{Binding PreviewSepaExportCommand}" Content="Validate" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanGenerateSepaExports}"/>
                                    <Button Margin="8,0,0,0" Command="{Binding GenerateSepaExportCommand}" Content="Generate / retry" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanGenerateSepaExports}"/>
                                    <Button Margin="8,0,0,0" Command="{Binding SupersedeSepaExportCommand}" Content="Supersede + regenerate" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanGenerateSepaExports}"/>
                                    <Button Margin="8,0,0,0" Command="{Binding DownloadSepaExportCommand}" Content="Download exact XML" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanDownloadSepaExports}"/>
                                </WrapPanel>
                                <Separator Margin="0,12"/>
                                <TextBlock Text="External status evidence" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Margin="0,4,0,0" ItemsSource="{Binding SepaManualStatuses}" SelectedItem="{Binding SepaTargetStatus}" Style="{StaticResource AppComboBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="External reference" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding SepaExternalReference}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Evidence note" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding SepaEvidenceNote}" Style="{StaticResource AppTextBoxStyle}"/>
                                <Button Margin="0,8,0,0" HorizontalAlignment="Right" Command="{Binding UpdateSepaExportStatusCommand}" Content="Record status" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanManageSepaStatus}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource WorkspaceSectionStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Debtor payment profile" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                                <TextBlock Margin="0,4,0,10" Text="Explicit structured payment identity for the selected bank account. IBAN/BIC remain on the bank account." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                                <TextBlock Text="Account holder / debtor name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding DebtorName}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Street name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding DebtorStreet}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Building number" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding DebtorBuilding}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Postal code" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding DebtorPostalCode}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Town" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding DebtorTown}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Country subdivision" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding DebtorSubdivision}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Country code" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding DebtorCountry}" Style="{StaticResource AppTextBoxStyle}"/>
                                <Button Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding SaveSepaDebtorProfileCommand}" Content="Save debtor profile" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanManageSepaProfiles}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource WorkspaceSectionStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Supplier / creditor payment profile" Style="{StaticResource WorkspaceSectionTitleStyle}"/>
                                <TextBlock Margin="0,4,0,10" Text="A structured profile is required for every supplier in the payment run. No free-form supplier address is emitted." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                                <TextBlock Text="Supplier ID" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding CreditorSupplierId}" Style="{StaticResource AppTextBoxStyle}"/>
                                <Button Margin="0,6,0,8" HorizontalAlignment="Right" Command="{Binding LoadSepaCreditorProfileCommand}" Content="Load profile" Style="{StaticResource SecondaryButtonStyle}"/>
                                <TextBlock Text="Creditor name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding CreditorName}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="IBAN" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding CreditorIban}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="BIC (optional where permitted)" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding CreditorBic}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Street name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding CreditorStreet}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Building number" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding CreditorBuilding}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Postal code" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding CreditorPostalCode}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Town" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding CreditorTown}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Country subdivision" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding CreditorSubdivision}" Style="{StaticResource AppTextBoxStyle}"/>
                                <TextBlock Margin="0,8,0,0" Text="Country code" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding CreditorCountry}" Style="{StaticResource AppTextBoxStyle}"/>
                                <CheckBox Margin="0,8,0,0" Content="Active for SEPA export" IsChecked="{Binding CreditorActive}"/>
                                <Button Margin="0,10,0,0" HorizontalAlignment="Right" Command="{Binding SaveSepaCreditorProfileCommand}" Content="Save creditor profile" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanManageSepaProfiles}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>