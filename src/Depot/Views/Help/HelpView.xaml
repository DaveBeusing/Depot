<UserControl x:Class="Depot.Views.Help.HelpView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:commands="clr-namespace:Depot.Commands" xmlns:controls="clr-namespace:Depot.Controls">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><controls:OperationPanel ErrorText="{Binding OperationError}" HasError="{Binding HasOperationError}" IsBusy="{Binding IsBusy}" StatusText="{Binding StatusText}" /><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource Help.Navigation.Width}" /><ColumnDefinition Width="{DynamicResource Help.ColumnGap}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:Card><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><controls:SearchBox AutomationProperties.Name="Search help" Placeholder="Search help" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /><ComboBox Grid.Row="1" Margin="{DynamicResource Control.Margin}" AutomationProperties.Name="Help category" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Style="{DynamicResource AppComboBoxStyle}" /><Grid Grid.Row="2" Margin="{DynamicResource Control.Margin.Large}"><ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}" Style="{DynamicResource HelpTopicListStyle}" ItemContainerStyle="{DynamicResource HelpTopicListItemStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock FontWeight="SemiBold" FontSize="12" Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock Margin="{DynamicResource Help.Topic.Category.Margin}" Style="{DynamicResource CaptionStyle}" Text="{Binding Category}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><controls:EmptyState Title="No help topics found" Description="Change the search text or category filter." Visibility="{Binding HasNoTopics, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid></Grid></controls:Card><controls:Card Grid.Column="2" Padding="{DynamicResource Help.Article.Padding}"><Grid MaxWidth="{DynamicResource Help.Document.MaxWidth}" HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><FlowDocumentScrollViewer x:Name="DocumentViewer" Document="{Binding Document}" Style="{DynamicResource HelpDocumentViewerStyle}" /><StackPanel Grid.Row="1" Margin="{DynamicResource Help.Related.Margin}" Visibility="{Binding HasRelatedTopics, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Related topics" Style="{DynamicResource SectionTitleStyle}" /><ItemsControl Margin="{DynamicResource Control.Margin}" ItemsSource="{Binding RelatedTopics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button MinWidth="0" Height="Auto" Padding="{DynamicResource Help.Link.Padding}" Margin="{DynamicResource Help.Related.Item.Margin}" HorizontalContentAlignment="Left" Command="{x:Static commands:HelpCommands.OpenTopic}" CommandParameter="{Binding Id}" Content="{Binding Title}" Style="{DynamicResource SecondaryButtonStyle}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><controls:EmptyState Title="Select a help topic" Description="Choose a topic from the list or search Depot help." Visibility="{Binding HasNoDocument, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid></controls:Card></Grid></Grid></UserControl>