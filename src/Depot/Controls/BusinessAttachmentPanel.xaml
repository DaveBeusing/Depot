<UserControl x:Class="Depot.Controls.BusinessAttachmentPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
	xmlns:controls="clr-namespace:Depot.Controls">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
			<StackPanel>
				<TextBlock Text="Attachments" Style="{StaticResource WorkspaceSectionTitleStyle}" />
				<TextBlock Margin="0,3,0,0" Text="{Binding TargetHint}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal">
				<Button automation:AutomationProperties.Name="Refresh attachments" Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" />
				<Button Margin="{StaticResource Button.Margin}" automation:AutomationProperties.Name="Attach file" Command="{Binding UploadCommand}" Content="Attach file" Style="{StaticResource PrimaryButtonStyle}" />
			</StackPanel>
		</Grid>
		<controls:OperationPanel Grid.Row="1" Margin="0,10,0,0" ErrorText="{Binding ErrorMessage}" HasError="{Binding HasError}" />
		<Grid Grid.Row="2" Margin="0,10,0,0">
			<Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
			<Grid>
				<ListBox ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}" Style="{StaticResource MasterDataListBoxStyle}" ItemContainerStyle="{StaticResource MasterDataListBoxItemStyle}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid Margin="4">
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
									<TextBlock Style="{StaticResource CaptionStyle}"><Run Text="{Binding MediaType}" /><Run Text=" · rev " /><Run Text="{Binding CurrentRevision}" /></TextBlock>
								</StackPanel>
								<controls:DocumentStatusBadge Grid.Column="1" Status="{Binding Status}" />
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<controls:EmptyState Title="No attachments" Description="Attach supporting documents to this saved business record." Visibility="{Binding HasNoAttachments, Converter={StaticResource BooleanToVisibilityConverter}}" />
			</Grid>
			<Grid Grid.Column="2">
				<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
				<Grid>
					<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
					<StackPanel><TextBlock Text="Category" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
					<StackPanel Grid.Column="2"><TextBlock Text="Description" Style="{StaticResource FormLabelStyle}" /><controls:TextInput Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
				</Grid>
				<StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
					<Button Command="{Binding SaveMetadataCommand}" Content="Save metadata" Style="{StaticResource SecondaryButtonStyle}" />
					<Button Margin="{StaticResource Button.Margin}" Command="{Binding DownloadCommand}" Content="Download" Style="{StaticResource SecondaryButtonStyle}" />
					<Button Margin="{StaticResource Button.Margin}" Command="{Binding ReplaceCommand}" Content="Replace" Style="{StaticResource SecondaryButtonStyle}" />
					<Button Margin="{StaticResource Button.Margin}" Command="{Binding RetireCommand}" Content="Retire" Style="{StaticResource DangerButtonStyle}" />
				</StackPanel>
				<DataGrid Grid.Row="2" Margin="0,12,0,0" IsReadOnly="True" ItemsSource="{Binding Revisions}" Style="{StaticResource AppDataGridCompactStyle}" MaxHeight="180">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Revision" Binding="{Binding Revision}" Width="70" />
						<DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
						<DataGridTextColumn Header="Bytes" Binding="{Binding ByteLength, StringFormat={}{0:N0}}" Width="90" />
						<DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc, StringFormat={}{0:g}}" Width="130" />
					</DataGrid.Columns>
				</DataGrid>
				<TextBlock Grid.Row="3" Margin="0,8,0,0" Text="Previous revisions are immutable. Replacing content creates a new revision; retiring does not delete retained content." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
			</Grid>
		</Grid>
	</Grid>
</UserControl>
